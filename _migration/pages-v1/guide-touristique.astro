---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Guides et excursions", href: L("/guide-touristique/") },
];

const toc = [
  { label: "Guide agréé ou faux guide", id: "agree" },
  { label: "Types de visites", id: "types" },
  { label: "Tarifs indicatifs", id: "tarifs" },
  { label: "Ce que doit inclure une excursion", id: "inclusions" },
  { label: "Quand un guide est utile", id: "utile" },
  { label: "Pièges", id: "pieges" },
];

const faqs = [
  { q: "Comment reconnaître un guide officiel à Marrakech ?", a: "Il porte un badge officiel délivré par les autorités du tourisme, avec sa photo, son nom et son numéro d'agrément, et il vous le présente sur demande. Un guide agréé accepte de convenir du tarif et du parcours avant le départ. Méfiez-vous de ceux qui se présentent comme étudiants ou proposent de vous guider « gratuitement » dans la rue." },
  { q: "Combien coûte un guide à Marrakech ?", a: "À titre indicatif, une visite de la médina d'une demi-journée avec un guide agréé se situe entre 250 et 400 MAD ; une journée entre 500 et 800 MAD. Un guide de montagne ou un chauffeur-guide pour une excursion coûte davantage, souvent 900 à 1 500 MAD la journée avec véhicule. Fixez toujours le tarif par écrit ou de vive voix avant de partir." },
  { q: "Faut-il un guide pour visiter la médina ?", a: "Ce n'est pas obligatoire, mais utile pour la première demi-journée : il vous oriente dans les souks, vous explique les métiers et vous évite les faux guides. Ensuite, beaucoup de visiteurs préfèrent se promener seuls en gardant en tête la Koutoubia." },
  { q: "Que comprend une excursion organisée ?", a: "En général le transport, un guide ou un chauffeur, et parfois un déjeuner. Vérifiez ce qui est exclu : entrées, repas, boissons, pourboires. Demandez la taille du groupe, l'heure de départ et de retour, et la politique d'annulation." },
  { q: "Comment éviter les commissions dans les boutiques ?", a: "En précisant dès le départ à votre guide que vous ne souhaitez pas de visite de boutiques imposée. Un bon guide respecte cette demande. Sur les souks, un guide peu scrupuleux vous emmène vers des commerces qui lui reversent une commission, ce qui renchérit les prix." },
  { q: "Puis-je réserver un chauffeur pour une excursion à la journée ?", a: "Oui, c'est souvent la formule la plus souple : un chauffeur privé pour l'Ourika, Agafay, Ouzoud ou Essaouira, à l'horaire de votre choix. Comparez avec une excursion de groupe et une voiture de location, selon le nombre de personnes." },
];
---
<GuideLayout
  keywords="guide Marrakech, guide officiel Marrakech, excursion Marrakech, visite guidée médina, tarif guide"
  title={"Guide à Marrakech : choisir un guide agréé, tarifs"}
  description={"Choisir un guide à Marrakech : guide agréé ou faux guide, tarifs indicatifs, types de visites, ce que doit inclure une excursion et pièges à éviter."}
  eyebrow={"Pratique · Guides et excursions"}
  h1={"Guides et excursions à Marrakech"}
  lede={"Un bon guide fait gagner une demi-journée et évite les pièges ; un mauvais en fait perdre deux. Voici comment reconnaître un guide agréé, ce qu'il coûte, et quelle formule choisir."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-medina"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un chauffeur pour votre excursion", text: "Réservez un véhicule avec chauffeur pour la journée : horaires libres, arrêts à la carte, prix affiché à l'avance.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="agree">Guide agréé ou faux guide</h2>
<p>
  Les autorités marocaines délivrent aux guides professionnels un <strong>badge officiel</strong> et une carte
  d'agrément. C'est votre premier critère. Un guide agréé se présente, montre son badge, accepte que vous
  vérifiiez son identité et convient d'un tarif avant de partir. À l'inverse, les « faux guides » — des
  personnes qui vous abordent dans la rue en proposant de vous accompagner gratuitement, ou qui vous
  affirment que votre destination est fermée — cherchent une commission ou vous conduisent dans des
  boutiques.
</p>
<div class="callout">
  <span class="callout-label">Le test simple</span>
  <p>
    Demandez le badge et le tarif. Un professionnel répondra sans hésiter. Une personne qui esquive, qui
    insiste ou qui parle de « cadeau » est à éviter. Voyez aussi
    <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>.
  </p>
</div>

<h2 id="types">Types de visites</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Formule</th><th>Durée</th><th>Ce qu'on y voit</th></tr></thead>
    <tbody>
      <tr><td><strong>Médina et souks</strong></td><td>3 à 4 h</td><td>Monuments, corporations, portes, orientation</td></tr>
      <tr><td><strong>Gastronomie</strong></td><td>3 à 4 h</td><td>Marchés, stands, dégustations, cuisine de rue</td></tr>
      <tr><td><strong>Artisanat</strong></td><td>Demi-journée</td><td>Ateliers de tannage, poterie, tissage</td></tr>
      <tr><td><strong>Excursion à la journée</strong></td><td>8 à 10 h</td><td>Ourika, Ouzoud, Agafay, Essaouira</td></tr>
      <tr><td><strong>Randonnée en montagne</strong></td><td>Journée</td><td>Guide de montagne agréé, Haut Atlas</td></tr>
    </tbody>
  </table>
</div>
<p>
  Nous détaillons les principales excursions sur
  <a href={L('/excursion-vallee-ourika/')}>l'Ourika</a>,
  <a href={L('/excursion-desert-agafay/')}>Agafay</a>,
  <a href={L('/excursion-cascades-ouzoud/')}>Ouzoud</a> et
  <a href={L('/excursion-marrakech-essaouira/')}>Essaouira</a>.
</p>

<h2 id="tarifs">Tarifs indicatifs</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Prestation</th><th>Prix indicatif</th></tr></thead>
    <tbody>
      <tr><td>Guide officiel, médina, demi-journée</td><td class="num">250 – 400 MAD</td></tr>
      <tr><td>Guide officiel, médina, journée</td><td class="num">500 – 800 MAD</td></tr>
      <tr><td>Excursion de groupe (Ourika, Ouzoud…)</td><td class="num">250 – 450 MAD / pers.</td></tr>
      <tr><td>Chauffeur-guide privé, journée, véhicule inclus</td><td class="num">900 – 1 500 MAD</td></tr>
      <tr><td>Cours de cuisine</td><td class="num">400 – 700 MAD / pers.</td></tr>
    </tbody>
  </table>
</div>
<p class="small text-muted">Ordres de grandeur ; les tarifs varient selon la saison, la durée et le groupe.</p>

<h2 id="inclusions">Ce que doit inclure une excursion</h2>
<ul>
  <li><strong>Le transport</strong>, avec heure de départ et de retour.</li>
  <li><strong>Un guide ou chauffeur</strong> identifié, agréé si la visite l'exige.</li>
  <li><strong>Les entrées</strong> : précisez si elles sont comprises.</li>
  <li><strong>Le déjeuner</strong> : compris ou non, avec un budget indicatif.</li>
  <li><strong>La taille du groupe</strong>, pour éviter de partager un minibus de trente personnes.</li>
  <li><strong>L'annulation</strong> : délai et remboursement.</li>
</ul>

<h2 id="utile">Quand un guide est vraiment utile</h2>
<ul>
  <li><strong>La première demi-journée en médina</strong> : orientation, repères, ambiance.</li>
  <li><strong>Les souks</strong> : pour comprendre les métiers et connaître les bons prix.</li>
  <li><strong>La montagne</strong> : un guide de montagne agréé est indispensable pour un trek.</li>
  <li><strong>Les sites où le contexte change tout</strong> : madrasa, palais, jardins historiques.</li>
</ul>
<p>
  Pour le reste, une visite libre suffit. Nos parcours sont sur
  <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>, et l'orientation dans
  <a href={L('/medina-marrakech/')}>la médina</a>.
</p>

<h2 id="pieges">Pièges</h2>
<ul>
  <li><strong>Le tarif non convenu :</strong> « on verra à la fin » aboutit à une somme élevée.</li>
  <li><strong>Les boutiques imposées :</strong> précisez d'entrée que vous n'en voulez pas.</li>
  <li><strong>Les excursions « tout compris » très bon marché :</strong> souvent des étapes commerciales déguisées.</li>
  <li><strong>Les rabatteurs d'hôtel ou de rue :</strong> réservez plutôt à l'avance, auprès d'une source fiable.</li>
</ul>
</GuideLayout>
