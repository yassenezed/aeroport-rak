---
import DestinationsLayout from '../layouts/DestinationsLayout.astro';
import { getLocalizedPath } from '../i18n';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Vols', href: L('/vols-marrakech/') },
  { name: 'Lignes et compagnies', href: L('/destinations-aeroport-marrakech/') },
];

const dict = {
  city: 'Ville',
  country: 'Pays',
  continent: 'Région',
  airlines: 'Compagnie(s)',
  searchPlaceholder: 'Rechercher une ville, un pays ou une compagnie...',
  noResults: 'Aucune destination trouvée.',
  stats: {
    destinations: 'Destinations',
    airlines: 'Compagnies',
    continents: 'Régions'
  }
};
---
<DestinationsLayout
  lang="fr"
  title={"Vols directs depuis Marrakech : villes et compagnies"}
  description={"Les villes reliées en vol direct à Marrakech Ménara, par pays et par compagnie : France, Royaume-Uni, Espagne, Belgique, Suisse, Maroc et au-delà."}
  h1="Lignes et compagnies au départ de Marrakech"
  lede="Recherchez votre ville pour savoir quelles compagnies la relient à Marrakech en vol direct. La liste évolue à chaque saison : elle donne un ordre de grandeur fiable, pas un horaire."
  breadcrumbs={breadcrumbs}
  dict={dict}
>
  <section class="content-section">
    <div class="container">
      <div class="content-prose">
        <h2>Comment lire cette liste</h2>
        <p>
          Marrakech Ménara est le premier aéroport touristique du Maroc et le plus dense de son réseau
          après Casablanca. Ce tableau recense les villes reliées en vol régulier et les compagnies qui
          opèrent ces lignes. Il ne remplace pas un moteur de réservation : les fréquences changent
          avec les saisons — programmes d'hiver et d'été — et une ligne active en juillet peut être
          suspendue en janvier.
        </p>
        <p>
          Les compagnies à bas coût — Ryanair, easyJet, Transavia, Vueling, Wizz Air, Jet2 — assurent
          l'essentiel des rotations européennes. Royal Air Maroc et Air Arabia Maroc relient la plupart
          des grandes villes marocaines et proposent des correspondances vers l'Afrique et l'Amérique du
          Nord. Pour la comparaison des prix et des horaires, utilisez la recherche de notre page
          <a href={L('/vols-marrakech/')}>vols pour Marrakech</a>.
        </p>

        <h2>Ce qu'il faut retenir avant de réserver</h2>
        <ul>
          <li><strong>Les vols directs existent depuis la plupart des grandes villes européennes</strong> : évitez les correspondances sauf si aucun direct n'existe.</li>
          <li><strong>Le passeport est obligatoire</strong> pour les ressortissants français : la carte d'identité ne suffit pas. Voyez les <a href={L('/formalites-entree-maroc/')}>formalités d'entrée</a>.</li>
          <li><strong>Depuis la France</strong>, une dizaine de villes sont reliées : détail sur <a href={L('/vols-marrakech-depuis-france/')}>vols de France vers Marrakech</a>.</li>
          <li><strong>Pour payer moins</strong>, la saison et le bagage comptent plus que la compagnie : voyez <a href={L('/vols-marrakech/pas-chers/')}>vols pas chers</a>.</li>
        </ul>
      </div>

      <div class="links-grid">
        <a href={L('/guide-aeroport-marrakech/arrivees/')} class="link-card">
          <h3>Arrivées</h3>
          <p>Vols en temps réel et parcours d'arrivée</p>
        </a>
        <a href={L('/guide-aeroport-marrakech/departs/')} class="link-card">
          <h3>Départs</h3>
          <p>Horaires et rétroplanning du retour</p>
        </a>
        <a href={L('/transfert-aeroport-marrakech/')} class="link-card">
          <h3>Transferts et taxis</h3>
          <p>Rejoindre la médina depuis le terminal</p>
        </a>
        <a href={L('/location-voiture-aeroport-marrakech/')} class="link-card">
          <h3>Location de voiture</h3>
          <p>Comparer les agences du hall des arrivées</p>
        </a>
      </div>
    </div>
  </section>
</DestinationsLayout>
