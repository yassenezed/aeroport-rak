---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Chameau, quad et buggy", href: L("/balade-chameau-quad-marrakech/") },
];

const toc = [
  { label: "La Palmeraie : dromadaire", id: "palmeraie" },
  { label: "Agafay : quad et buggy", id: "agafay" },
  { label: "Combien ça coûte", id: "prix" },
  { label: "Choisir un opérateur", id: "operateur" },
  { label: "Sécurité", id: "securite" },
  { label: "Bien s'équiper", id: "equipement" },
];

const faqs = [
  { q: "Combien de temps dure une balade en dromadaire à Marrakech ?", a: "Entre 30 minutes et 1 h 30 dans la Palmeraie, en général suivie d'un thé à la menthe. Les formules de coucher de soleil sont les plus prisées et se réservent à l'avance en haute saison." },
  { q: "Quelle différence entre quad et buggy ?", a: "Le quad se conduit debout sur un véhicule à guidon, avec une prise en main sportive ; le buggy est une petite voiture à arceaux, à deux ou quatre places, plus stable et souvent préféré par les couples ou les familles. Les deux se font sur les pistes du désert d'Agafay, encadrés par un guide." },
  { q: "Quel est l'âge minimum pour conduire un quad ?", a: "Cela varie selon l'opérateur, généralement autour de 16 ans pour conduire seul, parfois moins pour les modèles enfants ou en passager. Les mineurs doivent être accompagnés. Vérifiez les conditions à la réservation et fuyez ceux qui n'en posent aucune." },
  { q: "Faut-il un permis pour le quad ou le buggy ?", a: "Un permis de conduire est demandé pour le buggy chez la plupart des opérateurs, et souvent pour le quad. Emportez-le. Certains opérateurs acceptent le quad sans permis avec une prise en main, ce qui doit vous alerter si aucune consigne de sécurité n'est donnée." },
  { q: "Ces activités sont-elles dangereuses ?", a: "Pas si l'équipement est en bon état, si le guide est sérieux et si vous respectez les consignes. Le risque vient des opérateurs qui font l'économie de casques, d'assurance ou de briefing. Choisissez sur les avis récents, et exigez casque, foulard et briefing avant de partir." },
  { q: "Quelle est la meilleure heure pour ces sorties ?", a: "En fin d'après-midi, pour la lumière et la chaleur moins forte, avec coucher de soleil sur les pistes. En été, évitez le milieu de la journée : 40 °C et poussière sur un quad, c'est éprouvant." },
];
---
<GuideLayout
  keywords="chameau Marrakech, quad Agafay, buggy Marrakech, balade Palmeraie, activités désert"
  title={"Quad, buggy et chameau à Marrakech : prix, sécurité"}
  description={"Dromadaire dans la Palmeraie, quad et buggy à Agafay : durées, prix indicatifs, sécurité, âge minimum et comment choisir un opérateur fiable."}
  eyebrow={"Marrakech · Activités"}
  h1={"Chameau, quad et buggy à Marrakech"}
  lede={"La Palmeraie pour la balade tranquille, Agafay pour la poussière et l'adrénaline. Voici ce que recouvrent ces sorties, ce qu'elles coûtent, et comment choisir un opérateur qui prend la sécurité au sérieux."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["camel-quad-marrakech"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Réservez une sortie avec un opérateur fiable", text: "Comparez les formules avec pick-up depuis votre hôtel, casque, assurance et prix affichés d'avance.", provider: "guide", label: "Voir les activités" }}
>
<h2 id="palmeraie">La Palmeraie : le dromadaire, tranquille</h2>
<p>
  Au nord-est de la ville, la Palmeraie aligne des centaines de milliers de palmiers, des resorts et des
  villas. Les balades en dromadaire y durent de 30 minutes à une heure et demie, à une allure lente, sur
  des sentiers entre les palmiers. C'est une activité facile, sans âge minimal exigeant, particulièrement
  adaptée aux familles. La formule du coucher de soleil, avec un thé à la menthe au retour, est la plus
  prisée.
</p>

<h2 id="agafay">Agafay : quad et buggy dans le désert</h2>
<p>
  À une quarantaine de kilomètres au sud-ouest, le plateau d'Agafay est un désert de cailloux et de
  collines douces, sans dunes, mais aux couleurs superbes au crépuscule, avec l'Atlas en toile de fond.
  C'est le terrain de jeu des quads et des buggys. Une sortie comprend généralement le transfert depuis
  l'hôtel, un briefing, deux ou trois heures de piste, et un thé sous une tente. Voyez
  <a href={L('/excursion-desert-agafay/')}>désert d'Agafay</a> pour combiner avec un dîner ou une nuit en
  camp.
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Activité</th><th>Lieu</th><th>Durée</th><th>Effort</th></tr></thead>
    <tbody>
      <tr><td><strong>Dromadaire</strong></td><td>Palmeraie</td><td>30 min – 1 h 30</td><td>Aucun</td></tr>
      <tr><td><strong>Buggy</strong></td><td>Agafay</td><td>2 – 3 h</td><td>Modéré, voiture stable</td></tr>
      <tr><td><strong>Quad</strong></td><td>Agafay ou Palmeraie</td><td>1 h – 3 h</td><td>Physique, poussière</td></tr>
      <tr><td><strong>Dromadaire au coucher du soleil</strong></td><td>Agafay</td><td>1 h + dîner</td><td>Aucun</td></tr>
    </tbody>
  </table>
</div>

<h2 id="prix">Combien ça coûte</h2>
<p>
  Les prix varient beaucoup selon la formule, la durée, le nombre de personnes et l'inclusion du
  transfert. À titre indicatif : une balade en dromadaire se situe en général entre 150 et 400 MAD par
  personne, une sortie de quad ou de buggy de deux à trois heures entre 400 et 900 MAD selon le véhicule
  et le nombre de passagers. Les formules avec dîner en désert ajoutent quelques centaines de dirhams.
  Demandez toujours ce qui est inclus : transfert, casque, assurance, boissons.
</p>

<h2 id="operateur">Choisir un opérateur</h2>
<div class="callout">
  <span class="callout-label">Les trois questions à poser</span>
  <p>
    Quel équipement est fourni, avec quelle assurance ? Combien de participants par guide ? Le prix
    comprend-il le transfert ? Un opérateur sérieux répond sans hésiter, propose un briefing et affiche
    des avis récents.
  </p>
</div>
<ul>
  <li><strong>Évitez</strong> les rabatteurs de rue et de médina, qui prennent une commission et vous emmènent chez le moins regardant.</li>
  <li><strong>Préférez</strong> une réservation en amont, par un hébergement ou une plateforme avec avis.</li>
  <li><strong>Vérifiez</strong> l'état des véhicules avant de monter : freins, pneus, casques propres.</li>
</ul>

<h2 id="securite">Sécurité</h2>
<p>
  Le casque est obligatoire, et non négociable. Portez des vêtements longs, des chaussures fermées et un
  foulard ou un masque contre la poussière. Respectez le rythme du guide et ne quittez pas le groupe.
  Vérifiez que votre assurance voyage couvre ces activités : beaucoup de contrats les excluent ou exigent
  une option sport. Pour l'ensemble des précautions en ville, voyez
  <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>.
</p>

<h2 id="equipement">Bien s'équiper</h2>
<ul>
  <li>Pantalon léger, manches longues, chaussures fermées.</li>
  <li>Lunettes de soleil ou de protection, chapeau ou casquette pour la balade à dos de dromadaire.</li>
  <li>Foulard ou cheich contre la poussière, surtout à quad.</li>
  <li>Crème solaire, eau, permis de conduire, une pièce d'identité.</li>
</ul>
<p>
  Pour construire une journée complète, voyez
  <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>.
</p>
</GuideLayout>
