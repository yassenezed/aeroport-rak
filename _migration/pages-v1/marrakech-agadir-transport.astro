---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';
import TransferWidget from '../components/affiliate/TransferWidget.astro';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Marrakech → Agadir", href: L("/marrakech-agadir-transport/") },
];

const toc = [
  { label: "Les quatre options", id: "options" },
  { label: "L'autocar", id: "autocar" },
  { label: "La voiture et l'autoroute", id: "voiture" },
  { label: "Le transfert privé", id: "transfert" },
  { label: "Le grand taxi", id: "taxi" },
  { label: "Quel choix", id: "choix" },
];

const faqs = [
  { q: "Combien de temps dure le trajet Marrakech - Agadir ?", a: "Environ trois heures en voiture par l'autoroute A7, hors pauses. En autocar CTM ou Supratours, comptez plutôt quatre à quatre heures et demie avec les arrêts. Ajoutez le temps pour rejoindre la gare routière ou le point de prise en charge." },
  { q: "Combien coûte le bus Marrakech - Agadir ?", a: "Entre 130 et 150 MAD par personne environ en autocar CTM ou Supratours, avec plusieurs départs par jour. Les tarifs varient légèrement selon l'horaire et la classe. Réservez sur les sites des compagnies ou en gare." },
  { q: "Quel est le péage entre Marrakech et Agadir ?", a: "L'autoroute A7 est à péage : comptez environ 100 MAD dans un sens pour une voiture particulière, à régler en espèces ou par carte selon la barrière. Prévoyez de la monnaie." },
  { q: "Peut-on faire ce trajet en une journée depuis Marrakech ?", a: "Oui, mais c'est un aller-retour de six à sept heures de route : à réserver à celles et ceux qui souhaitent absolument y aller. Mieux vaut dormir à Agadir ou à Taghazout et rentrer le lendemain." },
  { q: "Quelle est la meilleure option avec de gros bagages ?", a: "Un transfert privé, qui vous prend à votre hébergement et vous dépose à Agadir sans changement. L'autocar est possible avec des bagages en soute, mais les gares routières imposent de la marche et de l'attente." },
  { q: "Y a-t-il des vols entre Marrakech et Agadir ?", a: "Des liaisons intérieures existent selon les saisons, mais le temps de vol s'ajoute à l'enregistrement et au transfert à chaque extrémité. Pour 250 km sur une autoroute, la route reste plus simple." },
];
---
<GuideLayout
  keywords="Marrakech Agadir bus, transfert Marrakech Agadir, autoroute A7, CTM Supratours"
  title={"Marrakech - Agadir : bus, voiture et transfert"}
  description={"Marrakech - Agadir (250 km) : autocar CTM ou Supratours, voiture par l'A7, transfert privé, grand taxi. Durées, prix en dirhams et conseils."}
  eyebrow={"Interville · Marrakech → Agadir"}
  h1={"Marrakech - Agadir : comment y aller"}
  lede={"Deux cent cinquante kilomètres, trois à quatre heures de route et quatre façons de faire le trajet. Le bon choix dépend de votre budget, de vos bagages et de l'heure de votre vol."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["agadir"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Réservez votre transfert vers Agadir", text: "Indiquez Agadir comme destination : prix affiché avant de payer, chauffeur nommé et véhicule adapté à votre groupe.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="options">Les quatre options</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Option</th><th>Durée</th><th>Prix indicatif</th><th>Pour qui</th></tr></thead>
    <tbody>
      <tr><td><strong>Autocar CTM / Supratours</strong></td><td>4 – 4 h 30</td><td class="num">130–150 MAD / pers.</td><td>Petit budget, bagage léger</td></tr>
      <tr class="row-highlight"><td><strong>Transfert privé</strong></td><td>≈ 3 h</td><td class="num">Prix fixe affiché</td><td>Familles, bagages, confort</td></tr>
      <tr><td><strong>Voiture de location</strong></td><td>≈ 3 h</td><td class="num">Location + péage ≈ 100 MAD</td><td>Road-trip, liberté d'horaires</td></tr>
      <tr><td><strong>Grand taxi</strong></td><td>≈ 3 h</td><td class="num">1 800–2 500 MAD (privé)</td><td>Groupe, négociation à l'aise</td></tr>
    </tbody>
  </table>
</div>

<h2 id="autocar">L'autocar</h2>
<p>
  CTM et Supratours assurent plusieurs départs par jour. À Marrakech, l'autocar CTM part de la gare
  routière, du côté de Bab Doukkala, et Supratours au départ de la gare ferroviaire de Guéliz. Comptez 130 à
  150 MAD par personne, quatre heures à quatre heures et demie avec les arrêts. Les autocars sont
  climatisés, avec de la place pour les bagages en soute — un petit pourboire au porteur est d'usage. C'est
  la solution la plus économique, mais elle suppose de rejoindre la gare, ce qui, depuis un riad, demande
  encore un taxi.
</p>

<h2 id="voiture">La voiture et l'autoroute</h2>
<p>
  L'autoroute A7 relie Marrakech à Agadir en trois heures environ, sur une route à deux fois deux voies.
  Le péage coûte environ 100 MAD par sens. Pour les conseils de conduite, la vitesse et les contrôles, voyez
  <a href={L('/route-marrakech-agadir-en-voiture/')}>Marrakech → Agadir en voiture</a> et
  <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>. Pour la location,
  <a href={L('/location-voiture-aeroport-marrakech/')}>comparez les agences du RAK</a> : certains loueurs
  proposent une restitution à Agadir, avec supplément.
</p>

<h2 id="transfert">Le transfert privé</h2>
<p>
  Un véhicule et un chauffeur vous prennent à votre hébergement ou à l'aéroport et vous déposent à Agadir
  sans changement. C'est le plus confortable, surtout à plusieurs ou avec des bagages, et le prix se
  répartit entre les passagers. Estimez votre trajet ci-dessous.
</p>
<TransferWidget to="Agadir" title="Transfert Marrakech vers Agadir" />

<h2 id="taxi">Le grand taxi</h2>
<p>
  On peut louer un grand taxi pour la course entière, à un prix qui se négocie et dépend de la saison et de
  l'heure. Attendez-vous à 1 800 à 2 500 MAD environ. Les grands taxis « collectifs » qui partent quand ils
  sont pleins concernent plutôt les habitants et les liaisons régionales : peu pratiques pour un visiteur.
  Voyez notre <a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix</a> pour les ordres de grandeur.
</p>

<h2 id="choix">Quel choix</h2>
<ul>
  <li><strong>Seul, petit budget, temps libre :</strong> l'autocar.</li>
  <li><strong>Famille ou groupe, avec bagages :</strong> le transfert privé.</li>
  <li><strong>Plusieurs jours de route, envie d'explorer :</strong> la voiture, avec l'escale possible à Essaouira ou dans le pays de l'arganier.</li>
  <li><strong>Vol à prendre à Agadir :</strong> le transfert, avec de la marge.</li>
</ul>
<p>
  Si vous hésitez entre les deux villes pour un séjour, lisez
  <a href={L('/marrakech-ou-agadir/')}>Marrakech ou Agadir</a>.
</p>
</GuideLayout>
