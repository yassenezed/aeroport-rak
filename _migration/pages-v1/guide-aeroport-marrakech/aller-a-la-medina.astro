---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import { airport, PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Guide de l'aéroport", href: L('/guide-aeroport-marrakech/') },
  { name: 'Aller à la médina', href: L('/guide-aeroport-marrakech/aller-a-la-medina/') },
];

const toc = [
  { label: 'Pourquoi la médina est un cas à part', id: 'cas-a-part' },
  { label: 'Connaître sa porte', id: 'portes' },
  { label: 'Le porteur et sa charrette', id: 'porteur' },
  { label: 'Transfert, taxi ou bus', id: 'options' },
  { label: 'Arriver de nuit', id: 'nuit' },
  { label: 'La checklist avant le départ', id: 'checklist' },
];

// Les grandes portes utilisées comme points de dépose, avec les quartiers qu'elles desservent.
const portes = [
  { nom: 'Bab Doukkala', secteur: 'Nord-ouest : Dar el Bacha, Mouassine, quartier des riads', note: 'La porte la plus utilisée pour les riads du nord' },
  { nom: 'Bab Laksour', secteur: 'Ouest : Ksour, Riad Zitoun, abords de Jemaa el-Fna', note: 'La plus proche de la place, très pratique' },
  { nom: 'Bab Agnaou', secteur: 'Sud : Kasbah, tombeaux saadiens, palais El Badi', note: 'Pour les riads de la Kasbah' },
  { nom: 'Bab el Khemis', secteur: 'Nord-est : Bab Taghzout, souk du jeudi', note: 'Secteur plus résidentiel, moins touristique' },
  { nom: 'Bab Aylen / Bab Ghmat', secteur: 'Est : Mellah, Riad Zitoun el Jdid', note: 'Accès est de la médina' },
];

const faqs = [
  {
    q: "Comment aller de l'aéroport de Marrakech à la médina ?",
    a: `Quatre moyens : un transfert réservé (dès 27 € par véhicule), un taxi pris au rang officiel (${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]} MAD en journée), le bus ${airport.bus.line} jusqu'à Jemaa el-Fna (${airport.bus.oneWayMad} MAD) ou une voiture de location. Le trajet fait ${airport.distanceToCityKm} km et prend ${airport.driveToCityMin.min} à ${airport.driveToCityMin.max} minutes. Dans tous les cas, vous serez déposé à une porte de la médina, jamais devant votre riad.`
  },
  {
    q: "Pourquoi les voitures n'entrent-elles pas dans la médina ?",
    a: "Parce que les derbs — les ruelles de la médina — font par endroits un mètre cinquante de large, et que plusieurs accès sont fermés à la circulation. Seuls les deux-roues et les charrettes y circulent. C'est valable pour tout le monde : taxi, transfert privé, voiture personnelle. La dépose se fait à la porte la plus proche."
  },
  {
    q: "Quelle porte de la médina dois-je indiquer à mon chauffeur ?",
    a: "Demandez-la directement à votre riad au moment de la réservation : c'est l'information la plus utile de tout votre voyage. Les principales sont Bab Doukkala pour le nord-ouest, Bab Laksour pour les abords de Jemaa el-Fna, Bab Agnaou pour la Kasbah et Bab el Khemis pour le nord-est. Donner le nom de la porte évite d'être déposé du mauvais côté et de traverser la médina à pied avec vos valises."
  },
  {
    q: "Comment transporter ses valises jusqu'au riad ?",
    a: "Demandez un porteur avec charrette. La quasi-totalité des riads le proposent si vous annoncez votre heure d'arrivée : quelqu'un vous attend à la porte, charge les bagages et vous guide. C'est gratuit ou coûte un pourboire de 20 à 30 MAD, et cela vous évite de tirer une valise à roulettes sur des pavés irréguliers en cherchant votre chemin."
  },
  {
    q: "Le bus 19 dessert-il la médina ?",
    a: `Il dépose à Jemaa el-Fna, c'est-à-dire au cœur de la médina, ce qui est parfait si votre riad est proche de la place. En revanche, depuis la place, vous devrez rejoindre votre adresse à pied, sans porteur et sans quelqu'un qui vous guide. Le bus circule de ${airport.bus.firstDeparture} à ${airport.bus.lastDeparture} environ, toutes les ${airport.bus.frequencyMin} minutes.`
  },
  {
    q: "Est-il risqué d'arriver de nuit dans la médina ?",
    a: "Non, Marrakech est une ville sûre et la médina reste vivante tard en soirée, surtout autour de Jemaa el-Fna. La difficulté est pratique plutôt que sécuritaire : les ruelles sont mal éclairées, les repères visuels disparaissent et une adresse se trouve beaucoup moins facilement qu'en plein jour. D'où l'intérêt d'un transfert avec porteur annoncé."
  },
];
---
<GuideLayout
  keywords="aéroport Marrakech médina, aller à la médina depuis l'aéroport, portes médina Marrakech, bab Doukkala"
  title={"De l'aéroport de Marrakech à la médina : le guide"}
  description={"Rejoindre la médina depuis le RAK : pourquoi aucune voiture n'entre, quelle porte indiquer au chauffeur, porteur avec charrette, taxi, transfert et bus 19."}
  eyebrow="Guide de l'aéroport · Aller à la médina"
  h1="De l'aéroport de Marrakech à la médina"
  lede="Six kilomètres de route, puis quelques centaines de mètres qui font toute la différence. La médina ne se laisse pas approcher en voiture : voici comment organiser cette dernière étape pour qu'elle devienne un détail et non un mauvais souvenir."
  breadcrumbs={breadcrumbs}
  heroImage={photos['marrakech-medina']}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: 'Un chauffeur qui connaît votre porte', text: "Indiquez le nom de votre riad et sa porte au moment de la réservation : le chauffeur s'arrête au bon endroit, à prix fixe, même à minuit.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <h2 id="cas-a-part">Pourquoi la médina est un cas à part</h2>
  <p>
    Sur le papier, rien de plus simple : {airport.distanceToCityKm} kilomètres,
    {' '}{airport.driveToCityMin.min} à {airport.driveToCityMin.max} minutes, une avenue large et
    rectiligne. Puis la voiture s'arrête devant un rempart de terre ocre, et le voyage continue à pied.
    La médina de Marrakech est un tissu de derbs dont certains font à peine la largeur d'une charrette,
    et plusieurs accès sont fermés à la circulation automobile. Aucun véhicule n'y entre : ni votre
    taxi, ni votre transfert privé, ni une voiture de location.
  </p>
  <p>
    Ce n'est un problème que si vous le découvrez sur place, à 23 h, avec deux valises et un plan
    approximatif. Préparé, c'est un non-événement : trois à dix minutes de marche, souvent accompagné.
  </p>

  <h2 id="portes">Connaître sa porte : l'information la plus utile de votre voyage</h2>
  <p>
    Les remparts sont percés de portes — les <em>babs</em> — et chacune dessert un secteur. Demandez à
    votre riad laquelle est la plus proche, et transmettez ce nom à votre chauffeur plutôt que l'adresse
    seule. Un chauffeur qui ne sait pas où vous allez choisira la porte qui l'arrange, et vous
    traverserez une partie de la médina à pied pour rien.
  </p>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Porte</th><th>Secteur desservi</th><th>Bon à savoir</th></tr>
      </thead>
      <tbody>
        {portes.map((p) => (
          <tr>
            <td><strong>{p.nom}</strong></td>
            <td>{p.secteur}</td>
            <td>{p.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2 id="porteur">Le porteur et sa charrette</h2>
  <p>
    C'est l'astuce locale que personne ne pense à demander, et pourtant tous les riads la proposent.
    Annoncez votre heure d'arrivée et votre numéro de vol la veille : un employé vous attendra à la
    porte avec une charrette, chargera vos bagages et vous conduira jusqu'à la porte du riad. Le service
    est généralement gratuit ou se conclut par un pourboire de 20 à 30 MAD.
  </p>
  <div class="callout">
    <span class="callout-label">Le message à envoyer à votre riad</span>
    <p>
      « Bonjour, nous arrivons le [date] par le vol [numéro], atterrissage prévu à [heure]. Pouvez-vous
      nous indiquer la porte la plus proche du riad et prévoir quelqu'un pour nous accueillir avec une
      charrette ? » Trois lignes qui règlent l'essentiel.
    </p>
  </div>

  <h2 id="options">Transfert, taxi ou bus : lequel pour la médina</h2>
  <p>
    <strong>Le transfert réservé</strong> reste le plus confortable pour cette destination précise :
    à partir de 27 € par véhicule, le chauffeur suit votre vol, connaît les portes et vous dépose au
    plus près. C'est le seul moyen où l'information « Bab Laksour, riad X » est prise en compte dès la
    réservation. Voir <a href={L('/reserver-transfert/')}>réserver un transfert</a>.
  </p>
  <p>
    <strong>Le taxi</strong> fonctionne très bien de jour, entre {airport.taxiFare.dayMad[0]} et
    {' '}{airport.taxiFare.dayMad[1]} MAD pour la voiture. Annoncez la porte, pas le nom du riad, et
    fixez le prix avant de charger — tout est détaillé sur
    {' '}<a href={L('/taxi-aeroport-marrakech/')}>taxi à l'aéroport</a>.
  </p>
  <p>
    <strong>Le bus {airport.bus.line}</strong> vous dépose à Jemaa el-Fna pour
    {' '}{airport.bus.oneWayMad} MAD. Excellent si votre riad est à cinq minutes de la place et que vous
    voyagez léger ; nettement moins si vous devez ensuite traverser la médina avec des valises, sans
    guide ni charrette.
  </p>

  <h2 id="nuit">Arriver de nuit</h2>
  <p>
    Beaucoup de vols européens se posent après 21 h. La médina ne devient pas dangereuse pour autant —
    Marrakech est une ville sûre, et les abords de Jemaa el-Fna restent animés tard — mais elle devient
    <em>illisible</em> : peu d'éclairage, commerces fermés, repères visuels différents. À cette heure,
    le porteur annoncé à l'avance vaut son pesant d'or, et le bus ne circule plus. Nos conseils de
    sécurité et de bon sens sont regroupés dans
    {' '}<a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>.
  </p>

  <h2 id="checklist">La checklist avant le départ</h2>
  <ul>
    <li>Le <strong>nom de la porte</strong> la plus proche de votre riad, obtenu auprès du riad.</li>
    <li>Un <strong>porteur réservé</strong> pour votre heure d'arrivée.</li>
    <li>Des <strong>dirhams en petites coupures</strong> pour le taxi et le pourboire du porteur.</li>
    <li>Le <strong>numéro WhatsApp du riad</strong> enregistré, et une eSIM ou une SIM locale pour l'appeler.</li>
    <li>L'adresse écrite <strong>en arabe</strong> si le riad peut vous la fournir : redoutablement efficace.</li>
  </ul>
  <p>
    Pour choisir entre un riad en médina et un hôtel de Guéliz — deux expériences très différentes, y
    compris sur ce point logistique — voyez
    {' '}<a href={L('/ou-dormir-marrakech/')}>quel quartier pour dormir</a> et
    {' '}<a href={L('/riads-medina-marrakech/')}>les riads de la médina</a>.
  </p>
</GuideLayout>
