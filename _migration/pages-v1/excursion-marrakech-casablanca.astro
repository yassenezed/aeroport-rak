---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Excursions", href: L("/que-faire-marrakech/") },
  { name: "Casablanca", href: L("/excursion-marrakech-casablanca/") },
];

const toc = [
  { label: "Train, voiture ou bus", id: "moyens" },
  { label: "Une journée à Casablanca", id: "journee" },
  { label: "La mosquée Hassan II", id: "hassan-ii" },
  { label: "Prendre un vol à Casablanca", id: "aeroport" },
  { label: "Notre avis", id: "avis" },
];

const faqs = [
  { q: "Combien de temps dure le train Marrakech - Casablanca ?", a: "Entre 2 h 40 et 3 h 20 selon le train, avec un départ environ toutes les une à deux heures de la gare de Marrakech, à Guéliz. Un billet en 2ᵉ classe coûte en général autour de 100 MAD, davantage en 1ʳᵉ classe. Réservez sur le site ou l'application de l'ONCF." },
  { q: "Existe-t-il une ligne à grande vitesse vers Marrakech ?", a: "Le TGV Al Boraq relie Tanger à Casablanca, mais il ne va pas encore jusqu'à Marrakech : une extension jusqu'à Marrakech est en cours de construction, avec une mise en service annoncée pour la fin de la décennie. Les trains actuels sont des lignes classiques." },
  { q: "Peut-on visiter Casablanca en une journée depuis Marrakech ?", a: "Techniquement oui, mais c'est une journée de transport : cinq à six heures de route ou de train pour trois ou quatre heures sur place. La visite guidée de la mosquée Hassan II et un déjeuner sur la Corniche occupent la journée." },
  { q: "Peut-on visiter la mosquée Hassan II sans être musulman ?", a: "Oui, c'est l'un des rares grands édifices religieux ouverts aux non-musulmans, uniquement en visite guidée payante, à des horaires précis. Habillez-vous de façon couvrante et prévoyez de quitter vos chaussures. Vérifiez les horaires avant de venir, car ils changent en période de prière." },
  { q: "Comment aller de Marrakech à l'aéroport de Casablanca ?", a: "En train jusqu'à Casa-Voyageurs, puis en train jusqu'à l'aéroport Mohammed V, à une trentaine de kilomètres du centre. Le trajet complet dépasse quatre heures : prévoyez une marge très large avant votre vol, et vérifiez les correspondances sur oncf-voyages.ma." },
  { q: "Vaut-il mieux passer par Casablanca ou voler directement depuis Marrakech ?", a: "Pour un voyageur français, le vol direct depuis Marrakech est presque toujours plus simple : pas de correspondance, pas de transfert de quatre heures. Casablanca ne s'impose que si aucune ligne directe n'existe pour votre destination." },
];
---
<GuideLayout
  keywords="Marrakech Casablanca train, mosquée Hassan II, aéroport Casablanca Mohammed V, excursion Casablanca"
  title={"Marrakech - Casablanca : train, route et visite"}
  description={"De Marrakech à Casablanca : train ONCF en 2 h 40 à 3 h 20, autoroute, mosquée Hassan II, et comment rejoindre l'aéroport Mohammed V."}
  eyebrow={"Excursions · Casablanca"}
  h1={"Marrakech - Casablanca"}
  lede={"Casablanca est la capitale économique du Maroc, pas sa capitale touristique. On y va pour la mosquée Hassan II, une ville différente de Marrakech, ou pour un vol — et alors la question de la correspondance devient centrale."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["casablanca"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un vol direct depuis Marrakech", text: "Comparez les vols directs avant de vous engager dans un trajet de quatre heures jusqu'à Casablanca.", provider: "flight", label: "Rechercher un vol" }}
>
<h2 id="moyens">Train, voiture ou bus</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Moyen</th><th>Durée</th><th>Prix indicatif</th><th>À savoir</th></tr></thead>
    <tbody>
      <tr class="row-highlight"><td><strong>Train ONCF</strong></td><td>2 h 40 – 3 h 20</td><td class="num">≈ 100 MAD (2ᵉ cl.)</td><td>Départs fréquents, gare de Guéliz</td></tr>
      <tr><td><strong>Autocar</strong></td><td>3 h – 3 h 30</td><td class="num">Économique</td><td>Plus lent, moins lisible</td></tr>
      <tr><td><strong>Voiture (autoroute A7)</strong></td><td>2 h 30 – 3 h</td><td class="num">Location + péage</td><td>Route excellente, stationnement en ville difficile</td></tr>
      <tr><td><strong>Transfert privé</strong></td><td>2 h 30 – 3 h</td><td class="num">Sur devis</td><td>Le plus simple avec des bagages</td></tr>
    </tbody>
  </table>
</div>
<p>
  Le train est la solution la plus pratique : rapide, ponctuel en général et peu cher. La gare de
  Marrakech se trouve à Guéliz, à quelques kilomètres de l'aéroport : voyez
  <a href={L('/guide-aeroport-marrakech/aller-a-gueliz/')}>aller à Guéliz</a>. Vérifiez les horaires
  avant de partir, car l'ONCF adapte son plan de transport pendant les travaux de la future ligne à grande
  vitesse.
</p>

<h2 id="journee">Une journée à Casablanca</h2>
<p>
  Casablanca est une métropole de plusieurs millions d'habitants, moderne et étendue, plus proche d'une
  grande ville européenne que d'une carte postale. Les points d'intérêt se concentrent en quelques
  endroits : le quartier art déco du centre-ville, la mosquée Hassan II, la Corniche d'Aïn Diab au bord
  de l'océan et le quartier des Habous, à l'architecture néo-mauresque.
</p>
<div class="callout">
  <span class="callout-label">Notre avis honnête</span>
  <p>
    Casablanca ne mérite pas une journée entière depuis Marrakech sauf si vous avez déjà vu l'essentiel
    de Marrakech, et vous voulez un contraste. Pour un séjour de moins d'une semaine, mieux vaut
    <a href={L('/excursion-marrakech-essaouira/')}>Essaouira</a> ou l'
    <a href={L('/excursion-vallee-ourika/')}>Ourika</a>.
  </p>
</div>

<h2 id="hassan-ii">La mosquée Hassan II</h2>
<p>
  C'est la raison principale de venir. Achevée en 1993, sur l'océan, elle possède l'un des plus hauts
  minarets du monde, plus de 200 mètres, et une salle de prière pouvant accueillir plusieurs milliers de
  fidèles, avec un toit ouvrant. Les non-musulmans peuvent la visiter, en visite guidée payante et à des
  horaires précis. Vérifiez les horaires du jour avant de vous déplacer, et habillez-vous de façon
  couvrante.
</p>

<h2 id="aeroport">Prendre un vol à Casablanca</h2>
<p>
  C'est le cas de figure où l'on se retrouve à rejoindre Casablanca : un vol qui part de Mohammed V
  (CMN), l'aéroport le plus important du pays. L'aéroport se situe à une trentaine de kilomètres du
  centre-ville, relié par un train navette qui rejoint la gare Casa-Voyageurs en trente à quarante
  minutes.
</p>
<ol>
  <li>Train Marrakech → Casa-Voyageurs : environ trois heures.</li>
  <li>Correspondance vers l'aéroport : environ trente-cinq minutes de trajet.</li>
  <li>Marge avant le vol : deux heures et demie à trois heures, comme pour tout vol international.</li>
</ol>
<p>
  Soit un minimum de six heures et demie entre votre départ de Marrakech et le décollage. C'est pourquoi
  le vol direct depuis Marrakech est, la plupart du temps, la meilleure option : voyez
  <a href={L('/vols-marrakech/')}>vols pour Marrakech</a>.
</p>

<h2 id="avis">Notre avis</h2>
<p>
  Casablanca est un excellent complément à un séjour long, une escale utile ou une ville à découvrir pour
  son architecture. Ce n'est pas une excursion à la journée depuis Marrakech. Si vous cherchez une
  évasion, choisissez plutôt la montagne ou l'océan.
</p>
</GuideLayout>
