---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Marrakech ou Agadir", href: L("/marrakech-ou-agadir/") },
];

const toc = [
  { label: "En un coup d'œil", id: "tableau" },
  { label: "Le caractère de chaque ville", id: "caractere" },
  { label: "Le climat", id: "climat" },
  { label: "Le budget", id: "budget" },
  { label: "Avec des enfants", id: "enfants" },
  { label: "Faire les deux", id: "deux" },
];

const faqs = [
  { q: "Marrakech ou Agadir pour une première fois au Maroc ?", a: "Marrakech, si vous voulez découvrir le pays : médina, souks, cuisine, architecture. Agadir, si vous voulez avant tout du soleil, de la plage et de la détente dans un cadre moderne. Beaucoup de voyageurs commencent par Marrakech, plus dépaysante." },
  { q: "Où fait-il le plus chaud en été ?", a: "À Marrakech, où les maximales dépassent régulièrement 38 °C en juillet et août. Agadir, sur l'Atlantique, reste nettement plus fraîche, autour de 27 à 30 °C, grâce à la brise océane." },
  { q: "Quelle ville est la moins chère ?", a: "Le coût de la vie est comparable. L'écart se joue sur l'hébergement et les activités : Marrakech propose un choix immense à tous les prix, Agadir des hôtels de plage en formule tout compris. Les vols vers Marrakech sont en général plus concurrentiels et donc plus abordables." },
  { q: "Quelle ville pour des enfants ?", a: "Agadir est plus simple : plage, bains, hôtels-clubs, rues larges. Marrakech est un voyage plus riche mais plus exigeant, avec la chaleur, la foule et la médina. Voyez notre page Marrakech en famille pour adapter le rythme." },
  { q: "Peut-on visiter les deux en un séjour ?", a: "Oui, c'est même un excellent format : trois à quatre nuits à Marrakech puis trois à quatre à Agadir, reliées par trois heures de route. Voyez la page Marrakech - Agadir pour le trajet." },
  { q: "Quelle destination en hiver ?", a: "Les deux sont agréables : Marrakech est plus fraîche la nuit, avec des riads non chauffés ; Agadir reste douce, avec 20 °C environ en journée, et convient mieux à la baignade et aux séjours de plage." },
];
---
<GuideLayout
  keywords="Marrakech ou Agadir, comparatif Marrakech Agadir, où partir Maroc"
  title={"Marrakech ou Agadir : quelle destination choisir ?"}
  description={"Marrakech ou Agadir ? Médina et culture contre plage et surf : climat, budget, enfants, hiver, été. Notre comparatif et l'option des deux villes."}
  eyebrow={"Comparatif · Marrakech ou Agadir"}
  h1={"Marrakech ou Agadir ?"}
  lede={"Deux villes, deux voyages : la ville impériale, ses souks et son désert, ou une station balnéaire moderne au bord de l'Atlantique. Voici comment trancher selon ce que vous cherchez, et comment faire les deux."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-koutoubia"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Comparez les vols vers Marrakech", text: "Comparer les vols directs et choisir vos dates, avant de vous décider sur la ville.", provider: "flight", label: "Rechercher un vol" }}
>
<h2 id="tableau">En un coup d'œil</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th></th><th>Marrakech</th><th>Agadir</th></tr></thead>
    <tbody>
      <tr><td><strong>Le voyage</strong></td><td>Culture, médina, souks, gastronomie</td><td>Plage, soleil, détente, surf à proximité</td></tr>
      <tr><td><strong>L'ambiance</strong></td><td>Intense, dense, sollicitante</td><td>Calme, aérée, moderne</td></tr>
      <tr><td><strong>Été</strong></td><td>Très chaud, 38 °C et plus</td><td>Tempéré, 27–30 °C</td></tr>
      <tr><td><strong>Hiver</strong></td><td>Doux le jour, frais la nuit</td><td>Doux, 20 °C environ</td></tr>
      <tr><td><strong>Plage</strong></td><td>Aucune (Essaouira à 2 h 30)</td><td>Grande plage urbaine</td></tr>
      <tr><td><strong>Hébergement type</strong></td><td>Riads, hôtels, resorts</td><td>Hôtels de plage, tout compris</td></tr>
      <tr><td><strong>Durée idéale</strong></td><td>3 à 5 jours</td><td>4 à 7 jours</td></tr>
    </tbody>
  </table>
</div>

<h2 id="caractere">Le caractère de chaque ville</h2>
<p>
  <strong>Marrakech</strong> est une ville-spectacle. On y vient pour la médina classée à l'UNESCO, la place
  Jemaa el-Fna, la cuisine et l'artisanat, avec l'Atlas à portée de main. C'est une destination
  stimulante, parfois fatigante, qui se mérite : sollicitations, ruelles labyrinthiques, chaleur. Le
  détail est dans notre <a href={L('/guide-voyage-marrakech/')}>guide de voyage</a>.
</p>
<p>
  <strong>Agadir</strong> est une station balnéaire moderne, reconstruite après le séisme de 1960, avec une
  grande plage, une promenade, des hôtels de bord de mer et un climat tempéré presque toute l'année. C'est
  la destination du repos et du surf sur la côte voisine, moins dépaysante en ville, mais nettement plus
  facile. Ce qu'on ne trouve pas à Agadir : une médina historique.
</p>

<h2 id="climat">Le climat</h2>
<p>
  C'est le critère décisif en été : Marrakech dépasse régulièrement 38 °C en juillet et août, quand
  Agadir profite de la brise atlantique, autour de 27 à 30 °C. L'hiver, la situation s'inverse
  partiellement : Marrakech est fraîche la nuit et ses riads sont rarement chauffés, alors qu'Agadir reste
  douce et se prête aux baignades. Notre page
  <a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a> donne le détail mensuel.
</p>

<h2 id="budget">Le budget</h2>
<p>
  Le coût de la vie est proche. Ce qui change, c'est l'offre : Marrakech propose tout, du petit riad au
  palace, et des activités à tous les prix ; Agadir s'organise autour d'hôtels de plage, souvent en
  formule tout compris. Côté transport, les vols vers Marrakech sont souvent plus nombreux et
  moins chers : voyez <a href={L('/vols-marrakech/pas-chers/')}>vols pas chers</a>.
</p>

<h2 id="enfants">Avec des enfants</h2>
<p>
  Agadir est nettement plus simple : plage aménagée, hôtels avec clubs enfants, rues larges. Marrakech est
  un voyage plus riche mais plus exigeant, où le rythme doit s'adapter à la chaleur et à la foule.
  Les familles réussissent très bien Marrakech, à condition de choisir un hôtel avec piscine et de limiter
  les visites en pleine journée : voyez <a href={L('/marrakech-en-famille/')}>Marrakech en famille</a>.
</p>

<h2 id="deux">Faire les deux</h2>
<div class="callout">
  <span class="callout-label">Le format que nous recommandons</span>
  <p>
    Trois à quatre nuits à Marrakech, puis trois à quatre à Agadir ou à Essaouira, reliées par trois
    heures de route. Vous voyez la ville impériale et vous terminez les vacances au bord de l'océan, avec
    la médina derrière vous et le sable devant.
  </p>
</div>
<p>
  Le trajet est détaillé sur <a href={L('/marrakech-agadir-transport/')}>Marrakech - Agadir : bus, voiture et
  transfert</a>, et l'itinéraire en voiture sur
  <a href={L('/route-marrakech-agadir-en-voiture/')}>Marrakech → Agadir en voiture</a>. Si l'océan vous
  tente mais que vous voulez une ville plus petite, voyez
  <a href={L('/excursion-marrakech-essaouira/')}>Essaouira</a>.
</p>
</GuideLayout>
