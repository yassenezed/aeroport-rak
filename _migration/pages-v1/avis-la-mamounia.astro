---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
import { photos } from '../data/images';

const t = useTranslations('fr');
const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'La Mamounia', href: L('/avis-la-mamounia/') },
];
---
<HotelReviewLayout
  title={"La Mamounia Marrakech : avis et accès aéroport"}
  description={"La Mamounia : un siècle d'histoire, de vastes jardins aux portes de la médina, et un accès depuis l'aéroport de Marrakech en 20 minutes."}
  h1={`La Mamounia : notre avis et l'accès depuis l'aéroport`}
  subtitle={`Le grand hôtel historique de Marrakech, à cinq kilomètres du terminal`}
  breadcrumbs={breadcrumbs}
  brand={`La Mamounia`}
  rating={4.8}
  verdict={`L'adresse où l'hôtel est la destination : un siècle d'histoire, des jardins d'oliviers en pleine ville et la médina à pied. Accès routier direct depuis l'aéroport, sans la logistique d'un riad.`}
  priceAvg={`Très élevé, forte saisonnalité`}
  address={`Abords des remparts, près de Bab Jdid`}
  stars={`★★★★★`}
  ratingText={`Exceptionnel`}
  heroImage={photos['la-mamounia']}
  ctaLink={L('/ou-dormir-marrakech/')}
  ctaLabel={`Comparer les disponibilités`}
  faqs={[
    { q: "À quelle distance La Mamounia est-elle de l'aéroport de Marrakech ?", a: "Environ 5 km, soit 12 à 20 minutes de route selon la circulation. C'est l'un des grands hôtels les plus proches du terminal, et l'accès se fait entièrement en voiture : dépose devant l'entrée, sans marche avec les bagages." },
    { q: "La Mamounia est-elle dans la médina ou dans la ville nouvelle ?", a: "À la charnière des deux : l'hôtel borde les remparts, à quelques minutes à pied de la Koutoubia et de Jemaa el-Fna, tout en restant accessible en voiture. C'est ce double statut qui explique une bonne partie de son attrait." },
    { q: "Faut-il être client pour profiter des jardins ?", a: "Les jardins historiques, plantés d'oliviers, font partie de l'expérience hôtelière. Une consommation au bar ou un repas permet d'en profiter sans y séjourner, sous réserve de réservation et des règles de l'établissement au moment de votre visite." },
    { q: "Quel transfert prévoir depuis l'aéroport ?", a: "L'hôtel organise généralement les transferts sur demande. À défaut, un transfert privé réservé ou un taxi au tarif affiché suffisent : le trajet est court et la dépose se fait devant l'entrée." }
  ]}
>
  <div class="content-block">
    <h2>Ce que c'est</h2>
    <p>
      Ouverte en 1923 sur un terrain d'oliviers offert autrefois par un sultan à son fils, La Mamounia
      est le grand hôtel historique de Marrakech, celui dont le nom circule bien au-delà du Maroc.
      Churchill y a peint, et l'établissement a traversé un siècle de restaurations successives sans
      perdre ce qui fait sa singularité : un vaste jardin clos, à deux pas des remparts.
    </p>

    <h3>Pourquoi on le retient</h3>
    <ul class="pros-list">
      <li>Des jardins historiques qui font l'essentiel de l'expérience, rares en pleine ville.</li>
      <li>Une position charnière : la médina à pied, l'accès en voiture sans contrainte.</li>
      <li>Une offre de restauration étoffée, marocaine comme internationale.</li>
      <li>Un spa et des espaces de détente à l'échelle du domaine.</li>
      <li>Un service de niveau palace, avec la mémoire d'un siècle d'hôtellerie.</li>
    </ul>

    <h2>L'accès depuis l'aéroport</h2>
    <p>
      C'est l'un des rares établissements prestigieux de Marrakech où la question logistique ne se pose
      pas : cinq kilomètres, un quart d'heure, et une dépose devant l'entrée. Aucune porte de médina à
      négocier, aucun porteur à prévoir, aucune ruelle à remonter.
    </p>
    <ol class="steps-list">
      <li>Bagages récupérés dans le hall des arrivées du RAK.</li>
      <li>Transfert privé réservé, ou taxi au tarif affiché au rang.</li>
      <li>12 à 20 minutes de route jusqu'aux abords des remparts.</li>
      <li>Dépose devant l'hôtel, prise en charge des bagages à l'arrivée.</li>
    </ol>

    <h2>Pour qui</h2>
    <p>
      Pour un voyage où l'hôtel <em>est</em> la destination : séjour anniversaire, lune de miel, quelques
      nuits de décompression entre deux vols. Les visiteurs qui cherchent d'abord l'immersion trouveront
      un contact plus direct avec la ville dans un
      <a href={L('/riads-medina-marrakech/')}>riad</a>, au prix d'une logistique plus exigeante.
    </p>

    <h2>À savoir avant de réserver</h2>
    <p>
      Les tarifs varient fortement selon la saison : février, Pâques et les fêtes de fin d'année sont
      les périodes les plus tendues, tandis que juillet et août — où Marrakech dépasse souvent 40 °C —
      se négocient mieux. Notre page
      <a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a> détaille ces arbitrages, et
      <a href={L('/ou-dormir-marrakech/')}>quel quartier pour dormir</a> replace l'établissement dans
      l'ensemble de l'offre.
    </p>
  </div>
</HotelReviewLayout>
