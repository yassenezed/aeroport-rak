---
import HotelLayout from '../layouts/HotelLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Près du RAK', href: L('/hotels-pres-aeroport-marrakech/') },
];

const facts = [
  { label: 'Hivernage', value: '10 min', sub: 'du terminal' },
  { label: 'Agdal', value: '12–15 min', sub: 'du terminal' },
  { label: 'Médina', value: '+ la marche', sub: 'à éviter tôt' },
  { label: 'Bagagerie', value: 'Gratuite', sub: 'dans les riads' },
];

const zones = [
  { zone: 'Hivernage', min: '8–12 min', profil: 'Grands hôtels, jardins, piscines', ideal: 'Dernière nuit confortable, familles' },
  { zone: 'Agdal', min: '12–15 min', profil: 'Hôtels récents, résidences', ideal: 'Vol très matinal, bon rapport qualité-prix' },
  { zone: 'Guéliz', min: '15–20 min', profil: 'Hôtels urbains, restaurants ouverts tard', ideal: 'Dîner en ville la veille du départ' },
  { zone: 'Médina', min: '15–30 min + marche', profil: 'Riads', ideal: 'À éviter pour un départ avant 7 h' },
  { zone: 'Palmeraie', min: '25–35 min', profil: 'Resorts', ideal: 'Peu adapté à un vol matinal' },
];

const faqs = [
  {
    q: "Y a-t-il un hôtel dans l'aéroport de Marrakech ?",
    a: "Non, aucun établissement ne se trouve dans l'enceinte du terminal. Les hébergements les plus proches sont dans l'Hivernage et à l'Agdal, à une dizaine de minutes de route, ce qui reste très confortable : Marrakech est l'un des aéroports les mieux placés du Maroc par rapport à sa ville."
  },
  {
    q: "Où dormir pour un vol tôt le matin ?",
    a: `Dans l'Hivernage ou à l'Agdal : 10 à 15 minutes de route, dépose et reprise devant la réception, et la possibilité de commander un taxi à 5 h sans traverser la médina. Comptez ${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]} MAD pour la course, ou réservez un transfert la veille.`
  },
  {
    q: "Peut-on dormir en médina avant un départ matinal ?",
    a: "C'est possible mais c'est le scénario le plus inconfortable : il faut sortir du riad à pied, dans des ruelles peu éclairées, avec les bagages, avant de rejoindre une porte où la voiture attend. Si votre vol part avant 7 h, mieux vaut passer la dernière nuit dans la ville nouvelle."
  },
  {
    q: "Le bruit des avions est-il gênant près de l'aéroport ?",
    a: "Peu, car les hébergements les plus proches ne se situent pas sous les trajectoires principales, et le trafic de nuit est limité. L'Hivernage et l'Agdal sont des quartiers résidentiels calmes ; le bruit de fond y vient davantage de la circulation que des avions."
  },
  {
    q: "Que faire de ses bagages le jour du départ ?",
    a: "L'aéroport n'offre pas de consigne fiable, mais tous les riads et hôtels gardent les valises gratuitement après la libération de la chambre. C'est la solution : vous profitez d'une dernière journée en ville et repassez avant votre transfert."
  },
];
---
<HotelLayout
  title={"Dormir près de l'aéroport de Marrakech (RAK)"}
  description={"Dormir près du RAK : Hivernage et Agdal à 10-15 minutes, Guéliz à 20, et pourquoi la médina est à éviter avant un vol matinal."}
  eyebrow="Marrakech · Hébergement"
  h1="Dormir près de l'aéroport de Marrakech"
  lede="Il n'y a pas d'hôtel dans le terminal, et ce n'est pas un problème : la ville commence à cinq kilomètres. Voici les quartiers à dix minutes des pistes, et le cas de figure où ce choix change vraiment votre départ."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['hotels-aeroport-rak']}
  faqs={faqs}
>
  <p>
    Marrakech Ménara est si proche du centre qu'aucune « zone hôtelière d'aéroport » ne s'est
    développée, contrairement à ce qu'on trouve autour des grands hubs. La question n'est donc pas de
    trouver un hôtel près des pistes, mais de choisir le quartier qui vous met à un quart d'heure du
    comptoir d'enregistrement sans traverser la médina à l'aube.
  </p>

  <h2>Les quartiers par temps de trajet</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Quartier</th><th>Vers le terminal</th><th>Type d'hébergement</th><th>Idéal pour</th></tr>
      </thead>
      <tbody>
        {zones.map((z, i) => (
          <tr class:list={[{ 'row-highlight': i < 2 }]}>
            <td><strong>{z.zone}</strong></td>
            <td class="num">{z.min}</td>
            <td>{z.profil}</td>
            <td>{z.ideal}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Quand ce choix compte vraiment</h2>
  <p>
    <strong>Vol qui part avant 7 h du matin.</strong> C'est le cas d'école. Depuis l'Hivernage, vous
    partez à 4 h 30, dépose devant la réception, quinze minutes de route sur des avenues vides. Depuis
    un riad de la médina, il faut ajouter la sortie à pied dans des ruelles obscures avec les valises —
    faisable, mais pénible, et difficile à organiser à cette heure.
  </p>
  <p>
    <strong>Vol qui atterrit après 23 h.</strong> Même logique en sens inverse : arriver dans un hôtel
    accessible en voiture évite de chercher un derb de nuit. Beaucoup de voyageurs réservent une
    première nuit en ville nouvelle, puis basculent en riad le lendemain, une fois la ville apprivoisée.
  </p>
  <p>
    <strong>Escale longue ou correspondance.</strong> Si vous avez huit heures entre deux vols,
    l'Hivernage vous laisse le temps d'une piscine et d'un déjeuner avant de revenir. Voyez notre page
    {' '}<a href={L('/guide-aeroport-marrakech/departs/')}>départs du RAK</a> pour le rétroplanning.
  </p>

  <div class="callout">
    <span class="callout-label">La combinaison que nous recommandons</span>
    <p>
      Riad en médina pour le cœur du séjour, puis une dernière nuit dans l'Hivernage ou à l'Agdal si
      votre vol part tôt. Vous gardez l'expérience et vous supprimez le seul moment réellement pénible
      d'un séjour en médina : le départ à l'aube avec les bagages.
    </p>
  </div>

  <h2>Organiser le trajet du retour</h2>
  <p>
    Deux options fiables. Un taxi commandé par la réception la veille, autour de
    {' '}{airport.taxiFare.dayMad[0]}–{airport.taxiFare.dayMad[1]} MAD selon l'heure — c'est le plus
    simple depuis un hôtel de la ville nouvelle. Ou un
    {' '}<a href={L('/reserver-transfert/')}>transfert réservé</a>, qui fixe le prix et l'horaire à
    l'avance : plus pertinent si vous partez d'un riad, avec un rendez-vous à une porte précise.
  </p>
  <p class="small text-muted">
    Repères tarifaires vérifiés en {PRICES_CHECKED}. Pour le panorama complet des quartiers, voyez
    {' '}<a href={L('/ou-dormir-marrakech/')}>où dormir à Marrakech</a> et notre sélection
    {' '}<a href={L('/meilleurs-hotels-marrakech/')}>meilleurs hôtels</a>.
  </p>
</HotelLayout>
