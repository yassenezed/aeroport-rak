---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Se déplacer à Marrakech", href: L("/se-deplacer-marrakech/") },
];

const toc = [
  { label: "À pied", id: "pied" },
  { label: "Le petit taxi", id: "petit-taxi" },
  { label: "Le grand taxi", id: "grand-taxi" },
  { label: "Bus et transports publics", id: "bus" },
  { label: "Applications de VTC", id: "vtc" },
  { label: "Calèches, scooters, vélos", id: "autres" },
  { label: "Et la voiture ?", id: "voiture" },
];

const faqs = [
  { q: "Combien coûte un petit taxi à Marrakech ?", a: "Une course courte en centre-ville revient en général à 15 à 30 MAD, une traversée plus longue à 30 à 50 MAD, avec une majoration d'environ 50 % la nuit, à partir de 20 ou 21 h selon la saison. Le compteur est censé être utilisé, mais il est rarement enclenché avec les touristes : demandez-le en montant, ou fixez le prix avant de partir." },
  { q: "Un petit taxi peut-il aller dans la médina ?", a: "Non, il vous dépose à une porte ou sur une place accessible, comme Jemaa el-Fna ou les abords de la Koutoubia. Les derbs sont trop étroits pour les voitures. Indiquez à votre chauffeur la porte la plus proche de votre riad, pas seulement son nom." },
  { q: "Combien de passagers dans un petit taxi ?", a: "Trois au maximum, bagages compris. À quatre, il faut deux voitures ou un grand taxi. C'est la source de malentendus la plus fréquente avec les familles." },
  { q: "Peut-on utiliser Uber, Careem ou inDrive à Marrakech ?", a: "Uber est revenu à Marrakech fin novembre 2025 avec des transporteurs touristiques agréés, et Careem comme inDrive fonctionnent dans une zone juridique encore floue. La disponibilité reste irrégulière, et les taxis s'opposent à ces services, surtout à l'aéroport et aux abords des gares. En ville, vous pouvez essayer, en vérifiant que le véhicule correspond à l'écran ; ne bâtissez pas un trajet important dessus." },
  { q: "Comment se repérer dans la médina ?", a: "Prenez la Koutoubia comme repère : son minaret de 77 mètres se voit de loin. Téléchargez une carte hors ligne avant de partir, car le GPS dérape dans les derbs, et repérez la porte de votre riad. Si quelqu'un vous dit que « c'est fermé » et propose de vous guider, méfiez-vous : c'est presque toujours une manœuvre pour vous emmener dans une boutique." },
  { q: "Le bus est-il une bonne option à Marrakech ?", a: "Le réseau urbain existe et coûte quelques dirhams, mais il est saturé aux heures de pointe et peu lisible pour un visiteur. Seul le bus 19 vers l'aéroport présente un vrai intérêt touristique. Pour le reste, le petit taxi est plus simple et reste peu cher." },
];
---
<GuideLayout
  keywords="taxi Marrakech, se déplacer Marrakech, petit taxi compteur, bus 19, calèche Marrakech"
  title={"Se déplacer à Marrakech : taxi, bus, à pied"}
  description={"Circuler à Marrakech : petit taxi et compteur, grand taxi, bus, marche en médina, calèches, scooters et applications de VTC. Tarifs et pièges."}
  eyebrow={"Marrakech · Transports"}
  h1={"Se déplacer à Marrakech"}
  lede={"La ville se parcourt à pied dans la médina, en petit taxi dès qu'on en sort, et presque jamais en voiture. Voici les tarifs réels, les pièges classiques et l'ordre dans lequel utiliser chaque moyen."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["getting-around-marrakech"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Le trajet de l'aéroport se règle à l'avance", text: "Pour l'arrivée, un transfert à 27 € par véhicule (jusqu'à sept passagers) vous évite de découvrir les règles de la ville à minuit.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="pied">À pied : le mode par défaut dans la médina</h2>
<p>
  Dans la médina, tout se fait à pied, et c'est un plaisir à condition d'accepter de se perdre un peu.
  Les distances sont courtes — de Jemaa el-Fna à la madrasa Ben Youssef, quinze minutes suffisent — mais
  les ruelles se ressemblent, se croisent et s'interrompent. Trois précautions : un plan hors ligne
  téléchargé avant le départ, la Koutoubia comme repère lointain, et la porte de votre riad notée sur
  votre téléphone.
</p>
<p>
  Marchez tôt le matin ou en fin d'après-midi. Entre midi et 16 h, en été, la chaleur transforme la
  médina en four, et les commerçants eux-mêmes ralentissent. Prévoyez de l'eau, un chapeau et des
  chaussures fermées : les pavés sont irréguliers et les caniveaux ouverts.
</p>

<h2 id="petit-taxi">Le petit taxi : l'outil du quotidien</h2>
<p>
  Les petits taxis beiges quadrillent la ville et se hèlent dans la rue ou aux stations de Jemaa el-Fna,
  de la Koutoubia et des grandes places. Ils prennent <strong>trois passagers au maximum</strong> et
  restent cantonnés à l'agglomération.
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Trajet type</th><th>Prix indicatif</th></tr></thead>
    <tbody>
      <tr><td>Course courte en centre-ville</td><td class="num">15–30 MAD</td></tr>
      <tr><td>Traversée plus longue (médina → Guéliz, médina → Majorelle)</td><td class="num">30–50 MAD</td></tr>
      <tr><td>Majoration de nuit (à partir de 20–21 h)</td><td class="num">+ 50 %</td></tr>
      <tr><td>Aéroport ↔ médina, tarif affiché</td><td class="num">100–150 MAD</td></tr>
    </tbody>
  </table>
</div>
<div class="callout">
  <span class="callout-label">Le compteur</span>
  <p>
    Il est censé fonctionner, mais rarement avec les visiteurs. Dites « compteur, s'il vous plaît » en
    montant. Si le chauffeur refuse ou « n'a pas de monnaie », fixez le prix <em>avant</em> de partir,
    dans la fourchette ci-dessus, ou descendez et prenez la voiture suivante.
  </p>
</div>

<h2 id="grand-taxi">Le grand taxi : pour sortir de la ville</h2>
<p>
  Plus vastes, les grands taxis prennent jusqu'à six passagers et assurent les liaisons hors de
  l'agglomération : l'Ourika, Imlil, le désert d'Agafay, Essaouira. Le prix se négocie intégralement,
  pour la voiture entière, et dépend de la distance, de la saison et du retour à vide. Notre
  <a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix</a> donne les ordres de grandeur, et une
  journée d'excursion avec chauffeur se compare aux offres de
  <a href={L('/guide-touristique/')}>guide et excursions</a>.
</p>

<h2 id="bus">Bus et transports publics</h2>
<p>
  Marrakech dispose d'un réseau de bus urbains qui coûtent quelques dirhams, mais ils sont saturés aux
  heures de pointe et difficiles à décrypter pour un visiteur. Le seul qui compte vraiment est le bus
  19, qui relie l'aéroport à Jemaa el-Fna — détaillé sur
  <a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport Marrakech</a>. La ville n'a pas de
  métro, et le train ne dessert que les liaisons vers Casablanca, Rabat, Fès et Tanger, depuis la gare
  de Guéliz.
</p>

<h2 id="vtc">Applications de VTC : à essayer, pas à parier</h2>
<p>
  Le paysage a changé : Uber a repris ses activités à Marrakech le 27 novembre 2025, uniquement avec des
  transporteurs touristiques agréés, tandis que Careem et inDrive fonctionnent dans une zone juridique
  encore floue, les autorités ayant annoncé un cadre réglementaire à venir. Concrètement, la
  disponibilité varie d'un jour à l'autre, et les taxis s'opposent à ces services, ce qui pose surtout
  problème aux abords de l'aéroport et des gares.
</p>
<p>
  En ville, vous pouvez essayer : vérifiez que la plaque et le chauffeur correspondent à l'écran, et
  convenez d'un point de rendez-vous précis, car la médina complique la géolocalisation. Ne construisez
  pas un trajet important dessus, notamment celui de l'arrivée ou du retour vers l'aéroport.
</p>

<h2 id="autres">Calèches, scooters et vélos</h2>
<p>
  <strong>Les calèches</strong> stationnent près de Jemaa el-Fna et de la Koutoubia. Le tarif se fixe
  avant de monter et pour une durée précise ; elles font une promenade agréable autour des remparts en
  fin de journée. Regardez l'état des chevaux : c'est un bon critère pour choisir un cocher.
</p>
<p>
  <strong>Scooters et vélos</strong> se louent à Guéliz et dans certains quartiers. La circulation
  marrakchie repose sur des priorités négociées au regard ; si vous n'êtes pas à l'aise, préférez le
  vélo dans la Palmeraie ou sur les grands boulevards. Casque, assurance et état des freins se vérifient
  avant de partir.
</p>

<h2 id="voiture">Et la voiture ?</h2>
<p>
  Pour Marrakech seule, c'est un handicap : la médina est interdite aux véhicules, le stationnement près
  des remparts est difficile et les petits taxis coûtent quelques dirhams. La location devient
  intéressante pour l'Ourika, Essaouira ou l'Atlas — voyez
  <a href={L('/location-voiture-aeroport-marrakech/')}>la location au RAK</a>. Pour les règles de
  circulation locales, <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
</p>
</GuideLayout>
