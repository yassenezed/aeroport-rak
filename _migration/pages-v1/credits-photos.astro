---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLocalizedPath } from '../i18n';
import { site } from '../data/site';

const L = (p: string) => getLocalizedPath(p);
---
<BaseLayout
  title={"Crédits photos | AeroportRAK"}
  description={"Origine et droits des photographies du site AeroportRAK."}
  noindex={true}
>
  <section class="hero">
    <div class="container hero-inner">
      <Breadcrumbs items={[{ name: 'Accueil', href: L('/') }, { name: "Crédits photos", href: L("/credits-photos/") }]} />
      <span class="eyebrow">Légal</span>
      <h1>Crédits photos</h1>
      <p class="lede">Les photographies du site et leurs droits.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="prose">
<p>
  Les photographies présentes sur AeroportRAK appartiennent à l'éditeur du site ou sont utilisées avec
  l'autorisation de leurs auteurs. Toute reproduction sans accord préalable est interdite.
</p>
<p>
  Si vous pensez qu'une image est utilisée sans autorisation, ou si vous souhaitez en proposer une, écrivez-nous
  via la page <a href={L('/contact/')}>contact</a> : nous la retirerons ou nous vous créditerons rapidement.
</p>
      </article>
    </div>
  </section>
</BaseLayout>
