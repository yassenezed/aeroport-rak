---
import RouteLayout from '../layouts/RouteLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts & taxi', href: L('/transfert-aeroport-marrakech/') },
  { name: 'Aéroport → Médina', href: L('/transfert-aeroport-marrakech-medina/') },
];

const facts = [
  { label: 'Distance', value: `${airport.distanceToCityKm} km` },
  { label: 'Durée', value: `${airport.driveToCityMin.min}–${airport.driveToCityMin.max}`, sub: 'min' },
  { label: 'Transfert privé', value: '27 €', sub: 'dès' },
  { label: 'Taxi (jour)', value: `${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]}`, sub: 'MAD' },
];

const faqs = [
  {
    q: "Combien coûte un transfert de l'aéroport de Marrakech à la médina ?",
    a: `Un transfert privé réservé démarre à 27 € par véhicule, jusqu'à 7 passagers, suivi du vol inclus chez la plupart des opérateurs. Un taxi pris au rang coûte ${airport.taxiFare.dayMad[0]} à ${airport.taxiFare.dayMad[1]} MAD en journée et ${airport.taxiFare.nightMad[0]} à ${airport.taxiFare.nightMad[1]} MAD la nuit, pour la voiture entière. Le bus ${airport.bus.line} dépose à Jemaa el-Fna pour ${airport.bus.oneWayMad} MAD.`
  },
  {
    q: "Combien de temps dure le trajet ?",
    a: `${airport.driveToCityMin.min} à ${airport.driveToCityMin.max} minutes de route pour ${airport.distanceToCityKm} km, selon la circulation et la porte visée. Ajoutez 3 à 10 minutes de marche depuis la porte jusqu'à votre riad : c'est cette portion, et non la route, qui fait varier l'expérience.`
  },
  {
    q: "Le chauffeur peut-il aller jusqu'au riad ?",
    a: "Non. Les derbs de la médina sont trop étroits et plusieurs accès sont fermés à la circulation. La dépose se fait obligatoirement à une porte. Le bon chauffeur est celui qui s'arrête à la <em>bonne</em> porte : demandez-la à votre riad et transmettez-la à la réservation."
  },
  {
    q: "Quelle porte pour quel secteur de la médina ?",
    a: "Bab Doukkala pour le nord-ouest (Dar el Bacha, Mouassine), Bab Laksour pour les abords de Jemaa el-Fna et Riad Zitoun, Bab Agnaou pour la Kasbah et les tombeaux saadiens, Bab el Khemis pour le nord-est. Votre riad vous donnera la bonne en une phrase."
  },
  {
    q: "Et pour les bagages dans les ruelles ?",
    a: "Demandez un porteur avec charrette à votre riad en annonçant votre heure d'arrivée. Presque tous le font, gratuitement ou pour 20 à 30 MAD de pourboire. C'est le meilleur investissement de tout le trajet, surtout de nuit."
  },
  {
    q: "Ce trajet est-il praticable avec de jeunes enfants ?",
    a: "Oui, mais anticipez : la marche finale se fait sur des pavés irréguliers, difficilement en poussette. Avec des enfants en bas âge, beaucoup de familles préfèrent un hôtel de Guéliz ou de l'Hivernage, où la voiture dépose devant la réception."
  },
];
---
<RouteLayout
  title={"Aéroport de Marrakech → Médina : prix et bonne porte"}
  description={"Le trajet le plus demandé du RAK : 6 km jusqu'à la médina, 15-30 minutes, prix du transfert et du taxi, la porte à indiquer et le porteur à prévoir."}
  eyebrow="Trajet · Aéroport → Médina"
  h1="Aéroport de Marrakech → Médina"
  lede="Six kilomètres, un quart d'heure de route, puis quelques minutes à pied : c'est le trajet le plus court et le plus fréquent du RAK, et celui où une seule information — le nom de votre porte — fait toute la différence."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={27}
  heroImage={photos['marrakech-medina']}
  heroProvider="transfer"
  heroCtaLabel="Réserver ce trajet"
  faqs={faqs}
  cta={{ heading: 'Dépose à la bonne porte', text: "Indiquez le nom de votre riad et sa porte à la réservation : le chauffeur s'arrête au plus près, à prix fixe, même sur un vol de nuit.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    C'est le trajet que la majorité des visiteurs de Marrakech effectuent en premier, et celui qui
    surprend le plus. Non pas par sa durée — il est court — mais parce qu'il ne se termine pas devant
    votre porte. Les {airport.distanceToCityKm} kilomètres se font en voiture ; les cent derniers mètres
    se font à pied.
  </p>

  <h2>Le trajet, étape par étape</h2>
  <ol>
    <li>Sortie du hall des arrivées, direction le rang de taxis ou la pancarte à votre nom.</li>
    <li>{airport.driveToCityMin.min} à {airport.driveToCityMin.max} minutes de route par l'avenue Mohammed VI puis les boulevards qui longent les remparts.</li>
    <li>Arrêt à la porte (bab) la plus proche de votre riad.</li>
    <li>3 à 10 minutes à pied dans les derbs, idéalement avec un porteur.</li>
  </ol>

  <h2>Les trois façons de le faire</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Option</th><th>Prix</th><th>Avantage</th><th>Limite</th></tr>
      </thead>
      <tbody>
        <tr class="row-highlight">
          <td><strong>Transfert privé réservé</strong></td>
          <td class="num">dès 27 € / véhicule</td>
          <td>Suivi du vol, bonne porte, prix fixe</td>
          <td>À réserver avant de partir</td>
        </tr>
        <tr>
          <td><strong>Taxi au rang</strong></td>
          <td class="num">{airport.taxiFare.dayMad[0]}–{airport.taxiFare.dayMad[1]} MAD le jour</td>
          <td>Immédiat, sans préparation</td>
          <td>3 passagers max, tarif à confirmer, porte au choix du chauffeur</td>
        </tr>
        <tr>
          <td><strong>Bus {airport.bus.line}</strong></td>
          <td class="num">{airport.bus.oneWayMad} MAD / personne</td>
          <td>Le moins cher, dépose à Jemaa el-Fna</td>
          <td>Rien après {airport.bus.lastDeparture}, puis marche sans guide</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>La bonne porte : l'information qui change tout</h2>
  <p>
    Les remparts de la médina sont percés de nombreuses portes, et être déposé à la mauvaise oblige à
    traverser une partie du labyrinthe à pied. Demandez à votre riad la porte de référence et
    transmettez-la telle quelle. Le tableau complet des portes et des secteurs qu'elles desservent est
    sur notre page <a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>.
  </p>

  <div class="callout">
    <span class="callout-label">Message type à envoyer la veille</span>
    <p>
      « Bonjour, nous arrivons le [date] par le vol [numéro], atterrissage à [heure]. Quelle porte
      indiquer au chauffeur, et pouvez-vous prévoir quelqu'un avec une charrette pour les bagages ? »
    </p>
  </div>

  <h2>Arriver de nuit</h2>
  <p>
    Une part importante des vols se pose après 21 h. À cette heure, le bus ne circule plus, le taxi
    passe à {airport.taxiFare.nightMad[0]}–{airport.taxiFare.nightMad[1]} MAD, et la médina, peu
    éclairée, se lit beaucoup moins facilement. C'est le scénario où le transfert réservé avec porteur
    annoncé fait la plus grande différence. Marrakech reste une ville sûre la nuit — voyez
    {' '}<a href={L('/securite-marrakech/')}>sécurité à Marrakech</a> — mais s'y repérer demande de la
    lumière.
  </p>

  <p class="small text-muted">
    Tarifs vérifiés en {PRICES_CHECKED}, par véhicule sauf le bus. Comparez les options sur
    {' '}<a href={L('/meilleur-transfert-aeroport-marrakech/')}>quel transfert choisir</a>.
  </p>
</RouteLayout>
