---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { getLocalizedPath } from '../i18n';
import { site } from '../data/site';

const L = (p: string) => getLocalizedPath(p);
---
<BaseLayout
  title={"À propos d'AeroportRAK, guide de l'aéroport RAK"}
  description={"Qui édite AeroportRAK, comment nous vérifions les prix, comment le site est financé, et ce que nous ne sommes pas : ni l'aéroport, ni une compagnie."}
>
  <section class="hero">
    <div class="container hero-inner">
      <Breadcrumbs items={[{ name: 'Accueil', href: L('/') }, { name: "À propos", href: L("/a-propos/") }]} />
      <span class="eyebrow">À propos</span>
      <h1>À propos d'AeroportRAK</h1>
      <p class="lede">Un guide pratique de l'aéroport de Marrakech Ménara, écrit pour ceux qui arrivent : comment rejoindre la médina, ce que ça coûte, et à quoi faire attention.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <article class="prose">
<h2>Pourquoi ce site existe</h2>
<p>
  Atterrir à Marrakech pose des questions que les sites officiels ignorent : par quelle porte de la médina
  se faire déposer, combien vaut réellement un taxi la nuit, ce qu'il faut savoir avant de louer une
  voiture. AeroportRAK rassemble ces réponses en français, avec des chiffres datés et des conseils issus
  du terrain.
</p>

<h2>Comment nous travaillons</h2>
<ul>
  <li><strong>Des prix datés.</strong> Chaque tarif indique la période de vérification. Les prix évoluent : nous les relevons et les mettons à jour, et nous vous invitons à toujours confirmer avant de réserver.</li>
  <li><strong>Des sources croisées.</strong> Pour les chiffres publics — tarifs d'entrée, distances, horaires — nous recoupons plusieurs sources, et nous indiquons quand une valeur est un ordre de grandeur plutôt qu'un tarif fixe.</li>
  <li><strong>Des corrections assumées.</strong> Quand une information s'avère fausse ou dépassée, nous la corrigeons. Écrivez-nous si vous en repérez une.</li>
</ul>

<h2>Comment le site est financé</h2>
<p>
  AeroportRAK est gratuit, sans abonnement. Il est financé par des commissions d'affiliation : lorsque vous
  réservez un transfert, un vol, un hébergement ou une location de voiture via les liens et widgets du site,
  nous pouvons percevoir une commission, <strong>sans surcoût pour vous</strong>. Ce financement ne nous
  fait pas dire n'importe quoi : nous écrivons, par exemple, que le taxi est moins cher qu'un transfert pour
  deux personnes en journée, même si nous ne touchons rien sur le taxi.
</p>
<p>
  Le détail est sur la page <a href={L('/divulgation-affiliation/')}>divulgation d'affiliation</a>.
</p>

<h2>Ce que nous ne sommes pas</h2>
<p>
  AeroportRAK n'est <strong>ni l'aéroport de Marrakech Ménara, ni la société qui le gère, ni une compagnie
  aérienne, ni un opérateur de taxis, de transferts ou de location</strong>. Nous ne vendons ni billets ni trajets en direct : les réservations sont traitées par des prestataires tiers, et
  toute question sur une réservation effectuée doit leur être adressée.
</p>

<h2>Nous contacter</h2>
<p>
  Pour une correction, une suggestion ou une demande de partenariat, voyez la page
  <a href={L('/contact/')}>contact</a>.
</p>
      </article>
    </div>
  </section>
</BaseLayout>
