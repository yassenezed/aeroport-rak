---
import CarRentalLayout from '../layouts/CarRentalLayout.astro';
import AffiliateLink from '../components/affiliate/AffiliateLink.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Location de voiture', href: L('/location-voiture-aeroport-marrakech/') },
  { name: 'Quelle agence choisir', href: L('/meilleure-location-voiture-aeroport-marrakech/') },
];

const facts = [
  { label: 'Critère n°1', value: 'Caution', sub: 'et carte exigée' },
  { label: 'Critère n°2', value: 'Carburant', sub: 'plein → plein' },
  { label: 'Citadine dès', value: '25 €', sub: '/jour' },
  { label: 'Réserver', value: 'En ligne', sub: 'jamais au comptoir' },
];

const compare = [
  { name: 'Europcar', type: 'International', deposit: 'Moyenne', fuel: 'Plein → plein', pour: 'Semaine complète, familles, monospaces' },
  { name: 'Hertz', type: 'International', deposit: 'Élevée', fuel: 'Plein → plein', pour: 'Longs itinéraires, voyage d\'affaires' },
  { name: 'Sixt', type: 'International', deposit: 'La plus élevée', fuel: 'Plein → plein', pour: 'Véhicules récents, SUV, Ouarzazate' },
  { name: 'Avis / Budget', type: 'International', deposit: 'Moyenne', fuel: 'À vérifier au tarif', pour: 'Alternative si les autres sont complets' },
  { name: 'Agences marocaines', type: 'Locale', deposit: 'Très variable', fuel: 'À lire de près', pour: 'Petit budget, usage urbain et court' },
];

const faqs = [
  {
    q: "Quelle est la meilleure agence de location à l'aéroport de Marrakech ?",
    a: "Aucune ne gagne pour tous les profils. Europcar offre le meilleur compromis sur une semaine et pour les familles, Hertz la plus grande prévisibilité sur les longs trajets, Sixt la flotte la plus récente, et les agences marocaines les tarifs les plus bas avec une régularité moindre. Le bon choix se décide sur vos dates, en comparant caution, carburant et franchise, pas sur le logo."
  },
  {
    q: "Enseigne internationale ou agence marocaine ?",
    a: "Internationale si votre itinéraire est long, si vous voyagez en haute saison ou si vous voulez un recours structuré en cas de litige. Agence marocaine si votre usage est court et urbain et que vous acceptez de lire les conditions avec attention. La différence de prix atteint 20 à 30 %, celle de régularité est réelle mais pas systématique."
  },
  {
    q: "Qu'est-ce qui fait une bonne location, au-delà du prix ?",
    a: "Quatre choses : une caution que votre carte de crédit absorbe sans difficulté, une politique de carburant en plein-à-plein, une franchise raisonnable ou rachetée en ligne à bas coût, et un état des lieux initial sérieux. Un tarif un peu plus élevé avec ces quatre points vaut mieux qu'un tarif plancher sans."
  },
  {
    q: "Comment comparer les cautions avant de réserver ?",
    a: "Utilisez un comparateur qui affiche les conditions avant le paiement, et non seulement le prix : montant de caution, type de carte exigé, politique de carburant, montant de franchise. Les lire chez soi permet d'éliminer les offres attractives mais mal conditionnées, ce qui est impossible debout au comptoir après un vol."
  },
  {
    q: "Faut-il réserver à l'avance à Marrakech ?",
    a: `Oui. La réservation anticipée fixe un tarif inférieur à celui du guichet, sécurise les catégories rares — boîte automatique, monospace, SUV — avant les pics de février et de Pâques, et vous laisse le temps de souscrire une couverture de franchise en ligne, bien moins chère que le rachat vendu au comptoir. Prix relevés en ${PRICES_CHECKED}.`
  },
];
---
<CarRentalLayout
  title={"Quelle agence de location choisir au RAK ?"}
  description={"Loueurs du RAK face à face : Europcar, Hertz, Sixt, Avis et agences marocaines comparés sur la caution, le carburant, la franchise et le profil idéal."}
  eyebrow="Aéroport Marrakech Ménara · Location"
  h1="Quelle agence de location choisir à l'aéroport de Marrakech"
  lede="Il n'existe pas de meilleur loueur au RAK, seulement un meilleur loueur pour votre itinéraire. Les quatre critères qui décident réellement, et le comparatif agence par agence."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={25}
  heroImage={photos['marrakech-car-rental']}
  heroCtaLabel="Comparer toutes les agences du RAK"
  faqs={faqs}
>
  <p>
    Poser la question « quelle est la meilleure agence ? » revient à demander quelle est la meilleure
    voiture : la réponse dépend du trajet. À Marrakech, quatre critères décident du coût et de la
    tranquillité réels, et aucun n'apparaît dans le tarif journalier mis en avant.
  </p>

  <h2>Les quatre critères qui tranchent</h2>
  <ol>
    <li><strong>La caution et la carte exigée.</strong> Une carte de crédit au nom du conducteur, avec un plafond suffisant. Premier motif de refus au comptoir.</li>
    <li><strong>La politique de carburant.</strong> Plein-à-plein, sans exception. Le plein-à-vide peut coûter 60 € sur trois jours.</li>
    <li><strong>La franchise.</strong> Son montant, ses exclusions — pneus, vitrage, bas de caisse, pistes — et le coût du rachat en ligne face au comptoir.</li>
    <li><strong>L'état des lieux.</strong> Dommages notés par écrit au départ, vidéo au départ et au retour, document de restitution signé.</li>
  </ol>

  <h2>Les agences du RAK face à face</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Agence</th><th>Type</th><th>Caution</th><th>Carburant</th><th>Idéale pour</th></tr>
      </thead>
      <tbody>
        {compare.map((c, i) => (
          <tr class:list={[{ 'row-highlight': i === 0 }]}>
            <td><strong>{c.name}</strong></td>
            <td>{c.type}</td>
            <td>{c.deposit}</td>
            <td>{c.fuel}</td>
            <td>{c.pour}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Notre recommandation par profil</h2>
  <p>
    <strong>Couple, une semaine, excursions variées.</strong> Europcar sur un tarif hebdomadaire, en
    citadine ou SUV compact. Le meilleur rapport prévisibilité/prix du terminal.
  </p>
  <p>
    <strong>Famille de quatre ou cinq, bagages volumineux.</strong> Europcar ou Sixt pour la
    disponibilité des monospaces, avec sièges enfants réservés en même temps que le véhicule.
  </p>
  <p>
    <strong>Grand itinéraire : Ouarzazate, vallée du Dadès, Essaouira.</strong> Hertz ou Sixt. Sur
    500 kilomètres de montagne, l'entretien du véhicule et la qualité de l'assistance valent leur
    supplément.
  </p>
  <p>
    <strong>Deux jours d'excursion depuis la médina, petit budget.</strong> Une agence marocaine bien
    notée, réservée en ligne avec conditions affichées — et surtout, ne louez que les jours utiles,
    comme nous l'expliquons dans
    {' '}<a href={L('/location-voiture-aeroport-marrakech/pas-cher/')}>location pas chère</a>.
  </p>

  <div class="callout">
    <span class="callout-label">Le piège du classement par étoiles</span>
    <p>
      Les notes moyennes d'un loueur mélangent des clients qui ont pris une couverture complète et
      d'autres qui ont refusé toute assurance. Un « mauvais » avis décrit souvent un litige de franchise
      prévisible plutôt qu'une agence malhonnête. Lisez le motif, pas la note.
    </p>
  </div>

  <h2>Et si vous n'aviez pas besoin de voiture ?</h2>
  <p>
    La question mérite d'être posée avant de comparer quoi que ce soit. Pour un séjour exclusivement à
    Marrakech, la voiture est un handicap : médina interdite, stationnement difficile, petits taxis à
    quelques dirhams. Un chauffeur à la journée pour une ou deux excursions coûte souvent moins qu'une
    semaine de location plus le parking. Voyez
    {' '}<a href={L('/se-deplacer-marrakech/')}>se déplacer à Marrakech</a> et
    {' '}<a href={L('/guide-touristique/')}>guide et excursions</a>.
  </p>
  <p>
    <AffiliateLink provider="discovercars" sub="best-car-body" class="btn btn-primary">Comparer les agences sur vos dates</AffiliateLink>
  </p>
</CarRentalLayout>
