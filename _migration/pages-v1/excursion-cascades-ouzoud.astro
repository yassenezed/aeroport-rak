---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Excursions", href: L("/que-faire-marrakech/") },
  { name: "Cascades d'Ouzoud", href: L("/excursion-cascades-ouzoud/") },
];

const toc = [
  { label: "Ce qu'est Ouzoud", id: "cascades" },
  { label: "Le trajet", id: "trajet" },
  { label: "Sur place", id: "sur-place" },
  { label: "Les singes", id: "singes" },
  { label: "Quand y aller", id: "quand" },
  { label: "Journée ou nuit sur place", id: "nuit" },
];

const faqs = [
  { q: "À quelle distance sont les cascades d'Ouzoud de Marrakech ?", a: "Environ 150 kilomètres, soit deux heures trente à trois heures de route selon le trafic et l'état de la chaussée. C'est nettement plus loin que l'Ourika : prévoyez une journée longue, de 8 h à 19 h, ou une nuit sur place." },
  { q: "Quelle est la hauteur des cascades d'Ouzoud ?", a: "Environ 110 mètres, ce qui les place parmi les plus hautes d'Afrique du Nord. Elles s'écoulent en plusieurs paliers dans un canyon aux parois ocre, au milieu d'oliviers et de moulins à eau." },
  { q: "Quelle est la meilleure saison pour Ouzoud ?", a: "Le printemps, de mars à mai, quand le débit est le plus fort et la végétation verte. Le reste de l'année, les chutes demeurent belles ; en été, on peut se baigner dans les vasques en contrebas, et l'hiver est frais et calme." },
  { q: "Peut-on nourrir les singes d'Ouzoud ?", a: "Mieux vaut s'abstenir. Les macaques de Barbarie, qui vivent librement autour des chutes, sont habitués aux visiteurs, mais leur comportement peut devenir insistant. Ne montrez pas de nourriture, ne sortez pas votre téléphone à portée de main, et ne les touchez pas." },
  { q: "Y a-t-il des bus directs pour Ouzoud ?", a: "Des lignes desservent la région d'Azilal depuis Marrakech, mais rejoindre Ouzoud sans voiture est lent et peu pratique. Les visiteurs choisissent en général une excursion organisée, un chauffeur privé ou une voiture de location." },
  { q: "Faut-il dormir à Ouzoud ?", a: "C'est fortement conseillé si vous n'avez qu'une journée : les six heures de route aller-retour laissent peu de temps sur place. Plusieurs hébergements se trouvent près des chutes, avec des dîners sur les terrasses et un calme qui contraste avec la journée." },
];
---
<GuideLayout
  keywords="cascades Ouzoud, Ouzoud Marrakech excursion, singes Ouzoud, Azilal"
  title={"Cascades d'Ouzoud depuis Marrakech : guide 2026"}
  description={"Cascades d'Ouzoud depuis Marrakech : 110 m de chute, 2 h 30 de route, saison de l'eau, macaques, balade en barque et nuit sur place."}
  eyebrow={"Excursions · Cascades d'Ouzoud"}
  h1={"Cascades d'Ouzoud depuis Marrakech"}
  lede={"Cent dix mètres de chute, des macaques, des champs d'oliviers et une bonne quinzaine de kilomètres de pistes au bout de la route. Ouzoud est loin, mais c'est l'une des plus belles excursions du pays."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["ouzoud-falls"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un chauffeur pour la journée", text: "Une voiture privée évite les horaires de groupe et permet de rester plus longtemps sur place : le trajet est long, autant le faire à votre rythme.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="cascades">Ce qu'est Ouzoud</h2>
<p>
  Dans l'Atlas, près du village de Tanaghmeilt, la rivière El Abid se jette d'une falaise de
  110 mètres en plusieurs cascades, dans un canyon d'un rouge profond. L'ensemble est entouré d'oliviers,
  de moulins à eau traditionnels et de sentiers qui descendent jusqu'aux vasques. C'est un site naturel
  spectaculaire, très fréquenté le week-end et les jours fériés, mais qui garde sa force.
</p>

<h2 id="trajet">Le trajet</h2>
<p>
  Comptez 150 kilomètres et deux heures trente à trois heures de route depuis Marrakech, par les nationales
  en direction d'Azilal. La chaussée est correcte, avec des portions de montagne et
  des villages qui font chuter la vitesse. Une citadine convient. Pour l'organisation, voyez
  <a href={L('/location-voiture-aeroport-marrakech/')}>la location</a> et
  <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
</p>
<div class="callout">
  <span class="callout-label">Une excursion longue</span>
  <p>
    Six heures de route pour trois ou quatre heures sur place : c'est faisable, mais dense. Partir à
    7 h 30 et rentrer vers 19 h est un maximum raisonnable. Beaucoup préfèrent dormir sur place et
    profiter des chutes au petit matin, avant l'arrivée des groupes.
  </p>
</div>

<h2 id="sur-place">Sur place</h2>
<ul>
  <li><strong>Le sentier du haut :</strong> par la rive, avec des points de vue sur la chute et des restaurants aux terrasses. Facile.</li>
  <li><strong>La descente :</strong> vingt à trente minutes de marche sur un chemin de pierre, avec des marches irrégulières. Chaussures fermées obligatoires.</li>
  <li><strong>La balade en barque :</strong> de petites embarcations approchent le pied de la chute pour quelques dizaines de dirhams. Bruyant, humide, très photographié.</li>
  <li><strong>Les vasques :</strong> en été, on peut se baigner dans l'eau en contrebas, à distance des chutes.</li>
  <li><strong>Les restaurants :</strong> en surplomb ou au bord de l'eau ; convenez du prix avant de commander.</li>
</ul>

<h2 id="singes">Les singes</h2>
<p>
  Les macaques de Barbarie vivent librement autour du site et font partie de l'attraction. Ils sont
  habitués aux visiteurs et peuvent devenir insistants. Quelques règles : ne les nourrissez pas, ne
  leur montrez pas de nourriture, gardez téléphone et lunettes à l'abri, et ne les touchez pas — comme
  tout animal sauvage, ils peuvent mordre ou griffer, et le risque de rage impose de consulter en cas de
  blessure.
</p>

<h2 id="quand">Quand y aller</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Saison</th><th>Débit</th><th>Ambiance</th></tr></thead>
    <tbody>
      <tr class="row-highlight"><td><strong>Mars – mai</strong></td><td>Fort</td><td>Vert, spectaculaire, températures douces</td></tr>
      <tr><td><strong>Juin – septembre</strong></td><td>Moyen</td><td>Chaud, baignade possible, foule le week-end</td></tr>
      <tr><td><strong>Octobre – novembre</strong></td><td>Moyen</td><td>Calme, lumière dorée</td></tr>
      <tr><td><strong>Décembre – février</strong></td><td>Variable</td><td>Frais, peu de monde, sentiers humides</td></tr>
    </tbody>
  </table>
</div>

<h2 id="nuit">Journée ou nuit sur place</h2>
<p>
  Une journée depuis Marrakech se fait, mais la nuit sur place change l'expérience : les hébergements
  proches des chutes proposent des dîners en terrasse, un calme complet et un accès aux sentiers avant
  les groupes. Notre page <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a> compare avec les
  autres excursions, et <a href={L('/excursion-vallee-ourika/')}>l'Ourika</a> est l'alternative plus
  proche si vous n'avez qu'une demi-journée.
</p>
</GuideLayout>
