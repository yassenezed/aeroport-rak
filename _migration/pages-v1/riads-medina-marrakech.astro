---
import HotelLayout from '../layouts/HotelLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Riads dans la médina', href: L('/riads-medina-marrakech/') },
];

const facts = [
  { label: 'Chambres', value: '4–10', sub: 'en moyenne' },
  { label: 'Accès', value: 'À pied', sub: 'depuis une porte' },
  { label: 'Porteur', value: '20–30', sub: 'MAD de pourboire' },
  { label: 'Petit-déj', value: 'Terrasse', sub: 'presque partout' },
];

const nos = [
  { nom: 'Riad Yasmine', angle: 'Le patio le plus photographié de la médina', href: '/avis-riad-yasmine/' },
  { nom: 'Riad BE Marrakech', angle: 'Esprit riad, lecture contemporaine, accès facile à Bab Doukkala', href: '/avis-riad-be-marrakech/' },
];

const faqs = [
  {
    q: "Qu'est-ce qu'un riad exactement ?",
    a: "Une maison traditionnelle organisée autour d'un patio intérieur, sans fenêtres sur la rue : toute la lumière et la vie viennent du centre. Cette architecture explique à la fois le calme surprenant qu'on y trouve et l'absence de vue extérieure depuis les chambres. Beaucoup de riads ont été restaurés en maisons d'hôtes de quatre à dix chambres."
  },
  {
    q: "Comment arrive-t-on à son riad avec des valises ?",
    a: "Le chauffeur dépose à la porte (bab) la plus proche, puis on termine à pied, généralement 3 à 10 minutes dans les derbs. La quasi-totalité des riads envoient un porteur avec une charrette si vous annoncez votre heure d'arrivée : demandez-le, c'est gratuit ou coûte 20 à 30 MAD de pourboire, et cela change tout."
  },
  {
    q: "Les riads sont-ils bruyants ?",
    a: "Le patio agit comme une caisse de résonance : ce qui se dit au rez-de-chaussée s'entend aux étages. Les riads sont silencieux quand ils sont peu occupés, plus vivants quand ils sont pleins. L'appel à la prière de l'aube s'entend nettement partout en médina. Si votre sommeil est fragile, demandez une chambre à l'étage supérieur ou côté rue aveugle."
  },
  {
    q: "Y a-t-il une piscine dans les riads ?",
    a: "Souvent un bassin de patio, dimensionné pour se rafraîchir plutôt que pour nager, parfois non chauffé et à l'ombre une partie de la journée. Si la baignade compte vraiment dans votre séjour, regardez plutôt les hôtels de l'Hivernage ou les resorts de la Palmeraie."
  },
  {
    q: "Un riad est-il adapté aux personnes à mobilité réduite ?",
    a: "Rarement. Escaliers étroits et raides, seuils, absence d'ascenseur dans la plupart des maisons, et une marche d'approche sur pavés irréguliers. Certains riads disposent d'une chambre en rez-de-patio : demandez explicitement, mais un hôtel de Guéliz reste généralement plus adapté."
  },
  {
    q: "Peut-on laisser ses bagages après le départ ?",
    a: "Oui, tous les riads le font gratuitement, et c'est précieux à Marrakech : l'aéroport n'offre pas de consigne fiable. Vous libérez la chambre, vous passez la journée en ville, et vous repassez avant votre transfert."
  },
];
---
<HotelLayout
  title={"Riads de la médina de Marrakech : bien choisir"}
  description={"Choisir un riad dans la médina de Marrakech : arrivée à pied, porteur avec charrette, bruit, escaliers, bassin de patio et à qui la formule convient."}
  eyebrow="Marrakech · Riads"
  h1="Riads dans la médina de Marrakech"
  lede="Un patio silencieux à trente mètres des souks : c'est ce qu'on vient chercher. Voici ce que la formule implique réellement — l'arrivée à pied, le bruit du patio, les escaliers — et comment choisir la bonne maison."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['riads-medina']}
  faqs={faqs}
>
  <p>
    Le riad est l'argument numéro un de Marrakech en matière d'hébergement, et il le mérite : peu de
    villes permettent de dormir dans une maison à patio du XIX<sup>e</sup> siècle, à cinq minutes à
    pied d'une place classée. Mais c'est une formule avec des règles propres, qu'il vaut mieux
    connaître avant de réserver que découvrir à 23 h avec deux valises.
  </p>

  <h2>Ce que vous obtenez</h2>
  <ul>
    <li>Un <strong>patio</strong> central, souvent avec bassin et orangers, qui tient la fraîcheur.</li>
    <li>Une <strong>terrasse</strong> sur le toit, lieu du petit-déjeuner et du thé de fin d'après-midi.</li>
    <li>Une <strong>petite échelle</strong> : quatre à dix chambres, un service personnalisé.</li>
    <li>Un emplacement <strong>au cœur de la médina</strong>, souks et monuments à pied.</li>
  </ul>

  <h2>Ce que personne ne vous dit avant</h2>
  <p>
    <strong>L'arrivée se fait à pied.</strong> Aucune voiture n'entre dans les derbs. Le chauffeur
    s'arrête à une porte et vous marchez trois à dix minutes sur des pavés. La solution est simple et
    gratuite : demander un porteur avec charrette, en annonçant votre heure d'arrivée. Tout est détaillé
    sur <a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>.
  </p>
  <p>
    <strong>Le patio porte les sons.</strong> C'est la contrepartie de l'architecture : une conversation
    au rez-de-chaussée monte aux étages. Ajoutez l'appel à la prière avant l'aube, audible partout en
    médina. Demandez une chambre haute si votre sommeil est léger.
  </p>
  <p>
    <strong>Les escaliers sont raides.</strong> Peu de riads ont un ascenseur. Avec une valise lourde,
    un genou fragile ou une poussette, la question mérite d'être posée avant de réserver.
  </p>
  <p>
    <strong>Le bassin n'est pas une piscine.</strong> Il rafraîchit, il ne permet pas de nager, et il
    est souvent à l'ombre l'après-midi. Si la baignade structure vos journées, regardez
    {' '}<a href={L('/ou-dormir-marrakech/')}>l'Hivernage ou la Palmeraie</a>.
  </p>

  <h2>Comment choisir la bonne maison</h2>
  <ol>
    <li><strong>La porte de rattachement.</strong> Un riad proche d'un grand bab — Doukkala, Laksour, Agnaou — s'atteint en trois minutes ; un riad au cœur du labyrinthe en demande dix.</li>
    <li><strong>La climatisation.</strong> Indispensable de juin à septembre, où la ville dépasse fréquemment 40 °C.</li>
    <li><strong>Le nombre de chambres.</strong> Quatre chambres donnent une maison privée ; douze donnent un petit hôtel.</li>
    <li><strong>Le service de porteur.</strong> Confirmez-le par écrit à la réservation.</li>
    <li><strong>Le petit-déjeuner en terrasse.</strong> Simple à vérifier, et c'est souvent le meilleur moment de la journée.</li>
  </ol>

  <h2>Nos fiches détaillées</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Riad</th><th>Notre angle</th><th>Fiche</th></tr>
      </thead>
      <tbody>
        {nos.map((n) => (
          <tr>
            <td><strong>{n.nom}</strong></td>
            <td>{n.angle}</td>
            <td><a href={L(n.href)}>Lire</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout">
    <span class="callout-label">Le bon compromis</span>
    <p>
      Si vous hésitez, réservez un riad dans le premier cercle de la médina, à proximité immédiate d'une
      grande porte. Vous gardez l'expérience — patio, terrasse, ruelles — en réduisant la marche
      d'approche à quelques minutes, ce qui règle l'essentiel des réserves formulées plus haut.
    </p>
  </div>

  <p class="small text-muted">
    Repères et conseils vérifiés en {PRICES_CHECKED}. Pour l'ensemble des quartiers, voyez
    {' '}<a href={L('/ou-dormir-marrakech/')}>où dormir à Marrakech</a> ; pour les grands hôtels,
    {' '}<a href={L('/meilleurs-hotels-marrakech/')}>notre sélection</a>.
  </p>
</HotelLayout>
