---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Marrakech → Agadir", href: L("/marrakech-agadir-transport/") },
  { name: "En voiture", href: L("/route-marrakech-agadir-en-voiture/") },
];

const toc = [
  { label: "Deux itinéraires", id: "itineraires" },
  { label: "L'autoroute A7", id: "autoroute" },
  { label: "Par le Tizi n'Test", id: "montagne" },
  { label: "Carburant, radars, contrôles", id: "pratique" },
  { label: "Étapes possibles", id: "etapes" },
  { label: "Louer et restituer", id: "location" },
];

const faqs = [
  { q: "Quelle est la distance entre Marrakech et Agadir ?", a: "Environ 250 kilomètres par l'autoroute A7, à parcourir en trois heures environ. Par la route de montagne du Tizi n'Test, le trajet est plus long et peut s'étendre à cinq ou six heures avec les arrêts." },
  { q: "Combien coûte le péage de l'autoroute ?", a: "Environ 100 MAD par sens pour une voiture particulière. Gardez des dirhams en petites coupures et vérifiez le mode de paiement à chaque barrière." },
  { q: "Est-il dangereux de rouler de nuit ?", a: "Pas sur l'autoroute, qui est bien entretenue. Sur les nationales et surtout en montagne, la nuit multiplie les difficultés : routes sans éclairage, virages, animaux, véhicules mal éclairés. Partez de façon à arriver avant la tombée du jour." },
  { q: "Peut-on prendre la route du Tizi n'Test avec une citadine ?", a: "Oui, par beau temps : c'est une route goudronnée, très sinueuse, culminant à plus de 2 000 mètres. Évitez-la après de fortes pluies ou de la neige, et par mauvaise visibilité. Vérifiez les conditions avant de partir et faites le plein avant de monter." },
  { q: "Que voir entre Marrakech et Agadir ?", a: "Par l'autoroute, peu de choses : c'est une route de transit. Par la montagne, la mosquée almohade de Tinmel, les villages du Haut Atlas et des paysages spectaculaires. Une escale à Taroudant, la « petite Marrakech » aux remparts ocre, vaut le détour." },
  { q: "Une voiture de location peut-elle être rendue à Agadir ?", a: "Certains loueurs proposent la restitution dans une autre ville, avec un supplément. Vérifiez à la réservation, car c'est une condition qu'on découvre rarement au comptoir." },
];
---
<GuideLayout
  keywords="route Marrakech Agadir, autoroute A7, Tizi n'Test, Tinmel, Taroudant"
  title={"Route Marrakech - Agadir : autoroute et étapes"}
  description={"Marrakech - Agadir en voiture : autoroute A7, péage, durée, radars, étapes, et l'itinéraire de montagne par le Tizi n'Test et la mosquée de Tinmel."}
  eyebrow={"Interville · Route Marrakech → Agadir"}
  h1={"Marrakech - Agadir en voiture"}
  lede={"L'autoroute fait le trajet en trois heures, la montagne en cinq ou six. Deux routes, deux voyages : voici laquelle choisir, ce qu'elle coûte et où s'arrêter."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-car-rental"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Comparer les loueurs du RAK", text: "Restitution à Agadir, caution, carburant : comparez avant de réserver.", provider: "discovercars", label: "Comparer les prix de location" }}
>
<h2 id="itineraires">Deux itinéraires</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Itinéraire</th><th>Distance</th><th>Durée</th><th>Caractère</th></tr></thead>
    <tbody>
      <tr class="row-highlight"><td><strong>Autoroute A7</strong></td><td class="num">≈ 250 km</td><td>≈ 3 h</td><td>Rapide, monotone, à péage</td></tr>
      <tr><td><strong>Tizi n'Test (par Taroudant)</strong></td><td class="num">≈ 300 km</td><td>5 à 6 h</td><td>Spectaculaire, montagne, sinueux</td></tr>
    </tbody>
  </table>
</div>

<h2 id="autoroute">L'autoroute A7</h2>
<p>
  C'est le choix évident si vous voulez arriver : deux fois deux voies, une chaussée en bon état, peu de
  circulation en dehors des week-ends et des départs en vacances. Le péage coûte environ 100 MAD par sens.
  Le paysage est celui d'un plateau aride, puis des contreforts de l'Atlas, et les aires de service
  sont espacées mais fournies. Vous y roulerez à 120 km/h maximum, avec des radars réguliers.
</p>

<h2 id="montagne">Par le Tizi n'Test</h2>
<p>
  La route de montagne, en direction de Taroudant, est l'une des plus belles du Maroc. Elle franchit le
  col du Tizi n'Test à plus de 2 000 mètres, en lacets serrés, avec des vues sur les vallées du Haut
  Atlas. Sur le parcours, la mosquée almohade de Tinmel, du XII<sup>e</sup> siècle, mérite un arrêt.
</p>
<div class="callout">
  <span class="callout-label">À ne pas faire</span>
  <p>
    Ne l'empruntez pas de nuit, ni par mauvais temps, ni si vous êtes pressé. La route est étroite,
    avec des à-pics sans glissière par endroits. Faites le plein avant de monter, et prévoyez de quoi
    manger : les points de ravitaillement sont rares.
  </p>
</div>

<h2 id="pratique">Carburant, radars, contrôles</h2>
<ul>
  <li><strong>Carburant :</strong> gasoil majoritaire ; stations fréquentes sur l'autoroute, rares en montagne.</li>
  <li><strong>Radars :</strong> nombreux, notamment aux entrées d'agglomération où la limite chute.</li>
  <li><strong>Contrôles :</strong> gendarmerie courtoise, permis, contrat et carte grise à présenter.</li>
  <li><strong>Péage :</strong> en dirhams, gardez de la monnaie.</li>
</ul>
<p>
  Tout est détaillé sur <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
</p>

<h2 id="etapes">Étapes possibles</h2>
<ul>
  <li><strong>Taroudant :</strong> une ville fortifiée aux remparts ocre, surnommée la « petite Marrakech », avec ses souks calmes.</li>
  <li><strong>Tinmel :</strong> la mosquée almohade sur la route du col, dans un cadre spectaculaire.</li>
  <li><strong>Essaouira :</strong> un détour côté Atlantique, voyez <a href={L('/excursion-marrakech-essaouira/')}>Marrakech - Essaouira</a>.</li>
</ul>

<h2 id="location">Louer et restituer</h2>
<p>
  Si vous louez à Marrakech pour rendre à Agadir, vérifiez que le loueur accepte la restitution en
  ville différente et quel supplément s'applique. Notre
  <a href={L('/louer-voiture-marrakech-guide/')}>guide de la location</a> détaille les conditions, et
  <a href={L('/marrakech-agadir-transport/')}>Marrakech - Agadir</a> compare la route aux autres options.
</p>
</GuideLayout>
