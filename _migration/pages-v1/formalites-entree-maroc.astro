---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Formalités d'entrée", href: L("/formalites-entree-maroc/") },
];

const toc = [
  { label: "Le passeport", id: "passeport" },
  { label: "Le visa", id: "visa" },
  { label: "Voyager avec des enfants", id: "mineurs" },
  { label: "À l'arrivée : la fiche de police", id: "fiche" },
  { label: "Douane et argent", id: "douane" },
  { label: "Santé et objets interdits", id: "sante" },
];

const faqs = [
  { q: "Ma carte d'identité suffit-elle pour aller au Maroc ?", a: "Non. Un ressortissant français doit présenter un passeport en cours de validité, même pour un court séjour. La carte nationale d'identité n'est pas acceptée pour entrer au Maroc." },
  { q: "Combien de temps mon passeport doit-il rester valide ?", a: "Il doit couvrir toute la durée du séjour. Par précaution, visez au moins six mois de validité restante : plusieurs compagnies exigent ce délai à l'embarquement, et refusent les passagers dont le passeport expire plus tôt." },
  { q: "Ai-je besoin d'un visa ?", a: "Non pour un séjour touristique de moins de 90 jours si vous êtes ressortissant de l'Union européenne, du Royaume-Uni, des États-Unis et de nombreux autres pays. Les conditions peuvent évoluer : vérifiez sur le site officiel du ministère des Affaires étrangères de votre pays avant de partir." },
  { q: "Un mineur peut-il voyager seul ?", a: "Un mineur français voyageant sans ses parents doit présenter une autorisation de sortie du territoire complétée et signée, une copie de la pièce d'identité du parent signataire, et son propre passeport. Chaque enfant a besoin de son propre passeport, y compris les bébés." },
  { q: "Peut-on rapporter ou emporter des dirhams ?", a: "L'importation et l'exportation de dirhams sont strictement limitées, voire interdites au-delà d'un faible montant : ne comptez pas en rapporter. Les devises étrangères en grosse quantité doivent être déclarées au-delà d'un seuil élevé. Retirez des dirhams à l'arrivée et dépensez-les avant de repartir." },
  { q: "Que faire de mes médicaments ?", a: "Emportez-les dans leur emballage d'origine avec l'ordonnance, pour ceux qui contiennent des substances contrôlées ou en cas de traitement long. Les stupéfiants sont strictement illégaux, y compris le cannabis, et les sanctions sont réelles." },
];
---
<GuideLayout
  keywords="formalités Maroc, passeport Maroc, visa Maroc, douane Maroc, fiche de police"
  title={"Formalités d'entrée au Maroc : passeport et visa"}
  description={"Entrer au Maroc depuis la France : passeport obligatoire (pas la carte d'identité), pas de visa pour 90 jours, fiche de police, mineurs et douane."}
  eyebrow={"Pratique · Formalités"}
  h1={"Formalités d'entrée au Maroc"}
  lede={"Un passeport valide, et c'est presque tout : pas de visa pour un séjour touristique de moins de 90 jours. Voici le détail pour les voyageurs français, et les points qui provoquent un refus d'embarquement."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["rak-arrivals"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Réservez votre transfert d'arrivée", text: "Formalités réglées, il reste à rejoindre la médina : prix fixe, chauffeur qui suit votre vol.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="passeport">Le passeport</h2>
<p>
  C'est le document obligatoire, sans alternative pour un Français : le <strong>passeport en cours de
  validité</strong>, valable pendant toute la durée du séjour. La carte nationale d'identité n'est pas
  acceptée à la frontière marocaine, même valide.
</p>
<div class="callout">
  <span class="callout-label">Le piège de la validité</span>
  <p>
    Le règlement marocain exige que le passeport couvre le séjour, mais beaucoup de compagnies appliquent
    une règle plus stricte : six mois de validité restante à l'entrée. Vérifiez la date d'expiration au
    moment de réserver votre vol, pas la veille. Un renouvellement prend plusieurs semaines.
  </p>
</div>

<h2 id="visa">Le visa</h2>
<p>
  Aucun visa n'est requis pour un séjour touristique de <strong>moins de 90 jours</strong> pour les
  ressortissants de l'Union européenne, et de nombreux autres pays. Au-delà, ou pour un séjour autre que
  touristique, une démarche spécifique est nécessaire. Ces règles peuvent évoluer : consultez, avant de
  partir, les conseils aux voyageurs du ministère des Affaires étrangères de votre pays.
</p>

<h2 id="mineurs">Voyager avec des enfants</h2>
<ul>
  <li><strong>Chaque enfant</strong> a son propre passeport, bébé compris.</li>
  <li><strong>Mineur voyageant sans ses parents</strong> (français) : autorisation de sortie du territoire, copie de la pièce d'identité du parent signataire, passeport.</li>
  <li><strong>Parent seul avec enfant</strong> : gardez un justificatif de l'autorité parentale et, si possible, un courrier de l'autre parent.</li>
</ul>
<p>
  Pour le voyage lui-même, voyez <a href={L('/marrakech-en-famille/')}>Marrakech en famille</a>.
</p>

<h2 id="fiche">À l'arrivée : la fiche de police</h2>
<p>
  Une fiche d'entrée vous sera demandée au contrôle des passeports. Elle est souvent distribuée à bord :
  remplissez-la pendant le vol, avec l'adresse complète de votre hébergement. Sans elle, vous devrez la
  remplir sur place et vous replacer dans la file. Le parcours complet est décrit sur
  <a href={L('/guide-aeroport-marrakech/arrivees/')}>arrivées au RAK</a>.
</p>

<h2 id="douane">Douane et argent</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Sujet</th><th>Ce qu'il faut savoir</th></tr></thead>
    <tbody>
      <tr><td><strong>Dirhams</strong></td><td>Import et export limités, voire interdits : retirez à l'arrivée, dépensez avant le départ</td></tr>
      <tr><td><strong>Devises</strong></td><td>Déclaration obligatoire au-delà d'un seuil élevé</td></tr>
      <tr><td><strong>Alcool, tabac</strong></td><td>Franchises limitées pour les adultes</td></tr>
      <tr><td><strong>Objets de valeur</strong></td><td>Ordinateur, appareil photo : effets personnels, sans formalité en général</td></tr>
      <tr><td><strong>Drones</strong></td><td>Interdits sans autorisation, confiscation possible</td></tr>
    </tbody>
  </table>
</div>
<p>
  Le détail du change et des retraits est sur <a href={L('/guide-aeroport-marrakech/services/')}>services de l'aéroport</a>.
</p>

<h2 id="sante">Santé et objets interdits</h2>
<ul>
  <li><strong>Vaccins :</strong> aucun n'est obligatoire pour entrer ; les vaccins de routine à jour sont recommandés.</li>
  <li><strong>Médicaments :</strong> dans leur emballage d'origine, avec l'ordonnance.</li>
  <li><strong>Stupéfiants :</strong> illégaux, y compris le cannabis. Les propositions de rue sont un piège.</li>
  <li><strong>Assurance :</strong> vérifiez que votre carte bancaire ou votre contrat couvre les frais médicaux à l'étranger.</li>
</ul>
<p>
  Pour la sécurité sur place, voyez <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>, et pour
  rester connecté, <a href={L('/esim-maroc/')}>eSIM Maroc</a>.
</p>
</GuideLayout>
