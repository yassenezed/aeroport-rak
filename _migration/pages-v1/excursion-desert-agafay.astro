---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Excursions", href: L("/que-faire-marrakech/") },
  { name: "Désert d'Agafay", href: L("/excursion-desert-agafay/") },
];

const toc = [
  { label: "Ce qu'est Agafay (et ce qu'il n'est pas)", id: "agafay" },
  { label: "Trois façons d'y aller", id: "formules" },
  { label: "Le dîner et la nuit en camp", id: "camp" },
  { label: "Le froid", id: "froid" },
  { label: "Quad, buggy, dromadaire", id: "activites" },
  { label: "Budget", id: "budget" },
];

const faqs = [
  { q: "Où se trouve le désert d'Agafay ?", a: "À environ 35 à 45 kilomètres au sud-ouest de Marrakech, soit quarante minutes à une heure de route, sur un plateau de cailloux et de collines argileuses, au pied de l'Atlas. C'est l'un des déserts les plus accessibles du Maroc depuis une grande ville." },
  { q: "Y a-t-il des dunes de sable à Agafay ?", a: "Non. C'est un désert de pierres, aux reliefs doux, pas un erg. Les grandes dunes se trouvent à Merzouga ou à Zagora, à plusieurs heures de route. Agafay convient pour un coucher de soleil, une nuit et des activités ; ceux qui veulent des dunes doivent prévoir un voyage plus long." },
  { q: "Combien coûte un dîner dans le désert d'Agafay ?", a: "Une formule coucher de soleil avec dîner, animations et transfert se situe en général entre 500 et 900 MAD par personne. Une nuit en tente de luxe peut aller de 1 500 à plus de 5 000 MAD selon le camp. Demandez ce qui est inclus : transfert, boissons, activités." },
  { q: "Fait-il froid la nuit à Agafay ?", a: "Oui, nettement, de novembre à mars : la nuit peut descendre autour de 5 °C, parfois moins, et même en été l'air se rafraîchit vite après le coucher du soleil. Emportez une veste chaude, quelle que soit la saison." },
  { q: "Peut-on aller à Agafay sans voiture ?", a: "Oui : la plupart des formules incluent un transfert depuis Marrakech, et les grands taxis assurent la liaison à un prix négocié. Sur place, la dernière portion se fait sur une piste courte. Un chauffeur privé est plus simple qu'une voiture de location." },
  { q: "Faut-il réserver à l'avance ?", a: "Oui, en particulier pour les nuits en camp, qui se remplissent tôt de février à mai et à l'automne. Pour un dîner, un jour ou deux suffisent hors haute saison." },
];
---
<GuideLayout
  keywords="désert Agafay, Agafay Marrakech, dîner désert Marrakech, camp Agafay, quad Agafay"
  title={"Désert d'Agafay depuis Marrakech : dîner, nuit, quad"}
  description={"Désert d'Agafay à 40 minutes de Marrakech : coucher de soleil, dîner, nuit en camp, quad. Ce qui le distingue du Sahara, prix et froid."}
  eyebrow={"Excursions · Désert d'Agafay"}
  h1={"Désert d'Agafay depuis Marrakech"}
  lede={"Un désert de cailloux et de collines douces à 40 minutes de la ville, un coucher de soleil sur l'Atlas et un ciel étoilé. Ce n'est pas le Sahara, et c'est justement son intérêt — à condition de savoir à quoi s'attendre."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["agafay-desert"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un chauffeur aller-retour", text: "Un transfert privé jusqu'au camp évite de conduire de nuit sur la piste : c'est le plus simple pour une soirée en désert.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="agafay">Ce qu'est Agafay (et ce qu'il n'est pas)</h2>
<p>
  Agafay est un plateau semi-aride au pied du Haut Atlas : cailloux ocre, collines douces, quelques arbustes
  et, au loin, les sommets. On l'appelle « désert » par commodité, et il en a l'aridité et la lumière.
  Ce qu'il n'a pas, ce sont les grandes dunes de sable — pour cela, il faut partir vers Merzouga ou Zagora,
  à plusieurs heures de route. Avec cette précision, Agafay tient ses promesses : des couleurs superbes
  au crépuscule, un silence profond et un ciel plein d'étoiles.
</p>

<h2 id="formules">Trois façons d'y aller</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Formule</th><th>Durée</th><th>Prix indicatif</th><th>Pour qui</th></tr></thead>
    <tbody>
      <tr><td><strong>Coucher de soleil + dîner</strong></td><td>4 à 5 h</td><td class="num">500–900 MAD</td><td>Le plus courant, sans nuit sur place</td></tr>
      <tr><td><strong>Journée avec activités</strong></td><td>6 à 8 h</td><td class="num">600–1 200 MAD</td><td>Quad, buggy, dromadaire, déjeuner</td></tr>
      <tr class="row-highlight"><td><strong>Nuit en camp</strong></td><td>Nuit complète</td><td class="num">1 500–5 000+ MAD</td><td>Étoiles, calme, expérience complète</td></tr>
    </tbody>
  </table>
</div>

<h2 id="camp">Le dîner et la nuit en camp</h2>
<p>
  Le programme type : arrivée en fin d'après-midi, thé à la menthe, coucher de soleil depuis une
  terrasse ou à dos de dromadaire, puis dîner sous tente avec musique berbère ou gnaoua. Les camps
  vont de la simple tente commune aux suites climatisées avec piscine. Renseignez-vous sur la
  configuration, car l'écart de prestation et de prix est considérable.
</p>
<div class="callout">
  <span class="callout-label">Lire les avis récents</span>
  <p>
    La qualité varie fortement d'un camp à l'autre. Regardez les avis des six derniers mois, la
    présence d'un vrai chauffage l'hiver, la taille du groupe et la distance à la ville. Un camp sur
    une piste isolée est plus dépaysant, mais plus long d'accès.
  </p>
</div>

<h2 id="froid">Le froid</h2>
<p>
  C'est l'erreur des visiteurs : le désert refroidit vite. De novembre à mars, les nuits tombent autour de
  5 °C ; au printemps et à l'automne, elles sont fraîches ; même en été, l'air se rafraîchit nettement
  après le coucher du soleil. Emportez une veste chaude, un pull et des chaussures fermées, et
  demandez à votre camp si les tentes sont chauffées.
</p>

<h2 id="activites">Quad, buggy, dromadaire</h2>
<p>
  Les pistes se prêtent aux sorties en quad ou en buggy, encadrées par un guide, et aux balades en
  dromadaire au coucher du soleil. Détails, prix et règles de sécurité sur
  <a href={L('/balade-chameau-quad-marrakech/')}>chameau, quad et buggy</a>. Certains camps proposent aussi
  un vol en montgolfière à l'aube, à réserver à l'avance.
</p>

<h2 id="budget">Budget</h2>
<p>
  Le poste principal est l'hébergement en camp, qui va de quelques centaines à plusieurs milliers de
  dirhams. Un dîner avec transfert reste à un tarif raisonnable. La route se fait en voiture privée
  (400 à 500 MAD la course) ou avec un tour organisé, comme le montre notre
  <a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix</a>. Pour composer un séjour complet,
  consultez <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>.
</p>
</GuideLayout>
