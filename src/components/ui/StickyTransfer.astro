---
import { getLocalizedPath, defaultLang, type Lang } from '../../i18n';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const href = getLocalizedPath('/reserver-transfert/', lang);

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') ? currentPath : currentPath + '/';

const t = {
  title: "Besoin d'un transfert ?",
  sub: "Trajet direct et fiable jusqu'à votre hôtel ou riad",
  btn: 'Réserver'
};

const showWidget = normalizedPath !== href;
---

{showWidget && (
<div class="floating-cta-widget" id="transferWidget">
  <button class="close-btn" aria-label="Close" onclick="document.getElementById('transferWidget').style.display='none'">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  
  <div class="widget-content">
    <div class="text-area">
      <div class="widget-title">{t.title}</div>
      <div class="widget-sub">{t.sub}</div>
    </div>
    
    <a href={href} class="widget-btn">
      {t.btn}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</div>
)}

<style>
  .floating-cta-widget {
    position: fixed;
    left: 0; right: 0; bottom: 0;
    z-index: 90;
    background: var(--ink);
    border-top: 2px solid var(--saffron);
    padding: 0.7rem 1.25rem;
    display: flex;
    justify-content: center;
  }
  .widget-content {
    width: 100%;
    max-width: var(--container);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .text-area { display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap; min-width: 0; }
  .widget-title { font-family: var(--font-display); font-weight: 600; font-size: 1.02rem; color: #fff; }
  .widget-sub { font-size: 0.85rem; color: rgba(255,255,255,0.6); }
  .widget-btn {
    flex: none;
    display: inline-flex; align-items: center; gap: 0.45rem;
    background: var(--blue); color: #fff;
    font-family: var(--font-body); font-weight: 700; font-size: 0.9rem;
    padding: 0.62rem 1.2rem; border-radius: var(--r-md);
    text-decoration: none;
    transition: background var(--transition);
  }
  .widget-btn:hover { background: var(--blue-dark); color: #fff; }
  .close-btn {
    position: absolute; top: 0.3rem; right: 0.5rem;
    background: none; border: none; cursor: pointer;
    color: rgba(255,255,255,0.4); padding: 0.15rem; line-height: 0;
  }
  .close-btn:hover { color: #fff; }
  .close-btn svg { width: 15px; height: 15px; }

  @media (max-width: 620px) {
    .floating-cta-widget { padding: 0.6rem 1rem; }
    .widget-content { gap: 0.75rem; }
    .widget-sub { display: none; }
    .widget-title { font-size: 0.93rem; }
    .widget-btn { padding: 0.55rem 0.95rem; font-size: 0.85rem; }
  }
</style>
