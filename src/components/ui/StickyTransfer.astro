---
import { getLocalizedPath, defaultLang, type Lang } from '../../i18n';
import Icon from './Icon.astro';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const href = getLocalizedPath('/reserver-transfert/', lang);

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') ? currentPath : currentPath + '/';

const t = {
  title: "Besoin d'un transfert ?",
  sub: "Trajet direct et fiable jusqu'\u00e0 votre h\u00f4tel ou riad",
  btn: 'R\u00e9server'
};

const showWidget = normalizedPath !== href;
---

{showWidget && (
<div class="floating-cta-widget" id="transferWidget">
  <button class="close-btn" aria-label="Close" onclick="document.getElementById('transferWidget').style.display='none'">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
  </button>
  
  <div class="widget-content">
    <div class="text-area">
      <div class="widget-title">{t.title}</div>
      <div class="widget-sub">{t.sub}</div>
    </div>
    
    <a href={href} class="widget-btn">
      {t.btn}
      <Icon name="arrow-right" size={18} />
    </a>
  </div>
</div>
)}

<style>
  .floating-cta-widget {
    position: fixed;
    bottom: 24px;
    left: 0;
    right: 0;
    margin: 0 auto;
    background-color: var(--green-dark);
    color: white;
    padding: 16px 32px 16px 20px;
    border-radius: 12px;
    box-shadow: 0 10px 25px rgba(13, 114, 86, 0.35);
    z-index: 999999;
    width: 90%;
    max-width: 500px;
    display: flex;
    flex-direction: column;
    animation: fadeInWidget 0.5s ease-out forwards;
  }
  
  @keyframes fadeInWidget {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .close-btn {
    position: absolute;
    top: 6px;
    right: 6px;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    cursor: pointer;
    padding: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    transition: background 0.2s, color 0.2s;
  }
  .close-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .widget-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .text-area {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .widget-title {
    font-weight: 700;
    font-size: 1.1rem;
    font-family: var(--font-display);
    line-height: 1.2;
    color: white;
  }

  .widget-sub {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.3;
  }

  .widget-btn {
    background-color: white;
    color: var(--green-dark);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    display: flex;
    align-items: center;
    gap: 6px;
    transition: background-color 0.2s, transform 0.2s;
    white-space: nowrap;
  }
  .widget-btn:hover {
    background-color: var(--cream);
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .floating-cta-widget {
      bottom: 0;
      width: 100%;
      max-width: 100%;
      border-radius: 20px 20px 0 0;
      padding: 20px 16px;
    }
    .widget-content {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
    .widget-btn {
      width: 100%;
      justify-content: center;
      padding: 10px;
      font-size: 1.05rem;
    }
  }
</style>
