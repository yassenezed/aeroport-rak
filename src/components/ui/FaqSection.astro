---
import SchemaFAQ from '../seo/SchemaFAQ.astro';
export interface FAQ { q: string; a: string; }
interface Props { faqs: FAQ[]; heading?: string; }
const { faqs, heading } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq-section">
    {heading && <h2>{heading}</h2>}
    <div class="faq-list">
      {faqs.map((f) => (
        <details class="faq-item">
          <summary>{f.q}</summary>
          <div class="faq-body" set:html={f.a} />
        </details>
      ))}
    </div>
    <SchemaFAQ faqs={faqs} />
  </section>
)}
<style>.faq-section h2 { margin-bottom: 1rem; }</style>
