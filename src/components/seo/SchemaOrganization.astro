---
import { site } from '../../data/site';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': `${site.url}/#organization`,
  name: site.name,
  url: site.url,
  logo: `${site.url}${site.logo}`,
  description: site.description.fr,
  sameAs: [],
};
---
<script type="application/ld+json" set:html={JSON.stringify(schema)} />
