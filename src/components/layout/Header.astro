---
// Navigation calquée sur celle d'aeroportcmn.com : 10 entrées, 4 menus
// déroulants, sélecteur de langue. Différence importante : chaque langue est
// rendue côté serveur au lieu d'être permutée en JavaScript, ce qui permet à
// Google de voir la bonne langue dans le HTML livré.
import { useTranslations, pathFor, alternatesFor, LOCALE_NAMES, LOCALES, type Locale, type RouteKey } from '../../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey | string;
}
const { locale, routeKey } = Astro.props;
const t = useTranslations(locale);
const P = (key: string) => pathFor(key, locale);

const nav = [
  { key: 'home', label: t('nav.home') },
  { key: 'arrivals', label: t('nav.arrivals') },
  { key: 'departures', label: t('nav.departures') },
  { key: 'destinations', label: t('nav.destinations') },
  {
    key: 'services', label: t('nav.services'),
    children: [
      { key: 'flights', label: t('nav.flights') },
      { key: 'esim', label: t('nav.esim') },
      { key: 'compensation', label: t('nav.compensation') },
      { key: 'tourGuide', label: t('nav.tourGuide') },
    ],
  },
  {
    key: 'transfers', label: t('nav.transfers'),
    children: [{ key: 'bookTransfer', label: t('nav.bookTransfer') }],
  },
  {
    key: 'carRental', label: t('nav.carRental'),
    children: [
      { key: 'carBudget', label: t('nav.carBudget') },
      { key: 'carLuxury', label: t('nav.carLuxury') },
      { key: 'carMinivan', label: t('nav.carMinivan') },
      { key: 'carEasy', label: t('nav.carEasy') },
    ],
  },
  { key: 'parking', label: t('nav.parking') },
  {
    key: 'hotels', label: t('nav.hotels'),
    children: [
      { key: 'mamounia', label: 'La Mamounia' },
      { key: 'mansour', label: 'Royal Mansour' },
      { key: 'essaadi', label: 'Es Saadi' },
      { key: 'yasmine', label: 'Riad Yasmine' },
      { key: 'riadbe', label: 'Riad BE' },
    ],
  },
  { key: 'blogIndex', label: t('nav.blog') },
];

// Le sélecteur pointe vers la traduction de la page courante, pas vers l'accueil.
const alternates = alternatesFor(routeKey);
const current = Astro.url.pathname;
const isActive = (key: string) => {
  const p = pathFor(key, locale);
  return p === current || (p !== pathFor('home', locale) && current.startsWith(p));
};
---

<div class="disclaimer-bar">
  <div class="container"><p>{t('site.disclaimer')}</p></div>
</div>

<header class="header">
  <div class="container header__inner">
    <a href={P('home')} class="header__logo" aria-label="AirportRAK">
      <img src="/logo.png" alt="AirportRAK — Marrakech Menara Airport" width="1000" height="187" />
    </a>

    <button class="header__toggle" aria-label={t('nav.menu')} aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span><span></span>
    </button>

    <nav class="nav" id="site-nav" aria-label={t('nav.menu')}>
      <ul class="nav__list">
        {nav.map((item) => (
          <li class:list={['nav__item', { 'nav__item--dropdown': !!item.children }]}>
            <a href={P(item.key)} class:list={['nav__link', { 'is-active': isActive(item.key) }]}>
              {item.label}
              {item.children && (
                <svg class="nav__caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              )}
            </a>
            {item.children && (
              <ul class="nav__submenu">
                {item.children.map((child) => (
                  <li><a href={P(child.key)} class:list={['nav__sublink', { 'is-active': isActive(child.key) }]}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        ))}

        <li class="nav__item nav__item--dropdown nav__item--lang">
          <button class="nav__link nav__link--lang" aria-haspopup="true" aria-expanded="false">
            <span class="nav__lang-code">{locale.toUpperCase()}</span>
            <svg class="nav__caret" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
          </button>
          <ul class="nav__submenu nav__submenu--lang">
            {alternates.map(({ locale: l, path }) => (
              <li>
                <a href={path} hreflang={l} lang={l} class:list={['nav__sublink', { 'is-active': l === locale }]}>
                  <span class="nav__lang-code">{l.toUpperCase()}</span> {LOCALE_NAMES[l]}
                </a>
              </li>
            ))}
          </ul>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector('.header__toggle');
  const nav = document.getElementById('site-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', String(!!open));
  });

  // Sur mobile, un premier appui sur une rubrique à sous-menu la déplie.
  document.querySelectorAll('.nav__item--dropdown > .nav__link').forEach((link) => {
    link.addEventListener('click', (e) => {
      if (window.innerWidth <= 1100) {
        const li = link.closest('.nav__item');
        if (li && !li.classList.contains('is-open')) {
          e.preventDefault();
          document.querySelectorAll('.nav__item.is-open').forEach((o) => o !== li && o.classList.remove('is-open'));
          li.classList.add('is-open');
        }
      }
    });
  });

  // Menu de langue au clic (desktop comme mobile).
  const langBtn = document.querySelector('.nav__link--lang');
  langBtn?.addEventListener('click', (e) => {
    e.preventDefault();
    const li = langBtn.closest('.nav__item');
    const open = li?.classList.toggle('is-open');
    langBtn.setAttribute('aria-expanded', String(!!open));
  });
  document.addEventListener('click', (e) => {
    if (!(e.target as HTMLElement).closest('.nav__item--lang')) {
      document.querySelector('.nav__item--lang')?.classList.remove('is-open');
    }
  });
</script>
