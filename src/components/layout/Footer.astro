---
import { useTranslations, getLocalizedPath, defaultLang, type Lang } from '../../i18n';
import Icon from '../ui/Icon.astro';

interface Props { lang?: Lang; }
const { lang = defaultLang } = Astro.props;
const t = useTranslations(lang);
const year = 2026;

const columns = [
  {
    heading: t('footer.transfersHeading'),
    links: [
      ['/transfert-aeroport-marrakech/', t('nav.transfers')],
      ['/taxi-aeroport-marrakech/', t('nav.taxi')],
      ['/transfert-prive-aeroport-marrakech/', 'Transfert privé'],
      ['/meilleur-transfert-aeroport-marrakech/', 'Meilleur transfert'],
      ['/transfert-aeroport-marrakech-medina/', t('nav.toMedina')],
      ['/transfert-aeroport-marrakech-essaouira/', t('nav.toEssaouira')],
    ],
  },
  {
    heading: t('footer.carHotelHeading'),
    links: [
      ['/location-voiture-aeroport-marrakech/', t('nav.carRental')],
      ['/location-voiture-aeroport-marrakech/pas-cher/', 'Location pas chère'],
      ['/hotels-pres-aeroport-marrakech/', 'Hôtels près du RAK'],
      ['/riads-medina-marrakech/', t('nav.riadsMedina')],
      ['/ou-dormir-marrakech/', t('nav.whereToStay')],
    ],
  },
  {
    heading: t('footer.guideHeading'),
    links: [
      ['/guide-aeroport-marrakech/', t('nav.guide')],
      ['/guide-aeroport-marrakech/arrivees/', t('nav.arrivals')],
      ['/guide-aeroport-marrakech/uber-taxi/', t('nav.uberTaxi')],
      ['/destinations-aeroport-marrakech/', t('nav.destinations')],
      ['/que-faire-marrakech/', t('nav.thingsToDo')],
      ['/vols-marrakech/', t('nav.flights')],
    ],
  },
  {
    heading: t('footer.legalHeading'),
    links: [
      ['/a-propos/', t('footer.aboutLink')],
      ['/divulgation-affiliation/', t('footer.disclosureLink')],
      ['/contact/', t('footer.contactLink')],
      ['/politique-confidentialite/', t('footer.privacyLink')],
      ['/credits-photos/', 'Crédits photos'],
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="brand-name">Airport<strong>RAK</strong></span>
        <p class="footer-tagline">{t('footer.tagline')}</p>
      </div>
      <div class="footer-cols">
        {columns.map((col) => (
          <div class="footer-col">
            <h3>{col.heading}</h3>
            <ul>
              {col.links.map(([href, label]) => (
                <li><a href={getLocalizedPath(href, lang)}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="footer-disclosure">
      <Icon name="info" size={16} />
      <span>{t('footer.disclosureShort')}</span>
    </div>

    <div class="footer-bottom">
      <span>© {year} {t('site.name')}. {t('footer.rights')}</span>
      <span class="footer-iata">Marrakech Ménara · RAK · Maroc</span>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--ink); color: #cfd0c4; padding-block: 3rem 1.5rem; margin-top: 3rem; }
  .footer-top { display: grid; grid-template-columns: 1.3fr 3fr; gap: 2.5rem; }
  .footer-brand .brand-name { font-family: var(--font-display); font-weight: 500; font-size: 1.4rem; color: #fff; }
  .footer-brand .brand-name strong { color: var(--yellow); font-weight: 700; }
  .footer-tagline { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.6; color: #a3a499; max-width: 40ch; }
  .footer-cols { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; }
  .footer-col h3 { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.07em; color: #fff; margin-bottom: 0.8rem; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.5rem; }
  .footer-col a { color: #cfd0c4; text-decoration: none; font-size: 0.92rem; }
  .footer-col a:hover { color: var(--orange); }
  .footer-disclosure {
    display: flex; gap: 0.5rem; align-items: flex-start;
    margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid #3a3a35;
    font-size: 0.84rem; color: #9a9b90;
  }
  .footer-disclosure svg { flex: none; margin-top: 2px; color: var(--yellow); }
  .footer-bottom { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0.5rem; margin-top: 1.25rem; font-size: 0.82rem; color: #86877d; }
  @media (max-width: 820px) {
    .footer-top { grid-template-columns: 1fr; gap: 1.75rem; }
    .footer-cols { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 480px) { .footer-cols { grid-template-columns: 1fr; } }
</style>
