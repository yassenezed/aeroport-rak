---
// Footer calqué sur celui d'aeroportcmn.com : bloc marque + trois colonnes
// (à l'aéroport / se déplacer / à propos) + barre légale.
import { useTranslations, pathFor, type Locale } from '../../i18n';
import { site } from '../../data/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useTranslations(locale);
const P = (key: string) => pathFor(key, locale);
const year = new Date().getFullYear();

const columns = [
  {
    title: t('footer.airport'),
    links: [
      ['arrivals', t('nav.arrivals')],
      ['departures', t('nav.departures')],
      ['flights', t('nav.flights')],
      ['destinations', t('nav.destinations')],
      ['airportGuide', t('nav.airportGuide')],
    ],
  },
  {
    title: t('footer.getAround'),
    links: [
      ['transfers', t('nav.transfers')],
      ['bookTransfer', t('nav.bookTransfer')],
      ['carRental', t('nav.carRental')],
      ['parking', t('nav.parking')],
      ['hotels', t('nav.hotels')],
    ],
  },
  {
    title: t('footer.about'),
    links: [
      ['about', t('footer.about')],
      ['contact', t('legal.contact')],
      ['blogIndex', t('nav.blog')],
      ['disclosure', t('legal.disclosure')],
      ['privacy', t('legal.privacy')],
    ],
  },
];
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a href={P('home')} class="site-footer__logo" aria-label="AirportRAK">
          <img src="/logo.png" alt={t('common.logoAlt')} width="1000" height="187" loading="lazy" />
        </a>
        <p class="site-footer__tagline">{t('footer.tagline')}</p>
      </div>

      <div class="site-footer__cols">
        {columns.map((col) => (
          <div class="site-footer__col">
            <h3>{col.title}</h3>
            <ul>
              {col.links.map(([key, label]) => (
                <li><a href={P(key as string)}>{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <p class="site-footer__disclosure">{t('footer.disclosure')}</p>

    <div class="site-footer__bottom">
      <span>© {year} {site.name}. {t('footer.rights')}</span>
      <nav class="site-footer__legal" aria-label="Legal">
        <a href={P('privacy')}>{t('legal.privacy')}</a>
        <a href={P('terms')}>{t('legal.terms')}</a>
        <a href={P('disclosure')}>{t('legal.disclosure')}</a>
        <a href={P('contact')}>{t('legal.contact')}</a>
      </nav>
      <span class="site-footer__iata">Marrakech Ménara · RAK · GMMX</span>
    </div>
  </div>
</footer>
