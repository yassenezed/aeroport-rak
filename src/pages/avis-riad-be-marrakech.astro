---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
import { photos } from '../data/images';

const t = useTranslations('fr');
const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Riad BE', href: L('/avis-riad-be-marrakech/') },
];
---
<HotelReviewLayout
  title={`Riad BE Marrakech : notre avis et l'accès depuis l'aéroport | AirportRAK`}
  description={`Notre regard sur Riad BE : l'esprit riad dans une lecture contemporaine, à Bab Doukkala, l'un des accès les plus commodes de la médina depuis l'aéroport de Marrakech.`}
  h1={`Riad BE Marrakech : notre avis et l'accès depuis l'aéroport`}
  subtitle={`L'expérience médina, par la porte la plus commode`}
  breadcrumbs={breadcrumbs}
  brand={`Riad BE Marrakech`}
  rating={4.3}
  verdict={`Le bon compromis pour un premier séjour en riad : patio, bassin et terrasse, mais à Bab Doukkala, l'un des accès les plus simples de la médina pour qui arrive avec des bagages.`}
  priceAvg={`Moyen`}
  address={`Médina, secteur Bab Doukkala`}
  stars={`★★★★`}
  ratingText={`Très bien`}
  heroImage={photos['riad-be-marrakech']}
  ctaLink={L('/ou-dormir-marrakech/')}
  ctaLabel={`Comparer les disponibilités`}
  faqs={[
    { q: "Où se trouve le Riad BE Marrakech ?", a: "Dans la médina, dans le secteur de Bab Doukkala, au nord-ouest. C'est l'un des accès les plus pratiques de la médina : la porte est largement accessible en voiture et la marche jusqu'au riad reste courte." },
    { q: "Quelle porte indiquer au chauffeur ?", a: "Bab Doukkala, dans la très grande majorité des cas. Confirmez tout de même auprès du riad au moment de la réservation : c'est l'information qui évite d'être déposé du mauvais côté de la médina." },
    { q: "Le Riad BE a-t-il une piscine ?", a: "Les riads de cette catégorie disposent généralement d'un bassin de patio, dimensionné pour se rafraîchir plutôt que pour nager, et d'une terrasse sur le toit. Vérifiez les équipements exacts au moment de réserver, car ils varient d'une maison à l'autre." },
    { q: "Peut-on laisser ses bagages le jour du départ ?", a: "Oui, c'est un service standard dans les riads et il est gratuit. C'est particulièrement utile à Marrakech, où l'aéroport ne propose pas de consigne fiable : vous libérez la chambre, vous visitez, et vous repassez prendre vos valises avant le transfert." }
  ]}
>
  <div class="content-block">
    <h2>Ce que c'est</h2>
    <p>
      Riad BE appartient à cette génération de maisons d'hôtes de la médina qui ont gardé la structure
      traditionnelle — patio, bassin, terrasse — en y appliquant une lecture contemporaine : lignes
      épurées, couleurs sobres, confort actuel. Son secteur, autour de Bab Doukkala, est l'un des plus
      commodes de la médina pour qui arrive avec des bagages.
    </p>

    <h3>Pourquoi on le retient</h3>
    <ul class="pros-list">
      <li>Un accès parmi les plus simples de la médina, par une grande porte carrossable.</li>
      <li>L'esthétique riad sans l'austérité : décoration soignée et confort contemporain.</li>
      <li>Une terrasse exploitable, précieuse en fin de journée.</li>
      <li>Proximité immédiate des souks et de Dar el Bacha, à pied.</li>
    </ul>

    <h2>L'accès depuis l'aéroport</h2>
    <p>
      Comptez 15 à 30 minutes de route jusqu'à Bab Doukkala, puis une courte marche. C'est justement
      l'intérêt du secteur : la porte est large, bien desservie et facilement identifiable par n'importe
      quel chauffeur, ce qui n'est pas le cas de tous les accès de la médina. Demandez malgré tout un
      porteur si vous arrivez de nuit ou avec de grosses valises — voyez
      <a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>.
    </p>

    <h2>Pour qui</h2>
    <p>
      Pour un premier séjour en riad : vous obtenez l'expérience de la médina — le calme derrière une
      porte cloutée, le patio, la terrasse — sans le parcours d'obstacles d'un derb profond. C'est le
      compromis que nous recommandons à ceux qui hésitent entre riad et hôtel.
    </p>

    <h2>À savoir avant de réserver</h2>
    <p>
      Comme dans tous les riads, le nombre de chambres est limité et les équipements varient : vérifiez
      la présence d'une climatisation efficace si vous venez entre juin et septembre, et l'existence
      d'un ascenseur si les escaliers posent problème. Pour l'ensemble de nos sélections, voyez
      <a href={L('/riads-medina-marrakech/')}>riads dans la médina</a> et
      <a href={L('/meilleurs-hotels-marrakech/')}>meilleurs hôtels de Marrakech</a>.
    </p>
  </div>
</HotelReviewLayout>
