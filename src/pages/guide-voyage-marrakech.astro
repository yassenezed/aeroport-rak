---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Guide de voyage", href: L("/guide-voyage-marrakech/") },
];

const toc = [
  { label: "Pourquoi Marrakech", id: "pourquoi" },
  { label: "Quand partir", id: "quand" },
  { label: "Y aller et arriver", id: "arriver" },
  { label: "Où dormir", id: "dormir" },
  { label: "Se déplacer", id: "deplacer" },
  { label: "Que faire", id: "faire" },
  { label: "Manger", id: "manger" },
  { label: "Argent et budget", id: "argent" },
  { label: "Langue et étiquette", id: "langue" },
  { label: "Pratique : électricité, réseau, heure", id: "pratique" },
  { label: "Sécurité", id: "securite" },
];

const faqs = [
  { q: "Faut-il un visa pour aller à Marrakech ?", a: "Pas pour un séjour touristique de moins de 90 jours si vous êtes ressortissant de l'Union européenne. Il faut en revanche un passeport valide pendant tout le séjour — la carte d'identité ne suffit pas. Voir formalités d'entrée." },
  { q: "Quelle monnaie utilise-t-on à Marrakech ?", a: "Le dirham marocain (MAD). Il ne se rapporte pas depuis l'étranger et ne s'achète pas avant de partir : retirez à l'arrivée. Comptez environ 10,8 à 11 MAD pour 1 €. Les espèces dominent dans la médina, la carte est acceptée dans les hôtels et les grandes enseignes." },
  { q: "Quelle est la meilleure période pour visiter Marrakech ?", a: "Mars-avril et octobre-novembre pour le climat, janvier et juillet-août pour les prix. Voir notre page quand partir pour le calendrier détaillé." },
  { q: "Combien de jours pour visiter Marrakech ?", a: "Trois jours pour la médina, un jardin et une demi-journée en dehors, cinq pour ajouter l'Ourika ou Essaouira. Un week-end de deux jours permet l'essentiel." },
  { q: "Marrakech est-elle chère ?", a: "Pas pour se déplacer, manger simplement ou visiter : ces postes restent modérés. Le budget grimpe avec l'hébergement, les expériences hors de la ville et les achats en souk. Un séjour confortable se situe autour de 80 à 150 € par personne et par jour, tout compris." },
  { q: "Peut-on visiter Marrakech sans parler arabe ni français ?", a: "Oui. Dans le tourisme, le français, l'anglais et souvent l'espagnol sont couramment parlés. Quelques mots de darija — merci, non merci, combien — sont appréciés et changent le ton des échanges." },
];
---
<GuideLayout
  keywords="guide voyage Marrakech, préparer son voyage Marrakech, budget Marrakech, dirham, visa Maroc"
  title={"Guide de voyage Marrakech 2026 : tout savoir avant de partir | AirportRAK"}
  description={"Le guide pratique de Marrakech : quand partir, comment y aller, où dormir, que faire, budget par jour, argent et dirham, langue et étiquette, électricité, connexion, sécurité et liens vers tous nos guides."}
  eyebrow={"Marrakech · Guide de voyage"}
  h1={"Guide de voyage Marrakech"}
  lede={"Douze questions, douze réponses, pour préparer un séjour à Marrakech sans mauvaise surprise : arriver, dormir, circuler, manger, payer, et savoir à qui se fier."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["travel-guide-marrakech"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Réservez l'arrivée, le reste suit", text: "Un transfert à prix fixe vers votre riad ou votre hôtel, avec chauffeur qui suit votre vol : la première décision qui simplifie tout.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="pourquoi">Pourquoi Marrakech</h2>
<p>
  Marrakech réunit ce que peu de villes proposent ensemble : une médina classée par l'UNESCO depuis
  1985, une place de spectacle vivant ouverte toute l'année, un climat presque toujours ensoleillé, les
  sommets de l'Atlas à une heure de route et le désert à quarante minutes. Elle est à moins de quatre
  heures de vol de l'essentiel de l'Europe de l'Ouest, et son aéroport est l'un des rares grands
  aéroports à six kilomètres seulement d'un centre historique.
</p>
<p>
  C'est aussi une ville exigeante : sollicitations, chaleur, ruelles labyrinthiques. Bien préparée, elle
  se révèle généreuse. Voici les points qui font la différence.
</p>

<h2 id="quand">Quand partir</h2>
<p>
  <strong>Mars, avril, octobre et novembre</strong> sont les plus agréables : 22 à 28 °C, ciel bleu, nuits
  douces. <strong>Juillet et août</strong> dépassent régulièrement 38 °C mais offrent les prix les plus
  bas. <strong>L'hiver</strong> est doux le jour, frais la nuit. Le détail est sur
  <a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a> et
  <a href={L('/marrakech-en-hiver/')}>Marrakech en hiver</a>.
</p>

<h2 id="arriver">Y aller et arriver</h2>
<p>
  Les vols directs relient Marrakech à des dizaines de villes européennes, avec une concurrence vive qui
  tire les prix vers le bas : voyez <a href={L('/vols-marrakech/')}>vols pour Marrakech</a> et
  <a href={L('/vols-marrakech/pas-chers/')}>vols pas chers</a>. Le passeport est obligatoire : consultez
  <a href={L('/formalites-entree-maroc/')}>formalités d'entrée</a>.
</p>
<p>
  À l'arrivée, l'aéroport est à 6 km de la médina. Quatre façons de rejoindre la ville — transfert
  réservé, taxi, bus 19, location — détaillées dans
  <a href={L('/guide-aeroport-marrakech/')}>le guide de l'aéroport</a> et
  <a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport</a>. Retenez surtout qu'aucune voiture
  n'entre dans la médina : la dépose se fait à une porte.
</p>

<h2 id="dormir">Où dormir</h2>
<p>
  Le quartier décide de votre séjour. Un <a href={L('/riads-medina-marrakech/')}>riad en médina</a> offre
  l'immersion, avec une arrivée à pied ; Guéliz et l'Hivernage offrent le confort pratique ; la
  Palmeraie, l'espace et la piscine. Comparaison complète sur
  <a href={L('/ou-dormir-marrakech/')}>quel quartier pour dormir</a>, et nos adresses sur
  <a href={L('/meilleurs-hotels-marrakech/')}>meilleurs hôtels</a>.
</p>

<h2 id="deplacer">Se déplacer</h2>
<p>
  À pied dans la médina, en petit taxi ensuite — courses de 15 à 50 MAD en ville, compteur ou prix fixé
  avant de partir. Les applications de VTC existent mais restent aléatoires. Voyez
  <a href={L('/se-deplacer-marrakech/')}>se déplacer à Marrakech</a>. Une voiture ne sert que pour les
  excursions : <a href={L('/location-voiture-aeroport-marrakech/')}>location au RAK</a>.
</p>

<h2 id="faire">Que faire</h2>
<p>
  Le cœur, c'est la <a href={L('/medina-marrakech/')}>médina</a>, la place
  <a href={L('/jemaa-el-fna/')}>Jemaa el-Fna</a> et les souks. Autour, les jardins, les musées, le hammam,
  la cuisine. Plus loin, la <a href={L('/excursion-vallee-ourika/')}>vallée de l'Ourika</a>, le
  <a href={L('/excursion-desert-agafay/')}>désert d'Agafay</a>, les
  <a href={L('/excursion-cascades-ouzoud/')}>cascades d'Ouzoud</a> et
  <a href={L('/excursion-marrakech-essaouira/')}>Essaouira</a>. Idées et parcours sur
  <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>.
</p>

<h2 id="manger">Manger</h2>
<p>
  Tanjia, tajine, pastilla, méchoui : la cuisine marrakchie est riche. Des stands de rue à 30-60 MAD
  aux tables de palace, tout existe. Voyez <a href={L('/restaurants-marrakech/')}>où manger à
  Marrakech</a>. Et pour les souvenirs : <a href={L('/shopping-souvenirs-marrakech/')}>souks et
  shopping</a>.
</p>

<h2 id="argent">Argent et budget</h2>
<p>
  Le dirham est une devise fermée : retirez à l'arrivée, aux distributeurs du hall ou en ville, et
  gardez des coupures de 50 et 100 MAD. La carte fonctionne dans les hôtels et grandes enseignes, mais
  les espèces règnent en médina. Repère : 1 € vaut environ 10,8 à 11 MAD.
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Style de voyage</th><th>Budget par jour et par personne (tout compris)</th></tr></thead>
    <tbody>
      <tr><td><strong>Économique</strong> — auberge ou petit riad, cuisine de rue, bus et taxis</td><td class="num">30 – 50 €</td></tr>
      <tr class="row-highlight"><td><strong>Confortable</strong> — riad ou hôtel de charme, restaurants, une excursion</td><td class="num">80 – 150 €</td></tr>
      <tr><td><strong>Haut de gamme</strong> — palace ou riad de luxe, expériences privées</td><td class="num">250 € et plus</td></tr>
    </tbody>
  </table>
</div>
<p class="small text-muted">Ordres de grandeur, hors vol. L'hébergement et les activités hors ville pèsent le plus.</p>

<h2 id="langue">Langue et étiquette</h2>
<p>
  On parle l'arabe marocain (darija) et l'amazighe ; le français est très répandu, l'anglais et
  l'espagnol courants dans le tourisme. Quelques mots changent l'ambiance :
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>En darija</th><th>Sens</th></tr></thead>
    <tbody>
      <tr><td><strong>Salam alaykoum</strong></td><td>Bonjour</td></tr>
      <tr><td><strong>Shukran</strong></td><td>Merci</td></tr>
      <tr><td><strong>La, shukran</strong></td><td>Non, merci — à répéter sans s'arrêter</td></tr>
      <tr><td><strong>Bshhal ?</strong></td><td>Combien ?</td></tr>
      <tr><td><strong>Balak !</strong></td><td>Attention ! (dans les ruelles)</td></tr>
      <tr><td><strong>Bslama</strong></td><td>Au revoir</td></tr>
    </tbody>
  </table>
</div>
<p>
  Côté étiquette : une tenue qui couvre épaules et genoux, un mot avant de photographier quelqu'un,
  la main droite pour donner et recevoir, de la discrétion pendant le ramadan. Les mosquées sont fermées
  aux non-musulmans, à de rares exceptions.
</p>

<h2 id="pratique">Pratique : électricité, réseau, heure</h2>
<ul>
  <li><strong>Électricité :</strong> 220 V, prises identiques à celles de la France : aucun adaptateur pour un voyageur français.</li>
  <li><strong>Réseau :</strong> le Maroc n'est pas dans la zone d'itinérance européenne sans surcoût ; une <a href={L('/esim-maroc/')}>eSIM marocaine</a> évite les frais.</li>
  <li><strong>Heure :</strong> UTC+1 toute l'année ; identique à Paris l'hiver, une heure de moins l'été, UTC+0 pendant le ramadan.</li>
  <li><strong>Eau :</strong> en bouteille scellée.</li>
</ul>

<h2 id="securite">Sécurité</h2>
<p>
  Marrakech est globalement sûre. Les désagréments — faux guides, petites arnaques, insistance —
  se gèrent avec des réflexes simples décrits dans
  <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>. Retenez la règle qui vaut pour tout :
  quelqu'un qui vous aborde sans que vous l'ayez sollicité cherche à vous vendre quelque chose.
</p>
</GuideLayout>
