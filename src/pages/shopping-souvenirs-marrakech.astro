---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Souks et shopping", href: L("/shopping-souvenirs-marrakech/") },
];

const toc = [
  { label: "Le souk, mode d'emploi", id: "souk" },
  { label: "Que rapporter", id: "quoi" },
  { label: "Négocier", id: "negocier" },
  { label: "Boutiques à prix fixe", id: "prix-fixe" },
  { label: "Emballer et transporter", id: "retour" },
  { label: "Pièges", id: "pieges" },
];

const faqs = [
  { q: "Comment négocier dans les souks de Marrakech ?", a: "Ne pas payer le premier prix, qui est un prix d'ouverture souvent trois à quatre fois supérieur à la valeur réelle. Une méthode simple : proposer environ le tiers, monter par petits paliers, et savoir partir sans colère. Négocier est un jeu de politesse, pas un affrontement. Ne proposez jamais un prix que vous n'êtes pas prêt à payer." },
  { q: "Que faut-il acheter à Marrakech ?", a: "Les classiques qui valent le voyage : babouches en cuir, poufs et sacs en cuir, lanternes en laiton ou en fer forgé, poteries et zellige, tapis berbères, huile d'argan pure, épices, savon noir. Achetez ce qui vous plaît et que vous saurez rapporter, plutôt que ce que « tout le monde achète »." },
  { q: "Comment reconnaître une vraie huile d'argan ?", a: "Méfiez-vous des flacons vendus à bas prix dans les souks touristiques. La vraie huile d'argan cosmétique est chère, produite par pression à froid, conditionnée dans du verre foncé. Les coopératives de femmes, comme celles que l'on croise sur la route d'Essaouira, offrent une traçabilité plus fiable qu'une boutique de médina." },
  { q: "Peut-on payer par carte dans les souks ?", a: "Rarement, sauf dans les boutiques plus grandes. Prévoyez des espèces en dirhams et fractionnez vos coupures. Les distributeurs se trouvent à l'entrée de la médina et à Guéliz." },
  { q: "Y a-t-il des boutiques à prix fixes ?", a: "Oui. L'Ensemble artisanal, complexe public à prix affichés près de la Koutoubia, permet de repérer les prix justes de chaque article avant d'aller négocier dans les souks. Quelques boutiques de créateurs à Guéliz et dans la médina pratiquent aussi des prix fixes." },
  { q: "Que puis-je rapporter en avion ?", a: "Attention aux liquides : huile d'argan, eau de fleur d'oranger, cosmétiques dépassent presque toujours les 100 ml autorisés en cabine et doivent aller en soute. Les lanternes et tapis pèsent lourd : pensez au poids autorisé. Pour les objets volumineux, la plupart des boutiques proposent un envoi par transporteur." },
];
---
<GuideLayout
  keywords="souks Marrakech, quoi acheter Marrakech, négocier souk, babouches, tapis, huile d'argan"
  title={"Shopping à Marrakech : souks et négociation"}
  description={"Acheter à Marrakech : souks par corporation, tapis, babouches, lanternes, argan, épices. Prix repères, négociation, prix fixes et bagages au retour."}
  eyebrow={"Marrakech · Souks et artisanat"}
  h1={"Shopping et souvenirs à Marrakech"}
  lede={"Les souks de Marrakech sont l'un des plus grands marchés d'artisanat du monde arabe. On y trouve tout, à condition de savoir négocier, distinguer l'artisan du revendeur, et rester patient."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["souks-marrakech"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un guide pour les souks", text: "Un guide agréé vous évite le faux guide, connaît les prix justes et vous emmène chez les artisans plutôt que chez les revendeurs.", provider: "guide", label: "Voir les visites guidées" }}
>
<h2 id="souk">Le souk, mode d'emploi</h2>
<p>
  Au nord de Jemaa el-Fna, les souks s'étendent sur plusieurs hectares de ruelles couvertes, organisées par
  corporation : les forgerons, les teinturiers, les cordonniers, les vendeurs d'épices. Chacun a son
  quartier, ses odeurs et son bruit. Se perdre y est presque inévitable, et pas désagréable si l'on
  garde en tête que la place est toujours au sud.
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Secteur</th><th>Ce qu'on y trouve</th></tr></thead>
    <tbody>
      <tr><td><strong>Souk Semmarine</strong></td><td>L'artère principale : tissus, babouches, maroquinerie, souvenirs</td></tr>
      <tr><td><strong>Rahba Kedima (place des Épices)</strong></td><td>Épices, herbes médicinales, savon noir, tapis</td></tr>
      <tr><td><strong>Souk Haddadine</strong></td><td>Forgerons : lanternes en fer forgé, ferronnerie</td></tr>
      <tr><td><strong>Souk des Teinturiers</strong></td><td>Laines et soies teintes séchant au-dessus des ruelles</td></tr>
      <tr><td><strong>Souk Chouari</strong></td><td>Travail du bois : cèdre, thuya, marqueterie</td></tr>
    </tbody>
  </table>
</div>

<h2 id="quoi">Que rapporter</h2>
<ul>
  <li><strong>Babouches en cuir :</strong> de 100 à 250 MAD pour une paire correcte, davantage pour du cuir de qualité et des broderies. Vérifiez les coutures et la semelle.</li>
  <li><strong>Lanternes :</strong> laiton ou fer forgé, de 150 à 800 MAD selon la taille et le travail. À emballer avec soin.</li>
  <li><strong>Tapis berbères :</strong> les plus coûteux, à comparer en plusieurs boutiques ; la laine et la densité de nœuds font la valeur. Comptez des milliers de dirhams pour une pièce authentique.</li>
  <li><strong>Poufs en cuir :</strong> souvent vendus vides et pliés, ce qui les rend faciles à transporter.</li>
  <li><strong>Huile d'argan, savon noir, épices :</strong> à acheter de préférence en coopérative, avec des échantillons.</li>
  <li><strong>Poterie, zellige, tadelakt :</strong> beau et lourd : pensez à l'envoi.</li>
</ul>

<h2 id="negocier">Négocier</h2>
<div class="callout">
  <span class="callout-label">La méthode en quatre temps</span>
  <p>
    Regardez sans montrer votre enthousiasme. Demandez le prix, et proposez environ le tiers. Montez par
    petits paliers, en souriant, en buvant le thé si on vous l'offre. Si l'écart reste trop important,
    remerciez et partez : c'est souvent à ce moment que le vrai prix apparaît.
  </p>
</div>
<p>
  Trois principes : ne discutez que d'un article que vous voulez vraiment, ne proposez pas de prix que
  vous n'accepteriez pas de payer, et considérez la négociation comme une conversation, pas comme un
  combat. Un vendeur qui a passé vingt minutes avec vous mérite le respect, même si vous n'achetez pas.
</p>

<h2 id="prix-fixe">Boutiques à prix fixe : votre étalon</h2>
<p>
  Avant de vous lancer dans les souks, passez par l'<strong>Ensemble artisanal</strong>, près de la
  Koutoubia : un complexe public où les prix sont affichés. Il ne propose pas le choix ni le charme des
  souks, mais il fournit un point de référence précieux pour savoir si l'on vous demande le double ou
  le triple. Quelques boutiques de créateurs, à Guéliz et dans la médina, pratiquent aussi des prix
  fixes.
</p>

<h2 id="retour">Emballer et transporter</h2>
<ul>
  <li><strong>Liquides :</strong> argan, fleur d'oranger et cosmétiques dépassent la limite de 100 ml en cabine : ils voyagent en soute, dans un sac fermé.</li>
  <li><strong>Poids :</strong> lanternes, poteries et tapis pèsent vite ; vérifiez votre franchise de bagage.</li>
  <li><strong>Envois :</strong> la plupart des boutiques expédient à l'international. Demandez un devis écrit et le numéro de suivi.</li>
  <li><strong>Douane :</strong> gardez vos factures pour les achats de valeur.</li>
</ul>
<p>
  Notre page <a href={L('/vols-marrakech/pas-chers/')}>vols pas chers</a> détaille l'impact du bagage
  en soute sur le prix d'un billet low cost.
</p>

<h2 id="pieges">Pièges à éviter</h2>
<ul>
  <li><strong>Le faux guide « gratuit »</strong> qui vous emmène chez un cousin : il touche une commission sur ce que vous achetez.</li>
  <li><strong>Le prix « spécial aujourd'hui »</strong> : il n'y a pas de tarif du jour, seulement des négociations.</li>
  <li><strong>Le tapis « antique »</strong> vendu comme une pièce de collection : demandez toujours un certificat, et méfiez-vous des affirmations.</li>
  <li><strong>L'huile d'argan bon marché</strong> : si le prix paraît trop beau, c'est qu'elle est coupée.</li>
</ul>
<p>
  Pour l'ensemble des réflexes de prudence, voyez
  <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>.
</p>
</GuideLayout>
