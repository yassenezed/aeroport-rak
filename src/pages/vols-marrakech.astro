---
import MoneyLayout from '../layouts/MoneyLayout.astro';
import FlightSearchWidget from '../components/affiliate/FlightSearchWidget.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Vols', href: L('/vols-marrakech/') },
];

const facts = [
  { label: 'Aéroport', value: airport.code, sub: 'Marrakech Ménara' },
  { label: 'Depuis Paris', value: '≈ 3 h 30', sub: 'en direct' },
  { label: 'Trafic 2024', value: '9,3 M', sub: 'passagers' },
  { label: 'Moins cher', value: 'Juil.–août', sub: 'et janvier' },
];

const durees = [
  { ville: 'Madrid', duree: '≈ 1 h 45' },
  { ville: 'Marseille, Toulouse, Bordeaux', duree: '≈ 2 h 45 – 3 h' },
  { ville: 'Lyon, Nantes, Nice', duree: '≈ 3 h – 3 h 15' },
  { ville: 'Paris, Bruxelles, Genève', duree: '≈ 3 h – 3 h 30' },
  { ville: 'Londres, Manchester', duree: '≈ 3 h 45 – 4 h 15' },
  { ville: 'Amsterdam, Francfort, Berlin', duree: '≈ 4 h – 4 h 30' },
];

const faqs = [
  {
    q: "Quelles compagnies desservent Marrakech ?",
    a: "Marrakech Ménara est l'un des aéroports les plus concurrentiels du Maroc : Ryanair, easyJet, Transavia, Vueling, Wizz Air, Jet2 et TUI côté low cost et charter, Air France, British Airways et Royal Air Maroc côté compagnies classiques, auxquelles s'ajoute Air Arabia Maroc. Les lignes varient d'une saison à l'autre : vérifiez toujours quelles compagnies opèrent votre route à vos dates."
  },
  {
    q: "Combien de temps dure un vol vers Marrakech ?",
    a: "Environ 3 h 30 depuis Paris, 3 heures depuis Lyon ou Nice, 2 h 45 depuis Toulouse, moins de 2 heures depuis Madrid et près de 4 heures depuis Londres. Pas de décalage éprouvant : le Maroc est à l'heure d'Europe de l'Ouest, avec une particularité — il reste en heure d'hiver toute l'année, donc une heure de moins qu'en France pendant l'heure d'été."
  },
  {
    q: "Y a-t-il un décalage horaire entre la France et Marrakech ?",
    a: "Cela dépend de la saison. Le Maroc est à UTC+1 toute l'année. Il est donc à l'heure de Paris en hiver, mais une heure en retard de fin mars à fin octobre. Pendant le mois de ramadan, le pays repasse à UTC+0 : l'écart est alors d'une heure en hiver et de deux heures en été. Vérifiez l'heure locale de votre atterrissage avant de caler un transfert."
  },
  {
    q: "Marrakech est-elle moins chère à rejoindre qu'Agadir ou Casablanca ?",
    a: "Souvent oui, parce que la concurrence entre compagnies y est plus vive et que le nombre de lignes plus élevé. Un aller-retour vers Marrakech se trouve fréquemment moins cher que vers Agadir sur les mêmes dates, en particulier depuis la France. Pour un séjour dans la ville, les environs ou l'Atlas, c'est le choix évident ; pour la côte atlantique, comparez avec notre page Marrakech ou Agadir."
  },
  {
    q: "Quand les vols pour Marrakech sont-ils les moins chers ?",
    a: "Juillet et août, à cause de la chaleur qui dépasse régulièrement 38 °C, ainsi que janvier et les semaines creuses de novembre. Les tarifs montent en février, à Pâques, aux ponts de mai et pendant les fêtes de fin d'année. Voir notre guide des vols pas chers pour la méthode de recherche."
  },
  {
    q: "Faut-il un visa pour aller à Marrakech ?",
    a: "Pas pour un séjour touristique de moins de 90 jours si vous détenez un passeport français, belge, suisse ou d'un autre pays de l'Union européenne. Attention : la carte d'identité seule ne suffit pas, il faut un passeport, valide pendant tout le séjour et de préférence au moins six mois. Le détail est sur la page formalités d'entrée."
  },
];
---
<MoneyLayout
  title="Vols pour Marrakech (RAK) 2026 : compagnies, durées et quand réserver | AirportRAK"
  description="Guide des vols vers Marrakech Ménara : compagnies qui desservent l'aéroport, durée du vol depuis Paris, Londres ou Madrid, décalage horaire, saisons de prix et recherche en direct."
  eyebrow="Marrakech · Vols"
  h1="Vols pour Marrakech"
  lede="Marrakech est le premier aéroport touristique du Maroc et l'un des mieux desservis d'Europe du Sud : des dizaines de villes en direct, une concurrence vive entre compagnies et des prix qui varient de un à trois selon la saison."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['marrakech-koutoubia']}
  heroProvider="#recherche"
  heroCtaLabel="Rechercher un vol pour Marrakech"
  secondaryHref="/vols-marrakech/pas-chers/"
  secondaryLabel="Trouver un vol pas cher"
  faqs={faqs}
  cta={{ heading: 'Comparez avant de réserver', text: "Les prix bougent d'un jour à l'autre sur une même route. Comparer plusieurs compagnies et des dates voisines est le moyen le plus rapide de payer moins.", provider: '#recherche', label: 'Lancer la recherche' }}
>
  <div id="recherche" style="scroll-margin-top: 6rem;">
    <h2 style="margin-top:0">Recherchez votre vol</h2>
    <p>
      Indiquez votre ville de départ et vos dates : le comparateur interroge plusieurs compagnies et
      agences. Pensez à cocher l'option hôtels si vous n'avez pas encore réservé le séjour.
    </p>
    <FlightSearchWidget />
    <p class="disclosure-inline">
      Prix indicatifs, susceptibles d'évoluer jusqu'à la réservation. Nous pouvons percevoir une
      commission sur les réservations effectuées via ce comparateur, sans surcoût pour vous.
    </p>
  </div>

  <h2 id="marche">Un marché très concurrentiel</h2>
  <p>
    Marrakech n'est pas un aéroport à saison unique, contrairement à d'autres destinations marocaines.
    La ville se visite toute l'année, ce qui fait tourner les lignes en continu : les compagnies low
    cost y ont installé des rotations régulières depuis la France, l'Espagne, le Royaume-Uni, la
    Belgique, l'Italie, l'Allemagne et la Suisse, tandis que les compagnies classiques proposent des
    horaires plus commodes et des bagages inclus.
  </p>
  <p>
    Deux chiffres résument le poids de l'aéroport : {(airport.passengers2024 / 1_000_000).toFixed(1).replace('.', ',')} millions
    de passagers en 2024, soit 34 % de plus qu'en 2023. Cette croissance a attiré de nouvelles lignes
    mais elle sature aussi les créneaux du matin, ce qui explique les files aux contrôles décrites sur
    {' '}<a href={L('/guide-aeroport-marrakech/arrivees/')}>arrivées au RAK</a>. La liste complète des
    villes reliées est sur
    {' '}<a href={L('/destinations-aeroport-marrakech/')}>lignes et compagnies</a>.
  </p>

  <h2 id="durees">Combien de temps dure le vol</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Depuis</th><th>Durée en direct (approx.)</th></tr>
      </thead>
      <tbody>
        {durees.map((d) => (
          <tr>
            <td><strong>{d.ville}</strong></td>
            <td class="num">{d.duree}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small text-muted">Durées indicatives, variables selon les vents et la route empruntée.</p>

  <h2 id="heure">L'heure locale : un détail qui piège</h2>
  <p>
    Le Maroc vit à UTC+1 <em>toute l'année</em>. Il n'y a donc pas de changement d'heure au printemps ni
    à l'automne : l'écart avec la France varie selon la saison. Vous avez la même heure que Paris de fin
    octobre à fin mars, et une heure de moins le reste de l'année. Pendant le mois de ramadan, le pays
    repasse à UTC+0, ce qui creuse l'écart d'une heure de plus.
  </p>
  <div class="callout">
    <span class="callout-label">Pourquoi c'est utile</span>
    <p>
      L'heure d'atterrissage affichée sur votre billet est l'heure <em>locale</em>. Communiquez toujours
      votre numéro de vol à votre chauffeur plutôt qu'une heure : il suit l'appareil et ne se trompe pas
      de fuseau. Voir <a href={L('/reserver-transfert/')}>réserver un transfert</a>.
    </p>
  </div>

  <h2 id="saison">Quand voler moins cher</h2>
  <p>
    Deux périodes tirent les prix vers le bas : <strong>juillet et août</strong>, où la chaleur
    dépasse régulièrement 38 °C et éloigne une partie des visiteurs, et <strong>janvier</strong>, entre
    les fêtes et les vacances de février. À l'opposé, février, Pâques, les ponts de mai et les fêtes de
    fin d'année concentrent la demande. Les meilleures conditions climatiques — mars-mai et
    septembre-novembre — se paient au tarif intermédiaire. Notre page
    {' '}<a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a> croise météo et prix.
  </p>

  <h2 id="bagages">Le vrai prix d'un vol low cost</h2>
  <p>
    Le tarif d'appel d'une compagnie à bas coût ne comprend en général que le bagage à main sous le
    siège. Ajoutez la valise de soute, le choix du siège et parfois l'embarquement prioritaire : sur un
    aller-retour, l'écart avec une compagnie classique bagage inclus fond souvent de moitié. Comparez
    toujours le prix <em>final</em>, pas le prix d'appel. Et rappelez-vous que les objets achetés dans les
    souks — lanternes, poteries, tapis — pèsent lourd au retour.
  </p>

  <h2 id="apres">Une fois le vol réservé</h2>
  <p>
    Trois réflexes évitent l'essentiel des problèmes : vérifier votre
    {' '}<a href={L('/formalites-entree-maroc/')}>passeport</a> (la carte d'identité ne suffit pas),
    réserver votre <a href={L('/reserver-transfert/')}>transfert d'arrivée</a> avec le numéro de vol, et
    préparer une <a href={L('/esim-maroc/')}>eSIM</a> pour être connecté dès l'atterrissage. En cas de
    retard important ou d'annulation, voyez
    {' '}<a href={L('/indemnisation-vol/')}>vol retardé ou annulé</a>.
  </p>
  <p class="small text-muted">Repères vérifiés en {PRICES_CHECKED}.</p>
</MoneyLayout>
