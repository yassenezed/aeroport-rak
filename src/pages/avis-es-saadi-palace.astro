---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
// Import images
import heroImg from '../assets/img/placeholder.png';
import bodyImg from '../assets/img/placeholder.png';
import { Image } from 'astro:assets';

const lang = 'fr';
const t = useTranslations(lang);
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: t('nav.hotels'), href: L('/best-hotels-agadir/') },
  { name: 'Iberostar Founty Beach', href: L('/iberostar-founty-beach-review/') },
];
---
<HotelReviewLayout
  lang={lang}
  title={`Iberostar Founty Beach. Avis & Accès Aéroport | AirportAGA`}
  description={`Un avis détaillé sur l'Iberostar Founty Beach à Agadir. Le resort All-Inclusive ultime pour les familles.`}
  h1={`Iberostar Founty Beach. Avis & Accès Aéroport`}
  subtitle={`Le resort familial All-Inclusive par excellence à Agadir`}
  breadcrumbs={breadcrumbs}
  brand={`Iberostar Founty Beach`}
  rating={4.5}
  verdict={`Une machine à vacances parfaitement huilée pour les familles.`}
  priceAvg={`120€ - 250€ / nuit`}
  address={`B.P. 1039, Cite Founty, Agadir 80000`}
  stars={`★★★★`}
  ratingText={`Excellent`}
  heroImage={heroImg}
  ctaLink="https://www.booking.com/hotel/ma/iberostar-founty-beach.fr.html"
  ctaLabel={`Voir les disponibilités`}
  faqs={[{"q": "L'Iberostar Founty Beach est-il bien pour les enfants ?", "a": "Absolument. C'est considéré comme le meilleur resort familial d'Agadir grâce à son programme Star Camp."}, {"q": "Combien coûte un taxi de l'aéroport à l'Iberostar ?", "a": "Un taxi officiel coûte environ 220-250 MAD (22-25 EUR). Un transfert privé est recommandé pour les familles."}]}
>
  <div class="content-block">
    <h2>Présentation</h2>
    <p>L'Iberostar Founty Beach est une institution à Agadir. Connu pour ses immenses piscines et ses programmes d'animation intenses, c'est sans doute le resort familial le plus populaire. Situé sur la plage, il offre un environnement sans stress pour les familles atterrissant à l'aéroport d'Agadir.</p>
    
    <h3>Pourquoi choisir l'Iberostar Founty Beach ?</h3>
    <ul class="pros-list">
      <li>Incroyable club enfants (Star Camp) et animation quotidienne.</li>
      <li>Complexe de piscines géant avec des zones pour tous les âges.</li>
      <li>Buffets All-Inclusive très généreux et variés.</li>
      <li>Accès direct à la magnifique plage de sable fin.</li>
      <li>Chambres familiales spacieuses disponibles.</li>
    </ul>

    <h3>Les Chambres</h3>
    <p>Les chambres sont lumineuses, confortables et pensées pour les familles. Beaucoup offrent une vue mer. Bien qu'elles arborent une esthétique de resort traditionnel plutôt qu'un luxe ultra-moderne, elles sont d'une propreté irréprochable et très fonctionnelles.</p>
    
    <div style="margin: 2rem 0; border-radius: 8px; overflow: hidden;">
      <Image src={bodyImg} alt={`Iberostar Founty Beach`} widths={[768, 1200]} sizes="(max-width: 768px) 100vw, 800px" />
    </div>

    <h2>Comment rejoindre l'Iberostar depuis l'aéroport</h2>
    <ol class="steps-list">
      <li>Sortez du terminal des arrivées d'Agadir Al Massira (AGA).</li>
      <li>Prenez votre transfert réservé à l'avance ou un grand taxi officiel.</li>
      <li>Le trajet dure environ 35 minutes jusqu'à la zone touristique de Founty.</li>
      <li>L'enregistrement est géré efficacement par la grande équipe de réception.</li>
    </ol>

    <h2>Équipements & Services</h2>
    <div class="features-grid">
      <div class="feature-item"><strong>Club Enfants (Star Camp)</strong><p>Activités par âge pour divertir les enfants toute la journée.</p></div>
      <div class="feature-item"><strong>Complexe Aquatique</strong><p>Immenses piscines extérieures et bassins pour enfants.</p></div>
      <div class="feature-item"><strong>Restauration All-Inclusive</strong><p>Buffets géants avec stands locaux et internationaux.</p></div>
      <div class="feature-item"><strong>Sports & Fitness</strong><p>Courts de tennis, salle de sport et beach-volley.</p></div>
    </div>

    <h2>Idéal pour des vacances en famille sans effort</h2>
    <p>Si vous voulez vous détendre au bord de la piscine pendant que les enfants sont pris en charge par des pros, tout en profitant de repas à volonté, c'est le meilleur choix en ville.</p>

    <div class="promo-box">
      <h3>Meilleur Tarif Garanti</h3>
      <p>Réservez vos vacances en famille dès aujourd'hui avec des options d'annulation flexibles.</p>
      <a class="btn btn--green" href="https://www.booking.com/hotel/ma/iberostar-founty-beach.fr.html" rel="nofollow sponsored" target="_blank">{`Voir les disponibilités`}</a>
    </div>
  </div>
</HotelReviewLayout>
