---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
import { photos } from '../data/images';

const t = useTranslations('fr');
const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Es Saadi Palace', href: L('/avis-es-saadi-palace/') },
];
---
<HotelReviewLayout
  title={`Es Saadi Palace Marrakech : notre avis et l'accès depuis l'aéroport | AirportRAK`}
  description={`Notre regard sur Es Saadi : un domaine familial de l'Hivernage, plusieurs niveaux d'hébergement dans un grand parc, et le quartier le plus rapide d'accès depuis l'aéroport de Marrakech.`}
  h1={`Es Saadi Palace : notre avis et l'accès depuis l'aéroport`}
  subtitle={`Un domaine familial de l'Hivernage, à dix minutes du terminal`}
  breadcrumbs={breadcrumbs}
  brand={`Es Saadi`}
  rating={4.5}
  verdict={`Un parc de plusieurs hectares en pleine ville, plusieurs catégories d'hébergement et une gestion familiale de longue date. Le quartier le plus rapide depuis l'aéroport, idéal en famille ou pour une dernière nuit.`}
  priceAvg={`Élevé, variable selon l'aile`}
  address={`Hivernage, quartier des grands hôtels`}
  stars={`★★★★★`}
  ratingText={`Excellent`}
  heroImage={photos['es-saadi-palace']}
  ctaLink={L('/ou-dormir-marrakech/')}
  ctaLabel={`Comparer les disponibilités`}
  faqs={[
    { q: "Où se situe Es Saadi ?", a: "Dans l'Hivernage, le quartier des grands hôtels et des jardins, à environ 4 km de l'aéroport et une dizaine de minutes en voiture. C'est l'un des secteurs les plus rapides d'accès depuis le terminal." },
    { q: "Quelle différence entre les différentes parties du domaine ?", a: "Le domaine réunit plusieurs entités dans un même parc : une partie hôtelière historique, une partie palace aux prestations supérieures, et des villas privées. Le choix dépend du niveau de service et d'espace recherché, toutes partageant les jardins." },
    { q: "Es Saadi convient-il aux familles ?", a: "Oui, c'est l'un de ses points forts dans l'Hivernage : de vastes jardins, des espaces piscine généreux et des hébergements familiaux, dans un domaine clos où les enfants circulent sans traverser de rue." },
    { q: "Peut-on rejoindre la médina à pied depuis l'Hivernage ?", a: "C'est faisable mais long, entre vingt-cinq et quarante minutes selon le point d'entrée, le long d'avenues peu ombragées. En pratique, un petit taxi coûte quelques dirhams et règle la question en dix minutes." }
  ]}
>
  <div class="content-block">
    <h2>Ce que c'est</h2>
    <p>
      Es Saadi est une institution marrakchie d'un genre différent : un domaine familial de l'Hivernage,
      développé depuis les années 1950 par la même famille, devenu au fil des décennies un parc
      réunissant plusieurs niveaux d'hébergement — partie hôtelière historique, aile palace plus
      récente, villas privées — autour de grands jardins.
    </p>

    <h3>Pourquoi on le retient</h3>
    <ul class="pros-list">
      <li>Un parc de plusieurs hectares en pleine ville, rare dans l'Hivernage.</li>
      <li>Plusieurs catégories d'hébergement sur un même domaine.</li>
      <li>Une gestion familiale de longue date, sensible dans le ton du service.</li>
      <li>Espaces piscine généreux, appréciés en famille.</li>
      <li>L'accès le plus rapide du centre depuis l'aéroport.</li>
    </ul>

    <h2>L'accès depuis l'aéroport</h2>
    <p>
      L'Hivernage est le premier quartier que l'on atteint en sortant du RAK : comptez une dizaine de
      minutes en conditions normales, un peu plus en fin d'après-midi. Dépose devant la réception,
      aucune contrainte de bagages. C'est le quartier que nous recommandons pour une dernière nuit avant
      un vol matinal — voyez <a href={L('/hotels-pres-aeroport-marrakech/')}>dormir près du RAK</a>.
    </p>

    <h2>Pour qui</h2>
    <p>
      Pour les familles et les séjours où l'on souhaite un vrai espace extérieur sans quitter le centre,
      et pour les voyageurs qui préfèrent la commodité d'un grand domaine à l'immersion d'un riad. Les
      amateurs de ruelles et de patios trouveront leur compte du côté de la
      <a href={L('/medina-marrakech/')}>médina</a>.
    </p>

    <h2>À savoir avant de réserver</h2>
    <p>
      Le domaine regroupant plusieurs entités, vérifiez précisément laquelle vous réservez : prestations
      et tarifs diffèrent sensiblement d'une partie à l'autre. Pour le contexte saisonnier, voyez
      <a href={L('/quand-partir-marrakech/')}>quand partir</a>, et pour l'ensemble de l'offre,
      <a href={L('/meilleurs-hotels-marrakech/')}>les meilleurs hôtels de Marrakech</a>.
    </p>
  </div>
</HotelReviewLayout>
