---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Jemaa el-Fna", href: L("/jemaa-el-fna/") },
];

const toc = [
  { label: "Jour et nuit", id: "jour-nuit" },
  { label: "Manger sur la place", id: "manger" },
  { label: "Conteurs, musiciens, spectacles", id: "spectacles" },
  { label: "Les terrasses qui surplombent", id: "terrasses" },
  { label: "Les pièges", id: "pieges" },
  { label: "Y aller", id: "acces" },
];

const faqs = [
  { q: "À quelle heure aller sur Jemaa el-Fna ?", a: "Deux moments : à la fin de l'après-midi, vers 17 h, pour voir la place se transformer et prendre un verre sur une terrasse ; puis entre 19 h et 22 h pour l'ambiance des stands, quand les fumées des grills montent et que les musiciens s'installent. Le matin, la place est presque vide et sert surtout de point de passage." },
  { q: "Est-il sûr de manger sur les stands de Jemaa el-Fna ?", a: "Généralement oui, si vous appliquez le bon sens : choisissez un stand fréquenté par des Marocains, où la rotation est rapide, préférez les plats cuits sur place à la commande et évitez les crudités lavées à l'eau du robinet. Les stands sont numérotés, affichent leurs prix et cuisinent devant vous." },
  { q: "Combien coûte un repas sur la place ?", a: "Une soupe ou un plat simple se paie quelques dizaines de dirhams, un repas complet — brochettes, salades, pain, thé — se situe en général entre 50 et 100 MAD par personne. Vérifiez le prix avant de commander ; plusieurs stands affichent un menu, certains vous en proposent un oral qui change selon le client." },
  { q: "Peut-on photographier les charmeurs de serpents et les porteurs d'eau ?", a: "Ils vous réclameront de l'argent, parfois avec insistance, et le tarif annoncé après la photo est rarement le vôtre. Convenez du prix avant de sortir l'appareil, ou photographiez de loin. Nous déconseillons les photos avec des animaux : leur condition est loin d'être idéale." },
  { q: "Jemaa el-Fna est-elle dangereuse le soir ?", a: "Non, elle reste très animée jusqu'à minuit, mais la foule attire les pickpockets. Gardez votre sac devant vous, votre téléphone dans une poche fermée, et évitez de sortir de gros billets. Si l'on vous saisit la main pour un tatouage au henné, retirez-la fermement : le service se paie." },
  { q: "Que faire si le tatouage au henné m'a déjà été appliqué ?", a: "Ne discutez pas trop : payez une somme modeste, aussi raisonnable que possible, et partez. Le mieux est d'éviter la situation en gardant les mains dans vos poches lorsque vous traversez la place et en disant fermement « non, merci » aux femmes qui s'approchent avec un carnet de modèles." },
];
---
<GuideLayout
  keywords="Jemaa el-Fna, place Marrakech, stands cuisine, conteurs, terrasses café"
  title={"Jemaa el-Fna : la place, les stands du soir, les pièges et les bons plans (2026) | AirportRAK"}
  description={"Visiter Jemaa el-Fna à Marrakech : la place de jour et de nuit, les stands de cuisine numérotés, conteurs et musiciens, terrasses de café, prix, photos avec les animaux et pièges classiques."}
  eyebrow={"Marrakech · Jemaa el-Fna"}
  h1={"Jemaa el-Fna, la place"}
  lede={"Un vide à peu près désert le matin, une foule de milliers de personnes le soir : la place la plus célèbre du Maroc change de nature au fil de la journée. Voici comment la vivre sans tomber dans les pièges."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["jemaa-el-fna"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un guide pour la place et les souks", text: "Une visite guidée de deux à trois heures, avec un guide agréé et un tarif fixé d'avance, évite la plupart des pièges décrits ici.", provider: "guide", label: "Voir les visites guidées" }}
>
<h2 id="jour-nuit">Jour et nuit : deux places différentes</h2>
<p>
  Classée par l'UNESCO au titre du patrimoine culturel immatériel, Jemaa el-Fna n'est pas un simple
  espace : c'est un spectacle vivant permanent, renouvelé depuis des siècles. La journée, on y croise
  des vendeurs de jus d'orange pressé, des porteurs d'eau en costume traditionnel, des tatoueuses au
  henné et des charmeurs de serpents. C'est une place à traverser et à observer, plus qu'à fréquenter
  longtemps : le soleil tape fort et la sollicitation est constante.
</p>
<p>
  À la fin de l'après-midi, la place se transforme. Les stands de cuisine montent en quelques minutes,
  la fumée des grills s'élève, et les cercles de spectateurs se forment autour des conteurs, des
  musiciens gnaoua et des troupes acrobatiques. C'est le moment, entre 18 h et 22 h, où la place mérite
  sa réputation.
</p>

<h2 id="manger">Manger sur la place</h2>
<p>
  Les stands de cuisine sont numérotés et alignés sur plusieurs rangées, chacun avec son ou ses rabatteurs
  qui vous interpellent. Ce n'est pas de l'agressivité, c'est un usage : sourire, laisser passer, et
  choisir sans hâte. Quelques règles utiles.
</p>
<ul>
  <li><strong>Regardez qui mange.</strong> Un stand où mangent des familles marocaines tourne vite et cuisine frais.</li>
  <li><strong>Demandez le prix avant de vous asseoir.</strong> Certains stands ont un menu affiché, d'autres l'énoncent, et l'écart peut être net d'un client à l'autre.</li>
  <li><strong>Commandez ce qui est grillé ou frit à la demande</strong> : brochettes, merguez, poisson frit, soupe harira.</li>
  <li><strong>Évitez</strong> les salades crues lavées à l'eau du robinet si votre estomac est fragile.</li>
  <li><strong>Prenez de la monnaie :</strong> le paiement se fait en espèces, et rendre la monnaie sur un gros billet n'est pas toujours facile.</li>
</ul>
<p>
  Pour une adresse plus posée, voyez <a href={L('/restaurants-marrakech/')}>où manger à Marrakech</a>.
</p>

<h2 id="spectacles">Conteurs, musiciens, spectacles</h2>
<p>
  La tradition de la <em>halqa</em> — le cercle de spectateurs autour d'un artiste — est l'essence de la
  place. Conteurs en darija, musiciens gnaoua aux crotales métalliques, joueurs de tambour berbère,
  acrobates : ils passent parmi les spectateurs avec un plateau. Un billet de quelques dirhams est
  l'usage, bien accueilli et souvent attendu. Vous pouvez observer sans donner, mais ne prenez pas de
  photos sans un mot.
</p>

<h2 id="terrasses">Les terrasses qui surplombent la place</h2>
<p>
  La plus belle façon de voir Jemaa el-Fna est d'en haut. Plusieurs cafés aux terrasses en étage, comme
  le Café de France ou le Café Glacier, dominent la place : une boisson à quelques dizaines de dirhams
  vous donne accès à la vue. Arrivez vers 17 h pour avoir une table au moment où le décor se met en
  place, et restez jusqu'à la nuit.
</p>

<h2 id="pieges">Les pièges classiques</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Situation</th><th>Ce qui se passe</th><th>Le bon réflexe</th></tr></thead>
    <tbody>
      <tr><td>Une femme vous prend la main</td><td>Un henné est tracé, puis payé cher</td><td>Retirer la main, dire « non, merci » avant qu'elle ne saisisse</td></tr>
      <tr><td>Photo avec un serpent ou un singe</td><td>Un animal est posé sur vous, puis un tarif est annoncé</td><td>Convenir du prix avant, ou refuser</td></tr>
      <tr><td>« La place est fermée, venez par ici »</td><td>Un faux guide vous emmène en boutique</td><td>Ignorer, continuer</td></tr>
      <tr><td>Stand qui change son tarif</td><td>Le prix annoncé n'est pas celui de l'addition</td><td>Demander le prix avant de s'asseoir</td></tr>
      <tr><td>Foule dense</td><td>Petits vols à la tire</td><td>Sac devant soi, téléphone rangé</td></tr>
    </tbody>
  </table>
</div>
<p>
  Le panorama complet des précautions à prendre est sur <a href={L('/securite-marrakech/')}>sécurité à
  Marrakech</a>.
</p>

<h2 id="acces">Y aller</h2>
<p>
  Depuis l'aéroport, le bus 19 vous dépose à Jemaa el-Fna, et un taxi coûte 100 à 150 MAD. Dans les deux
  cas, vous êtes au cœur de la médina : voyez
  <a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a> pour la suite. Sur
  place, la place est piétonne : les voitures s'arrêtent à ses abords.
</p>
</GuideLayout>
