---
import HotelLayout from '../layouts/HotelLayout.astro';
import AffiliateLink from '../components/affiliate/AffiliateLink.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Où dormir', href: L('/where-to-stay-agadir/') },
  { name: 'Surf camps de Taghazout', href: L('/taghazout-surf-camps/') },
];
const facts = [
  { label: 'Semaine en camp', value: '250 €', sub: 'dès' },
  { label: 'Aéroport → Taghazout', value: '48 km' },
  { label: 'Temps de trajet', value: '50–65', sub: 'min' },
  { label: 'Pension + repas', value: 'La plupart', sub: 'des camps' },
];
const faqs = [
  { q: "Que comprend un surf camp à Taghazout ?", a: "Une semaine type regroupe le lit (dortoir ou chambre privée), quelques repas, en général le petit-déjeuner et quelques dîners, et le volet surf : prêt de planche et combinaison, sessions guidées ou cours quotidiens par niveau, et le transport vers le spot adapté à la marée. Le yoga, la prise en charge à l'aéroport et un dîner de bienvenue sont des options fréquentes. Le contenu exact varie beaucoup : lisez le forfait ligne par ligne avant de réserver." },
  { q: "Combien coûte un surf camp à Taghazout ?", a: "Environ 250 à 450 € la semaine avec le lit, la planche et quelques repas, tarifs vérifiés en juin 2026, dortoirs et semaines d'intersaison en bas de fourchette, chambres privées et semaines de pointe plus haut. Les formules débutant avec cours quotidiens coûtent plus qu'un « surf and stay » où vous n'avez qu'un lit et la location de matériel. Les vols et la plupart des déjeuners sont en général en supplément." },
  { q: "Faut-il réserver un surf camp ou un appartement en gestion libre ?", a: "Un camp si vous voulez le côté social, le coaching quotidien et zéro organisation, planche, transport vers les spots et une bande déjà formée, tout est réglé. Un appartement si vous surfez en autonomie, voulez cuisiner, ou voyagez en couple ou en groupe et préférez votre propre espace en réservant les cours à la carte. Taghazout et Tamraght ont les deux en abondance." },
  { q: "Les surf camps de Taghazout conviennent-ils aux débutants ?", a: "Oui, c'est l'une des meilleures zones débutant du Maroc. La côte compte des beach breaks doux comme Crocodile et Panoramas près de Tamraght pour apprendre, à côté des points célèbres (Anchor Point, Killer) pour quand vous progressez. La plupart des camps répartissent les élèves par niveau et donnent les cours sur les vagues tranquilles, donc les débutants ne sont pas lâchés sur les reefs musclés." },
];
---
<HotelLayout
  lang={lang}
  title="Surf camps de Taghazout : ce qui est inclus et comment réserver (2026) | AirportAGA"
  description="Un guide direct des surf camps de Taghazout, ce qu'une semaine en camp inclut vraiment, camp vs appartement en gestion libre, vrais prix 2026, et la question adresse-et-transfert qui piège les nouveaux venus depuis l'aéroport d'Agadir."
  eyebrow="Où dormir · Côte de surf"
  h1="Les surf camps de Taghazout"
  lede="Taghazout est la capitale marocaine du surf camp, un village détendu égrené le long des point breaks, à 45–60 minutes de l'aéroport d'Agadir en remontant la côte. Voici ce qu'une semaine en camp inclut vraiment, quand un appartement vaut mieux qu'un camp, et comment rejoindre un logement qui n'a souvent pas d'adresse."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={250}
  heroImage={photos['taghazout']}
  heroCtaLabel="Trouver un séjour surf à Taghazout"
  faqs={faqs}
  cta={{ heading: 'Trouvez votre séjour surf à Taghazout', text: 'Comparez surf camps, maisons d\'hôtes et appartements à Taghazout et Tamraght, annulation gratuite sur la plupart des réservations.', provider: 'booking', label: 'Chercher un séjour à Taghazout' }}
>
  <p>
    Si vous avez atterri à Agadir pour les vagues, c'est en réalité à Taghazout que vous allez, un
    petit village de surf sur la côte dont toute l'économie tourne autour des point breaks qui se
    déroulent en face. La plupart des gens logent en surf camp : lit, planche et sessions quotidiennes
    dans un seul forfait. Mais « surf camp » recouvre tout, de l'auberge sociale avec cours à
    l'appartement en gestion libre réservé à part, et l'écart compte. Voici comment ça marche, ce que ça
    coûte, et le détail du transfert qui piège les nouveaux venus.
  </p>

  <h2 id="what-included">Ce qu'inclut un surf camp</h2>
  <p>
    Une semaine de camp classique regroupe le lit et le surf en un seul prix. Le forfait type ressemble
    à ça :
  </p>
  <ul>
    <li><strong>L'hébergement</strong>, un lit en dortoir ou une chambre privée, souvent dans un camp à l'esprit maison d'hôtes avec terrasse partagée.</li>
    <li><strong>Quelques repas</strong>, en général le petit-déjeuner et quelques dîners de groupe ; les déjeuners à la plage sont souvent à votre charge.</li>
    <li><strong>Le volet surf</strong>, prêt de planche et combinaison, sessions guidées ou cours quotidiens par niveau, et le transport vers le spot adapté à la marée et à la houle du jour.</li>
    <li><strong>Les extras fréquents</strong>, yoga, dîner de bienvenue, photos de votre session, et prise en charge à l'aéroport (à prendre si on vous la propose).</li>
  </ul>
  <p>
    Le contenu réel varie beaucoup d'un camp à l'autre, alors lisez le forfait ligne par ligne, un tarif
    « surf and stay » bon marché peut n'être qu'un lit et la location de matériel, les cours facturés en
    plus.
  </p>

  <h2 id="board-vs-apartment">Camp vs appartement en gestion libre</h2>
  <p>
    Le grand choix, c'est de vouloir tout organisé ou son propre espace. Un camp vous donne le côté
    social, le coaching quotidien, le transport vers les spots et une bande déjà formée, idéal si vous
    êtes seul, débutant, ou voulez juste arriver et surfer. Un appartement en gestion libre à Taghazout
    ou Tamraght convient aux surfeurs autonomes, aux couples et aux groupes qui préfèrent cuisiner,
    garder leurs propres horaires et réserver les cours à la carte. Les deux se trouvent facilement le
    long de cette portion de côte.
  </p>
  <div class="grid grid-2" style="margin-top:1.5rem">
    <div class="card">
      <h3>Surf camp</h3>
      <p class="small text-muted">Social, coaché, zéro organisation.</p>
      <p>Lit, planche, transport vers les spots et sessions quotidiennes en un seul forfait, avec une bande intégrée. Parfait pour les voyageurs solo, les débutants et tous ceux qui veulent que tout soit réglé. Dès 250 € environ la semaine.</p>
      <AffiliateLink provider="booking" sub="taghazout-surf-camps-camp" class="btn btn-primary btn-block">Comparer les séjours surf</AffiliateLink>
    </div>
    <div class="card">
      <h3>Appartement en gestion libre</h3>
      <p class="small text-muted">Autonome, vos propres horaires.</p>
      <p>Votre propre logement à Taghazout ou Tamraght, on cuisine soi-même, on réserve les cours à part. Parfait pour les surfeurs confirmés, les couples et les groupes qui veulent de l'espace. À associer à des cours réservés le jour même.</p>
      <AffiliateLink provider="booking" sub="taghazout-surf-camps-apartment" class="btn btn-primary btn-block">Trouver des appartements</AffiliateLink>
    </div>
  </div>

  <h2 id="lessons">Réserver les cours à part</h2>
  <p>
    Si vous prenez un appartement plutôt qu'un camp complet, vous pouvez quand même avoir du coaching en
    réservant cours de surf et sessions guidées comme des activités, pratique quand un seul du couple
    surfe, ou pour une simple journée d'initiation. Des plateformes comme
    <AffiliateLink provider="getyourguide" sub="taghazout-surf-camps-lessons" class="text-link">GetYourGuide proposent des cours de surf et des journées surf en groupe à Taghazout</AffiliateLink>
    que vous bloquez avant de partir, ce qui vaut mieux que de chercher sur la plage en plein décalage
    horaire le premier jour.
  </p>

  <h2 id="address">Le problème de l'adresse et du transfert</h2>
  <p>
    C'est le détail qui piège les nouveaux venus. Les camps et appartements de Taghazout et Tamraght
    n'ont presque jamais de vrai numéro de rue, juste un nom, un point de repère et un point de
    localisation. Un grand taxi pris à la station de l'aéroport peut hausser les épaules devant une
    adresse non signalée, tourner dans le village, puis renoncer ou facturer un supplément. Les
    solutions : prenez la prise en charge à l'aéroport du camp s'il en propose une, ou réservez un
    transfert privé où vous transmettez le point WhatsApp au moment du paiement. Enregistrez ce point
    hors ligne avant de partir. Notre route <a href={L('/agadir-airport-to-taghazout/')}>aéroport vers
    Taghazout</a> détaille les prix, le temps de trajet et la circulation de la route côtière ; si vous
    êtes un peu plus près, voyez <a href={L('/agadir-airport-to-tamraght-aourir/')}>l'aéroport vers
    Tamraght et Aourir</a>.
  </p>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Taghazout fonctionne au liquide, les petits-déjeuners du camp, la boulangerie, l'homme qui surveille
    la voiture. Retirez des dirhams à un distributeur de l'aéroport avant de monter sur la côte, et
    prenez une SIM ou eSIM pour pouvoir envoyer à votre chauffeur le point du logement et consulter le
    bulletin surf avant même d'avoir quitté les arrivées.
  </div>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation : si vous réservez un séjour, un transfert ou un
    cours via ces liens, nous pouvons percevoir une petite commission, sans surcoût pour vous. Cela ne
    change ni les prix affichés ni nos recommandations.
    <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>

  <p>
    Envie des vagues elles-mêmes ? Lisez notre <a href={L('/surfing-taghazout-guide/')}>guide du surf à
    Taghazout</a> pour les spots par niveau et par saison. Vous organisez le trajet ? Commencez par la
    route <a href={L('/agadir-airport-to-taghazout/')}>aéroport vers Taghazout</a>.
  </p>
</HotelLayout>
