---
import RouteLayout from '../layouts/RouteLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
  { name: 'Vers Marrakech', href: L('/agadir-airport-to-marrakech/') },
];
const facts = [
  { label: 'Distance', value: '235 km' },
  { label: 'Durée', value: '2¾–3¼', sub: 'h' },
  { label: 'Transfert réservé', value: '120 €', sub: 'dès' },
  { label: 'Bus (Supratours)', value: '~140', sub: 'MAD' },
];
const faqs = [
  { q: "À quelle distance Marrakech se trouve-t-elle de l'aéroport d'Agadir ?", a: "Environ 235 km par l'autoroute A7, soit 2 h 45 à 3 h 15 de route. C'est le plus long transfert courant depuis l'AGA : mieux vaut décider d'emblée si la voiture privée ou le car convient le mieux à votre groupe et à votre budget." },
  { q: "Combien coûte un transfert de l'aéroport d'Agadir à Marrakech ?", a: "Un transfert privé porte-à-porte démarre autour de 120 € pour une voiture, davantage pour un minivan ou un grand groupe, c'est le prix du véhicule entier, pas par place, donc il se partage bien entre trois ou quatre. Le car Supratours ou CTM est bien moins cher, environ 130–160 MAD la place, mais il part des gares routières de la ville, pas de l'aéroport. Prix vérifiés en juin 2026." },
  { q: "Y a-t-il un bus de l'aéroport d'Agadir à Marrakech ?", a: "Pas directement depuis le terminal. Supratours et CTM assurent de bons cars interurbains entre Agadir et Marrakech plusieurs fois par jour, mais ils partent des gares routières d'Agadir, pas de l'aéroport. Il faut donc d'abord un taxi jusqu'au centre, ce qui réduit l'économie et le temps. Pour un couple avec bagages, le transfert privé direct est souvent le meilleur compromis." },
  { q: "Combien de temps dure le trajet Agadir – Marrakech ?", a: "Comptez 2 h 45 à 3 h 15 en voiture par l'A7. La route est une autoroute à péage moderne et rapide sur presque tout le parcours, qui monte vers l'intérieur des terres à travers le pays de l'arganier. Un chauffeur privé fera en général une halte café si vous le demandez." },
  { q: "Vaut-il mieux prendre l'avion ou la route entre Agadir et Marrakech ?", a: "Il n'existe pas de vol régulier utile sur ce court trajet : c'est donc une décision routière. Pour trois ou quatre personnes, le transfert privé est confortable et porte-à-porte ; en solo ou en couple soucieux du budget, beaucoup prennent le car depuis la ville. Dans tous les cas, prévoyez la demi-journée, ce n'est pas un saut de puce." },
];
---
<RouteLayout
  lang={lang}
  title="Transfert aéroport Agadir – Marrakech : bus et prix (2026) | AirportAGA"
  description="Le guide honnête de l'aéroport d'Agadir à Marrakech : 235 km et près de 3 heures par l'A7. Prix transfert privé 2026, comparaison avec les cars Supratours et CTM, et lequel choisir."
  eyebrow="Trajets depuis l'AGA · Longue distance"
  h1="Transfert aéroport Agadir → Marrakech"
  lede="Marrakech est à 235 km et près de trois heures par l'A7, le plus long des trajets courants depuis l'AGA. Voici la comparaison franche : une voiture privée jusqu'à la porte dès 120 €, face au car Supratours bien moins cher mais qui ne part pas de l'aéroport."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={120}
  heroImage={photos['marrakech']}
  heroProvider="transfer"
  heroCtaLabel="Voir les prix vers Marrakech"
  faqs={faqs}
  cta={{ heading: 'Porte à porte, sans correspondance', text: 'Une voiture ou un minivan privé directement de l\'arrivée à votre riad de Marrakech, prix fixe pour le véhicule entier, vol suivi, halte café sur demande. Idéal partagé entre trois ou quatre.', provider: 'transfer', label: 'Réserver votre transfert Marrakech' }}
>
  <p>
    Beaucoup atterrissent à Agadir avant de réaliser que leur vraie destination est Marrakech, un
    billet en correspondance moins cher, ou un séjour qui marie la côte et la ville impériale. C'est un
    vrai trajet : 235 km vers l'intérieur par l'autoroute A7, soit 2 h 45 à 3 h 15. Cette distance
    change le calcul par rapport à un court saut côtier : mieux vaut peser honnêtement le transfert
    privé face au car interurbain avant de réserver.
  </p>

  <h2 id="options">Transfert privé ou car ?</h2>
  <p>
    Pas de train vers Marrakech de ce côté, pas de vol utile : le choix se joue entre la voiture et le
    bus :
  </p>
  <ul>
    <li><strong>Transfert privé</strong>, il vous accueille à l'arrivée, vous conduit droit à la porte du riad, et vous maîtrisez les arrêts. Dès 120 € pour la voiture entière, donc raisonnable par tête à trois ou quatre. L'option la plus simple avec des bagages ou après une arrivée tardive.</li>
    <li><strong>Car Supratours / CTM</strong>, d'excellents cars interurbains à environ 130–160 MAD la place, mais ils partent des gares routières d'Agadir, pas de l'aéroport. Ajoutez un taxi vers le centre et l'horaire, et l'économie fond pour un couple.</li>
    <li><strong>Voiture de location</strong>, correcte si vous gardez la voiture à Marrakech, mais les frais d'aller simple et la conduite dans la médina en découragent beaucoup.</li>
  </ul>


  <div class="widget-wrap">
    <iframe
      class="tpemd-iframe"
      srcdoc='<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:0;font-family:system-ui,sans-serif;overflow:hidden}</style></head><body><script async src="https://tpemd.com/content?currency=EUR&amp;trs=554574&amp;shmarker=697149&amp;locale=fr&amp;from=al%20massira%20airport&amp;to=Marrakech&amp;country=Morocco&amp;powered_by=true&amp;transfer_options_limit=10&amp;transfer_options=MCR&amp;disable_currency_selector=true&amp;hide_form_extras=true&amp;hide_external_links=true&amp;campaign_id=1&amp;promo_id=3879" charset="utf-8"><\/script><script>new MutationObserver(function(){document.documentElement.style.height="auto";window.parent.postMessage({tpemdHeight:document.body.scrollHeight},"*")}).observe(document.body,{childList:true,subtree:true,attributes:true})<\/script></body></html>'
      style="width:100%;border:none;min-height:200px;overflow:hidden;"
      loading="lazy"
      title="Transfer booking widget"
    ></iframe>
  </div>

  <h2 id="bus">La vérité sur le car</h2>
  <p>
    Les cars Supratours et CTM sont confortables, climatisés et bon marché : pour un voyageur solo au
    budget serré, difficile de faire mieux. Le hic, c'est qu'aucun ne dessert l'aéroport, il faut
    d'abord rejoindre Agadir (22 km) jusqu'à la gare routière, attendre un départ, rouler trois heures,
    puis reprendre un taxi du terminal de Marrakech à votre riad. Ça marche, mais cela transforme un
    transfert unique en une journée à quatre étapes. À deux ou plus avec des bagages, la voiture privée
    directe l'emporte souvent sur le temps et le stress, même si elle coûte plus cher.
  </p>

  <h3 id="reserver">Réserver un transfert vers Marrakech</h3>
  <TransferOptions
    sub="aeroport-agadir-marrakech"
    options={[
      { provider: 'transfer', highlight: true, badge: 'Meilleur rapport', pitch: 'Une voiture ou un minivan à prix fixe de l\'arrivée AGA vers n\'importe quelle adresse de Marrakech, dès 120 € le véhicule, se partage bien en groupe, avec suivi du vol et annulation gratuite jusqu\'à 24 h.', label: 'Voir les prix des transferts' },
      { provider: 'transfer-vip', badge: 'Accueil personnalisé', pitch: 'Un chauffeur nommé, anglophone, pour le long trajet vers l\'intérieur, pratique pour une arrivée fluide et un contact clair sur les trois heures de route.', label: 'Réserver un transfert VIP' },
    ]}
  />

  <h2 id="route">À quoi ressemble le trajet</h2>
  <p>
    L'A7 est une autoroute à péage moderne et la route longue la plus facile de la région, à deux fois
    deux voies presque partout, qui s'élève en douceur depuis la côte à travers le pays de l'arganier
    avant que la plaine du Haouz ne s'ouvre vers Marrakech. Un chauffeur privé glissera volontiers une
    halte café si vous le demandez. Rien de technique, mais ce sont trois heures : n'enchaînez pas une
    correspondance serrée ni un dîner juste après le transfert, et gardez eau et en-cas à portée si vous
    voyagez avec des enfants.
  </p>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Si Marrakech ouvre un voyage plus large au Maroc, envisagez de garder le même chauffeur privé pour
    les étapes suivantes plutôt que de tout re-réserver. Beaucoup proposent un tarif à la journée. Voyez
    notre <a href={L('/agadir-private-driver/')}>guide du chauffeur privé</a> pour le fonctionnement et
    le juste prix.
  </div>

  <p>
    Vous venez en sens inverse et préférez la côte ? Comparez le trajet
    <a href={L('/agadir-airport-to-essaouira/')}>aéroport → Essaouira</a>, qui se marie bien avec
    Marrakech en boucle. Vous pesez encore vos options pour tout le séjour ? Notre
    <a href={L('/best-agadir-airport-transfer/')}>guide du meilleur transfert</a> classe les
    prestataires, et le <a href={L('/agadir-airport-transfers/')}>hub des transferts</a> couvre tous
    les trajets depuis l'AGA.
  </p>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation, réservez via ces liens et nous pouvons percevoir
    une petite commission, sans surcoût pour vous. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>
</RouteLayout>
