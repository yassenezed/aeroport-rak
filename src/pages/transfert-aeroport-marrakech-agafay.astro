---
import RouteLayout from '../layouts/RouteLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
  { name: 'Vers Imsouane', href: L('/agadir-airport-to-imsouane/') },
];
const facts = [
  { label: 'Distance', value: '90 km' },
  { label: 'Durée', value: '90–110', sub: 'min' },
  { label: 'Transfert réservé', value: '70 €', sub: 'dès' },
  { label: 'Grand taxi', value: 'à négocier', sub: '' },
];
const faqs = [
  { q: "Comment aller de l'aéroport d'Agadir à Imsouane ?", a: "Par la route uniquement, et c'est le plus long des transferts surf, environ 90 km au nord, soit 90 minutes à près de deux heures. Pas de bus vers Imsouane, pas de train : il reste le transfert privé réservé ou un grand taxi négocié pour le long trajet. La plupart des surfeurs réservent d'avance car le dernier tronçon vers la baie est isolé." },
  { q: "Combien coûte un transfert de l'aéroport d'Agadir à Imsouane ?", a: "Un transfert privé réservé démarre autour de 70 € pour la voiture, prix fixé avant le départ. Un grand taxi doit se négocier ferme vu la distance, et beaucoup de chauffeurs hésitent à pousser jusqu'à la baie : réserver d'avance reste l'option fiable. Prix vérifiés en juin 2026." },
  { q: "Combien de temps dure le trajet vers Imsouane ?", a: "Comptez 90 minutes à près de deux heures pour les 90 km. On remonte la côte au-delà de Taghazout, puis la route bifurque vers l'intérieur avant de redescendre par une approche finale sinueuse vers la baie, ce sont ces 20 derniers kilomètres lents qui allongent le trajet, pas la distance brute." },
  { q: "Pourquoi les surfeurs vont-ils jusqu'à Imsouane ?", a: "Pour « la baie », l'une des plus longues droites du Maroc, une vague lente et indulgente qui peut dérouler sur des centaines de mètres un bon jour. Plus douce que les pointes de Taghazout, elle est prisée des longboarders et des surfeurs qui progressent, et le village reste calme et brut. Le long transfert est le prix d'entrée." },
  { q: "Peut-on faire Imsouane à la journée ?", a: "Possible, mais la route à l'aller comme au retour en fait une longue journée. La plupart restent au moins une ou deux nuits pour que le trajet en vaille la peine, surfant la baie matin et soir. Pour un simple coup d'œil, un chauffeur privé qui attend est faisable mais serré, mieux vaut prévoir une nuit sur place." },
];
---
<RouteLayout
  lang={lang}
  title="Transfert aéroport Agadir – Imsouane : taxi et prix (2026) | AirportAGA"
  description="De l'aéroport Agadir Al Massira à Imsouane : 90 km au nord, environ deux heures jusqu'à la baie et sa célèbre longue droite. Prix transfert et taxi 2026, et pourquoi le tronçon final isolé impose de réserver."
  eyebrow="Trajets depuis l'AGA · Côte du surf"
  h1="Transfert aéroport Agadir → Imsouane"
  lede="Imsouane, c'est le long trajet, environ 90 km au nord et près de deux heures jusqu'à la baie réputée pour sa droite interminable. Voici le prix du transfert, pourquoi l'approche finale isolée impose de réserver d'avance, et comment planifier le voyage."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={70}
  heroImage={photos['taghazout']}
  heroProvider="transfer"
  heroCtaLabel="Voir les prix vers Imsouane"
  faqs={faqs}
  cta={{ heading: 'Jusqu\'au bout, jusqu\'à la baie', text: 'Une voiture privée à prix fixe ou un minivan avec place pour les planches de l\'arrivée AGA à Imsouane, vol suivi, les 90 km gérés, annulation gratuite sur la plupart des réservations.', provider: 'transfer', label: 'Réserver votre transfert Imsouane' }}
>
  <p>
    Imsouane, c'est le voyage surf qu'on fait pour une seule chose : la baie, et la longue droite lente
    qui s'y déroule. C'est le plus éloigné des transferts surf depuis l'aéroport, environ 90 km au
    nord, 90 minutes à près de deux heures. Pas de bus, pas de train, et l'approche finale vers la baie
    est assez isolée pour que ce soit le trajet où réserver d'avance prend tout son sens.
  </p>

  <h2 id="options">Y aller depuis l'aéroport</h2>
  <p>
    Deux façons réalistes de gagner la baie, et elles ne se valent pas pour un endroit aussi reculé :
  </p>
  <ul>
    <li><strong>Transfert privé réservé</strong>, un chauffeur attend avec votre nom et parcourt les 90 km jusqu'à votre camp ou maison d'hôtes au village. Dès 70 €, place pour les planches sur demande. Le choix fiable.</li>
    <li><strong>Grand taxi</strong>, possible mais à négocier ferme, et certains chauffeurs refusent le trajet isolé jusqu'à la baie ou demandent un supplément. Convenez le tarif complet et la destination avant de charger.</li>
    <li><strong>Voiture de location</strong>, judicieuse si vous parcourez toute la côte et voulez la liberté de suivre la houle entre Imsouane et Taghazout ; la route finale sinueuse passe sans souci en voiture normale.</li>
  </ul>


  <div class="widget-wrap">
    <iframe
      class="tpemd-iframe"
      srcdoc='<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:0;font-family:system-ui,sans-serif;overflow:hidden}</style></head><body><script async src="https://tpemd.com/content?currency=EUR&amp;trs=554574&amp;shmarker=697149&amp;locale=fr&amp;from=al%20massira%20airport&amp;to=Imssouane&amp;country=Morocco&amp;powered_by=true&amp;transfer_options_limit=10&amp;transfer_options=MCR&amp;disable_currency_selector=true&amp;hide_form_extras=true&amp;hide_external_links=true&amp;campaign_id=1&amp;promo_id=3879" charset="utf-8"><\/script><script>new MutationObserver(function(){document.documentElement.style.height="auto";window.parent.postMessage({tpemdHeight:document.body.scrollHeight},"*")}).observe(document.body,{childList:true,subtree:true,attributes:true})<\/script></body></html>'
      style="width:100%;border:none;min-height:200px;overflow:hidden;"
      loading="lazy"
      title="Transfer booking widget"
    ></iframe>
  </div>

  <h3 id="reserver">Réserver un transfert vers Imsouane</h3>
  <TransferOptions
    sub="aeroport-agadir-imsouane"
    options={[
      { provider: 'transfer', highlight: true, badge: 'Meilleur rapport', pitch: 'Une voiture ou un minivan avec place pour les planches sur les 90 km jusqu\'à la baie, dès 70 € le véhicule, avec suivi du vol et annulation gratuite jusqu\'à 24 h.', label: 'Voir les prix des transferts' },
      { provider: 'transfer-vip', badge: 'Accueil personnalisé', pitch: 'Un chauffeur nommé, anglophone, qui s\'engage sur le long trajet isolé, rassurant pour une première venue à Imsouane, avec un contact clair.', label: 'Réserver un transfert VIP' },
    ]}
  />

  <h2 id="route">À quoi ressemble le trajet</h2>
  <p>
    Le premier tronçon est la route côtière familière au-delà d'Aourir, Tamraght et Taghazout. Passé les
    villages de surf, la route bifurque vers l'intérieur sur des collines arides, puis redescend par 20
    derniers kilomètres sinueux jusqu'à la baie, c'est cette dernière section qui étire le voyage, pas
    la distance brute. C'est une route goudronnée ordinaire, rien qu'une voiture standard ne gère, mais
    lente : n'enchaînez pas un plan serré juste après le transfert et n'attendez guère de services avant
    d'atteindre le village.
  </p>

  <h2 id="baie">La baie et la longue droite</h2>
  <p>
    L'atout d'Imsouane, c'est « la baie », une longue droite douce qui peut dérouler sur des centaines
    de mètres quand elle marche, l'une des plus longues du Maroc. Plus douce et plus indulgente que les
    pointes plus nerveuses de Taghazout, elle attire longboarders, surfeurs en progrès et tous ceux qui
    cherchent une vague détendue plutôt que musclée. Le village reste petit et brut, un port de pêche
    en activité, quelques cafés et camps, et cet isolement fait justement tout son charme.
  </p>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Réglez espèces, SIM et provisions à Agadir avant de partir. Imsouane est petit et calme, avec peu
    de commerces et une acceptation de carte aléatoire. Le point partagé avec votre chauffeur compte ici
    aussi, car les maisons d'hôtes s'éparpillent autour de la baie plutôt que sur une seule rue nommée.
  </div>

  <p>
    Vous basez le séjour un peu plus près ? Comparez le trajet plus court
    <a href={L('/agadir-airport-to-taghazout/')}>aéroport → Taghazout</a>, et lisez notre
    <a href={L('/surfing-taghazout-guide/')}>guide du surf à Taghazout</a> pour le fonctionnement des
    spots et des saisons sur toute la côte. Pour tous les trajets depuis le terminal, voyez le
    <a href={L('/agadir-airport-transfers/')}>hub des transferts</a>.
  </p>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation, réservez via ces liens et nous pouvons percevoir
    une petite commission, sans surcoût pour vous. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>
</RouteLayout>
