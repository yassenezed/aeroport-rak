---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import { PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Guide de l'aéroport", href: L('/guide-aeroport-marrakech/') },
  { name: 'Services', href: L('/guide-aeroport-marrakech/services/') },
];

const toc = [
  { label: 'Argent et bureaux de change', id: 'argent' },
  { label: 'Wi-Fi, SIM et recharge', id: 'connexion' },
  { label: 'Manger et boire', id: 'restauration' },
  { label: 'Boutiques et duty-free', id: 'boutiques' },
  { label: 'Salons et espaces de repos', id: 'salons' },
  { label: 'Bagages, santé, prière', id: 'pratique' },
  { label: 'Familles et accessibilité', id: 'accessibilite' },
];

const faqs = [
  {
    q: "Quels services trouve-t-on à l'aéroport de Marrakech Ménara ?",
    a: "Les terminaux réunissent des distributeurs et des bureaux de change, des corners d'opérateurs mobiles, des cafés et enseignes de restauration, des boutiques et un duty-free, des salons, des pharmacies et un service médical, des salles de prière, des espaces famille et une assistance aux passagers à mobilité réduite. Le Wi-Fi est gratuit dans les terminaux."
  },
  {
    q: "Le Wi-Fi est-il gratuit à l'aéroport de Marrakech ?",
    a: "Oui, un réseau gratuit couvre les terminaux. Comme dans beaucoup d'aéroports, il peut être inégal aux heures de pointe et demander une connexion par portail. Si vous devez absolument être joignable en sortant — pour prévenir votre riad ou votre chauffeur — une eSIM activée avant le départ est nettement plus sûre."
  },
  {
    q: "Peut-on retirer et changer de l'argent à l'aéroport ?",
    a: "Oui, plusieurs distributeurs de banques marocaines et des bureaux de change opèrent dans les terminaux. Le dirham étant une devise fermée, vous ne pouvez pas en apporter de chez vous : le retrait sur place est le passage obligé. Privilégiez les automates bancaires et demandez des coupures de 100 MAD si l'écran le propose."
  },
  {
    q: "Y a-t-il une consigne à bagages au RAK ?",
    a: "Il n'existe pas de service de consigne fiable et permanent côté public : partez du principe que vous gardez vos bagages avec vous. Si vous avez une longue journée entre la libération de votre chambre et votre vol, la solution la plus simple reste de laisser vos valises à votre riad ou votre hôtel, qui le font systématiquement et gratuitement."
  },
  {
    q: "Y a-t-il des salles de prière à l'aéroport de Marrakech ?",
    a: "Oui, des salles de prière avec points d'ablution sont prévues dans les terminaux, signalées en arabe et en français, côté public comme côté piste."
  },
  {
    q: "L'aéroport est-il accessible aux personnes à mobilité réduite ?",
    a: "Oui. Une assistance est prévue et des places de stationnement dédiées se trouvent au plus près des entrées. Comme partout, la demande doit se faire auprès de votre compagnie aérienne au moins 48 heures avant le vol : c'est elle qui déclenche la prestation, pas l'aéroport."
  },
];
---
<GuideLayout
  keywords="services aéroport Marrakech, wifi RAK, distributeur aéroport Marrakech, duty free Marrakech"
  title={"Services de l'aéroport de Marrakech Ménara"}
  description={"Les terminaux du RAK : distributeurs, bureaux de change, Wi-Fi gratuit, SIM, restauration, duty-free, salons, pharmacie, salles de prière et PMR."}
  eyebrow="Guide de l'aéroport · Services"
  h1="Services et équipements de l'aéroport de Marrakech"
  lede="Ce qui existe vraiment dans les terminaux, ce qu'il vaut mieux régler avant d'atterrir, et les deux ou trois choses que les voyageurs cherchent en vain une fois sur place."
  breadcrumbs={breadcrumbs}
  heroImage={photos['rak-terminal']}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: 'Le trajet, lui, se règle avant', text: "Les services de l'aéroport, vous les trouverez sur place. Le prix de votre course vers la médina, mieux vaut le connaître avant de sortir du hall.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    Marrakech Ménara est un aéroport de 9,3 millions de passagers annuels réparti sur deux terminaux
    logés dans un même bâtiment d'environ 42 000 m². Les services y sont ceux d'une grande plateforme
    touristique : complets, mais inégalement répartis entre le côté public et le côté piste. Voici ce
    qui compte réellement.
  </p>

  <h2 id="argent">Argent et bureaux de change</h2>
  <p>
    C'est le premier arrêt utile. Distributeurs de banques marocaines et bureaux de change sont présents
    dans les terminaux, y compris au niveau des arrivées. Rappel qui surprend encore beaucoup de
    voyageurs : le dirham est une <strong>devise fermée</strong>. Vous ne pouvez pas en acheter avant de
    partir, ni en rapporter chez vous en quantité. Le retrait à l'arrivée n'est donc pas une option de
    confort, c'est le point de passage.
  </p>
  <p>
    Retirez de quoi couvrir votre trajet, les pourboires et votre première journée. Demandez des
    coupures de 100 MAD si l'automate le permet : avec un billet de 200, ni le taxi ni le porteur ne
    rendront la monnaie. Notre page
    {' '}<a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix taxi</a> vous donne le montant
    exact à prévoir.
  </p>

  <h2 id="connexion">Wi-Fi, cartes SIM et recharge</h2>
  <p>
    Le Wi-Fi gratuit couvre les terminaux. Il fait le travail pour consulter un message, moins bien pour
    dépendre entièrement de lui à l'instant où vous sortez. Les corners des opérateurs marocains vendent
    des SIM prépayées sur présentation du passeport, avec une activation de quelques minutes.
    L'alternative, plus confortable, est une
    {' '}<a href={L('/esim-maroc/')}>eSIM installée avant le départ</a> : vous atterrissez déjà connecté,
    ce qui compte quand il faut confirmer une arrivée à un riad ou retrouver un chauffeur.
  </p>
  <p>
    Les prises de recharge existent dans les salles d'embarquement mais restent disputées aux heures de
    pointe. Une batterie externe chargée avant le retour reste le réflexe le plus sûr.
  </p>

  <h2 id="restauration">Manger et boire</h2>
  <p>
    Cafés, sandwicheries et enseignes de restauration rapide sont présents des deux côtés du contrôle,
    avec une offre plus fournie côté piste. C'est correct pour patienter, sans plus, et les prix sont
    ceux d'un aéroport — comptez trois à quatre fois le prix d'un café en médina. Si vous partez d'un
    vol de fin de matinée, le meilleur arbitrage reste de déjeuner en ville avant de venir : nos
    adresses sont dans <a href={L('/restaurants-marrakech/')}>où manger à Marrakech</a>.
  </p>

  <h2 id="boutiques">Boutiques et duty-free</h2>
  <p>
    Le duty-free et plusieurs boutiques de souvenirs occupent la zone d'embarquement. Précision utile
    pour les achats de dernière minute : l'artisanat y coûte nettement plus cher qu'aux souks, et le
    choix est plus étroit. Si vous voulez rapporter de l'huile d'argan, des épices ou de la vaisselle,
    achetez en ville — voyez
    {' '}<a href={L('/shopping-souvenirs-marrakech/')}>souks et shopping</a> — et gardez l'aéroport pour
    ce que vous auriez oublié.
  </p>
  <div class="callout">
    <span class="callout-label">Le piège des liquides</span>
    <p>
      L'huile d'argan, l'eau de fleur d'oranger et les cosmétiques achetés en médina dépassent presque
      toujours les 100 ml autorisés en cabine. Prévoyez-les en soute, emballés dans un sac plastique
      fermé : ces bouteilles fuient plus souvent qu'on ne le croit.
    </p>
  </div>

  <h2 id="salons">Salons et espaces de repos</h2>
  <p>
    Le RAK dispose de salons accessibles à l'achat ou via certaines cartes bancaires et programmes de
    fidélité. L'intérêt dépend de votre attente : sur un vol du matin, avec trois heures d'avance et un
    terminal chargé, un salon transforme le moment ; pour quarante minutes, il ne se justifie pas. Les
    conditions et les tarifs varient selon l'opérateur du salon et se vérifient sur place ou lors de la
    réservation en ligne.
  </p>

  <h2 id="pratique">Bagages, santé et prière</h2>
  <p>
    Chariots à bagages, service d'emballage de valises, pharmacie et service médical sont présents. En
    revanche, ne comptez pas sur une consigne à bagages : la solution habituelle pour une journée de
    battement est de laisser vos valises à votre hébergement, ce que tous les riads font gratuitement.
    Les salles de prière avec points d'ablution sont signalées en arabe et en français, côté public
    comme côté piste.
  </p>

  <h2 id="accessibilite">Familles et accessibilité</h2>
  <p>
    Les espaces famille et les tables à langer existent dans les terminaux. Pour les passagers à
    mobilité réduite, l'assistance se demande auprès de la compagnie aérienne, au moins 48 heures avant
    le départ : c'est la compagnie qui déclenche la prestation, et non l'aéroport. Des places de
    stationnement dédiées sont situées au plus près des entrées, comme indiqué sur notre page
    {' '}<a href={L('/guide-aeroport-marrakech/parking/')}>parking de l'aéroport</a>.
  </p>
  <p>
    Voyager avec de jeunes enfants change aussi la logistique du trajet vers la ville, notamment pour
    les sièges-auto, qui ne sont jamais fournis en taxi. Nous détaillons ce point dans
    {' '}<a href={L('/marrakech-en-famille/')}>Marrakech en famille</a>.
  </p>
</GuideLayout>
