---
import GuideLayout from '../../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import FlightWidget from '../../components/ui/FlightWidget.astro';
import { airport, PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Guide de l'aéroport", href: L('/guide-aeroport-marrakech/') },
  { name: 'Arrivées', href: L('/guide-aeroport-marrakech/arrivees/') },
];

const toc = [
  { label: 'Vols en temps réel', id: 'vols' },
  { label: 'La fiche de police', id: 'fiche' },
  { label: 'Contrôle des passeports', id: 'passeport' },
  { label: 'Bagages et douane', id: 'bagages' },
  { label: 'Dirhams et connexion', id: 'argent' },
  { label: 'La sortie et les rabatteurs', id: 'sortie' },
  { label: 'Retrouver son chauffeur', id: 'chauffeur' },
];

const faqs = [
  {
    q: "Combien de temps faut-il pour sortir des arrivées à Marrakech ?",
    a: "Entre 30 et 50 minutes en temps normal, du débarquement au parvis. Le contrôle des passeports est l'étape la plus variable : quand plusieurs vols européens se posent dans la même demi-heure, en fin d'après-midi ou en soirée, il faut parfois compter une heure. Les bagages arrivent généralement pendant que vous faites la queue, ce qui absorbe une partie de l'attente."
  },
  {
    q: "Faut-il remplir une fiche de police à l'arrivée au Maroc ?",
    a: "Oui, une fiche d'entrée est demandée au contrôle des passeports. Elle est le plus souvent distribuée à bord en fin de vol : remplissez-la pendant le vol, avec l'adresse exacte de votre hébergement. Sans elle, vous devrez sortir de la file, la remplir sur un comptoir et vous replacer à la fin."
  },
  {
    q: "Y a-t-il des distributeurs de billets dans le hall des arrivées ?",
    a: "Oui, plusieurs automates de banques marocaines ainsi que des bureaux de change. Retirez de quoi couvrir le trajet et votre première journée. Le dirham est une devise fermée : vous ne pouvez pas en emporter depuis chez vous, et vous devrez dépenser ou reconvertir ce qu'il vous reste avant de repartir."
  },
  {
    q: "Peut-on acheter une carte SIM à l'aéroport de Marrakech ?",
    a: "Oui, les opérateurs marocains tiennent des corners dans le hall. Comptez quelques minutes, votre passeport et un prix modique pour une SIM prépayée avec de la data. Si vous préférez être connecté dès l'atterrissage — pratique pour prévenir votre riad — une eSIM installée avant le départ fait le travail sans passer par un guichet."
  },
  {
    q: "Comment retrouver le chauffeur de mon transfert à Marrakech ?",
    a: "Il vous attend dans le hall des arrivées, après la douane, avec une pancarte à votre nom. La zone est compacte et facile à balayer du regard. Traversez sans vous arrêter auprès des personnes qui vous abordent avant : votre chauffeur, lui, reste à sa place avec son panneau."
  },
  {
    q: "Peut-on utiliser Uber ou Careem à l'arrivée à Marrakech ?",
    a: `Ne comptez pas dessus pour votre arrivée. Uber est revenu à Marrakech fin novembre 2025, mais uniquement avec des transporteurs touristiques agréés, et sa disponibilité reste irrégulière ; Careem et inDrive fonctionnent dans une zone juridique encore floue, les autorités annonçant un cadre réglementaire à venir. Les taxis, eux, s'opposent farouchement à ces services, et la prise en charge devant les terminaux est le point de friction principal. Pour l'aéroport, les options fiables restent le rang de taxis officiel et le transfert réservé ; les applications peuvent dépanner en ville, en vérifiant que le véhicule et le chauffeur correspondent à l'écran. Le taxi au rang coûte ${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]} MAD le jour vers la médina.`
  },
];
---
<GuideLayout
  keywords="arrivées aéroport Marrakech, vols arrivée RAK, sortie aéroport Marrakech, fiche police Maroc"
  title="Arrivées à l'aéroport de Marrakech : le parcours pas à pas (2026) | AirportRAK"
  description="De la passerelle au parvis : durée des formalités au RAK, fiche de police, contrôle des passeports, distributeurs, carte SIM, rang de taxis et comment retrouver son chauffeur. Avec les vols en temps réel."
  eyebrow="Guide de l'aéroport · Arrivées"
  h1="Arrivées à l'aéroport de Marrakech, pas à pas"
  lede="Ce qui se passe réellement entre le moment où l'avion s'immobilise et celui où vous montez en voiture. De quoi sortir du hall avec des dirhams, du réseau et un plan, plutôt qu'en cherchant qui suivre."
  breadcrumbs={breadcrumbs}
  heroImage={photos['rak-arrivals']}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: 'Un chauffeur qui vous attend avec votre nom', text: "Le vol est suivi, le prix est fixe, et la dépose se fait à la porte la plus proche de votre riad. C'est la différence entre arriver et chercher.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <h2 id="vols">Vols en temps réel à Marrakech Ménara</h2>
  <p>
    Si vous venez chercher quelqu'un, fiez-vous à ce tableau plutôt qu'à l'horaire du billet, et ajoutez
    une quarantaine de minutes entre l'atterrissage affiché et l'apparition de votre passager sur le
    parvis.
  </p>
  <FlightWidget type="arrivals" />

  <h2 id="fiche">La fiche de police : à remplir dans l'avion</h2>
  <p>
    Une fiche d'entrée vous sera demandée au contrôle. Le personnel de cabine la distribue en général
    avant l'atterrissage : remplissez-la à bord, tant que vous avez une tablette devant vous et de la
    lumière. Il vous faudra votre numéro de passeport, votre profession et surtout l'adresse complète de
    votre hébergement. Notez-la sur votre téléphone avant de partir, car un nom de riad seul ne suffit
    pas toujours.
  </p>

  <h2 id="passeport">Le contrôle des passeports</h2>
  <p>
    C'est l'étape qui décide de la durée totale. Marrakech reçoit énormément de vols européens
    concentrés sur quelques créneaux : quand quatre appareils se vident en même temps, la file devient
    longue, même si elle avance à un rythme constant. Les ressortissants de l'Union européenne n'ont pas
    besoin de visa pour un séjour touristique de moins de 90 jours, mais votre passeport doit être
    valide pendant toute la durée du séjour. Les conditions précises sont détaillées dans notre page
    {' '}<a href={L('/formalites-entree-maroc/')}>formalités d'entrée au Maroc</a>.
  </p>
  <div class="callout">
    <span class="callout-label">Gagner dix minutes</span>
    <p>
      Descendez de l'avion sans traîner et marchez d'un bon pas jusqu'au contrôle : sur un vol plein,
      l'écart entre les premiers et les derniers passagers dans la file dépasse souvent vingt minutes.
      Vos bagages, eux, tourneront de toute façon sur le tapis.
    </p>
  </div>

  <h2 id="bagages">Bagages et douane</h2>
  <p>
    Les tapis se trouvent immédiatement après le contrôle. Les bagages sortent en général dans les
    vingt minutes suivant l'atterrissage, donc souvent pendant que vous faites la queue. En cas de
    bagage manquant, le comptoir de la compagnie se trouve dans la même salle : faites établir le
    constat avant de sortir, c'est beaucoup plus simple que d'y revenir le lendemain. La douane est un
    couloir que l'on traverse sans formalité dans l'immense majorité des cas.
  </p>

  <h2 id="argent">Dirhams et connexion, avant de franchir les portes</h2>
  <p>
    Deux choses à régler pendant que vous êtes encore à l'intérieur. D'abord les espèces : taxi,
    porteur, pourboires et petits achats fonctionnent en dirhams, et la carte bancaire est rarement
    acceptée en dehors des hôtels et des grandes enseignes. Les distributeurs du hall sont fiables ;
    si l'automate vous laisse choisir, privilégiez les coupures de 100 MAD. Rappel utile : le dirham ne
    s'exporte pas, inutile d'en retirer pour trois semaines si vous restez cinq jours.
  </p>
  <p>
    Ensuite la connexion. Les corners des opérateurs marocains vendent des SIM prépayées sur
    présentation du passeport, ou vous arrivez déjà connecté avec une
    {' '}<a href={L('/esim-maroc/')}>eSIM activée avant le départ</a>. C'est plus confortable qu'il n'y
    paraît : c'est précisément au moment de sortir que vous aurez besoin d'écrire à votre riad ou de
    vérifier une adresse.
  </p>

  <h2 id="sortie">La sortie, et les propositions qui vont avec</h2>
  <p>
    Les portes du hall donnent directement sur le parvis, et vous serez sollicité. Ce n'est ni agressif
    ni dangereux, mais les prix annoncés dans le hall sont systématiquement supérieurs à ceux du rang
    officiel. Le réflexe simple : si vous n'avez rien réservé, avancez jusqu'à la station de taxis et
    traitez là-bas, après avoir regardé le panneau tarifaire. Nos repères chiffrés sont sur la
    {' '}<a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix taxi</a>.
  </p>
  <p>
    Pour le bus {airport.bus.line}, traversez le parking : l'arrêt se trouve de l'autre côté,
    {' '}{airport.bus.oneWayMad} MAD jusqu'à Jemaa el-Fna, dernier départ vers
    {' '}{airport.bus.lastDeparture}.
  </p>

  <h2 id="chauffeur">Si vous avez réservé un transfert</h2>
  <p>
    Votre chauffeur attend dans le hall, après la douane, avec une pancarte portant votre nom. Deux
    conseils qui évitent l'essentiel des ratés : transmettez votre numéro de vol au moment de la
    réservation, afin qu'un retard soit absorbé automatiquement, et indiquez le nom du riad
    <em>avec</em> la porte de la médina la plus proche. Le chauffeur saura alors exactement où
    s'arrêter, au lieu de choisir la porte qui l'arrange. Tout est expliqué sur notre page
    {' '}<a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>, et les
    options se comparent sur
    {' '}<a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport Marrakech</a>.
  </p>
</GuideLayout>
