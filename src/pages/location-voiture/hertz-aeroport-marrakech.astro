---
import ReviewLayout from '../../layouts/ReviewLayout.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import { PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Location de voiture', href: L('/location-voiture-aeroport-marrakech/') },
  { name: 'Hertz', href: L('/location-voiture/hertz-aeroport-marrakech/') },
];

const pros = [
  'Comptoir dans le hall des arrivées, clés en main sans quitter le terminal',
  'Procédure identique à celle des autres aéroports : aucune surprise de méthode',
  'Politique plein-à-plein sur la plupart des tarifs, la plus équitable',
  'Recours et service client structurés en cas de litige au retour',
  'Flotte correctement entretenue pour les longues routes de l\'Atlas',
];
const cons = [
  'Tarif journalier nettement au-dessus des agences marocaines',
  'Empreinte de caution dans le haut de la fourchette du marché',
  'Franchise de base élevée sans rachat, vendu avec insistance au comptoir',
  'Boîtes automatiques rares et à réserver très en avance',
];

const faqs = [
  {
    q: "Où se trouve le comptoir Hertz à l'aéroport de Marrakech ?",
    a: "Dans le hall des arrivées, parmi la rangée des loueurs, à quelques dizaines de mètres des tapis à bagages. Vous n'avez pas à sortir du terminal ni à prendre une navette : le véhicule est récupéré au parking voisin, après signature."
  },
  {
    q: "Quelle caution Hertz demande-t-il à Marrakech ?",
    a: "Une empreinte sur carte de crédit au nom du conducteur principal, dans le haut du marché local selon la catégorie du véhicule — comptez plusieurs milliers de dirhams. La carte de débit est refusée. Vérifiez le montant exact sur votre réservation et assurez-vous que le plafond disponible le supporte, surtout si vous réglez aussi l'hôtel avec la même carte."
  },
  {
    q: "Quelle est la politique de carburant de Hertz au RAK ?",
    a: "La majorité des tarifs sont en plein-à-plein : vous partez avec le réservoir plein et le rendez plein. C'est la formule la plus juste. Vérifiez néanmoins la ligne sur votre tarif précis, et conservez le ticket de la station la plus proche de l'aéroport pour justifier le plein au retour."
  },
  {
    q: "Hertz vaut-il son surcoût face à une agence marocaine ?",
    a: "Si votre itinéraire reste urbain et court, l'écart de prix est difficile à justifier. Il devient défendable dès que vous partez loin — Ouarzazate, Essaouira, plusieurs jours de montagne — parce que l'entretien du véhicule et la qualité de l'assistance en cas de panne prennent alors plus de valeur que dix euros par jour."
  },
  {
    q: "Peut-on rendre la voiture en dehors des horaires d'ouverture ?",
    a: "C'est possible dans la plupart des cas, mais des frais de restitution hors horaires peuvent s'appliquer et le véhicule reste sous votre responsabilité jusqu'à l'inspection. Pour un vol très matinal, faites confirmer la procédure par écrit et photographiez la voiture au moment de la laisser."
  },
];
---
<ReviewLayout
  title="Avis Hertz à l'aéroport de Marrakech : comptoir, caution et carburant (2026) | AirportRAK"
  description="Notre avis sur Hertz au RAK : emplacement du comptoir dans les arrivées, montant de caution, politique de carburant, franchise et à quels voyageurs l'enseigne convient vraiment."
  eyebrow="Aéroport Marrakech Ménara · Avis location"
  h1="Avis Hertz à l'aéroport de Marrakech"
  lede="Le choix de la prévisibilité. Comptoir dans les arrivées, procédure connue, carburant plein-à-plein : vous payez plus qu'une agence locale et laissez une caution plus élevée, en échange de zéro surprise de méthode."
  breadcrumbs={breadcrumbs}
  heroImage={photos['marrakech-car-rental']}
  brand="Hertz"
  rating={3.9}
  verdict="Une valeur sûre au RAK : facile à trouver, conditions lisibles, carburant équitable et vrai service client en cas de litige. Le tarif journalier et la caution se situent au-dessus du marché local, ce qui rend l'enseigne surtout pertinente pour les longs itinéraires et les voyageurs qui refusent l'aléa."
  pros={pros}
  cons={cons}
  heroProvider="discovercars"
  heroCtaLabel="Voir les tarifs Hertz au RAK"
  faqs={faqs}
  cta={{ heading: 'Comparez Hertz aux autres comptoirs du RAK', text: "Tarif, caution, politique de carburant et franchise côte à côte, pour arbitrer sur le coût réel plutôt que sur le prix affiché.", provider: 'discovercars', label: 'Comparer les prix de location' }}
>
  <p>
    Hertz est le réflexe de beaucoup de voyageurs à Marrakech, et ce n'est pas illogique : l'enseigne
    applique ici la même méthode que partout ailleurs. Le comptoir est dans le hall des arrivées, le
    contrat ressemble à celui que vous avez déjà signé en Europe, et la politique de carburant est la
    plus honnête du marché. Ce que vous achetez, au fond, c'est l'absence de mauvaise surprise sur la
    procédure.
  </p>
  <p>
    Le prix de cette tranquillité est réel. Sur des dates comparables, Hertz se situe régulièrement au-dessus
    des agences marocaines de l'aéroport, et son empreinte de caution figure parmi les plus élevées.
    Tarifs et conditions relevés en {PRICES_CHECKED}.
  </p>

  <h2>À qui Hertz convient au RAK</h2>
  <p>
    L'enseigne se justifie dans trois situations. D'abord les <strong>longs itinéraires</strong> :
    Ouarzazate par le Tizi n'Tichka, la côte jusqu'à Essaouira, une semaine de montagne. Sur ces routes,
    l'état du véhicule et la fiabilité de l'assistance pèsent bien plus lourd que l'écart de tarif.
    Ensuite les <strong>voyageurs d'affaires</strong>, qui ont besoin d'une facture propre et d'un
    processus rapide. Enfin les <strong>premiers séjours au Maroc</strong>, quand on préfère ne pas
    ajouter l'inconnu d'une petite agence à celui du pays.
  </p>

  <h2>Les deux points à préparer avant le comptoir</h2>
  <p>
    <strong>La carte de crédit.</strong> Elle doit être au nom du conducteur principal, être une vraie
    carte de crédit et disposer du plafond nécessaire. C'est la première cause de refus au guichet, tous
    loueurs confondus.
  </p>
  <p>
    <strong>La franchise.</strong> Le tarif de base laisse une franchise élevée. Le rachat proposé au
    comptoir est la solution la plus chère : si votre carte bancaire couvre déjà la location, vérifiez-le
    avant de partir et faites-le noter ; sinon, souscrivez la couverture en ligne à la réservation. Nous
    détaillons ces arbitrages sur
    {' '}<a href={L('/location-voiture-aeroport-marrakech/pas-cher/')}>location pas chère au RAK</a>.
  </p>

  <h2>Notre verdict</h2>
  <p>
    Hertz n'est pas le tarif le plus bas de l'aéroport de Marrakech, et ne cherche pas à l'être. C'est
    un choix cohérent quand la route est longue ou quand la sérénité vaut son prix. Pour un usage
    ponctuel en ville, comparez d'abord avec une agence locale bien notée — la question du véhicule
    importe alors beaucoup moins. Voyez aussi nos fiches
    {' '}<a href={L('/location-voiture/europcar-aeroport-marrakech/')}>Europcar</a> et
    {' '}<a href={L('/location-voiture/sixt-aeroport-marrakech/')}>Sixt</a>.
  </p>
</ReviewLayout>
