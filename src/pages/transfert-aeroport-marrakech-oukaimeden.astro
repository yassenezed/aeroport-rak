---
import RouteLayout from '../layouts/RouteLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
  { name: 'Vers Sidi Ifni', href: L('/agadir-airport-to-sidi-ifni/') },
];
const facts = [
  { label: 'Distance', value: '165 km' },
  { label: 'Durée', value: '2h30–2h45', sub: '' },
  { label: 'Transfert réservé', value: '110 €', sub: 'dès' },
  { label: 'Grand taxi', value: 'à négocier', sub: '' },
];
const faqs = [
  { q: "À quelle distance est Sidi Ifni de l'aéroport d'Agadir ?", a: "Environ 165 km vers le sud par la côte, soit 2h30 à 2h45 de route via Tiznit et en passant par Legzira. Pas de train, pas de bus direct depuis l'aéroport : c'est donc un transfert privé ou un grand taxi longue distance négocié à la station." },
  { q: "Combien coûte un transfert de l'aéroport d'Agadir à Sidi Ifni ?", a: "Un transfert privé porte-à-porte démarre autour de 110 € pour la voiture entière. Sur 165 km de route du Sud, un prix fixé avant le départ est en général plus serein et plus fiable que la négociation d'un grand taxi. Prix vérifiés en juin 2026." },
  { q: "Pour quoi Sidi Ifni est-elle connue ?", a: "Pour son passé colonial espagnol. Sidi Ifni est restée espagnole jusqu'en 1969, et l'héritage saute aux yeux : façades Art déco patinées, ancienne place, ambiance de ville portuaire qu'on ne retrouve nulle part ailleurs sur la côte. Ajoutez les grandes vagues atlantiques, une lumière saisissante et un rythme lent, et c'est une favorite des voyageurs en quête d'autre chose." },
  { q: "Peut-on associer Sidi Ifni à la plage de Legzira ?", a: "Facilement. Legzira se trouve sur la route entre Mirleft et Sidi Ifni, donc un chauffeur privé peut s'y arrêter en descendant. Beaucoup associent les deux et coupent le trajet pour les falaises de grès rouge avant de continuer vers Sidi Ifni." },
  { q: "Combien de temps prend la route vers Sidi Ifni ?", a: "Comptez 2h30 à 2h45. La portion rapide descend jusqu'à Tiznit ; ensuite la route file vers la côte et redescend par Mirleft et Legzira sur des axes plus calmes et plus jolis. Un long trajet mais qui en vaut la peine, à ne pas précipiter en fin de journée de voyage." },
];
---
<RouteLayout
  lang={lang}
  title="Aéroport Agadir vers Sidi Ifni : transfert, taxi et prix (2026) | AirportAGA"
  description="De l'aéroport Agadir Al Massira à Sidi Ifni : 165 km vers le sud par la côte, environ 2h45 via Tiznit et Legzira. Prix des transferts 2026, et ce que vaut cette ville portuaire à l'héritage colonial espagnol."
  eyebrow="Trajets depuis l'AGA · Côte sud"
  h1="Aéroport Agadir vers Sidi Ifni"
  lede="Sidi Ifni est à 165 km au sud par la côte, environ 2h45 via Tiznit et Legzira jusqu'à une ville portuaire à l'héritage colonial espagnol qui ne ressemble à rien d'autre au Maroc. Voici ce que coûte le transfert et comment organiser le trajet."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={110}
  heroImage={photos['souss-coast']}
  heroProvider="transfer"
  heroCtaLabel="Voir les prix vers Sidi Ifni"
  faqs={faqs}
  cta={{ heading: 'Cap au sud, vers l\'ancien port espagnol', text: 'Une voiture privée à prix fixe des arrivées de l\'AGA jusqu\'à Sidi Ifni, vol suivi, les 165 km pris en charge, annulation gratuite sur la plupart des réservations. Un arrêt à Legzira en chemin sur demande.', provider: 'transfer', label: 'Réserver votre transfert Sidi Ifni' }}
>
  <p>
    Sidi Ifni ne ressemble pas au reste de la côte marocaine, et c'est tout son intérêt. Restée espagnole
    jusqu'en 1969, elle a gardé l'ossature d'une ville coloniale, façades Art déco patinées, ancienne
    place très dessinée, perchée au-dessus des grandes vagues atlantiques, et il en sort une ville
    portuaire lente, un peu mélancolique, dont les voyageurs tombent amoureux. Elle est à environ 165 km
    au sud de l'aéroport, soit 2h30 à 2h45 via Tiznit et Legzira. Ni train ni bus direct : c'est un
    transfert privé ou un grand taxi longue distance.
  </p>

  <h2 id="options">Comment y aller depuis l'aéroport</h2>
  <p>
    Deux façons réalistes de descendre la côte sud :
  </p>
  <ul>
    <li><strong>Transfert privé</strong>, vous accueille aux arrivées et conduit les 165 km jusqu'à votre maison d'hôtes, ce qui compte aussi loin au sud où les adresses sont dispersées et la route longue. Dès environ 110 € pour la voiture.</li>
    <li><strong>Grand taxi</strong>, fait le trajet si vous négociez ferme, mais sur cette distance et ces routes du Sud plus calmes, un prix fixe réservé à l'avance est plus simple et plus fiable. Convenez du prix complet et de la destination avant de charger.</li>
    <li><strong>Voiture de location</strong>, une bonne option si vous explorez la côte sud sur plusieurs jours, en bouclant Legzira, Mirleft et Sidi Ifni à votre rythme.</li>
  </ul>

  <h3 id="book">Réserver un transfert vers Sidi Ifni</h3>
  <TransferOptions
    sub="agadir-to-sidi-ifni"
    options={[
      { provider: 'transfer', highlight: true, badge: 'Meilleur rapport qualité-prix', pitch: 'Une voiture ou un minivan à prix fixe sur les 165 km jusqu\'à Sidi Ifni, dès environ 110 € pour le véhicule, avec suivi du vol et annulation gratuite jusqu\'à 24 h.', label: 'Voir les prix des transferts' },
      { provider: 'transfer-vip', badge: 'Accueil personnalisé', pitch: 'Un chauffeur nommé et anglophone qui s\'engage sur le long trajet du Sud, rassurant pour un premier voyage aussi loin sur la côte.', label: 'Réserver un transfert VIP' },
    ]}
  />

  <h2 id="town">La ville coloniale espagnole</h2>
  <p>
    Le caractère de Sidi Ifni, c'est son histoire. Les Espagnols ne l'ont rendue qu'en 1969, laissant
    derrière eux une ville pensée sur plan, une place centrale, des bâtiments publics Art déco qui
    s'érodent doucement, des ruelles bleu et blanc qui dévalent vers la mer. C'est un port en activité,
    avec une vraie flotte de pêche, de grosses vagues qui déroulent depuis l'Atlantique et une lumière
    que les photographes adorent. On y vient pour l'atmosphère et le sentiment d'avoir atteint un endroit
    hors des circuits, pas pour le vernis balnéaire.
  </p>

  <h2 id="legzira">Couper le trajet à Legzira</h2>
  <p>
    La descente passe par la plage de Legzira, cette étendue sauvage de falaises de grès rouge entre
    Mirleft et Sidi Ifni. Ça vaut la peine de prévenir votre chauffeur à l'avance si vous voulez vous y
    arrêter, ça coupe les 2h45 de route et c'est sincèrement l'un des temps forts de la côte sud, à voir
    de préférence dans la lumière basse de fin d'après-midi. De Legzira, il ne reste qu'une courte étape
    jusqu'à Sidi Ifni.
  </p>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Partez le plein fait, avec de l'eau et la position de votre maison d'hôtes enregistrée hors ligne.
    Plus on descend au sud, plus les services se raréfient, et les ruelles en pente de Sidi Ifni avec ses
    maisons d'hôtes éparpillées sont bien plus simples pour un chauffeur qui a le point que pour un autre
    travaillant à partir d'une seule adresse.
  </div>

  <p>
    Vous passez par la côte ? Comparez le trajet
    <a href={L('/agadir-airport-to-mirleft/')}>aéroport vers Mirleft</a> juste en amont, le compagnon
    naturel d'un voyage sur la côte sud. Pour tous les trajets depuis le terminal et la comparaison des
    prestataires, voyez le <a href={L('/agadir-airport-transfers/')}>hub des transferts</a>.
  </p>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation : si vous réservez un transfert via ces liens, nous
    pouvons percevoir une petite commission, sans surcoût pour vous. Cela ne change ni les prix
    affichés ni nos recommandations. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>
</RouteLayout>
