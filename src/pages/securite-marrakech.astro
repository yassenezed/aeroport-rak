---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Sécurité", href: L("/securite-marrakech/") },
];

const toc = [
  { label: "Le niveau de risque réel", id: "risque" },
  { label: "Les arnaques classiques", id: "arnaques" },
  { label: "Les voyageuses seules", id: "femmes" },
  { label: "Taxis, argent, effets personnels", id: "pratique" },
  { label: "Santé, eau, chaleur", id: "sante" },
  { label: "Ce qui est interdit ou mal vu", id: "regles" },
  { label: "Numéros d'urgence", id: "urgences" },
];

const faqs = [
  { q: "Marrakech est-elle dangereuse pour un touriste ?", a: "Non, les violences envers les visiteurs sont rares et les zones touristiques sont très surveillées, y compris par une brigade dédiée. Les risques réels sont la petite délinquance — vol à la tire ou à l'arraché dans les foules —, les arnaques et l'insistance des rabatteurs. Ces désagréments se gèrent avec des réflexes simples." },
  { q: "Une femme seule peut-elle voyager à Marrakech ?", a: "Oui, de nombreuses voyageuses le font. Attendez-vous à des remarques et à de l'insistance, surtout dans la médina : ignorer, marcher d'un pas assuré et ne pas engager la conversation suffit généralement. Une tenue couvrant épaules et genoux réduit les sollicitations. Le soir, préférez les grands axes éclairés et les taxis ou transferts réservés." },
  { q: "Peut-on boire l'eau du robinet ?", a: "Mieux vaut l'éviter et boire de l'eau en bouteille scellée, y compris pour se brosser les dents si votre estomac est sensible. Les glaçons des hôtels sont généralement sûrs ; ceux des stands de rue, moins. La déshydratation guette bien plus souvent que la gastro : buvez régulièrement." },
  { q: "Que faire en cas de vol ou de perte de documents ?", a: "Déclarez-le au commissariat le plus proche : le procès-verbal est indispensable pour votre assurance et pour un duplicata de passeport auprès de votre consulat. Gardez une copie numérique de vos papiers séparée des originaux." },
  { q: "Le séisme de 2023 a-t-il affecté Marrakech ?", a: "Le séisme du 8 septembre 2023 avait son épicentre dans le Haut Atlas, et les villages de montagne ont été les plus durement touchés. Marrakech a subi des dégâts limités, notamment sur certaines maisons de la médina et sur des éléments des remparts. La vie touristique a repris ; vérifiez toutefois l'ouverture et les horaires des monuments avant de venir." },
  { q: "Peut-on consommer de l'alcool à Marrakech ?", a: "Oui dans les hôtels, certains restaurants et les bars licenciés, principalement à Guéliz et à l'Hivernage. Boire dans la rue ou dans un lieu public est interdit. Pendant le ramadan, la vente et la consommation sont plus restreintes dans la journée." },
];
---
<GuideLayout
  keywords="Marrakech sécurité, arnaques Marrakech, femme seule Marrakech, numéro urgence Maroc"
  title={"Marrakech est-elle sûre ? Arnaques, santé, femmes seules et numéros utiles (2026) | AirportRAK"}
  description={"Marrakech est-elle une ville sûre pour un touriste ? Petite délinquance, arnaques classiques, voyageuses seules, taxis, eau et santé, séisme de 2023, règles à respecter et numéros d'urgence."}
  eyebrow={"Marrakech · Sécurité"}
  h1={"Marrakech est-elle une ville sûre ?"}
  lede={"Oui, dans l'ensemble : des millions de touristes la visitent chaque année sans incident. Les désagréments sont surtout de l'ordre de l'insistance et de la petite arnaque. Voici lesquels, et comment les éviter."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-safe"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Arriver sans stress", text: "Un transfert réservé, avec chauffeur nommé et prix fixe, supprime le moment de l'arrivée où l'on est le plus exposé aux sollicitations.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="risque">Le niveau de risque réel</h2>
<p>
  Marrakech accueille chaque année plusieurs millions de visiteurs, et l'immense majorité repart avec
  de bons souvenirs. Les zones touristiques sont surveillées, la brigade touristique est visible, et les
  agressions graves contre des visiteurs sont exceptionnelles. Ce qui gâche parfois un séjour est d'un
  autre ordre : l'insistance des rabatteurs, la petite arnaque et le vol à la tire dans la foule.
</p>
<p>
  Rappelons aussi le contexte : la région a été touchée par le séisme du 8 septembre 2023, dont
  l'épicentre se situait dans le Haut Atlas. Marrakech a subi des dégâts limités, et les principaux
  monuments sont de nouveau accessibles ; vérifiez néanmoins les horaires avant de planifier une visite.
</p>

<h2 id="arnaques">Les arnaques classiques</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Arnaque</th><th>Comment ça se passe</th><th>Réponse</th></tr></thead>
    <tbody>
      <tr><td><strong>« C'est fermé »</strong></td><td>Quelqu'un vous annonce que le souk, la tannerie ou votre riad est fermé et propose de vous guider</td><td>Un refus poli, et vérifier sur place</td></tr>
      <tr><td><strong>Le faux guide</strong></td><td>Un « étudiant » vous accompagne gratuitement, puis réclame un tarif élevé</td><td>Dire non dès le début, ou convenir du prix avant</td></tr>
      <tr><td><strong>Le henné</strong></td><td>Une main saisie, un dessin tracé, un paiement exigé</td><td>Garder les mains à l'abri</td></tr>
      <tr><td><strong>Le taxi sans compteur</strong></td><td>Un tarif annoncé sans rapport avec la distance</td><td>Exiger le compteur ou fixer le prix avant</td></tr>
      <tr><td><strong>La photo</strong></td><td>Un animal ou un costume, puis un tarif après coup</td><td>Convenir du prix avant, ou refuser</td></tr>
      <tr><td><strong>Le prix « du jour »</strong></td><td>En souk, un prix d'ouverture très supérieur à la valeur</td><td>Négocier, comparer, savoir partir</td></tr>
    </tbody>
  </table>
</div>
<div class="callout">
  <span class="callout-label">La règle qui vaut pour tout</span>
  <p>
    Quelqu'un qui vous aborde sans que vous l'ayez sollicité cherche presque toujours à vous vendre
    quelque chose. Un sourire, un « non, merci » sans vous arrêter, et vous continuez. Vous ne devez à
    personne une conversation.
  </p>
</div>

<h2 id="femmes">Les voyageuses seules</h2>
<p>
  Marrakech se visite en solo, et beaucoup de voyageuses le font régulièrement. La réalité à connaître :
  les remarques dans la rue sont fréquentes et l'insistance plus marquée dans la médina que dans les
  quartiers modernes. Quelques réflexes aident : une tenue couvrant épaules et genoux, un regard
  décidé, pas de discussion avec ceux qui accostent, et la possibilité de vous réfugier dans un café ou
  une boutique en cas de gêne. Le soir, un transfert réservé ou un petit taxi valent mieux qu'une marche
  dans une ruelle isolée.
</p>

<h2 id="pratique">Taxis, argent, effets personnels</h2>
<ul>
  <li><strong>Sac :</strong> porté devant vous dans la foule, fermé, avec le téléphone rangé. Les vols à l'arraché à scooter existent, rares mais réels.</li>
  <li><strong>Argent :</strong> ne sortez pas de grosses coupures dans la rue. Séparez les espèces entre plusieurs poches.</li>
  <li><strong>Taxis :</strong> compteur ou prix fixé avant de partir. Voir <a href={L('/se-deplacer-marrakech/')}>se déplacer à Marrakech</a>.</li>
  <li><strong>Riad :</strong> laissez votre passeport dans le coffre du riad, gardez une photo dans votre téléphone.</li>
  <li><strong>Assurance :</strong> vérifiez que votre carte bancaire ou votre contrat couvre le vol et les frais médicaux.</li>
</ul>

<h2 id="sante">Santé, eau, chaleur</h2>
<p>
  <strong>L'eau :</strong> en bouteille scellée. <strong>La nourriture :</strong> préférez ce qui est cuit
  à la commande. <strong>La chaleur :</strong> en été, les températures dépassent fréquemment 38 °C et
  peuvent atteindre 45 °C ; hydratez-vous, couvrez-vous la tête et évitez la médina entre midi et 16 h.
  <strong>Les animaux errants :</strong> ne caressez pas les chats et les chiens de rue, et consultez sans
  tarder en cas de morsure ou de griffure.
</p>
<p>
  Emportez une trousse minimale : antidiarrhéique, sels de réhydratation, désinfectant, crème solaire,
  antimoustiques. Les pharmacies sont nombreuses et bien fournies, y compris à l'aéroport.
</p>

<h2 id="regles">Ce qui est interdit ou mal vu</h2>
<ul>
  <li><strong>Les stupéfiants :</strong> illégaux, y compris le cannabis, malgré des propositions insistantes dans la rue et en médina. Les sanctions sont réelles.</li>
  <li><strong>Les drones :</strong> interdits sans autorisation, et confisqués à l'aéroport.</li>
  <li><strong>Photographier</strong> bâtiments officiels, forces de l'ordre et militaires est proscrit.</li>
  <li><strong>L'alcool :</strong> en lieux licenciés seulement, jamais dans la rue.</li>
  <li><strong>Le ramadan :</strong> mangez et buvez discrètement en journée dans les lieux publics, par respect.</li>
</ul>

<h2 id="urgences">Numéros d'urgence</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Service</th><th>Numéro</th></tr></thead>
    <tbody>
      <tr><td>Police</td><td class="num">19</td></tr>
      <tr><td>Gendarmerie royale (hors agglomération)</td><td class="num">177</td></tr>
      <tr><td>Protection civile, pompiers, ambulance</td><td class="num">15</td></tr>
    </tbody>
  </table>
</div>
<p>
  Enregistrez ces numéros et l'adresse de votre consulat avant le départ. Pour rester joignable dès
  l'atterrissage, une <a href={L('/esim-maroc/')}>eSIM marocaine</a> est la solution la plus simple.
</p>
</GuideLayout>
