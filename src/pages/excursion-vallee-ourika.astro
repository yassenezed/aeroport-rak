---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Excursions", href: L("/que-faire-marrakech/") },
  { name: "Vallée de l'Ourika", href: L("/excursion-vallee-ourika/") },
];

const toc = [
  { label: "Le trajet et l'itinéraire", id: "trajet" },
  { label: "Ce qu'on y voit", id: "voir" },
  { label: "Les cascades de Setti Fatma", id: "cascades" },
  { label: "Quand y aller, et le risque de crue", id: "quand" },
  { label: "Y aller : taxi, tour ou voiture", id: "transport" },
  { label: "Budget", id: "budget" },
];

const faqs = [
  { q: "Combien de temps faut-il pour aller dans l'Ourika depuis Marrakech ?", a: "Environ une heure à une heure quinze pour rejoindre Setti Fatma, le bout de la route, à une soixantaine de kilomètres. Les premiers villages sont à quarante minutes. Comptez une journée complète avec les arrêts, en partant vers 8 h 30 et en rentrant en fin d'après-midi." },
  { q: "Quand a lieu le marché de l'Ourika ?", a: "Le lundi matin, à Tnine Ourika, un village de la vallée. C'est un marché rural authentique, fréquenté par les habitants des montagnes, où l'on trouve légumes, épices, ustensiles et animaux. La circulation est dense ce jour-là : partez tôt." },
  { q: "Les cascades de Setti Fatma sont-elles faciles d'accès ?", a: "La première est accessible en une vingtaine de minutes de marche facile, avec de nombreux guides sur place ; les suivantes demandent d'escalader des rochers, souvent glissants, et une bonne condition physique. En cas de pluie ou de crue, l'ascension est déconseillée. Des chaussures fermées à semelle accrocheuse s'imposent." },
  { q: "L'Ourika est-elle dangereuse ?", a: "La rivière peut monter très vite lors d'orages en montagne, et des crues meurtrières se sont produites par le passé. Consultez la météo, évitez les tables installées dans le lit de la rivière si le ciel se couvre, et suivez les consignes des guides locaux. Par temps stable, la vallée ne pose pas de difficulté." },
  { q: "Faut-il un guide pour la vallée de l'Ourika ?", a: "Pas pour la route et les villages, que l'on visite librement. Pour les cascades, un guide local est utile, souvent proposé sur place à un tarif modeste, et pour une randonnée plus longue un guide agréé de montagne est recommandé." },
  { q: "Peut-on combiner l'Ourika avec le désert d'Agafay ?", a: "Ce serait une journée très dense, avec deux directions opposées. Mieux vaut consacrer une journée à chacune : l'Ourika le matin en montagne, l'Agafay une autre fois pour le coucher du soleil." },
];
---
<GuideLayout
  keywords="vallée Ourika, Setti Fatma, excursion Ourika Marrakech, marché Tnine Ourika"
  title={"Vallée de l'Ourika depuis Marrakech : guide 2026"}
  description={"Vallée de l'Ourika en une journée : trajet, marché du lundi, jardin Anima, villages berbères, cascades de Setti Fatma, saison et risques de crue."}
  eyebrow={"Excursions · Vallée de l'Ourika"}
  h1={"Vallée de l'Ourika depuis Marrakech"}
  lede={"À une heure de la ville, la vallée offre de la fraîcheur, des villages berbères et des cascades. C'est l'excursion la plus simple du Haut Atlas — à condition de la faire au bon moment."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["ourika-valley"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un chauffeur pour la journée", text: "Une voiture avec chauffeur permet de partir à l'heure de votre choix, de vous arrêter où vous voulez et de rentrer avant la nuit.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="trajet">Le trajet et l'itinéraire</h2>
<p>
  On quitte Marrakech par le sud-est, en direction de l'Atlas. Les premiers kilomètres traversent la plaine,
  puis la route s'élève le long de la rivière Ourika, dans un paysage de terrasses rouges, de villages en
  pisé et de champs. La route est goudronnée, étroite par endroits, et très fréquentée le week-end, quand
  les habitants montent chercher la fraîcheur.
</p>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Étape</th><th>Distance depuis Marrakech</th><th>À voir</th></tr></thead>
    <tbody>
      <tr><td><strong>Jardin Anima</strong></td><td>≈ 30 km</td><td>Jardin d'artiste, sculptures, calme</td></tr>
      <tr><td><strong>Tnine Ourika</strong></td><td>≈ 35 km</td><td>Marché du lundi, coopératives</td></tr>
      <tr><td><strong>Villages berbères</strong></td><td>40 à 55 km</td><td>Maisons de pisé, visites chez l'habitant</td></tr>
      <tr class="row-highlight"><td><strong>Setti Fatma</strong></td><td>≈ 60 km</td><td>Bout de la route, cascades, restaurants</td></tr>
    </tbody>
  </table>
</div>

<h2 id="voir">Ce qu'on y voit</h2>
<p>
  <strong>Les villages et les coopératives</strong> : plusieurs coopératives de femmes produisent huile
  d'argan, savon et safran, avec des démonstrations. Une visite chez l'habitant, autour d'un thé, est
  souvent proposée. Choisissez selon l'ambiance, sans vous sentir obligé d'acheter.
</p>
<p>
  <strong>Le jardin Anima</strong> : un jardin d'artiste, soigné, à mi-chemin, qui offre une pause
  paisible avant la montagne. Convient aux familles.
</p>
<p>
  <strong>Les tables au bord de l'eau</strong> : de nombreux restaurants installent tapis et tables sur
  les rochers, au-dessus de la rivière. Un tajine et une salade y sont agréables, à un prix raisonnable.
  Par temps instable, préférez une terrasse en hauteur, pas dans le lit de la rivière.
</p>

<h2 id="cascades">Les cascades de Setti Fatma</h2>
<p>
  Au bout de la route, sept cascades s'étagent dans la montagne. La première est accessible par un
  sentier d'environ vingt minutes, avec des passages sur les rochers. Les suivantes exigent d'escalader,
  parfois en s'aidant des mains, sur des roches humides. Un guide local se trouve sur place pour quelques
  dizaines de dirhams et rend la progression nettement plus sûre.
</p>
<div class="callout">
  <span class="callout-label">Ce qu'il faut savoir</span>
  <p>
    N'y allez pas en sandales et évitez les cascades supérieures si vous avez des enfants ou le
    vertige. Le niveau d'eau varie fortement : au printemps, la fonte des neiges rend la vallée
    superbe, mais les passages sont plus délicats.
  </p>
</div>

<h2 id="quand">Quand y aller, et le risque de crue</h2>
<ul>
  <li><strong>Printemps :</strong> le meilleur moment — vert, eau abondante, températures douces.</li>
  <li><strong>Été :</strong> un refuge contre la chaleur de la ville, avec 5 à 8 °C de moins. Beaucoup de monde le week-end.</li>
  <li><strong>Hiver :</strong> sommets enneigés, air frais. Voyez <a href={L('/marrakech-en-hiver/')}>Marrakech en hiver</a>.</li>
  <li><strong>Après un orage :</strong> à éviter. La rivière peut gonfler rapidement, et des crues se sont produites par le passé.</li>
</ul>

<h2 id="transport">Y aller : taxi, tour ou voiture</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Option</th><th>Prix indicatif</th><th>Avantage</th></tr></thead>
    <tbody>
      <tr><td><strong>Excursion en groupe</strong></td><td class="num">250–450 MAD / pers.</td><td>Simple, guide inclus, horaires imposés</td></tr>
      <tr><td><strong>Grand taxi ou chauffeur privé</strong></td><td class="num">400–650 MAD la voiture</td><td>Horaire libre, arrêts à la carte</td></tr>
      <tr><td><strong>Voiture de location</strong></td><td class="num">dès 25 € / jour</td><td>Liberté, route facile en citadine</td></tr>
    </tbody>
  </table>
</div>
<p>
  La route est entièrement goudronnée, et une citadine suffit : voyez
  <a href={L('/location-4x4-aeroport-marrakech/')}>faut-il un 4x4 ?</a> et
  <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a> pour les conseils de conduite en montagne. Les
  tarifs taxi sont détaillés dans notre
  <a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix</a>.
</p>

<h2 id="budget">Budget</h2>
<p>
  Une journée en excursion de groupe coûte 250 à 450 MAD par personne, déjeuner en plus (80 à 150 MAD).
  En voiture privée, comptez 400 à 650 MAD pour la course, plus le repas. Le poste qui grimpe est le
  guide pour les cascades, à quelques dizaines de dirhams. Pour d'autres idées autour de la ville, voyez
  <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>.
</p>
</GuideLayout>
