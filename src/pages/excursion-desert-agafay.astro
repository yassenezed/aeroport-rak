---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Surf à Imsouane', href: L('/imsouane-surf-guide/') },
];
const toc = [
  { label: 'Le village', id: 'village' },
  { label: 'La Baie', id: 'la-baie' },
  { label: 'Cathedral Point', id: 'cathedral' },
  { label: 'Pour quel niveau', id: 'niveau' },
  { label: 'Quand venir', id: 'quand' },
  { label: 'Comment y aller', id: 'acces' },
];
const faqs = [
  { q: "Pourquoi Imsouane est célèbre pour le surf ?", a: "Pour sa vague de la Baie : l'une des plus longues vagues de droite du Maroc, et d'Afrique. Elle déroule lentement et longtemps, ce qui en fait un terrain de jeu rêvé pour le longboard et pour la progression, on enchaîne des rides interminables dans une eau relativement abritée. C'est ce qui attire surfeurs et écoles du monde entier." },
  { q: "Imsouane convient-il aux débutants ?", a: "Oui, et c'est une partie de son charme. La vague de la Baie est douce, longue et régulière, idéale pour apprendre et progresser sans la puissance des spots plus exposés. Les écoles locales proposent cours et locations. Cathedral Point, l'autre spot, est en revanche plus engagé et réservé aux surfeurs confirmés." },
  { q: "À quelle distance d'Agadir se trouve Imsouane ?", a: "Imsouane est à environ 2 h 30 à 3 h de route au nord d'Agadir, au-delà de Taghazout, en remontant la côte vers Essaouira. Il n'y a pas de transport en commun pratique : on y va en voiture de location ou en transfert réservé. Beaucoup en font une étape de plusieurs jours plutôt qu'un aller-retour à la journée." },
  { q: "Quelle est la meilleure saison de surf à Imsouane ?", a: "L'automne et l'hiver apportent les houles atlantiques les plus régulières et les vagues les plus consistantes, comme sur toute la côte. La Baie reste surfable une bonne partie de l'année grâce à sa configuration abritée, ce qui la rend accessible même hors des grosses houles. Prévoyez une combinaison : l'eau est fraîche toute l'année." },
];
---
<GuideLayout keywords="Surf Imsouane Agadir, que faire à Agadir, attractions Agadir" 
  lang={lang}
  title="Guide Surf Imsouane Agadir 2026 | Astuces & Incontournables"
  description="Planifiez votre visite à Surf Imsouane à Agadir. Découvrez des astuces locales, le meilleur moment pour y aller et à quoi vous attendre. Réservez un guide local!"
  eyebrow="Surf · Imsouane"
  h1="Surf à Imsouane : la Baie"
  lede="Un village de pêcheurs au nord de la côte, et l'une des plus longues vagues de droite du Maroc. Imsouane est le rêve du longboarder et l'école idéale pour progresser. Voici ce qui rend ce spot à part."
  breadcrumbs={breadcrumbs}
  heroImage={photos['taghazout']}
  toc={toc}
  faqs={faqs}
  updated="juin 2026"
  cta={{ heading: 'Réservez un Guide Local Privé', text: 'Évitez les pièges à touristes. Laissez nos experts locaux vous montrer le vrai Agadir.', provider: 'guide', label: 'Voir les options' }}
>
  <p>
    Sur la côte atlantique au nord d'Agadir, Imsouane fait figure de spot mythique chez les surfeurs.
    Longtemps simple village de pêcheurs, il doit sa réputation à une vague hors norme : la Baie. Voici
    pourquoi tant de surfeurs y posent leurs planches, et ce qu'il faut savoir avant de venir.
  </p>

  <h2 id="village">Le village</h2>
  <p>
    Imsouane reste un petit port de pêche au rythme lent : barques colorées, étals de poisson, quelques cafés
    et chambres d'hôtes simples accrochés à la falaise. L'ambiance est décontractée, loin de l'effervescence
    de certains spots, c'est précisément ce que beaucoup viennent chercher. On y reste volontiers plusieurs
    jours, entre deux sessions, sans jamais courir.
  </p>

  <h2 id="la-baie">La Baie</h2>
  <p>
    La star, c'est « la Baie » : l'une des plus longues vagues de droite du Maroc, et d'Afrique. Elle se
    forme dans une anse abritée, déroule lentement et longtemps, et offre des rides d'une durée rare, de quoi
    parcourir des dizaines de mètres sur une seule vague. C'est un paradis pour le longboard et un terrain
    idéal pour la progression : la vague pardonne, on a le temps de manœuvrer, on enchaîne sans la violence
    des spots exposés.
  </p>

  <h2 id="cathedral">Cathedral Point</h2>
  <p>
    À l'opposé de la Baie, Imsouane compte un second spot, Cathedral Point, bien plus engagé : une droite
    plus puissante et plus creuse, sur fond rocheux, réservée aux surfeurs confirmés. C'est l'envers du
    décor tranquille de la Baie, utile à connaître pour ne pas s'y aventurer par erreur. Débutants et
    longboarders restent sur la Baie ; les confirmés en quête de plus de puissance regardent du côté de
    Cathedral.
  </p>

  <h2 id="niveau">Pour quel niveau</h2>
  <p>
    C'est l'un des rares grands spots marocains aussi accueillant pour les débutants. La Baie, douce et
    longue, est parfaite pour apprendre et engranger des heures de glisse, avec écoles et locations sur place.
    Les intermédiaires y peaufinent leurs trajectoires et leur longboard ; les confirmés trouvent du
    challenge à Cathedral. Peu de spots couvrent un tel éventail au même endroit. Pour situer Imsouane dans
    la côte, voyez notre <a href={L('/surfing-taghazout-guide/')}>guide du surf à Taghazout</a>.
  </p>

  <h2 id="quand">Quand venir</h2>
  <p>
    L'automne et l'hiver apportent les houles les plus régulières et les vagues les plus consistantes, comme
    sur toute la côte atlantique. Mais grâce à sa configuration abritée, la Baie reste surfable une bonne
    partie de l'année, même hors des grosses houles : c'est ce qui la rend si fiable pour la progression.
    Prévoyez une combinaison en toute saison, l'Atlantique restant frais.
  </p>

  <h2 id="acces">Comment y aller</h2>
  <p>
    Imsouane est à environ 2 h 30 à 3 h au nord d'Agadir, au-delà de Taghazout, en remontant la côte vers
    Essaouira. Il n'y a pas de transport en commun pratique : on y va en voiture de location ou en transfert
    réservé, et beaucoup en font une étape de quelques jours plutôt qu'un aller-retour. Notre page
    <a href={L('/agadir-airport-to-imsouane/')}>transfert aéroport-Imsouane</a> donne les prix et les détails
    du trajet.
  </p>

  <div class="disclosure-inline">
    Certains liens de cette page sont des liens d'affiliation : si vous réservez via eux, nous pouvons
    percevoir une petite commission, sans surcoût pour vous. Cela ne change jamais les prix affichés ni nos
    recommandations. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>

  <div class="callout">
    <span class="callout-label">Imsouane en bref</span>
    Village de pêcheurs paisible à ~2 h 30–3 h au nord d'Agadir · la Baie : l'une des plus longues vagues de
    droite du Maroc, idéale longboard et débutants · Cathedral Point pour les confirmés · combinaison
    indispensable · accès en voiture ou transfert.
  </div>
</GuideLayout>
