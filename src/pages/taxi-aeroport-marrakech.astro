---
import TransferLayout from '../layouts/TransferLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts & taxi', href: L('/transfert-aeroport-marrakech/') },
  { name: 'Taxi aéroport', href: L('/taxi-aeroport-marrakech/') },
];

const facts = [
  { label: 'Aéroport → médina', value: `${airport.distanceToCityKm} km` },
  { label: 'Durée', value: `${airport.driveToCityMin.min}–${airport.driveToCityMin.max}`, sub: 'min' },
  { label: 'Tarif affiché (jour)', value: `${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]}`, sub: 'MAD' },
  { label: 'Tarif affiché (nuit)', value: `${airport.taxiFare.nightMad[0]}–${airport.taxiFare.nightMad[1]}`, sub: 'MAD' },
];

const faqs = [
  {
    q: "Combien coûte un taxi de l'aéroport de Marrakech à la médina ?",
    a: `Le panneau officiel de la station affiche une fourchette d'environ ${airport.taxiFare.dayMad[0]} à ${airport.taxiFare.dayMad[1]} MAD en journée vers la médina, Guéliz et l'Hivernage, et ${airport.taxiFare.nightMad[0]} à ${airport.taxiFare.nightMad[1]} MAD la nuit. Le prix vaut pour la voiture entière, pas par passager. Tarifs relevés en ${PRICES_CHECKED}.`
  },
  {
    q: "Le compteur fonctionne-t-il au départ de l'aéroport ?",
    a: "Non : au départ de l'aéroport, la pratique établie est un tarif forfaitaire affiché au panneau, pas le compteur. En ville, les petits taxis sont censés en avoir un, mais il est rarement enclenché avec les touristes : demandez-le en montant, ou convenez du prix avant de partir. Une course courte en centre-ville coûte en général 15 à 30 MAD, une traversée plus longue 30 à 50 MAD."
  },
  {
    q: "Petit taxi ou grand taxi, quelle différence ?",
    a: "Le petit taxi est la berline beige de Marrakech, limitée à trois passagers et cantonnée à la ville. Le grand taxi est plus vaste, accepte jusqu'à six personnes et assure aussi les liaisons vers l'extérieur (Ourika, Agafay, Essaouira). Concrètement : à trois avec des bagages, ou à quatre et plus, demandez directement un grand taxi, sinon vous vous retrouverez à payer deux voitures."
  },
  {
    q: "Peut-on payer le taxi par carte à l'aéroport de Marrakech ?",
    a: "Non, prévoyez des espèces en dirhams. Les taxis n'acceptent pratiquement jamais la carte et les chauffeurs rendent difficilement la monnaie sur un gros billet : retirez au distributeur du hall des arrivées et procurez-vous, si possible, des coupures de 50 et 100 MAD."
  },
  {
    q: "Y a-t-il des taxis la nuit à l'aéroport de Marrakech ?",
    a: "Oui, la station reste alimentée tant qu'il y a des vols, et une bonne partie des low cost se posent après 21 h. Le barème passe simplement au tarif de nuit. Si vous atterrissez très tard et logez dans la médina, un transfert réservé reste plus confortable : le chauffeur suit votre vol et sait à quelle porte s'arrêter."
  },
  {
    q: "Le taxi peut-il entrer dans la médina ?",
    a: "Non. Les derbs sont trop étroits et plusieurs accès sont fermés à la circulation. Le chauffeur s'arrête à la porte la plus proche de votre riad — Bab Doukkala, Bab Laksour, Bab Agnaou ou Bab el Khemis selon le secteur — et vous terminez à pied. Demandez à votre riad d'envoyer un porteur avec charrette : la plupart le font si vous annoncez votre heure d'arrivée."
  },
];
---
<TransferLayout
  title={"Taxi à l'aéroport de Marrakech : tarifs et conseils"}
  description={"Taxi depuis l'aéroport de Marrakech : tarifs jour et nuit affichés, petit ou grand taxi, paiement en espèces et quand un transfert revient moins cher."}
  eyebrow="Aéroport Marrakech Ménara · Taxi"
  h1="Taxi à l'aéroport de Marrakech : tarifs et bons réflexes"
  lede="Marrakech affiche ses tarifs de taxi au rang de l'aéroport, et c'est une bonne nouvelle. Reste à savoir les lire, à choisir le bon gabarit de voiture et à se mettre d'accord avant que les bagages ne partent dans le coffre. Voici comment s'y prendre en trois minutes."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={10}
  heroImage={photos['marrakech-taxi']}
  heroProvider="transfer"
  heroCtaLabel="Comparer taxi et transfert"
  secondaryHref="/taxi-aeroport-marrakech/prix/"
  secondaryLabel="Grille des prix par quartier"
  faqs={faqs}
  cta={{ heading: "Évitez la négociation à une heure du matin", text: "Un prix fixe bloqué avant le départ, un chauffeur qui attend avec votre nom et qui connaît la bonne porte de la médina. Paiement différé et annulation gratuite sur la plupart des réservations.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    À la sortie du hall des arrivées, la station de taxis est immédiatement devant vous, et vous serez
    abordé avant même de l'atteindre. Contrairement à d'autres aéroports marocains, Marrakech affiche
    officiellement ses tarifs sur un panneau, par zone de destination. C'est votre meilleur outil : il
    ne s'agit pas de marchander à l'aveugle, mais de faire coïncider le prix annoncé avec le prix
    affiché.
  </p>

  <h2>Ce que vous devriez payer</h2>
  <p>
    Pour la médina, Guéliz ou l'Hivernage — c'est-à-dire l'écrasante majorité des arrivées — la
    fourchette raisonnable est de {airport.taxiFare.dayMad[0]} à {airport.taxiFare.dayMad[1]} MAD en
    journée et de {airport.taxiFare.nightMad[0]} à {airport.taxiFare.nightMad[1]} MAD après la tombée de
    la nuit, pour la voiture entière. La Palmeraie, plus éloignée, monte naturellement au-dessus. Le
    détail complet, zone par zone, est sur notre
    {' '}<a href={L('/taxi-aeroport-marrakech/prix/')}>grille des prix taxi</a>.
  </p>
  <div class="callout">
    <span class="callout-label">La phrase à dire</span>
    <p>
      « Médina, Bab Doukkala — c'est bien {airport.taxiFare.dayMad[0]} dirhams, comme sur le panneau ? »
      Nommer la porte, citer l'affichage et confirmer le montant avant d'ouvrir le coffre règle
      l'essentiel des malentendus. Si le chauffeur refuse, le suivant acceptera : il y a toujours une
      file.
    </p>
  </div>

  <h2>Petit taxi ou grand taxi : choisissez avant de monter</h2>
  <p>
    Les petits taxis beiges de Marrakech sont limités à <strong>trois passagers</strong>. C'est la
    source de friction la plus fréquente à la station : une famille de quatre se voit proposer deux
    voitures, et l'addition double. Les grands taxis acceptent jusqu'à six passagers et disposent d'un
    vrai coffre. Dès que vous êtes trois avec de grandes valises, ou quatre et plus, demandez d'emblée
    un grand taxi — le prix par personne reste alors très correct.
  </p>

  <h2>Espèces, monnaie et petits billets</h2>
  <p>
    Prévoyez des dirhams : la carte n'est presque jamais acceptée et la monnaie manque souvent. Les
    distributeurs du hall des arrivées fonctionnent bien, mais délivrent volontiers des billets de 200
    MAD, avec lesquels un chauffeur ne rendra pas la monnaie sur une course à 100. Retirez, puis
    fractionnez dès que possible — au café du terminal ou à la boutique — pour disposer de coupures de
    50 et 100 MAD. Notre page
    {' '}<a href={L('/guide-aeroport-marrakech/services/')}>services de l'aéroport</a> indique où trouver
    distributeurs et bureaux de change.
  </p>

  <h2>Quand le taxi est le bon choix, et quand il ne l'est pas</h2>
  <p>
    Le taxi gagne à chaque fois que vous atterrissez en journée, que vous logez à Guéliz, à l'Hivernage
    ou près d'une grande porte de la médina, que vous êtes deux ou trois et que vous n'aviez rien envie
    de préparer à l'avance. Vous sortez, vous partez, c'est réglé en cinq minutes.
  </p>
  <p>
    Il perd de son intérêt dans trois cas précis : les arrivées très tardives, où le barème de nuit
    rapproche le taxi du prix d'un transfert réservé sans en offrir le confort ; les groupes de quatre
    et plus, qui paient souvent deux véhicules ; et les riads difficiles à situer, où le chauffeur vous
    déposera à la porte qui l'arrange plutôt qu'à la plus proche. Dans ces situations, comparez avec un
    {' '}<a href={L('/reserver-transfert/')}>transfert à prix fixe</a> avant de partir : à 27 € le
    véhicule jusqu'à sept places, il devient le moins cher dès que vous êtes quatre.
  </p>

  <h2>Et pour le retour vers l'aéroport ?</h2>
  <p>
    Dans l'autre sens, le rapport de force s'inverse : vous êtes en ville, vous pouvez héler un taxi au
    compteur ou demander à votre riad d'en réserver un. Les tarifs pratiqués sont généralement
    inférieurs à ceux de l'aéroport pour un trajet identique. Prévoyez simplement de la marge : la
    circulation autour de la Ménara se densifie fortement en fin d'après-midi. Nos conseils pour le
    retour sont sur la page
    {' '}<a href={L('/guide-aeroport-marrakech/departs/')}>départs du RAK</a>.
  </p>
</TransferLayout>
