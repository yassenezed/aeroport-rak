---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "eSIM Maroc", href: L("/esim-maroc/") },
];

const toc = [
  { label: "Trois solutions", id: "solutions" },
  { label: "L'eSIM, mode d'emploi", id: "esim" },
  { label: "La carte SIM locale", id: "sim" },
  { label: "Combien de data", id: "data" },
  { label: "Couverture", id: "couverture" },
  { label: "Erreurs à éviter", id: "erreurs" },
];

const faqs = [
  { q: "Mon forfait mobile français fonctionne-t-il au Maroc ?", a: "Cela dépend de votre opérateur. Le Maroc ne fait pas partie de la zone d'itinérance sans surcoût de l'Union européenne : les données peuvent être facturées très cher, ou désactivées. Certains forfaits proposent une option ou incluent le Maroc, à vérifier avant de partir. Une eSIM ou une SIM locale reste en général plus économique." },
  { q: "Mon téléphone est-il compatible eSIM ?", a: "Les iPhone depuis le XS et le XR, la plupart des Google Pixel depuis le 3 et de nombreux Samsung Galaxy récents le sont. Le téléphone doit aussi être débloqué, c'est-à-dire non verrouillé sur un opérateur. Vérifiez dans les réglages, rubrique réseau mobile, ou en composant *#06# pour afficher un identifiant EID." },
  { q: "Quand installer l'eSIM ?", a: "Avant le départ, en Wi-Fi, en scannant le code QR ou en suivant l'application du fournisseur. Beaucoup d'eSIM ne s'activent qu'à l'arrivée sur le réseau marocain : l'installation avant le départ garantit que vous atterrissez déjà connecté." },
  { q: "Puis-je téléphoner et envoyer des SMS avec une eSIM ?", a: "La plupart des eSIM touristiques sont des forfaits de données seulement. Les appels et les messages passent alors par WhatsApp, Signal ou FaceTime. Conservez votre carte SIM habituelle active pour recevoir les SMS et appels, en désactivant les données mobiles dessus pour éviter des frais." },
  { q: "Combien de data faut-il pour un séjour à Marrakech ?", a: "Pour une semaine, 3 à 5 Go suffisent pour les cartes, la messagerie et quelques photos. Pour utiliser des données en continu, le partage de connexion ou la vidéo, comptez 10 Go ou plus. Les forfaits se trouvent de quelques euros à une vingtaine d'euros selon le volume et la durée." },
  { q: "Peut-on acheter une carte SIM à l'aéroport de Marrakech ?", a: "Oui, les opérateurs marocains tiennent des corners dans le hall des arrivées. Il faut votre passeport et quelques minutes. C'est simple, mais souvent plus cher et moins pratique qu'une eSIM installée avant le départ." },
];
---
<GuideLayout
  keywords="eSIM Maroc, carte SIM Maroc, internet Maroc voyage, itinérance Maroc"
  title={"eSIM Maroc : choisir et installer à Marrakech"}
  description={"eSIM ou SIM locale au Maroc : téléphones compatibles, installation avant le départ, forfaits data, couverture dans l'Atlas et alternatives à l'itinérance."}
  eyebrow={"Pratique · Connexion"}
  h1={"eSIM Maroc : rester connecté à Marrakech"}
  lede={"Le Maroc n'est pas dans la zone d'itinérance européenne sans surcoût. Trois solutions existent : l'eSIM installée avant le départ, la carte SIM locale, ou l'itinérance de votre opérateur. Voici comment choisir."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["esim-morocco"]}
  toc={toc}
  faqs={faqs}
  cta={{ heading: "Comment choisir", text: "Passez à la section qui compare les trois solutions.", provider: "#solutions", label: "Voir le comparatif" }}
>
<h2 id="solutions">Trois solutions</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Solution</th><th>Prix indicatif</th><th>Avantages</th><th>Limites</th></tr></thead>
    <tbody>
      <tr class="row-highlight"><td><strong>eSIM touristique</strong></td><td class="num">Quelques € à ≈ 20 €</td><td>Installée avant le départ, connectée dès l'atterrissage, garde votre ligne principale</td><td>Téléphone compatible et débloqué, data seulement</td></tr>
      <tr><td><strong>SIM locale</strong></td><td class="num">Quelques dizaines à ≈ 200 MAD</td><td>Numéro marocain, tarifs locaux, appels possibles</td><td>Passeport requis, retrait au comptoir, changement de carte</td></tr>
      <tr><td><strong>Itinérance de votre opérateur</strong></td><td class="num">Variable, souvent élevé</td><td>Rien à installer</td><td>Facturation parfois très chère, données parfois bloquées</td></tr>
    </tbody>
  </table>
</div>
<p>
  Pour la plupart des voyageurs, l'eSIM est la solution la plus simple. La SIM locale garde son intérêt si
  vous restez longtemps ou si vous avez besoin d'un numéro marocain.
</p>

<h2 id="esim">L'eSIM, mode d'emploi</h2>
<ol>
  <li><strong>Vérifiez la compatibilité</strong> de votre téléphone et qu'il est débloqué.</li>
  <li><strong>Choisissez un forfait</strong> pour le Maroc, en fonction du volume et de la durée de votre séjour.</li>
  <li><strong>Installez l'eSIM en Wi-Fi</strong> avant le départ, avec le code QR ou l'application du fournisseur.</li>
  <li><strong>Activez-la à l'arrivée</strong> en sélectionnant l'eSIM comme ligne de données et en activant l'itinérance de données sur celle-ci.</li>
  <li><strong>Désactivez les données mobiles</strong> de votre ligne habituelle pour éviter les frais.</li>
</ol>
<div class="callout">
  <span class="callout-label">Le détail qui compte à Marrakech</span>
  <p>
    Vous aurez besoin de réseau au moment précis où vous sortez de l'aéroport : pour écrire à votre riad,
    confirmer votre chauffeur ou situer votre porte de la médina. Une eSIM installée avant le départ règle
    ce problème. Voyez <a href={L('/guide-aeroport-marrakech/arrivees/')}>arrivées au RAK</a>.
  </p>
</div>

<h2 id="sim">La carte SIM locale</h2>
<p>
  Trois opérateurs se partagent le marché : Maroc Telecom, Orange Maroc et inwi. Leurs corners du hall
  des arrivées vendent des SIM prépayées avec données, sur présentation du passeport, avec une activation
  qui prend quelques minutes. C'est fiable, mais vous devrez changer de carte et perdre le numéro habituel
  pendant le séjour, sauf si votre téléphone accepte deux SIM.
</p>

<h2 id="data">Combien de data</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Usage</th><th>Volume conseillé</th></tr></thead>
    <tbody>
      <tr><td>Cartes, messagerie, mails, quelques photos, 3 à 4 jours</td><td class="num">1 – 3 Go</td></tr>
      <tr><td>Une semaine, usage régulier</td><td class="num">3 – 5 Go</td></tr>
      <tr><td>Partage de connexion, streaming, télétravail</td><td class="num">10 Go et plus</td></tr>
    </tbody>
  </table>
</div>

<h2 id="couverture">Couverture</h2>
<p>
  Marrakech et les grands axes sont bien couverts en 4G, et l'aéroport, la médina et les hôtels ne posent
  pas de difficulté. Dans l'Atlas — l'Ourika, Imlil, les cols — la couverture devient irrégulière, avec des
  zones sans réseau. Téléchargez donc vos cartes hors ligne avant de monter, et prévenez votre hébergement
  de votre heure d'arrivée.
</p>

<h2 id="erreurs">Erreurs à éviter</h2>
<ul>
  <li>Oublier de désactiver les données mobiles de sa ligne habituelle, et découvrir une facture d'itinérance.</li>
  <li>Acheter une eSIM sans vérifier que le téléphone est débloqué.</li>
  <li>Choisir trop peu de data, puis devoir en racheter à l'étranger.</li>
  <li>Ne pas installer l'eSIM avant le départ, faute de Wi-Fi à l'aéroport de départ.</li>
</ul>
<p>
  Pour un séjour complet, voyez le <a href={L('/guide-voyage-marrakech/')}>guide de voyage Marrakech</a>.
</p>
</GuideLayout>
