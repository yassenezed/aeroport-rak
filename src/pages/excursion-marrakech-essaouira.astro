---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Excursions", href: L("/que-faire-marrakech/") },
  { name: "Essaouira", href: L("/excursion-marrakech-essaouira/") },
];

const toc = [
  { label: "Pourquoi Essaouira", id: "pourquoi" },
  { label: "Y aller : les options", id: "options" },
  { label: "Que voir", id: "voir" },
  { label: "Manger", id: "manger" },
  { label: "Le vent", id: "vent" },
  { label: "Une journée ou une nuit ?", id: "duree" },
];

const faqs = [
  { q: "Combien de temps faut-il de Marrakech à Essaouira ?", a: "Environ 2 h 30 à 3 h pour 176 kilomètres, en voiture ou en autocar. La route traverse la plaine puis le pays des arganiers, avec des villages qui font ralentir. En autocar Supratours ou CTM, comptez trois heures, sans compter les attentes en gare." },
  { q: "Peut-on faire Essaouira en une journée depuis Marrakech ?", a: "Oui, mais c'est long : six heures de route pour cinq heures sur place. Une nuit sur place change tout : vous voyez la ville au petit matin, sans la foule des groupes, et vous profitez du coucher de soleil sur les remparts." },
  { q: "Comment aller à Essaouira sans voiture ?", a: "Par autocar : Supratours et CTM assurent plusieurs départs par jour au départ de Marrakech, pour environ 80 à 120 MAD. Sinon, un grand taxi ou un transfert privé, plus cher mais plus souple." },
  { q: "Essaouira est-elle très différente de Marrakech ?", a: "Radicalement. Elle est plus petite, plus calme, plus fraîche et plus ventée, avec une atmosphère de port, moins de sollicitation et une médina classée à l'UNESCO depuis 2001. Le contraste est ce qui fait tout l'intérêt." },
  { q: "Que faut-il manger à Essaouira ?", a: "Le poisson et les fruits de mer grillés, choisis au port ou aux étals : sardines, dorade, calmar. Négociez le prix avant de commander, et privilégiez les stands fréquentés par des locaux." },
  { q: "Quand a lieu le festival gnaoua ?", a: "Généralement en juin, il rassemble des maîtres gnaoua et des artistes internationaux, sur plusieurs scènes. C'est un moment de forte affluence : réservez l'hébergement bien à l'avance." },
];
---
<GuideLayout
  keywords="Essaouira excursion Marrakech, aller à Essaouira, Mogador, médina Essaouira"
  title={"Marrakech - Essaouira : bus, transfert et visite"}
  description={"Marrakech - Essaouira : 176 km, 2 h 30 de route, journée ou nuit sur place, médina classée, port de pêche, poisson grillé et festival gnaoua."}
  eyebrow={"Excursions · Essaouira"}
  h1={"Marrakech - Essaouira"}
  lede={"Une médina blanche et bleue battue par les alizés, un port de pêche et 2 h 30 de route. Essaouira est l'antithèse de Marrakech, ce qui en fait une évasion idéale — plutôt sur une nuit que sur une journée."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["essaouira"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Transfert privé aller-retour", text: "Un véhicule et un chauffeur pour 180 km : la solution la plus simple pour une journée ou un week-end à Essaouira.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="pourquoi">Pourquoi Essaouira</h2>
<p>
  Ancienne Mogador, Essaouira est une ville fortifiée sur l'Atlantique, aux remparts de pierre et aux
  maisons blanches aux volets bleus. Sa médina est classée par l'UNESCO depuis 2001. Ici, le rythme est
  lent : ruelles piétonnes, ateliers de marqueterie de thuya, galeries d'art, plages balayées par le
  vent. Après Marrakech, c'est un souffle. La ville a aussi servi de décor à plusieurs films et séries.
</p>

<h2 id="options">Y aller : les options</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Option</th><th>Prix indicatif</th><th>Durée</th><th>Commentaire</th></tr></thead>
    <tbody>
      <tr><td><strong>Autocar (Supratours, CTM)</strong></td><td class="num">80–120 MAD</td><td>≈ 3 h</td><td>Économique, départ de la gare routière</td></tr>
      <tr><td><strong>Transfert privé</strong></td><td class="num">dès 95 €</td><td>2 h 30 – 3 h</td><td>Depuis l'aéroport ou votre hébergement</td></tr>
      <tr><td><strong>Grand taxi</strong></td><td class="num">1 200–1 800 MAD</td><td>2 h 30 – 3 h</td><td>À négocier, course privée</td></tr>
      <tr><td><strong>Voiture de location</strong></td><td class="num">dès 25 € / jour</td><td>2 h 30 – 3 h</td><td>Route facile, liberté d'arrêt</td></tr>
    </tbody>
  </table>
</div>
<p>
  Le détail de la route depuis l'aéroport est sur
  <a href={L('/transfert-aeroport-marrakech-essaouira/')}>aéroport → Essaouira</a>.
</p>

<h2 id="voir">Que voir</h2>
<ul>
  <li><strong>La Skala de la Ville :</strong> les remparts et leurs canons de bronze face à l'océan, avec un coucher de soleil mémorable.</li>
  <li><strong>Le port de pêche :</strong> les bateaux bleus, les mouettes, les étals de poisson et la Skala du port.</li>
  <li><strong>La médina :</strong> ruelles calmes, ateliers de thuya, boutiques d'artisans et galeries.</li>
  <li><strong>La place Moulay Hassan :</strong> le cœur de la vie locale, avec ses cafés.</li>
  <li><strong>La plage :</strong> large et venteuse, pour marcher ou regarder les kitesurfeurs.</li>
</ul>

<h2 id="manger">Manger</h2>
<p>
  Le poisson est la spécialité. Au port, des stands grillent sardines, dorades et calmars, que vous
  choisissez sur la glace : négociez le prix avant de commander, et privilégiez les tables fréquentées.
  En médina, de petits restaurants proposent tajines de poisson et crevettes. Prévoyez des espèces.
</p>

<h2 id="vent">Le vent</h2>
<div class="callout">
  <span class="callout-label">L'erreur classique</span>
  <p>
    Essaouira est balayée par les alizés, presque toute l'année. Il y fait plusieurs degrés de moins
    qu'à Marrakech, et la plage est plus fréquentée par les kitesurfeurs que par les baigneurs. Emportez
    un coupe-vent et une veste, même en été.
  </p>
</div>

<h2 id="duree">Une journée ou une nuit ?</h2>
<p>
  Une journée se fait, mais elle est courte. Une nuit permet de voir la ville au matin, quand elle
  appartient à ses habitants, et de dîner face à l'océan. Si votre temps est limité, la moitié des
  excursions décrites sur <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a> se fait plus
  facilement dans la journée : l'<a href={L('/excursion-vallee-ourika/')}>Ourika</a> en est un bon
  exemple.
</p>
</GuideLayout>
