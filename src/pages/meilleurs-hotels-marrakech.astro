---
import { Image } from 'astro:assets';
import img_hotel_1 from '../assets/img/placeholder.png';
import img_hotel_2 from '../assets/img/placeholder.png';
import img_hotel_3 from '../assets/img/placeholder.png';
import img_hotel_4 from '../assets/img/placeholder.png';
import img_hotel_5 from '../assets/img/placeholder.png';
import img_hotel_6 from '../assets/img/placeholder.png';
import img_hotel_7 from '../assets/img/placeholder.png';
import img_hotel_8 from '../assets/img/placeholder.png';
import img_hotel_9 from '../assets/img/placeholder.png';
import img_hotel_10 from '../assets/img/placeholder.png';
import img_hotel_11 from '../assets/img/placeholder.png';
import img_hotel_12 from '../assets/img/placeholder.png';
import img_hotel_13 from '../assets/img/placeholder.png';
import img_hotel_14 from '../assets/img/placeholder.png';
import img_hotel_15 from '../assets/img/placeholder.png';

import HotelCard from '../components/hotels/HotelCard.astro';
import HotelLayout from '../layouts/HotelLayout.astro';
import AffiliateLink from '../components/affiliate/AffiliateLink.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Où dormir', href: L('/where-to-stay-agadir/') },
  { name: 'Meilleurs hôtels', href: L('/best-hotels-agadir/') },
];

const facts = [
  { label: 'Top Hôtels', value: '15' },
  { label: 'Catégories', value: '4' },
  { label: 'Auberges', value: 'Dès 15€', sub: '/nuit' },
  { label: 'Luxe 5*', value: 'Dès 120€', sub: '/nuit' },
];

const faqs = [
  { q: "Quels sont les meilleurs hôtels 5 étoiles à Agadir ?", a: "Agadir regorge de magnifiques établissements 5 étoiles, en particulier en bord de mer. The View Agadir, Riu Palace Tikida, Sofitel Thalassa et Pickalbatros Palais Des Roses figurent parmi les mieux notés, offrant luxe, immenses piscines et accès direct à la plage." },
  { q: "Vaut-il mieux un resort tout compris ou un hôtel de charme ?", a: "Cela dépend de votre style de vacances. Si vous souhaitez vous détendre sans vous soucier des repas, les resorts tout compris de la zone de Founty (comme Iberostar ou Riu) sont parfaits. Si vous préférez l'intimité et le calme, optez pour un hôtel-boutique comme le Riad Villa Blanche ou Timoulay." },
  { q: "À quelle distance se trouve l'aéroport de ces hôtels ?", a: "L'aéroport Al Massira (AGA) est situé à environ 22 km du centre et de la zone hôtelière. Il faut entre 30 et 40 minutes en taxi ou en transfert privé pour rejoindre la plupart de ces hôtels. Nous recommandons vivement de réserver un transfert privé à l'avance pour une arrivée sans stress." },
  { q: "Y a-t-il de bonnes auberges de jeunesse pour les surfeurs à Agadir ?", a: "Absolument ! La région au nord d'Agadir (Taghazout, Tamraght, Banana Village) est mondialement connue pour le surf. Des auberges comme Tayri Surf House ou Dar Surf & Ocean offrent une ambiance incroyable, des prix abordables, et se trouvent à proximité des meilleurs spots de surf." },
];
---
<HotelLayout
  lang={lang}
  title="Les 15 Meilleurs Hôtels à Agadir (2026) : Palaces, Resorts & Hostels | AirportAGA"
  description="Découvrez notre guide complet des meilleurs hôtels d'Agadir. Des palaces 5 étoiles et resorts tout compris aux hôtels de charme et surf camps."
  eyebrow="Où dormir · Meilleurs hôtels"
  h1="Les 15 Meilleurs Hôtels d'Agadir"
  lede="Choisir le bon hôtel à Agadir, c'est savoir quel type de vacances vous souhaitez. Que vous cherchiez le luxe absolu face à l'océan, un resort tout compris pour la famille, ou un hostel convivial pour surfer, nous avons sélectionné les meilleurs établissements pour vous."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={15}
  heroImage={photos['agadir-bay']}
faqs={faqs}
  cta={{ heading: `Réservez votre transfert depuis l'aéroport d'Agadir`, text: `Évitez les files d'attente des taxis et commencez vos vacances sans stress. Réservez un chauffeur privé direct vers votre hôtel.`, provider: 'welcome-pickups', label: `Vérifier les prix` }}
>
  <p>
    En tant que passionnés de voyage, on nous demande souvent : « Quel est le meilleur hôtel à Agadir ? » La vérité est qu'il n'y a pas un seul « meilleur » hôtel. Tout dépend de ce que vous recherchez. Cherchez-vous une détente absolue dans un 5 étoiles ? Une atmosphère animée dans un resort tout compris ? Ou l'esprit bohème d'un surf camp ?
  </p>
  <p>
    Voici notre sélection très soignée des 15 meilleurs hébergements à Agadir, triés par catégorie et tous avec d'excellentes notes.
  </p>

  <h2 class="category-title" id="luxury">Palaces & Luxe : Les Meilleurs Hôtels 5 Étoiles</h2>
  <div class="hotel-list">
    <HotelCard 
      name="1. The View Agadir"
      rating={5}
      location="Baie d'Agadir"
      description="Un chef-d'œuvre de l'hôtellerie moderne surplombant l'océan avec un design épuré et des restaurants gastronomiques exceptionnels."
      features={['Design luxueux moderne', 'Restaurants gastronomiques exceptionnels', 'Piscine à débordement sur l\'océan']}
      imageSrc={img_hotel_1}
      imageAlt="The View Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/hotel/ma/the-view-agadir-hotel.fr.html"
      reviewUrl="/fr/avis-the-view-agadir/"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="2. Sofitel Agadir Thalassa Sea &amp; Spa"
      rating={5}
      location="Bord de mer, Agadir"
      description="Le summum du bien-être axé sur la thalassothérapie et la détente avec une architecture marocaine contemporaine."
      features={['Immense centre de thalassothérapie', 'Plage privée', 'Architecture marocaine contemporaine']}
      imageSrc={img_hotel_2}
      imageAlt="Sofitel Agadir Thalassa aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Sofitel+Agadir+Thalassa"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="3. Hotel Riu Palace Tikida Agadir"
      rating={5}
      location="Promenade, Agadir"
      description="Un classique intemporel dominant la promenade avec un service 5 étoiles impeccable et des jardins luxuriants."
      features={['Tout compris Premium', 'Jardins luxuriants', 'Piscine géante']}
      imageSrc={img_hotel_3}
      imageAlt="Hotel Riu Palace Tikida Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Riu+Palace+Tikida+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="4. Pickalbatros Palais Des Roses"
      rating={5}
      location="Founty, Agadir"
      description="Un grand resort de style palatial avec un immense complexe de spa et une architecture arabo-mauresque éblouissante."
      features={['Spa de 12 000 m²', 'Architecture arabo-mauresque', 'Accès privé à la plage']}
      imageSrc={img_hotel_4}
      imageAlt="Pickalbatros Palais Des Roses aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Pickalbatros+Palais+Des+Roses"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
  </div>

  <h2 class="category-title" id="comfort">Confort & Tout compris : Les Excellents Hôtels 4 Étoiles</h2>
  <div class="hotel-list">
    <HotelCard 
      name="5. Hotel Riu Tikida Beach"
      rating={4}
      location="Plage de Founty"
      description="Un resort festif réservé aux adultes avec un accès direct à la plage et un programme d'animations dynamique."
      features={['Réservé aux adultes', 'Accès direct à la plage', 'Ambiance festive']}
      imageSrc={img_hotel_5}
      imageAlt="Hotel Riu Tikida Beach aeroport al massira"
      bookingUrl="https://www.booking.com/hotel/ma/riu-tikida-beach.fr.html"
      reviewUrl="/fr/avis-riu-tikida-beach/"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="6. Iberostar Founty Beach"
      rating={4}
      location="Plage de Founty"
      description="Le resort familial idéal avec un club enfants fantastique, de multiples piscines et des repas tout compris."
      features={['Parfait pour les familles', 'Club enfants et animations', 'Grandes piscines']}
      imageSrc={img_hotel_6}
      imageAlt="Iberostar Founty Beach aeroport al massira"
      bookingUrl="https://www.booking.com/hotel/ma/iberostar-founty-beach.fr.html"
      reviewUrl="/fr/avis-iberostar-founty-beach/"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="7. Allegro Agadir"
      rating={4}
      location="Zone touristique"
      description="Un tout compris d'un excellent rapport qualité-prix au cœur de la zone touristique, entouré de magnifiques jardins."
      features={['Cœur du secteur touristique', 'Excellent rapport qualité-prix Tout compris', 'Magnifiques jardins']}
      imageSrc={img_hotel_7}
      imageAlt="Allegro Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Allegro+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="8. ROBINSON Agadir"
      rating={4}
      location="Dunes royales, Agadir"
      description="Un resort unique situé dans des dunes spectaculaires à côté du Palais Royal avec de vastes installations sportives."
      features={['À côté du Palais Royal', 'Cadre de dunes spectaculaire', 'Vastes installations sportives']}
      imageSrc={img_hotel_8}
      imageAlt="ROBINSON Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=ROBINSON+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
  </div>

  <h2 class="category-title" id="budget">Budget & Boutique : Les Meilleurs Hôtels 3 Étoiles</h2>
  <div class="hotel-list">
    <HotelCard 
      name="9. Hotel Timoulay &amp; Spa Agadir"
      rating={3}
      location="Marina, Agadir"
      description="Un hôtel de charme avec une piscine d'eau de mer distinctive et une atmosphère calme et intime."
      features={['Charme d\'hôtel-boutique', 'Piscine d\'eau de mer', 'Calme olympien']}
      imageSrc={img_hotel_9}
      imageAlt="Hotel Timoulay and Spa Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Hotel+Timoulay+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="10. Riad Villa Blanche"
      rating={4}
      location="Centre-ville, Agadir"
      description="Un Riad romantique et intime proposant un restaurant français exceptionnel et un spa de renom."
      features={['Riad romantique intime', 'Restaurant français exceptionnel', 'Spa de renom']}
      imageSrc={img_hotel_10}
      imageAlt="Riad Villa Blanche aeroport al massira"
      bookingUrl="https://www.booking.com/hotel/ma/riad-villa-blanche.fr.html"
      reviewUrl="/fr/avis-riad-villa-blanche/"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="11. Atlantic Hotel Agadir"
      rating={3}
      location="Centre-ville, Agadir"
      description="Un hôtel bien entretenu en centre-ville avec un décor marocain traditionnel et un excellent rapport qualité-prix."
      features={['Décor marocain traditionnel', 'Emplacement en centre-ville', 'Excellent rapport qualité-prix']}
      imageSrc={img_hotel_11}
      imageAlt="Atlantic Hotel Agadir aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Atlantic+Hotel+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="12. Tildi Hotel &amp; Spa"
      rating={3}
      location="Centre-ville, Agadir"
      description="Un hôtel pratique près du centre et de la plage avec deux piscines."
      features={['Proche du centre et de la plage', 'Deux piscines', 'Idéal pour les familles']}
      imageSrc={img_hotel_12}
      imageAlt="Tildi Hotel Spa aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Tildi+Hotel+Agadir"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
  </div>

  <h2 class="category-title" id="hostels">Auberges de jeunesse & Surf Camps</h2>
  <div class="hotel-list">
    <HotelCard 
      name="13. Tayri Surf House"
      location="Tamraght"
      description="Un surf camp dynamique avec des petits déjeuners sur le toit et des prix imbattables pour les voyageurs en solo."
      features={['Ambiance surfeurs et voyageurs en solo', 'Petits déjeuners sur le toit', 'Prix imbattables']}
      imageSrc={img_hotel_13}
      imageAlt="Tayri Surf House aeroport al massira"
      bookingUrl="https://www.booking.com/hotel/ma/tayri-surf-house.fr.html"
      reviewUrl="/fr/avis-tayri-surf-house/"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="14. Surf Zone Villa"
      location="Taghazout"
      description="Une villa de surf propre avec vue sur l'océan, parfaite pour les cours de surf près de Taghazout."
      features={['Vues sur l\'océan', 'Propreté impeccable', 'Idéal pour les cours de surf']}
      imageSrc={img_hotel_14}
      imageAlt="Surf Zone Villa aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Surf+Zone+Villa"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
    <HotelCard 
      name="15. Dar Surf &amp; Ocean"
      location="Anza, Agadir"
      description="Un surf camp chaleureux près d'Anza avec des dîners communautaires et une hospitalité exceptionnelle."
      features={['Près du spot de surf d\'Anza', 'Dîners communautaires', 'Hospitalité exceptionnelle']}
      imageSrc={img_hotel_15}
      imageAlt="Dar Surf Ocean aeroport al massira"
      bookingUrl="https://www.booking.com/searchresults.html?ss=Dar+Surf+Ocean"
      translations={{'viewPrices': 'Voir les prix', 'readReview': 'Lire l\'avis complet'}}
    />
  </div>

  <div class="callout" style="margin-top: 3rem;">
    <span class="callout-label">Conseil d'expert</span>
    Les tarifs des hôtels à Agadir varient énormément entre la basse saison (novembre-février) et la haute saison (juillet-août). Pour obtenir le meilleur prix, surtout sur les hôtels 4 et 5 étoiles, <strong>réservez 2 à 3 mois à l'avance</strong>. De nombreux hôtels sur Booking.com offrent l'annulation gratuite, ce qui vous permet de garantir un tarif avantageux et de changer d'avis plus tard.
  </div>

</HotelLayout>
