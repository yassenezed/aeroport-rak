---
import HotelLayout from '../layouts/HotelLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Meilleurs hôtels', href: L('/meilleurs-hotels-marrakech/') },
];

const facts = [
  { label: 'Palaces', value: 'Remparts', sub: 'Mamounia, Mansour' },
  { label: 'Resorts', value: 'Hivernage', sub: 'jardins, piscines' },
  { label: 'Riads', value: 'Médina', sub: 'petite échelle' },
  { label: 'Vol matinal', value: 'Agdal', sub: '10–15 min' },
];

const selection = [
  { nom: 'Royal Mansour', cat: 'Ultra-luxe', quartier: 'Remparts', pour: 'Intimité absolue, riads privés', href: '/avis-royal-mansour/' },
  { nom: 'La Mamounia', cat: 'Palace historique', quartier: 'Remparts', pour: 'Jardins, héritage, médina à pied', href: '/avis-la-mamounia/' },
  { nom: 'Es Saadi', cat: 'Resort familial', quartier: 'Hivernage', pour: 'Parc, piscines, familles', href: '/avis-es-saadi-palace/' },
  { nom: 'Riad Yasmine', cat: 'Riad boutique', quartier: 'Médina', pour: 'Couples, immersion', href: '/avis-riad-yasmine/' },
  { nom: 'Riad BE Marrakech', cat: 'Riad contemporain', quartier: 'Médina', pour: 'Premier riad, accès facile', href: '/avis-riad-be-marrakech/' },
];

const faqs = [
  {
    q: "Quel est le meilleur hôtel de Marrakech ?",
    a: "Cela dépend de ce que vous venez chercher. Pour l'intimité et l'artisanat, le Royal Mansour ; pour l'héritage et les jardins, La Mamounia ; pour un séjour en famille avec un vrai parc, Es Saadi dans l'Hivernage ; pour l'immersion en médina, un riad. Nos fiches détaillent chaque profil plutôt que de désigner un vainqueur unique."
  },
  {
    q: "Hôtel ou riad à Marrakech ?",
    a: "Le riad donne l'expérience de la médina — patio, terrasse, ruelles — avec une contrainte : l'arrivée à pied depuis une porte. L'hôtel de Guéliz, de l'Hivernage ou de la Palmeraie donne du confort pratique, une piscine où nager et une dépose devant la réception. Beaucoup de voyageurs combinent les deux sur un même séjour."
  },
  {
    q: "Quand réserver pour avoir les meilleures adresses ?",
    a: `Plusieurs mois à l'avance pour février, Pâques, les ponts de mai et les fêtes de fin d'année, qui sont les pics de Marrakech. Juillet et août, très chauds, se réservent facilement et se négocient. Repères relevés en ${PRICES_CHECKED}.`
  },
  {
    q: "Quels hôtels sont les plus proches de l'aéroport ?",
    a: "Ceux de l'Hivernage et de l'Agdal, à dix à quinze minutes du terminal, avec une dépose devant la réception. C'est le bon choix pour une première nuit après un vol tardif ou une dernière nuit avant un départ matinal — voyez notre page dormir près du RAK."
  },
];
---
<HotelLayout
  title="Les meilleurs hôtels de Marrakech : notre sélection par profil (2026) | AirportRAK"
  description="Notre sélection d'adresses à Marrakech, du palace des remparts au riad de la médina : Royal Mansour, La Mamounia, Es Saadi, Riad Yasmine, Riad BE. Choisies par profil de séjour et par accès depuis l'aéroport."
  eyebrow="Marrakech · Hébergement"
  h1="Les meilleurs hôtels de Marrakech"
  lede="Pas un classement, une sélection par profil : ce que chaque adresse fait mieux que les autres, pour qui, et ce que son emplacement implique quand vous arrivez de l'aéroport avec vos valises."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['la-mamounia']}
  faqs={faqs}
>
  <p>
    Marrakech compte parmi les villes les mieux dotées du bassin méditerranéen en hôtellerie de
    caractère : palaces historiques le long des remparts, resorts à jardins dans l'Hivernage, resorts
    plus vastes dans la Palmeraie, et des centaines de riads dans la médina. Trop d'offre, en réalité,
    ce qui rend le choix difficile. Nous l'abordons par profil de séjour, en intégrant un critère que
    les classements ignorent : comment on y arrive.
  </p>

  <h2>Notre sélection</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Adresse</th><th>Catégorie</th><th>Quartier</th><th>Idéale pour</th><th>Fiche</th></tr>
      </thead>
      <tbody>
        {selection.map((s, i) => (
          <tr class:list={[{ 'row-highlight': i === 0 }]}>
            <td><strong>{s.nom}</strong></td>
            <td>{s.cat}</td>
            <td>{s.quartier}</td>
            <td>{s.pour}</td>
            <td><a href={L(s.href)}>Lire</a></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Par profil de séjour</h2>
  <h3>Voyage d'exception, anniversaire, lune de miel</h3>
  <p>
    <a href={L('/avis-royal-mansour/')}>Royal Mansour</a> pour l'intimité de riads privés et un niveau
    d'artisanat rare, <a href={L('/avis-la-mamounia/')}>La Mamounia</a> pour l'héritage et des jardins
    qui constituent à eux seuls une raison de venir. Dans les deux cas, l'accès depuis l'aéroport est
    routier et immédiat.
  </p>
  <h3>Famille, séjour d'une semaine</h3>
  <p>
    <a href={L('/avis-es-saadi-palace/')}>Es Saadi</a> dans l'Hivernage : un parc clos, des piscines
    généreuses, plusieurs catégories d'hébergement et dix minutes de route depuis le terminal. La
    Palmeraie est l'alternative si vous voulez davantage d'espace, avec un éloignement à assumer.
  </p>
  <h3>Couple, immersion, court séjour</h3>
  <p>
    Un riad en médina : <a href={L('/avis-riad-yasmine/')}>Riad Yasmine</a> pour l'atmosphère et le
    patio, <a href={L('/avis-riad-be-marrakech/')}>Riad BE</a> pour un premier riad avec un accès simple
    par Bab Doukkala. Notre guide complet de la formule est sur
    {' '}<a href={L('/riads-medina-marrakech/')}>riads dans la médina</a>.
  </p>
  <h3>Une nuit avant le vol</h3>
  <p>
    Hivernage ou Agdal, sans hésitation. Voyez
    {' '}<a href={L('/hotels-pres-aeroport-marrakech/')}>dormir près du RAK</a>.
  </p>

  <div class="callout">
    <span class="callout-label">Notre méthode</span>
    <p>
      Nous ne notons pas les établissements sur la base d'un séjour unique. Nos fiches s'appuient sur
      des caractéristiques stables — emplacement, configuration, type d'expérience, accès depuis
      l'aéroport — et le disent quand une adresse ne convient pas à un profil. Nos notes sont
      éditoriales et signalées comme telles ; les tarifs ne sont donnés qu'en ordre de grandeur, car ils
      varient du simple au triple selon la saison.
    </p>
  </div>

  <p>
    Pour arbitrer d'abord sur le quartier — le choix le plus structurant — commencez par
    {' '}<a href={L('/ou-dormir-marrakech/')}>où dormir à Marrakech</a>.
  </p>
</HotelLayout>
