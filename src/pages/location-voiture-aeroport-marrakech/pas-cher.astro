---
import CarRentalLayout from '../../layouts/CarRentalLayout.astro';
import AffiliateLink from '../../components/affiliate/AffiliateLink.astro';
import { getLocalizedPath } from '../../i18n';
import { PRICES_CHECKED } from '../../data/airport';
import { photos } from '../../data/images';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Location de voiture', href: L('/location-voiture-aeroport-marrakech/') },
  { name: 'Pas chère', href: L('/location-voiture-aeroport-marrakech/pas-cher/') },
];

const facts = [
  { label: 'Citadine', value: '25 €', sub: 'dès/jour' },
  { label: 'Caution', value: 'Le vrai piège', sub: 'sur carte' },
  { label: 'Carburant', value: 'Plein→plein', sub: 'à exiger' },
  { label: 'Haute saison', value: '+50 %', sub: 'février, Pâques' },
];

const faqs = [
  {
    q: "Quelle est la location la moins chère à l'aéroport de Marrakech ?",
    a: `Hors saison, une citadine chez une agence marocaine démarre autour de 25 € par jour, contre 30 à 40 € chez une enseigne internationale. Mais le tarif journalier le plus bas ne donne pas toujours le séjour le moins cher : une caution élevée, une politique plein-à-vide et une franchise importante peuvent renverser le classement. Tarifs relevés en ${PRICES_CHECKED}.`
  },
  {
    q: "Les agences marocaines sont-elles moins chères que Hertz ou Europcar ?",
    a: "En général oui, sur le tarif affiché. La contrepartie tient à la régularité : montants de caution, état des véhicules et gestion d'un litige varient davantage d'une agence à l'autre. Une bonne agence locale offre un excellent rapport qualité-prix ; une mauvaise vous cherchera des dégâts au retour. Passer par un comparateur qui affiche conditions et avis permet d'obtenir le prix local sans jouer à pile ou face."
  },
  {
    q: "Pourquoi le devis le moins cher n'est-il pas toujours le moins cher ?",
    a: "Parce que le prix journalier n'est qu'une ligne de la facture. Ajoutez le carburant facturé d'avance et non remboursé, la franchise qui reste à votre charge, le rachat proposé au comptoir à un tarif bien supérieur à celui d'une assurance prise en ligne, et parfois des frais de conducteur additionnel ou de jeune conducteur. Additionnez : le classement change souvent."
  },
  {
    q: "Comment éviter le piège de la caution ?",
    a: "Vérifiez le montant avant de réserver, pas au comptoir. Il faut une carte de crédit au nom du conducteur principal, avec un plafond disponible suffisant — comptez 3 000 à 10 000 MAD bloqués selon la catégorie. Évitez d'épuiser ce plafond avec d'autres dépenses pendant le séjour, et gardez à l'esprit que la libération de l'empreinte prend souvent plusieurs jours après la restitution."
  },
  {
    q: "Faut-il prendre le rachat de franchise ?",
    a: "Une couverture est utile ; celle proposée au comptoir est rarement la moins chère. Si votre carte de crédit haut de gamme couvre déjà la location, vérifiez-le et faites-le écrire. Sinon, une couverture souscrite en ligne lors de la réservation coûte en général nettement moins que le rachat vendu à l'arrivée, souvent sous pression de temps."
  },
  {
    q: "Quand réserver pour payer le moins cher au RAK ?",
    a: "Plusieurs semaines à l'avance pour février, Pâques, les vacances scolaires européennes et les ponts de mai, où les prix peuvent gagner 50 % et où les boîtes automatiques disparaissent. En basse saison — juin, septembre, novembre — réserver une dizaine de jours avant suffit souvent à obtenir un bon tarif."
  },
];
---
<CarRentalLayout
  title={"Location de voiture pas chère à Marrakech (RAK)"}
  description={"Louer pas cher au RAK : agences locales ou internationales, piège de la caution, plein-à-plein, et pourquoi le devis le plus bas n'est pas le moins cher."}
  eyebrow="Aéroport Marrakech Ménara · Location"
  h1="Location de voiture pas chère à l'aéroport de Marrakech"
  lede="Une citadine à 25 € par jour est un bon point de départ, pas une garantie. Voici où se cachent les coûts qui font doubler une facture, et comment sortir du comptoir avec une location réellement bon marché."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={25}
  heroImage={photos['marrakech-car-rental']}
  heroCtaLabel="Trouver la location la moins chère"
  faqs={faqs}
>
  <p>
    À Marrakech, l'écart entre le prix affiché et le prix payé est plus large qu'ailleurs, parce que le
    marché mêle grandes enseignes et dizaines d'agences locales aux conditions très variables. Une
    location « pas chère » se joue sur quatre lignes, dont une seule apparaît vraiment sur les
    comparateurs.
  </p>

  <h2>Les quatre lignes qui décident du prix final</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Ligne</th><th>Ce qu'on vous annonce</th><th>Ce qu'il faut regarder</th></tr>
      </thead>
      <tbody>
        <tr class="row-highlight">
          <td><strong>Tarif journalier</strong></td>
          <td>Le chiffre mis en avant</td>
          <td>Sur combien de jours, et avec quel kilométrage</td>
        </tr>
        <tr>
          <td><strong>Caution</strong></td>
          <td>Rarement annoncée</td>
          <td>Montant bloqué, carte de crédit exigée, délai de libération</td>
        </tr>
        <tr>
          <td><strong>Carburant</strong></td>
          <td>« Plein inclus »</td>
          <td>Plein-à-plein ou plein-à-vide : l'écart peut atteindre 60 €</td>
        </tr>
        <tr>
          <td><strong>Franchise</strong></td>
          <td>« Assurance incluse »</td>
          <td>Le montant restant à votre charge, et les exclusions</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>Agences marocaines ou enseignes internationales ?</h2>
  <p>
    Les agences locales affichent souvent 20 à 30 % de moins sur le tarif journalier. Pour un séjour
    court sans traversée de l'Atlas, c'est un bon calcul, à condition de choisir une agence bien notée
    et de faire l'état des lieux sérieusement. Les internationales coûtent davantage mais offrent des
    procédures homogènes, un recours plus simple en cas de litige et, généralement, des véhicules plus
    récents.
  </p>
  <p>
    Le critère qui tranche n'est pas l'enseigne mais votre itinéraire : pour monter au Tizi n'Tichka ou
    rouler jusqu'à Ouarzazate, l'entretien du véhicule et la fiabilité de l'assistance pèsent plus lourd
    que dix euros par jour. Notre comparatif est sur
    {' '}<a href={L('/meilleure-location-voiture-aeroport-marrakech/')}>quelle agence choisir au RAK</a>.
  </p>

  <div class="callout">
    <span class="callout-label">Le calcul que personne ne fait</span>
    <p>
      Si vous ne sortez de Marrakech que deux jours sur sept, ne louez que deux jours. Une voiture
      immobilisée dans un parking près des remparts pendant que vous visitez la médina coûte le tarif
      journalier <em>plus</em> le stationnement, pour un usage nul. Louer à la carte, au milieu du
      séjour, revient presque toujours moins cher.
    </p>
  </div>

  <h2>Les suppléments qui s'ajoutent au comptoir</h2>
  <ul>
    <li><strong>Jeune conducteur</strong> : supplément quotidien en dessous de 25 ans, parfois 21.</li>
    <li><strong>Conducteur additionnel</strong> : facturé à la journée chez la plupart des loueurs.</li>
    <li><strong>Siège enfant</strong> : à réserver d'avance, les stocks sont limités en haute saison.</li>
    <li><strong>Sortie du territoire</strong> : interdite ou soumise à autorisation écrite.</li>
    <li><strong>Restitution hors horaires</strong> : un vol à 6 h du matin peut entraîner des frais.</li>
  </ul>

  <h2>Ce qu'il faut refuser sans hésiter</h2>
  <p>
    Le plein-à-vide, d'abord : vous achetez un réservoir complet au tarif du loueur et rendez la voiture
    à sec, sans remboursement de ce que vous n'avez pas consommé. Ensuite, tout contrat où les dommages
    existants ne sont pas notés par écrit avant votre départ. Enfin, une caution demandée en espèces :
    ce n'est ni la norme, ni protecteur pour vous.
  </p>

  <h2>Notre méthode en trois étapes</h2>
  <ol>
    <li>Comparer en ligne en filtrant sur <strong>plein-à-plein</strong> et caution modérée.</li>
    <li>Souscrire la couverture de franchise à la réservation, pas au comptoir.</li>
    <li>Filmer le véhicule à la prise en charge et à la restitution, jauge et compteur compris.</li>
  </ol>
  <p>
    <AffiliateLink provider="discovercars" sub="cheap-car-body" class="btn btn-primary">Comparer les tarifs au RAK</AffiliateLink>
  </p>
  <p class="small text-muted">
    Pour les itinéraires de montagne et la question du 4x4, voyez
    {' '}<a href={L('/location-4x4-aeroport-marrakech/')}>location de 4x4 à Marrakech</a>, et pour les
    règles locales, <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
  </p>
</CarRentalLayout>
