---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Marrakech en hiver", href: L("/marrakech-en-hiver/") },
];

const toc = [
  { label: "Le climat de décembre à février", id: "climat" },
  { label: "Le froid des riads", id: "riads" },
  { label: "Que faire en hiver", id: "activites" },
  { label: "Neige et montagne", id: "neige" },
  { label: "Prix et fréquentation", id: "prix" },
  { label: "Que mettre dans sa valise", id: "valise" },
];

const faqs = [
  { q: "Quelle température fait-il à Marrakech en hiver ?", a: "De décembre à février, environ 18 à 20 °C en journée au soleil et 5 à 7 °C la nuit. Les après-midi sont agréables en t-shirt sur une terrasse ; dès que le soleil décline, vers 17 h 30, la température chute rapidement." },
  { q: "Les riads sont-ils chauffés ?", a: "Rarement de façon efficace. Ces maisons sont conçues pour se protéger de la chaleur, avec des murs épais, du carrelage et des patios ouverts, ce qui garde le froid. Demandez un chauffage d'appoint à la réservation, ou choisissez un hôtel avec chauffage central." },
  { q: "Peut-on se baigner à la piscine en hiver ?", a: "Oui, si elle est chauffée, ce qui n'est pas toujours le cas. Beaucoup de piscines de riads et d'hôtels ne le sont pas et restent fraîches. Vérifiez avant de réserver si la baignade fait partie de votre séjour." },
  { q: "Y a-t-il de la neige près de Marrakech ?", a: "Oui, sur les sommets du Haut Atlas, visibles depuis la ville. À Oukaïmeden, la station de ski la plus proche, l'enneigement permet parfois de skier en janvier et février, selon les années. C'est une station modeste, mais l'expérience est singulière : du soleil en ville le matin, de la neige l'après-midi." },
  { q: "Est-ce la haute saison ?", a: "Pour partie. Noël et le Nouvel An sont les périodes les plus chères de l'année, et février, avec les vacances scolaires, reste élevé. Janvier, hors vacances, offre en revanche des tarifs bas et une ville calme." },
  { q: "Le ramadan tombe-t-il en hiver ?", a: "Il devrait débuter vers février 2027, ce qui l'amène en pleine saison hivernale. Le rythme de la ville change en journée et s'anime la nuit. Voyez notre page quand partir pour les repères." },
];
---
<GuideLayout
  keywords="Marrakech hiver, météo décembre Marrakech, riad froid, neige Oukaïmeden, Marrakech février"
  title={"Marrakech en hiver : météo, froid et activités"}
  description={"Marrakech de décembre à février : températures, nuits fraîches, riads non chauffés, neige sur l'Atlas, activités possibles, prix de fin d'année."}
  eyebrow={"Marrakech · Hiver"}
  h1={"Marrakech en hiver"}
  lede={"Le soleil est là, l'Atlas est enneigé, les terrasses sont agréables à midi. Mais l'hiver marrakchi surprend par son froid du soir. Voici comment en profiter sans grelotter."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-winter"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Trouvez un hébergement chauffé", text: "Filtrez sur le chauffage et la piscine chauffée : ce sont les deux critères qui font la différence l'hiver.", provider: "hotel", label: "Voir où dormir" }}
>
<h2 id="climat">Le climat de décembre à février</h2>
<p>
  L'hiver marrakchi est un hiver de soleil : le ciel est bleu presque tous les jours, les maximales
  tournent autour de 18 à 20 °C, et la lumière est superbe pour la photographie. Le contraste est
  saisissant avec les sommets enneigés de l'Atlas, qui surplombent la ville. La contrepartie, ce sont les
  nuits fraîches — 5 à 7 °C — et le soir qui tombe dès 18 h.
</p>
<p>
  La pluie est possible, surtout de novembre à mars, mais reste modeste : quelques averses par mois, avec
  un ciel qui se dégage vite. Voyez le tableau complet sur
  <a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a>.
</p>

<h2 id="riads">Le froid des riads</h2>
<div class="callout">
  <span class="callout-label">L'erreur classique</span>
  <p>
    Un riad est bâti pour fuir la chaleur : murs épais, carrelage, patio ouvert. En janvier, le même
    dispositif garde le froid. Une chambre à 12 °C n'est pas rare, et le petit-déjeuner en terrasse est
    agréable seulement quand le soleil est levé.
  </p>
</div>
<ul>
  <li>Demandez à la réservation un <strong>chauffage d'appoint</strong> et des <strong>couvertures supplémentaires</strong>.</li>
  <li>Privilégiez une <strong>chambre exposée au sud</strong> ou avec cheminée.</li>
  <li>Si la chaleur compte, pensez à un hôtel de l'<a href={L('/ou-dormir-marrakech/')}>Hivernage</a> avec chauffage central.</li>
  <li>Emportez une <strong>bouillotte</strong> : le geste simple qui change une nuit.</li>
</ul>

<h2 id="activites">Que faire en hiver</h2>
<p>
  L'hiver est la saison idéale pour <strong>marcher</strong> : la médina et les jardins se parcourent
  sans transpirer, et les sites sont agréables à toute heure. C'est aussi la bonne période pour le
  <a href={L('/jemaa-el-fna/')}>soir sur la place</a>, les terrasses de fin d'après-midi et les hammams,
  qui deviennent un vrai plaisir. Les excursions en montagne sont belles, avec des paysages enneigés, à
  condition de s'équiper. Le détail des activités est sur
  <a href={L('/que-faire-marrakech/')}>que faire à Marrakech</a>.
</p>
<ul>
  <li><strong>À privilégier :</strong> médina, musées, jardins, hammam, cours de cuisine, dîner en terrasse chauffée.</li>
  <li><strong>À éviter :</strong> la piscine non chauffée, les nuits en camp dans le désert sans équipement adapté.</li>
</ul>

<h2 id="neige">Neige et montagne</h2>
<p>
  Les sommets du Haut Atlas se couvrent de neige de décembre à mars. À la station d'Oukaïmeden, on peut
  skier lorsque l'enneigement le permet, généralement en janvier et février, avec du matériel loué sur
  place. La route est goudronnée mais forte en pente, et peut être fermée après de fortes chutes. Vérifiez
  les conditions avant de partir, et prévoyez pneus et chaînes si vous louez une voiture — voyez
  <a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
</p>

<h2 id="prix">Prix et fréquentation</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Période</th><th>Fréquentation</th><th>Prix</th></tr></thead>
    <tbody>
      <tr><td>Début décembre</td><td>Calme</td><td>Modérés</td></tr>
      <tr><td>Noël – Nouvel An</td><td>Très forte</td><td>Les plus élevés de l'année</td></tr>
      <tr class="row-highlight"><td>Janvier (hors vacances)</td><td>Calme</td><td>Bas</td></tr>
      <tr><td>Février</td><td>Forte (vacances scolaires)</td><td>Élevés</td></tr>
    </tbody>
  </table>
</div>
<p>
  Pour économiser, janvier est le meilleur mois. Voyez
  <a href={L('/vols-marrakech/pas-chers/')}>vols pas chers</a> pour la méthode de recherche.
</p>

<h2 id="valise">Que mettre dans sa valise</h2>
<ul>
  <li>Des <strong>couches</strong> : t-shirt, pull, veste chaude, écharpe pour le soir.</li>
  <li>Des <strong>chaussettes chaudes</strong> et une paire de chaussures fermées confortables.</li>
  <li>Des <strong>lunettes de soleil</strong> et de la crème solaire : le soleil reste fort.</li>
  <li>Une <strong>bouillotte</strong> souple, un petit rangement pour la nuit.</li>
  <li>Un <strong>imperméable léger</strong> pour les averses.</li>
</ul>
</GuideLayout>
