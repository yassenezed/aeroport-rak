---
import RouteLayout from '../layouts/RouteLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts & taxi', href: L('/transfert-aeroport-marrakech/') },
  { name: 'Aéroport → Essaouira', href: L('/transfert-aeroport-marrakech-essaouira/') },
];

const facts = [
  { label: 'Distance', value: '180 km' },
  { label: 'Durée', value: '2 h 30–3 h' },
  { label: 'Transfert privé', value: '95 €', sub: 'dès' },
  { label: 'Bus CTM / Supratours', value: '80–120', sub: 'MAD' },
];

const faqs = [
  {
    q: "Combien coûte un transfert de l'aéroport de Marrakech à Essaouira ?",
    a: "Un transfert privé réservé se situe autour de 95 € par véhicule, et davantage pour un minibus. Un grand taxi négocié au rang demande généralement 1 200 à 1 800 MAD pour une course privée directe. Les bus Supratours et CTM relient Marrakech à Essaouira pour 80 à 120 MAD par personne, mais partent de la gare routière en ville, pas de l'aéroport."
  },
  {
    q: "Combien de temps dure le trajet Marrakech - Essaouira ?",
    a: "Deux heures trente à trois heures pour 180 km, sur une nationale correcte mais sinueuse par endroits, qui traverse des villages où la vitesse tombe brutalement. Ajoutez une pause : la plupart des chauffeurs s'arrêtent à une coopérative d'huile d'argan ou à un café à mi-parcours."
  },
  {
    q: "Y a-t-il un bus direct depuis l'aéroport vers Essaouira ?",
    a: "Non, aucun transport public ne part de l'aérogare vers Essaouira. Pour prendre un bus Supratours ou CTM, il faut d'abord rejoindre la gare routière de Marrakech en taxi ou avec le bus 19, puis attendre un départ. C'est faisable et économique, mais cela ajoute facilement deux heures au total."
  },
  {
    q: "Vaut-il mieux réserver le transfert ou négocier sur place ?",
    a: "Réservez. Sur cette distance, la négociation au rang est défavorable : le chauffeur intègre un retour à vide, et les tarifs varient fortement selon l'heure et la saison. Un transfert réservé fixe le prix, garantit un véhicule adapté à vos bagages et évite de partir pour trois heures de route après une discussion tarifaire."
  },
  {
    q: "Peut-on faire une halte en route ?",
    a: "Oui, et c'est même l'un des avantages du transfert privé : les coopératives d'argan, le plateau à arganiers où grimpent les chèvres et quelques cafés jalonnent la route. Précisez-le à la réservation si vous souhaitez une pause formalisée, certains opérateurs facturent l'attente au-delà d'une durée."
  },
  {
    q: "Faut-il louer une voiture plutôt qu'un transfert pour Essaouira ?",
    a: "Si Essaouira est votre unique destination et que vous y restez plusieurs jours, le transfert aller-retour est plus simple : la médina d'Essaouira est également piétonne et vous n'aurez pas besoin de voiture sur place. Louez plutôt si vous comptez enchaîner la côte, Sidi Kaouki ou revenir par l'intérieur."
  },
];
---
<RouteLayout
  title={"Aéroport de Marrakech → Essaouira : prix et durée"}
  description={"Aéroport de Marrakech → Essaouira : 180 km, 2 h 30 à 3 h, prix du transfert privé et du taxi, pourquoi aucun bus ne part de l'aérogare, haltes."}
  eyebrow="Trajet · Aéroport → Essaouira"
  h1="Aéroport de Marrakech → Essaouira"
  lede="Cent quatre-vingts kilomètres jusqu'à l'Atlantique, deux heures et demie à trois heures de route, et aucun transport public au départ de l'aérogare. C'est le trajet longue distance le plus demandé du RAK : voici comment l'organiser."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={95}
  heroImage={photos['essaouira']}
  heroProvider="transfer"
  heroCtaLabel="Réserver ce trajet"
  faqs={faqs}
  cta={{ heading: 'Trois heures de route, un prix fixe', text: "Sur cette distance, la négociation au rang tourne rarement à votre avantage. Réservez à l'avance et partez directement à l'arrivée.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    Beaucoup de voyageurs atterrissent à Marrakech pour dormir le soir même à Essaouira : la ville des
    alizés et des remparts atlantiques n'a pas d'aéroport international comparable, et le RAK sert donc
    de porte d'entrée. Le trajet est simple sur le papier — une nationale, 180 kilomètres — mais il n'y
    a rien au départ du terminal, ce qui se prépare.
  </p>

  <h2>Le point à connaître : aucun transport public depuis l'aérogare</h2>
  <p>
    Les bus Supratours et CTM assurent de bonnes liaisons Marrakech - Essaouira, à 80 à 120 MAD par
    personne, mais ils partent des gares routières en ville. Depuis l'aéroport, il faut donc d'abord
    rejoindre la gare — taxi ou bus 19 — puis attendre un départ, avec des bagages. Le total dépasse
    souvent cinq heures. C'est une solution économique si vous n'êtes pas pressé, pas une solution
    pratique après un vol.
  </p>

  <h2>Les options réelles</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Option</th><th>Prix</th><th>Durée totale</th><th>Pour qui</th></tr>
      </thead>
      <tbody>
        <tr class="row-highlight">
          <td><strong>Transfert privé réservé</strong></td>
          <td class="num">dès 95 € / véhicule</td>
          <td>2 h 30 – 3 h</td>
          <td>Familles, groupes, arrivées tardives, bagages volumineux</td>
        </tr>
        <tr>
          <td><strong>Grand taxi négocié</strong></td>
          <td class="num">1 200–1 800 MAD</td>
          <td>2 h 30 – 3 h</td>
          <td>Voyageurs à l'aise avec la négociation, en journée</td>
        </tr>
        <tr>
          <td><strong>Bus depuis la ville</strong></td>
          <td class="num">80–120 MAD / pers.</td>
          <td>4 h 30 – 5 h 30</td>
          <td>Petit budget, bagage léger, pas de contrainte horaire</td>
        </tr>
        <tr>
          <td><strong>Voiture de location</strong></td>
          <td class="num">dès 25 € / jour</td>
          <td>2 h 30 – 3 h</td>
          <td>Séjours combinant la côte et l'intérieur</td>
        </tr>
      </tbody>
    </table>
  </div>

  <h2>La route, concrètement</h2>
  <p>
    On sort de Marrakech par l'ouest, puis la nationale traverse la plaine avant d'entrer dans le pays
    des arganiers. La chaussée est correcte mais la vitesse chute à chaque village, et les camions
    ralentissent les portions sinueuses. Comptez large plutôt que juste : trois heures est une
    estimation honnête avec une pause.
  </p>
  <p>
    Les haltes classiques sont les coopératives d'huile d'argan — dont certaines sont de vraies
    coopératives féminines, d'autres de simples boutiques — et les arganiers où l'on aperçoit parfois
    des chèvres perchées. Si vous voulez une pause, dites-le à la réservation.
  </p>

  <div class="callout">
    <span class="callout-label">À prévoir à l'arrivée</span>
    <p>
      La médina d'Essaouira est piétonne, comme celle de Marrakech : votre chauffeur vous déposera à
      Bab Doukkala ou Bab Marrakech, et le reste se fera à pied ou avec une charrette. Prévenez votre
      hébergement de votre heure d'arrivée.
    </p>
  </div>

  <h2>Aller-retour ou étape ?</h2>
  <p>
    Si Essaouira est le cœur de votre séjour, un transfert aller-retour suffit : sur place, tout se fait
    à pied et vous n'aurez aucun usage d'une voiture. Si vous envisagez plutôt une excursion à la
    journée depuis Marrakech, lisez d'abord notre page
    {' '}<a href={L('/excursion-marrakech-essaouira/')}>excursion à Essaouira</a> : six heures de route
    aller-retour pour quelques heures sur place, cela mérite réflexion.
  </p>
  <p class="small text-muted">
    Tarifs vérifiés en {PRICES_CHECKED}. Les autres options depuis le terminal sont détaillées sur
    {' '}<a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport Marrakech</a>.
  </p>
</RouteLayout>
