---
import TransferLayout from '../layouts/TransferLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
  { name: 'Navette aéroport', href: L('/agadir-airport-shuttle/') },
];
const facts = [
  { label: 'Aéroport → ville', value: '22 km' },
  { label: 'Durée', value: '25–40', sub: 'min' },
  { label: 'Navette partagée', value: '10 €', sub: 'dès' },
  { label: 'Pas de bus', value: 'Oui', sub: 'à AGA' },
];
const faqs = [
  { q: "Y a-t-il une navette aéroport à l'aéroport d'Agadir ?", a: "Il n'y a pas de navette publique régulière à Al Massira, le réseau local n'est pas pensé pour les voyageurs qui arrivent. Ce qu'on appelle « navette » ici, c'est un transfert partagé réservé à l'avance : un minivan que vous réservez en ligne, qui prend quelques groupes allant dans la même direction et dépose chacun à son hôtel. Cela démarre autour de 10 € par personne, moins cher qu'une voiture privée. Vérifié en juin 2026." },
  { q: "Combien coûte une navette partagée depuis l'aéroport d'Agadir ?", a: "Un transfert partagé en siège vers le centre d'Agadir coûte environ 10–15 € par personne, contre environ 20 € pour une voiture privée entière. Elle n'est moins chère qu'un transfert privé que si vous voyagez seul ou à deux, pour trois ou quatre personnes partageant une voiture, un transfert privé revient souvent au même prix ou moins par tête." },
  { q: "Quelle différence entre une navette partagée et un transfert privé ?", a: "La navette partagée se paie par personne et peut attendre brièvement d'autres passagers, puis dépose chaque groupe à tour de rôle : le trajet peut donc durer un peu plus longtemps. Le transfert privé se paie à la voiture, part dès que vous êtes installé et va droit à votre adresse. Le partagé est moins cher en solo ; le privé est plus rapide et meilleur pour les groupes, les familles et les adresses de la côte." },
  { q: "Une navette partagée vaut-elle le coup à Agadir ?", a: "Pour un voyageur seul ou un couple au budget serré vers un hôtel du centre d'Agadir en journée, oui, c'est l'option réservée la moins chère, à prix fixe et sans négociation. Elle convient moins aux arrivées tardives où l'on ne veut pas attendre, aux familles, ou aux villages de la côte où les détours d'itinéraire s'accumulent." },
  { q: "Peut-on réserver une navette d'aéroport à Agadir à l'avance ?", a: "Oui, et c'est nécessaire, il n'y a pas de comptoir navette à l'arrivée, il faut donc réserver en ligne au préalable. Réserver à l'avance fixe le prix par personne et garantit une place ; indiquez votre hôtel pour que l'itinéraire soit défini avant le départ." },
];
---
<TransferLayout
  lang={lang}
  title="Navette aéroport Agadir : transferts partagés et options éco (2026) | AirportAGA"
  description="La vérité sur les navettes de l'aéroport d'Agadir en 2026, pas de navette publique, mais un transfert partagé réservé est le moyen le moins cher à prix fixe pour rejoindre la ville. Prix, fonctionnement, et quand le privé est mieux."
  eyebrow="Aéroport d'Agadir · Navette"
  h1="Navette aéroport Agadir"
  lede="Il n'y a pas de navette publique à Al Massira, mais un transfert partagé réservé est l'option éco vers la ville : prix fixe par personne, une place en minivan, pas de négociation à la station. Voici comment ça marche et quand ça vaut le coup."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={10}
  heroImage={photos['agadir-bay']}
  heroProvider="intui"
  heroCtaLabel="Voir les prix des navettes partagées"
  secondaryHref="/agadir-airport-transfers/"
  secondaryLabel="Comparer tous les transferts"
  faqs={faqs}
  cta={{ heading: 'Le moyen le moins cher à prix fixe', text: 'Réservez une place en navette partagée en ligne, bloquez le prix par personne et évitez la négociation à la station, idéal en solo ou à deux avec un budget serré.', provider: 'intui', label: 'Voir les prix des navettes' }}
>
  <p>
    D'abord, ce que personne ne dit : il n'y a pas de navette publique à l'aéroport d'Agadir. Le réseau
    de bus local existe, mais il n'est pas conçu pour les voyageurs descendant d'un charter avec des
    bagages et un hôtel à rejoindre. Donc quand on cherche une « navette aéroport Agadir », ce qui
    correspond vraiment, c'est un transfert partagé réservé à l'avance, un minivan que vous réservez en
    ligne, qui transporte quelques groupes allant dans la même direction et dépose chacun à son hôtel.
    C'est l'option éco, avec un prix fixé avant le départ.
  </p>

  <h2 id="fonctionnement">Comment fonctionne une navette partagée</h2>
  <p>
    Vous réservez en ligne et indiquez votre hôtel ; à l'arrivée, vous rejoignez le véhicule, qui peut
    attendre brièvement de remplir ses places avec d'autres passagers atterrissant à peu près en même
    temps. Il dépose ensuite chaque groupe à tour de rôle : votre trajet peut donc durer un peu plus
    longtemps qu'une voiture directe, c'est la contrepartie du prix plus bas. Tout est réglé à
    l'avance : pas de station, pas de négociation, pas de mauvaise surprise de supplément de nuit. C'est
    facturé par personne, ce qui détermine si c'est le bon choix.
  </p>

  <h2 id="vs-prive">Navette partagée contre transfert privé, le calcul éco</h2>
  <p>
    Une place partagée vers le centre d'Agadir coûte environ 10–15 € par personne ; une voiture privée
    entière, environ 20 €. En solo ou à deux, la navette est donc nettement moins chère. Mais dès que
    vous êtes trois ou quatre à partager une voiture privée, le coût par tête s'inverse, un transfert
    privé revient souvent au même prix ou moins, part immédiatement et va droit à votre porte. Faites le
    calcul simple pour votre groupe avant de réserver.
  </p>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Option</th><th>Facturé</th><th>Dès</th><th>Idéal pour</th></tr>
      </thead>
      <tbody>
        <tr class="row-highlight"><td>Navette partagée</td><td>par personne</td><td class="num">10 €</td><td>solo / couples au budget serré</td></tr>
        <tr><td>Transfert privé</td><td>par voiture</td><td class="num">20 €</td><td>groupes, familles, côte</td></tr>
        <tr><td>Grand taxi</td><td>par voiture</td><td class="num">~19 €</td><td>course de jour en ville, espèces</td></tr>
      </tbody>
    </table>
  </div>
  <p class="small text-muted">Prix de départ indicatifs vers le centre d'Agadir, vérifiés en juin 2026. Les attentes et détours de la navette allongent un peu le trajet par rapport à une voiture directe.</p>

  <h3 id="reserver">Réserver une navette partagée</h3>
  <p>Pour les transferts partagés en siège, c'est le prestataire à vérifier en premier :</p>
  
  <div class="bt-widget-container" style="margin: 2rem 0;">
        <div class="widget-wrap">
      <iframe
        class="tpemd-iframe"
        srcdoc='<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:0;font-family:system-ui,sans-serif;overflow:hidden}</style></head><body><script async src="https://tpemd.com/content?currency=EUR&amp;trs=554574&amp;shmarker=697149&amp;locale=fr&amp;from=Al%20Massira%20Airport%20Agadir&amp;to=Agadir&amp;country=Morocco&amp;powered_by=true&amp;transfer_options_limit=10&amp;transfer_options=MCR&amp;disable_currency_selector=true&amp;hide_form_extras=true&amp;hide_external_links=true&amp;campaign_id=1&amp;promo_id=3879" charset="utf-8"><\/script><script>new MutationObserver(function(){document.documentElement.style.height="auto";window.parent.postMessage({tpemdHeight:document.body.scrollHeight},"*")}).observe(document.body,{childList:true,subtree:true,attributes:true})<\/script></body></html>'
        style="width:100%;border:none;min-height:200px;overflow:hidden;"
        loading="lazy"
        title="Transfer booking widget"
      ></iframe>
    </div>
  </div>


  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Une navette partagée convient à une arrivée de jour tranquille, pas à une arrivée à minuit où l'on
    ne veut que son lit. Si vous atterrissez tard ou avec des enfants, les quelques euros économisés ne
    valent rarement une voiture privée qui part dès que vous êtes attaché.
  </div>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation : si vous réservez un transfert via ces liens, nous
    pouvons percevoir une petite commission, sans surcoût pour vous. Cela ne change ni les prix affichés
    ni nos recommandations. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>

  <p>
    Vous pesez le pour et le contre ? Voyez comment se compare un <a href={L('/agadir-airport-taxi/')}>grand
    taxi</a>, trouvez le <a href={L('/best-agadir-airport-transfer/')}>meilleur transfert Agadir</a>, ou
    si le prix prime, le guide <a href={L('/cheapest-agadir-airport-transfer/')}>transfert pas cher</a>
    classe chaque option. Vue d'ensemble sur le <a href={L('/agadir-airport-transfers/')}>hub des
    transferts</a>.
  </p>
</TransferLayout>
