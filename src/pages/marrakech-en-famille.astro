---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "Marrakech en famille", href: L("/marrakech-en-famille/") },
];

const toc = [
  { label: "Ce qui plaît aux enfants", id: "activites" },
  { label: "Où dormir avec des enfants", id: "dormir" },
  { label: "Le trajet : sièges et poussettes", id: "trajet" },
  { label: "Chaleur et rythme", id: "rythme" },
  { label: "Repas et santé", id: "repas" },
  { label: "Par âge", id: "age" },
];

const faqs = [
  { q: "Marrakech est-elle adaptée aux enfants ?", a: "Oui, avec quelques précautions. Les enfants adorent les couleurs, les animations de Jemaa el-Fna, les balades en calèche ou en dromadaire et les piscines des hôtels. La chaleur, la foule et les pavés de la médina demandent en revanche de l'organisation : sorties courtes, horaires décalés, et beaucoup d'eau." },
  { q: "Peut-on circuler avec une poussette dans la médina ?", a: "C'est difficile : pavés irréguliers, ruelles étroites, deux-roues rapides. Un porte-bébé ou une poussette légère et robuste est bien plus pratique. Pour de jeunes enfants, un hôtel de Guéliz, de l'Hivernage ou de la Palmeraie simplifie nettement le séjour." },
  { q: "Les taxis fournissent-ils des sièges enfants ?", a: "Non, ni les petits taxis, ni les grands taxis de l'aéroport. Pour un bébé ou un jeune enfant, un transfert réservé avec siège adapté, à demander à la réservation, est la seule option conforme et confortable. C'est un argument fort pour réserver à l'avance." },
  { q: "Quel hébergement choisir avec des enfants ?", a: "Un hôtel ou un resort avec piscine, jardin et, idéalement, un espace jeux ou une piscine à faible profondeur. L'Hivernage et la Palmeraie sont les secteurs les mieux dotés. Un riad convient à des enfants plus grands, à partir de six ou sept ans, sensibles à l'aventure de l'arrivée à pied." },
  { q: "Que faire quand il fait trop chaud ?", a: "En été, mieux vaut visiter le matin avant 11 h et rentrer se rafraîchir. L'après-midi se passe à la piscine ; on ressort vers 17 h pour une balade ou un dîner. Les enfants supportent mal les rythmes serrés : prévoyez une seule sortie majeure par jour." },
  { q: "La cuisine marocaine plaît-elle aux enfants ?", a: "Généralement oui : brochettes, couscous, tajines non épicés, crêpes msemen au miel, jus d'orange frais. La cuisine est peu piquante par défaut. Demandez « sans piment » et privilégiez les plats cuits à la commande." },
];
---
<GuideLayout
  keywords="Marrakech enfants, Marrakech en famille, activités enfants Marrakech, siège enfant transfert"
  title={"Marrakech en famille : que faire avec des enfants, où dormir, conseils (2026) | AirportRAK"}
  description={"Voyager à Marrakech avec des enfants : activités par âge, jardins, piscines, désert d'Agafay, chaleur, poussette dans la médina, sièges enfants en transfert, repas et santé."}
  eyebrow={"Marrakech · Voyage en famille"}
  h1={"Marrakech en famille"}
  lede={"Oui, Marrakech se visite avec des enfants, à condition d'adapter le rythme : peu de médina en plein soleil, beaucoup de piscine, et des activités qui bougent. Voici le plan qui marche."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-with-kids"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Un transfert avec siège enfant", text: "À demander à la réservation. Un véhicule jusqu'à sept passagers coûte 27 €, prix fixe, chauffeur qui suit votre vol.", provider: "transfer", label: "Voir les prix des transferts" }}
>
<h2 id="activites">Ce qui plaît aux enfants</h2>
<ul>
  <li><strong>Jemaa el-Fna, en fin d'après-midi</strong> : musiciens, jongleurs, conteurs. Tenez les enfants par la main : la foule est dense, et évitez la zone des animaux.</li>
  <li><strong>La calèche</strong> : un tour autour des remparts, à convenir avant de monter, souvent le souvenir favori des petits.</li>
  <li><strong>Le dromadaire dans la Palmeraie</strong> : une demi-heure à une heure, sans effort, avec un thé au retour. Voyez <a href={L('/balade-chameau-quad-marrakech/')}>chameau, quad et buggy</a>.</li>
  <li><strong>Le jardin Majorelle</strong> : les cactus, les bassins, les couleurs. Une heure suffit, à l'ouverture pour éviter la foule.</li>
  <li><strong>Les jardins de la Ménara</strong> : un grand bassin, des allées d'oliviers et de l'espace pour courir.</li>
  <li><strong>Un parc aquatique</strong> en périphérie et les piscines de resorts, pour les après-midis chauds.</li>
  <li><strong>Le désert d'Agafay</strong> : dromadaires, coucher de soleil et dîner sous les étoiles ; voyez <a href={L('/excursion-desert-agafay/')}>désert d'Agafay</a>.</li>
  <li><strong>Un cours de cuisine ou de poterie</strong> : les ateliers acceptent souvent les enfants à partir de sept ou huit ans.</li>
</ul>

<h2 id="dormir">Où dormir avec des enfants</h2>
<p>
  Le choix du quartier compte plus que l'étoile de l'hôtel. L'<strong>Hivernage</strong> et la
  <strong>Palmeraie</strong> proposent grands jardins, piscines et espaces clos où les enfants circulent
  sans traverser une rue. <strong>Guéliz</strong> convient pour un séjour plus urbain. Un
  <a href={L('/riads-medina-marrakech/')}>riad en médina</a> se réserve pour des enfants plus grands :
  escaliers étroits, patios ouverts et marche d'approche avec les bagages. Le comparatif complet est sur
  <a href={L('/ou-dormir-marrakech/')}>quel quartier pour dormir</a>.
</p>

<h2 id="trajet">Le trajet : sièges et poussettes</h2>
<p>
  Le taxi est la première surprise : <strong>pas de sièges enfants</strong>, ni dans les petits taxis ni
  dans les grands, et un petit taxi n'accepte que trois passagers. Avec un bébé ou une famille de quatre
  ou plus, le transfert réservé règle tout : siège à cocher à la réservation, un véhicule pour la famille
  et prix fixe de 27 €. Voyez <a href={L('/reserver-transfert/')}>réserver un transfert</a>.
</p>
<p>
  Côté poussette, un modèle léger avec de grosses roues, ou un porte-bébé, s'en sort mieux dans les
  ruelles pavées. À l'aéroport, les chariots sont disponibles et les distances courtes.
</p>

<h2 id="rythme">Chaleur et rythme</h2>
<div class="callout">
  <span class="callout-label">La règle des trois créneaux</span>
  <p>
    Le matin (8 h – 11 h) pour visiter, l'après-midi (12 h – 17 h) pour la piscine et la sieste, le soir
    (à partir de 17 h) pour la place et le dîner. Une seule grande sortie par jour, sinon les enfants
    s'épuisent.
  </p>
</div>
<p>
  Emportez chapeaux, crème solaire, gourdes et vêtements amples. Dans la médina, l'eau en bouteille
  s'achète partout. Consultez <a href={L('/quand-partir-marrakech/')}>quand partir</a> : les
  vacances d'été sont chaudes, celles de printemps et d'automne bien plus confortables.
</p>

<h2 id="repas">Repas et santé</h2>
<ul>
  <li><strong>Eau :</strong> en bouteille scellée, y compris pour se brosser les dents avec de jeunes enfants.</li>
  <li><strong>Aliments :</strong> plats cuits à la commande, fruits que l'on épluche, pas de crudités douteuses.</li>
  <li><strong>Trousse :</strong> antidiarrhéique adapté à l'âge, sels de réhydratation, thermomètre, désinfectant, crème solaire.</li>
  <li><strong>Animaux errants :</strong> chats et chiens de rue à ne pas caresser.</li>
  <li><strong>Pharmacies :</strong> nombreuses et bien fournies, avec des conseils en français.</li>
</ul>
<p>
  Pour le panorama complet des précautions, voyez
  <a href={L('/securite-marrakech/')}>sécurité à Marrakech</a>.
</p>

<h2 id="age">Par âge</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Âge</th><th>Ce qui marche</th><th>À éviter</th></tr></thead>
    <tbody>
      <tr><td><strong>Bébé (0–2 ans)</strong></td><td>Hôtel avec piscine, porte-bébé, transferts réservés</td><td>Médina en poussette, chaleur de l'après-midi</td></tr>
      <tr><td><strong>3–6 ans</strong></td><td>Calèche, jardins, piscine, dromadaire</td><td>Longues visites de musées</td></tr>
      <tr><td><strong>7–12 ans</strong></td><td>Jemaa el-Fna, cuisine, Agafay, souks courts</td><td>Rythme trop dense</td></tr>
      <tr><td><strong>Adolescents</strong></td><td>Quad, buggy, souks, photo, montgolfière selon l'âge</td><td>Rien : la ville leur parle</td></tr>
    </tbody>
  </table>
</div>
</GuideLayout>
