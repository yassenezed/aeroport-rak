---
import TransferLayout from '../../layouts/TransferLayout.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import { airport, PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts & taxi', href: L('/transfert-aeroport-marrakech/') },
  { name: 'Taxi aéroport', href: L('/taxi-aeroport-marrakech/') },
  { name: 'Prix', href: L('/taxi-aeroport-marrakech/prix/') },
];

const facts = [
  { label: 'Médina (jour)', value: `${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]}`, sub: 'MAD' },
  { label: 'Médina (nuit)', value: `${airport.taxiFare.nightMad[0]}–${airport.taxiFare.nightMad[1]}`, sub: 'MAD' },
  { label: 'Tarification', value: 'par voiture', sub: 'pas par personne' },
  { label: 'Paiement', value: 'Espèces', sub: 'dirhams' },
];

// Courses urbaines : couvertes par l'affichage officiel du rang de taxis.
const ville = [
  { zone: 'Médina (Jemaa el-Fna, Bab Doukkala, Bab Laksour)', jour: '100–150', nuit: '150–240', eur: '9–14 €', note: 'Dépose à la porte, pas au riad' },
  { zone: 'Guéliz (centre moderne, gare ONCF)', jour: '100–150', nuit: '150–200', eur: '9–14 €', note: 'Dépose devant l\'hôtel' },
  { zone: 'Hivernage', jour: '100–150', nuit: '150–200', eur: '9–14 €', note: 'Le plus proche de l\'aéroport' },
  { zone: 'Agdal / Issil', jour: '100–160', nuit: '160–220', eur: '9–15 €', note: 'Résidences et hôtels récents' },
  { zone: 'Semlalia / Route de Casablanca', jour: '120–180', nuit: '180–250', eur: '11–17 €', note: 'Axe hôtelier nord' },
  { zone: 'Targa / Route de Safi', jour: '130–200', nuit: '200–270', eur: '12–19 €', note: 'Quartier résidentiel ouest' },
  { zone: 'La Palmeraie (resorts)', jour: '150–250', nuit: '250–350', eur: '14–23 €', note: 'Adresses dispersées, précisez le nom exact' },
];

// Longues distances : hors affichage, tarif négocié en grand taxi.
const longue = [
  { zone: "Désert d'Agafay", km: '30–40 km', prix: '350–500', eur: '32–46 €' },
  { zone: "Vallée de l'Ourika (Setti Fatma)", km: '40–65 km', prix: '400–650', eur: '37–60 €' },
  { zone: 'Imlil (Toubkal)', km: '65 km', prix: '600–850', eur: '55–78 €' },
  { zone: 'Oukaïmeden', km: '75 km', prix: '700–950', eur: '64–87 €' },
  { zone: "Cascades d'Ouzoud", km: '150 km', prix: '1 000–1 400', eur: '92–129 €' },
  { zone: 'Essaouira', km: '180 km', prix: '1 200–1 800', eur: '110–165 €' },
  { zone: 'Ouarzazate', km: '200 km', prix: '1 500–2 000', eur: '138–184 €' },
  { zone: 'Casablanca', km: '240 km', prix: '1 700–2 200', eur: '156–202 €' },
  { zone: 'Agadir', km: '250 km', prix: '1 800–2 500', eur: '165–230 €' },
];

const faqs = [
  {
    q: "Combien devrait coûter un taxi depuis l'aéroport de Marrakech ?",
    a: `Vers la médina, Guéliz ou l'Hivernage, comptez ${airport.taxiFare.dayMad[0]} à ${airport.taxiFare.dayMad[1]} MAD en journée et ${airport.taxiFare.nightMad[0]} à ${airport.taxiFare.nightMad[1]} MAD la nuit, pour la voiture entière. La Palmeraie monte à 150–250 MAD de jour. Les longues distances (Agafay, Ourika, Essaouira) sortent du barème affiché et se négocient en grand taxi. Tarifs relevés en ${PRICES_CHECKED}.`
  },
  {
    q: "Le prix est-il par personne ou par voiture ?",
    a: "Par voiture, pour une course privée, jusqu'au nombre de places autorisées. Un couple paie donc le même prix qu'un voyageur seul. La confusion vient des grands taxis interurbains que les Marocains partagent à la place, mais au rang de l'aéroport vous louez le véhicule entier. Faites confirmer « par voiture » au moment de fixer le montant."
  },
  {
    q: "Pourquoi le tarif augmente-t-il la nuit ?",
    a: "Un barème de nuit s'applique à partir de 20 h environ et ajoute grossièrement 50 % au tarif de journée. Comme une grande partie des vols low cost se posent en soirée, c'est souvent ce tarif-là que paient les arrivants. Ce n'est pas une arnaque : c'est le barème, et il est affiché."
  },
  {
    q: "Comment savoir si l'on me demande un prix excessif ?",
    a: `Repérez le panneau tarifaire du rang avant d'aborder un chauffeur, puis annoncez vous-même la zone et le montant. Au-delà de ${airport.taxiFare.dayMad[1]} MAD en journée pour la médina, Guéliz ou l'Hivernage, vous êtes au-dessus du marché : dites-le calmement et passez à la voiture suivante, il y a toujours une file.`
  },
  {
    q: "Peut-on payer un taxi par carte à l'aéroport ?",
    a: "Non, prévoyez des espèces en dirhams et, si possible, des coupures de 50 et 100 MAD : rendre la monnaie sur un billet de 200 est un motif de friction classique. Si vous tenez à payer par carte, seule une réservation de transfert en ligne le permet."
  },
  {
    q: "Le taxi revient-il moins cher qu'un transfert réservé ?",
    a: "En journée, pour deux personnes vers le centre, le taxi reste souvent un peu moins cher. L'écart disparaît la nuit, quand le barème grimpe, et s'inverse à quatre passagers, quand il faut deux petits taxis. Ajoutez-y le confort du prix fixe et de la dépose à la bonne porte, et le transfert redevient compétitif dans la majorité des arrivées en soirée."
  },
];
---
<TransferLayout
  title="Prix taxi aéroport Marrakech 2026 : grille complète jour et nuit | AirportRAK"
  description="La grille des prix taxi depuis l'aéroport Marrakech Ménara : médina, Guéliz, Hivernage, Palmeraie, Agafay, Ourika, Essaouira. Tarifs jour et nuit en dirhams et en euros, et comment repérer un prix excessif."
  eyebrow="Aéroport Marrakech Ménara · Prix des taxis"
  h1="Prix taxi aéroport Marrakech (2026)"
  lede="Les tarifs, zone par zone, jour et nuit, en dirhams et en euros. De quoi arriver au rang de taxis en sachant ce que vous devez payer plutôt qu'en le devinant, et savoir à partir de quel montant il vaut mieux passer à la voiture suivante."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={9}
  heroImage={photos['marrakech-taxi']}
  heroProvider="transfer"
  heroCtaLabel="Comparer avec un transfert à prix fixe"
  secondaryHref="/taxi-aeroport-marrakech/"
  secondaryLabel="Conseils taxi à l'aéroport"
  faqs={faqs}
  cta={{ heading: 'Un prix fixe, sans discussion', text: "Comparez ces tarifs avec un transfert réservé : prix bloqué par véhicule, suivi du vol et dépose à la porte la plus proche de votre riad.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    Marrakech fait partie des aéroports marocains qui affichent officiellement leurs tarifs de taxi au
    rang de prise en charge, par zone. Les fourchettes ci-dessous correspondent à ce que paient
    réellement les voyageurs en {PRICES_CHECKED}, prix pour la <strong>voiture entière</strong>. Le
    barème de nuit s'applique à partir de 20 h environ.
  </p>

  <h2>Courses urbaines : les zones couvertes par l'affichage</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Destination</th><th>Journée (MAD)</th><th>Nuit (MAD)</th><th>≈ en €</th><th>À savoir</th></tr>
      </thead>
      <tbody>
        {ville.map((r, i) => (
          <tr class:list={[{ 'row-highlight': i === 0 }]}>
            <td><strong>{r.zone}</strong></td>
            <td class="num">{r.jour}</td>
            <td class="num">{r.nuit}</td>
            <td class="num">{r.eur}</td>
            <td>{r.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small text-muted">
    Conversions indicatives sur la base d'environ 10,9 MAD pour 1 €. Le taux réel de votre retrait
    variera légèrement.
  </p>

  <h2>Longues distances : hors barème, en grand taxi</h2>
  <p>
    Dès que vous sortez de l'agglomération, l'affichage ne s'applique plus : le prix se négocie
    intégralement, en grand taxi, et dépend de la saison, de l'heure et du retour à vide du chauffeur.
    Ces trajets sont ceux où un transfert réservé se révèle souvent plus stable en prix, et surtout
    disponible à l'heure exacte de votre vol.
  </p>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Destination</th><th>Distance</th><th>Grand taxi (MAD)</th><th>≈ en €</th></tr>
      </thead>
      <tbody>
        {longue.map((r) => (
          <tr>
            <td><strong>{r.zone}</strong></td>
            <td>{r.km}</td>
            <td class="num">{r.prix}</td>
            <td class="num">{r.eur}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout">
    <span class="callout-label">Repère utile</span>
    <p>
      Un aller simple vers Essaouira en grand taxi coûte rarement moins de 1 200 MAD. En dessous, le
      chauffeur compte souvent remplir la voiture avec d'autres passagers, ou vous déposer à une gare
      routière plutôt qu'à votre adresse. Faites préciser « course privée, directe » avant de vous
      engager.
    </p>
  </div>

  <h2>Trois réflexes qui évitent le tarif touriste</h2>
  <ul>
    <li>
      <strong>Regardez le panneau avant de parler.</strong> Il est à l'entrée du rang. Annoncer
      soi-même la zone et le montant change immédiatement la conversation.
    </li>
    <li>
      <strong>Fixez le prix coffre fermé.</strong> Une fois les valises chargées, votre marge de
      discussion tombe à zéro. C'est la seule erreur vraiment coûteuse.
    </li>
    <li>
      <strong>Nommez la porte, pas le riad.</strong> « Bab Laksour » est une instruction claire ;
      le nom d'un riad parmi des centaines ne l'est pas, et sert souvent de prétexte à un supplément.
      La liste des portes utiles est sur notre page
      {' '}<a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>.
    </li>
  </ul>

  <h2>Quand le transfert réservé devient plus intéressant</h2>
  <p>
    Faites le calcul à quatre : deux petits taxis vers la médina de nuit, c'est 300 à 480 MAD, soit
    28 à 44 €. Un transfert privé pour un véhicule familial part de 12 à 20 € selon la période, prix
    bloqué, avec suivi du vol. Le raisonnement vaut aussi pour les vols tardifs et pour les longues
    distances, où l'écart de négociation atteint plusieurs centaines de dirhams. Notre comparatif
    {' '}<a href={L('/meilleur-transfert-aeroport-marrakech/')}>quel transfert choisir</a> détaille les
    opérateurs, et la page
    {' '}<a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport</a> reprend l'ensemble des
    options, bus {airport.bus.line} compris.
  </p>
</TransferLayout>
