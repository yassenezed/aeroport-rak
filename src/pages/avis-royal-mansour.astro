---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
// Import images
import heroImg from '../assets/img/placeholder.png';
import bodyImg from '../assets/img/placeholder.png';
import { Image } from 'astro:assets';

const lang = 'fr';
const t = useTranslations(lang);
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: t('nav.hotels'), href: L('/best-hotels-agadir/') },
  { name: 'Riu Tikida Beach', href: L('/riu-tikida-beach-review/') },
];
---
<HotelReviewLayout
  lang={lang}
  title={`Riu Tikida Beach. Avis Adults Only & Tarifs | AirportAGA`}
  description={`Notre avis d'expert sur le Riu Tikida Beach. Le meilleur resort All-Inclusive réservé aux adultes à Agadir.`}
  h1={`Riu Tikida Beach. Avis Adults Only & Tarifs`}
  subtitle={`L'oasis All-Inclusive premium réservée aux adultes`}
  breadcrumbs={breadcrumbs}
  brand={`Riu Tikida Beach`}
  rating={4.5}
  verdict={`L'escapade paisible parfaite pour les couples, sans enfants.`}
  priceAvg={`140€ - 280€ / nuit`}
  address={`Chemin des Dunes, Agadir 80000`}
  stars={`★★★★`}
  ratingText={`Excellent`}
  heroImage={heroImg}
  ctaLink="https://www.booking.com/hotel/ma/riu-tikida-beach.fr.html"
  ctaLabel={`Voir les disponibilités`}
  faqs={[{"q": "Le Riu Tikida Beach est-il strictement réservé aux adultes ?", "a": "Oui, les clients doivent être âgés de 16 ans ou plus."}, {"q": "Le All-Inclusive inclut-il l'alcool ?", "a": "Oui, la formule comprend une large gamme de boissons alcoolisées locales et internationales."}]}
>
  <div class="content-block">
    <h2>Présentation</h2>
    <p>Une oasis pour adultes au cœur de la baie d'Agadir. Le Riu Tikida Beach promet détente, service premium et excellente gastronomie, sans le bruit d'un resort familial typique. Si vous cherchez la paix, la thalassothérapie et des cocktails au bord de la piscine, c'est votre destination.</p>
    
    <h3>Pourquoi choisir le Riu Tikida Beach ?</h3>
    <ul class="pros-list">
      <li>Strictement réservé aux adultes (16+) pour une atmosphère calme.</li>
      <li>Excellent centre de thalassothérapie pour le bien-être.</li>
      <li>Service All-Inclusive premium 24h/24 (nourriture et boissons).</li>
      <li>Superbe plage privée avec chaises longues dédiées.</li>
      <li>Divertissements en soirée sophistiqués.</li>
    </ul>

    <h3>Les Chambres</h3>
    <p>Les chambres présentent une décoration élégante propice à la détente. Elles sont équipées d'installations modernes, de lits king-size confortables et de balcons donnant sur la piscine ou l'océan.</p>
    
    <div style="margin: 2rem 0; border-radius: 8px; overflow: hidden;">
      <Image src={bodyImg} alt={`Riu Tikida Beach`} widths={[768, 1200]} sizes="(max-width: 768px) 100vw, 800px" />
    </div>

    <h2>Comment rejoindre le Riu Tikida Beach depuis l'aéroport</h2>
    <ol class="steps-list">
      <li>Récupérez vos bagages à l'aéroport d'Agadir.</li>
      <li>Retrouvez votre chauffeur privé tenant un panneau à votre nom.</li>
      <li>Profitez d'un trajet agréable de 35 minutes le long de la côte.</li>
      <li>Arrivez à l'entrée où le personnel vous accueillera avec un verre.</li>
    </ol>

    <h2>Équipements & Services</h2>
    <div class="features-grid">
      <div class="feature-item"><strong>Adults Only</strong><p>Un environnement strictement sans enfants.</p></div>
      <div class="feature-item"><strong>Spa Thalasso</strong><p>Traitements à l'eau de mer et massages.</p></div>
      <div class="feature-item"><strong>4 Restaurants</strong><p>Restauration variée incluant cuisine marocaine et fusion.</p></div>
      <div class="feature-item"><strong>Discothèque & Bars</strong><p>Bars élégants et discothèque sur place.</p></div>
    </div>

    <h2>Idéal pour les couples et les amis</h2>
    <p>Parfait pour les escapades romantiques ou un voyage relaxant entre amis où l'accent est mis sur le bien-être, la bonne nourriture et la tranquillité.</p>

    <div class="promo-box">
      <h3>Réservez votre escapade sans enfants</h3>
      <p>Les resorts "Adults Only" à Agadir se remplissent vite. Vérifiez les prix aujourd'hui.</p>
      <a class="btn btn--green" href="https://www.booking.com/hotel/ma/riu-tikida-beach.fr.html" rel="nofollow sponsored" target="_blank">{`Voir les disponibilités`}</a>
    </div>
  </div>
</HotelReviewLayout>
