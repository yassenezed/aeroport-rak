---
import HotelReviewLayout from '../layouts/HotelReviewLayout.astro';
import { getLocalizedPath, useTranslations } from '../i18n';
import { photos } from '../data/images';

const t = useTranslations('fr');
const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: t('nav.home'), href: L('/') },
  { name: 'Où dormir', href: L('/ou-dormir-marrakech/') },
  { name: 'Royal Mansour', href: L('/avis-royal-mansour/') },
];
---
<HotelReviewLayout
  title={`Royal Mansour Marrakech : notre avis et l'accès depuis l'aéroport | AirportRAK`}
  description={`Notre regard sur le Royal Mansour : des riads privés plutôt que des chambres, un artisanat marocain d'exception, et un accès depuis l'aéroport de Marrakech en une vingtaine de minutes.`}
  h1={`Royal Mansour : notre avis et l'accès depuis l'aéroport`}
  subtitle={`Des riads privés au lieu de chambres, le long des remparts`}
  breadcrumbs={breadcrumbs}
  brand={`Royal Mansour`}
  rating={4.9}
  verdict={`Le sommet du marché marrakchi, et une conception à part : un jardin de riads privés plutôt qu'un palace vertical. Intimité totale, artisanat d'exception, accès routier immédiat depuis le RAK.`}
  priceAvg={`Très élevé, tarification par riad`}
  address={`Le long des remparts, secteur Bab Jdid`}
  stars={`★★★★★`}
  ratingText={`Exceptionnel`}
  heroImage={photos['royal-mansour']}
  ctaLink={L('/ou-dormir-marrakech/')}
  ctaLabel={`Comparer les disponibilités`}
  faqs={[
    { q: "Où se trouve le Royal Mansour par rapport à l'aéroport ?", a: "À environ 5 km du terminal, le long des remparts, soit 12 à 20 minutes de route. L'accès est entièrement routier : aucune marche dans les ruelles n'est nécessaire." },
    { q: "Qu'est-ce qui distingue le Royal Mansour des autres palaces de Marrakech ?", a: "Sa conception : l'hôtel n'est pas un bâtiment unique mais un ensemble de riads privés répartis dans un jardin, chacun avec son patio et sa terrasse. L'établissement a été voulu par le roi Mohammed VI et ouvert en 2010, avec un travail d'artisanat marocain poussé très loin." },
    { q: "Le Royal Mansour est-il adapté aux familles ?", a: "La configuration en riads privés, avec plusieurs chambres et un espace de vie propre, convient particulièrement aux familles et aux groupes qui souhaitent une intimité totale." },
    { q: "Quel budget prévoir ?", a: "C'est l'adresse la plus haut de gamme de la ville, dans un ordre de prix nettement supérieur aux autres palaces marrakchis. Les tarifs s'entendent par riad et varient fortement selon la saison." }
  ]}
>
  <div class="content-block">
    <h2>Ce que c'est</h2>
    <p>
      Ouvert en 2010 à l'initiative du roi Mohammed VI, le Royal Mansour a pris le contre-pied de
      l'hôtellerie de luxe classique : au lieu d'un palace vertical, un ensemble de riads privés
      dispersés dans un jardin clos, chacun avec son patio, son salon et sa terrasse sur le toit.
      L'artisanat y a été porté à un degré d'exécution — zellige, plâtre sculpté, bois de cèdre — qui en
      fait autant une vitrine du savoir-faire marocain qu'un hôtel.
    </p>

    <h3>Pourquoi on le retient</h3>
    <ul class="pros-list">
      <li>Des riads privés plutôt que des chambres : intimité complète, plusieurs niveaux.</li>
      <li>Un niveau d'artisanat exceptionnel, jusque dans les circulations de service.</li>
      <li>Une adresse le long des remparts, à quelques minutes en voiture de la médina.</li>
      <li>Un service d'une densité rare, pensé pour être invisible.</li>
      <li>Restauration et spa au niveau de l'ensemble.</li>
    </ul>

    <h2>L'accès depuis l'aéroport</h2>
    <p>
      Cinq kilomètres, douze à vingt minutes, dépose devant l'établissement. L'hôtel prend en charge les
      transferts pour ses hôtes ; si vous organisez vous-même le trajet, un
      <a href={L('/reserver-transfert/')}>transfert privé réservé</a> évite toute discussion à l'arrivée
      et permet d'annoncer un horaire exact.
    </p>

    <h2>Pour qui</h2>
    <p>
      Pour un séjour où la discrétion et l'espace privé comptent autant que le décor : familles réunies,
      voyages d'exception, séjours où l'on souhaite ne croiser personne. La configuration en riads le
      rend particulièrement adapté aux groupes qui veulent rester ensemble sans partager un couloir
      d'hôtel.
    </p>

    <h2>À savoir avant de réserver</h2>
    <p>
      C'est le segment le plus élevé du marché marrakchi, avec une tarification par riad et une forte
      saisonnalité. Pour comparer avec les autres adresses de la ville, voyez notre sélection
      <a href={L('/meilleurs-hotels-marrakech/')}>meilleurs hôtels de Marrakech</a>, et
      <a href={L('/ou-dormir-marrakech/')}>quel quartier pour dormir</a> pour arbitrer entre médina,
      Hivernage et Palmeraie.
    </p>
  </div>
</HotelReviewLayout>
