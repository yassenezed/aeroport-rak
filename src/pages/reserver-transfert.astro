---
import BaseLayout from '../layouts/BaseLayout.astro';
import TransferWidget from '../components/affiliate/TransferWidget.astro';
import Icon from '../components/ui/Icon.astro';
import { getLocalizedPath } from '../i18n';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const title = "Réserver un transfert à l'aéroport de Marrakech";
const description = "Réservez votre transfert depuis l'aéroport de Marrakech : prix fixe par véhicule, suivi du vol, chauffeur avec votre nom et dépose à la porte de votre riad.";

const garanties = [
  { icon: 'check', titre: 'Prix fixe par véhicule', desc: `Le montant affiché est celui que vous payez. Pas de barème de nuit, pas de discussion au rang de taxis à une heure du matin.` },
  { icon: 'clock', titre: 'Suivi du numéro de vol', desc: "Un retard d'avion décale automatiquement la prise en charge. C'est la principale raison de réserver plutôt que d'improviser." },
  { icon: 'map-pin', titre: 'Dépose à la bonne porte', desc: "Aucune voiture n'entre dans la médina. Indiquez le nom de votre riad et sa porte : le chauffeur s'arrête au plus près." },
  { icon: 'shield', titre: 'Opérateurs vérifiés', desc: 'Les trajets sont assurés par des transporteurs locaux agréés, avec chauffeurs professionnels et véhicules assurés.' },
];

const vehicules = [
  { tag: 'Solo & couples', titre: 'Berline', desc: '1 à 3 passagers, deux valises. Le format standard vers la médina, Guéliz ou l\'Hivernage.' },
  { tag: 'Familles', titre: 'Monospace', desc: 'Jusqu\'à 6 passagers, sièges enfants sur demande, vrai volume de coffre pour les poussettes.' },
  { tag: 'Groupes & désert', titre: 'Minibus', desc: 'À partir de 7 passagers. À réserver tôt : c\'est la catégorie qui manque en haute saison.' },
];

const etapes = [
  { n: 1, titre: 'Indiquez votre destination', desc: 'Le nom exact de votre riad, hôtel ou camp, avec la porte de la médina si vous en avez une.' },
  { n: 2, titre: 'Choisissez le véhicule', desc: 'Selon le nombre de passagers et le volume de bagages, sièges enfants compris.' },
  { n: 3, titre: 'Retrouvez votre chauffeur', desc: 'Il attend dans le hall des arrivées, après la douane, avec une pancarte à votre nom.' },
];

const faqs = [
  {
    q: "Comment retrouver mon chauffeur à l'aéroport de Marrakech ?",
    a: "Il vous attend dans le hall des arrivées, après la douane, avec une pancarte portant votre nom. La zone est compacte et se balaie du regard. Les personnes qui vous abordent avant ce point ne sont pas votre chauffeur : avancez jusqu'au hall."
  },
  {
    q: "Que se passe-t-il si mon vol est en retard ?",
    a: "Vous renseignez votre numéro de vol à la réservation, et l'opérateur suit l'horaire réel. La prise en charge est décalée automatiquement, sans frais d'attente. C'est le principal avantage face à un taxi pris sur place."
  },
  {
    q: "Le chauffeur peut-il me déposer devant mon riad ?",
    a: "Dans la médina, non : les derbs sont trop étroits et plusieurs accès sont fermés à la circulation. La dépose se fait à la porte la plus proche, puis 3 à 10 minutes à pied. Demandez à votre riad d'envoyer un porteur avec charrette, c'est gratuit ou coûte un pourboire de 20 à 30 MAD."
  },
  {
    q: "Les sièges enfants sont-ils disponibles ?",
    a: "Oui, à demander au moment de la réservation, siège bébé ou rehausseur selon l'âge. C'est indispensable à Marrakech : aucun taxi de l'aéroport n'en propose, ce qui rend le transfert réservé la seule option conforme avec de jeunes enfants."
  },
  {
    q: "Peut-on annuler ou modifier ?",
    a: "La plupart des tarifs autorisent l'annulation gratuite jusqu'à 24 heures avant la prise en charge, et le paiement différé. Vérifiez la politique exacte affichée dans le récapitulatif avant de valider, elle varie selon le véhicule et l'opérateur."
  },
  {
    q: "Un transfert est-il plus cher qu'un taxi ?",
    a: `En journée et à deux personnes, le taxi au tarif affiché (${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]} MAD) reste légèrement moins cher. L'écart s'annule la nuit, quand le barème passe à ${airport.taxiFare.nightMad[0]}–${airport.taxiFare.nightMad[1]} MAD, et s'inverse à partir de quatre passagers, quand il faut deux petits taxis.`
  },
];
---
<BaseLayout
  title={title}
  description={description}
  keywords="transfert aéroport Marrakech, réserver transfert Marrakech, navette aéroport Marrakech Ménara"
  hideStickyTransfer={true}
>
  <!-- Hero -->
  <section class="bk-hero">
    <div class="container">
      <div class="hero-rule"><span></span><span></span><span></span></div>
      <span class="bk-eyebrow">Marrakech Ménara · {airport.code}</span>
      <h1>Réservez votre trajet avant d'atterrir</h1>
      <p class="bk-lede">
        Prix fixe par véhicule, chauffeur qui suit votre vol, dépose à la porte la plus proche de votre
        riad. Les {airport.distanceToCityKm} kilomètres qui séparent le terminal de la médina se règlent
        en deux minutes, maintenant.
      </p>
      <div class="bk-route">
        <span class="bk-route-point">Aéroport {airport.code}</span>
        <span class="bk-route-line"></span>
        <span class="bk-route-point bk-route-dest">Votre riad ou hôtel</span>
      </div>
    </div>
  </section>

  <!-- Widget -->
  <section class="bk-widget-section" id="reservation">
    <div class="container">
      <div class="bk-widget-card">
        <h2>Où allez-vous ?</h2>
        <p class="text-muted">Indiquez votre destination pour voir les disponibilités et les prix fixes.</p>
        <TransferWidget title="Réservation de transfert aéroport Marrakech" />
        <p class="bk-note">
          <Icon name="info" size={14} />
          <span>Réservations traitées par notre partenaire. Nous pouvons percevoir une commission, sans surcoût pour vous.</span>
        </p>
      </div>
      <p class="bk-seo">
        Vous cherchez un <strong>transfert depuis l'aéroport de Marrakech</strong> vers la médina, Guéliz,
        l'Hivernage, la Palmeraie ou un camp du désert d'Agafay ? Le prix est fixé avant le départ et le
        chauffeur suit votre numéro de vol. Pour comparer avec les autres options, voyez le
        <a href={L('/taxi-aeroport-marrakech/')}>taxi de l'aéroport</a>, le
        <a href={L('/transfert-aeroport-marrakech/')}>panorama des transferts</a> ou notre comparatif
        <a href={L('/meilleur-transfert-aeroport-marrakech/')}>quel transfert choisir</a>.
      </p>
    </div>
  </section>

  <!-- Garanties -->
  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Ce que vous réservez</span>
      <h2>Quatre choses qu'un taxi ne vous donne pas</h2>
      <div class="grid grid-4" style="margin-top:1.75rem">
        {garanties.map((g) => (
          <div class="card">
            <div class="bk-icon"><Icon name={g.icon} size={22} /></div>
            <h3>{g.titre}</h3>
            <p class="small text-muted">{g.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Étapes -->
  <section class="section">
    <div class="container container-narrow">
      <span class="eyebrow">Comment ça marche</span>
      <h2>Trois étapes</h2>
      <ol class="bk-steps">
        {etapes.map((e) => (
          <li>
            <span class="bk-step-num">{e.n}</span>
            <div>
              <h3>{e.titre}</h3>
              <p class="small text-muted">{e.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Véhicules -->
  <section class="section section-alt">
    <div class="container">
      <span class="eyebrow">Choisir son véhicule</span>
      <h2>Trois formats, selon le groupe et les bagages</h2>
      <div class="grid grid-3" style="margin-top:1.75rem">
        {vehicules.map((v) => (
          <div class="card">
            <span class="chip">{v.tag}</span>
            <h3 style="margin-top:0.75rem">{v.titre}</h3>
            <p class="small text-muted">{v.desc}</p>
          </div>
        ))}
      </div>
      <div class="callout" style="margin-top:2rem">
        <span class="callout-label">Le détail qui compte à Marrakech</span>
        <p>
          Un petit taxi de l'aéroport n'accepte que <strong>trois passagers</strong> et ne propose pas de
          siège enfant. À quatre, ou avec un bébé, le transfert réservé n'est pas un luxe : c'est la
          seule option qui règle le problème en un seul véhicule.
        </p>
      </div>
    </div>
  </section>

  <!-- Avant de réserver + FAQ -->
  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="gap:3rem">
        <div>
          <h2>Avant de valider</h2>
          <ul class="bk-check">
            <li><Icon name="check" size={17} /><span><strong>Votre numéro de vol</strong> : c'est lui qui déclenche le suivi du retard.</span></li>
            <li><Icon name="check" size={17} /><span><strong>La porte de la médina</strong> la plus proche de votre riad, obtenue auprès du riad.</span></li>
            <li><Icon name="check" size={17} /><span><strong>Le nombre de valises</strong> : un monospace pour quatre grandes valises, pas une berline.</span></li>
            <li><Icon name="check" size={17} /><span><strong>Les sièges enfants</strong>, à cocher à la réservation et non sur place.</span></li>
            <li><Icon name="check" size={17} /><span><strong>La politique d'annulation</strong> affichée dans le récapitulatif.</span></li>
          </ul>
        </div>
        <div>
          <h2>Questions fréquentes</h2>
          <div class="faq-list">
            {faqs.map((f) => (
              <details class="faq-item">
                <summary>{f.q}</summary>
                <div class="faq-body"><p>{f.a}</p></div>
              </details>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="section">
    <div class="container">
      <div class="cta-band">
        <h2>Deux minutes maintenant, une arrivée sereine plus tard</h2>
        <p>Prix fixe, suivi du vol, dépose à la bonne porte. Tarifs vérifiés en {PRICES_CHECKED}.</p>
        <a href="#reservation" class="btn btn-primary btn-lg btn-arrow">Voir les prix des transferts</a>
      </div>
    </div>
  </section>

  <style>
    .bk-hero {
      background: var(--ink);
      color: #fff;
      padding-block: clamp(2.75rem, 6vw, 4.5rem) clamp(5rem, 9vw, 7rem);
      text-align: center;
    }
    .bk-hero .hero-rule { margin-inline: auto; }
    .bk-eyebrow {
      display: inline-block;
      font-family: var(--font-body); font-weight: 700;
      font-size: 0.72rem; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--saffron); margin-bottom: 1rem;
    }
    .bk-hero h1 { color: #fff; max-width: 22ch; margin-inline: auto; }
    .bk-lede {
      font-size: 1.12rem; line-height: 1.65;
      color: rgba(255,255,255,0.82);
      max-width: 60ch; margin: 1.1rem auto 0;
    }
    .bk-route {
      display: flex; align-items: center; justify-content: center; gap: 1rem;
      margin-top: 2rem; flex-wrap: wrap;
    }
    .bk-route-point {
      font-family: var(--font-body); font-weight: 700; font-size: 0.78rem;
      letter-spacing: 0.1em; text-transform: uppercase; color: rgba(255,255,255,0.65);
    }
    .bk-route-dest { color: var(--saffron); }
    .bk-route-line {
      width: 90px; height: 2px;
      background: repeating-linear-gradient(90deg, rgba(255,255,255,0.4) 0 4px, transparent 4px 8px);
    }

    .bk-widget-section { margin-top: clamp(-5rem, -7vw, -3.5rem); position: relative; z-index: 5; }
    .bk-widget-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-top: 3px solid var(--saffron);
      border-radius: var(--r-lg);
      box-shadow: var(--shadow-lg);
      padding: clamp(1.5rem, 3vw, 2.5rem);
      text-align: center;
    }
    .bk-widget-card h2 { margin-bottom: 0.4rem; }
    .bk-note {
      display: flex; align-items: center; justify-content: center; gap: 0.45rem;
      font-size: 0.82rem; color: var(--ink-3); margin: 1.25rem 0 0;
    }
    .bk-note :global(svg) { flex: none; }
    .bk-seo {
      max-width: var(--measure-wide); margin: 2rem auto 0;
      text-align: center; font-size: 0.95rem; color: var(--ink-2);
    }

    .bk-icon {
      display: inline-flex; align-items: center; justify-content: center;
      width: 44px; height: 44px; margin-bottom: 0.9rem;
      background: var(--blue-soft); color: var(--blue-dark);
      border-radius: var(--r-md);
    }

    .bk-steps { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.25rem; }
    .bk-steps li { display: flex; gap: 1rem; align-items: flex-start; margin: 0; }
    .bk-step-num {
      flex: none; display: grid; place-items: center;
      width: 34px; height: 34px;
      background: var(--saffron); color: #2a1e08;
      font-family: var(--font-body); font-weight: 700;
      border-radius: var(--r-sm);
    }
    .bk-steps h3 { font-size: 1.08rem; margin-bottom: 0.2rem; }

    .bk-check { list-style: none; padding: 0; margin: 1.25rem 0 0; display: grid; gap: 0.9rem; }
    .bk-check li { display: flex; gap: 0.7rem; align-items: flex-start; margin: 0; font-size: 0.95rem; color: var(--ink-2); }
    .bk-check :global(svg) { flex: none; margin-top: 3px; color: var(--blue); }

    @media (max-width: 560px) {
      .bk-route-line { display: none; }
    }
  </style>

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  })} />
</BaseLayout>
