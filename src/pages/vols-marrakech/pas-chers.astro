---
import MoneyLayout from '../../layouts/MoneyLayout.astro';
import FlightSearchWidget from '../../components/affiliate/FlightSearchWidget.astro';
import { getLocalizedPath } from '../../i18n';
import { photos } from '../../data/images';
import { PRICES_CHECKED } from '../../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Vols', href: L('/vols-marrakech/') },
  { name: 'Vols pas chers', href: L('/vols-marrakech/pas-chers/') },
];

const facts = [
  { label: 'Période creuse', value: 'Juil.–août', sub: 'chaleur' },
  { label: 'Meilleur jour', value: 'Mar.–jeu.', sub: 'pour partir' },
  { label: 'Prix final', value: 'Bagage', sub: 'à comparer' },
  { label: 'Anticipation', value: '6–10 sem.', sub: 'haute saison' },
];

const leviers = [
  { levier: 'Voyager en juillet ou août', gain: 'Fort', contre: 'Chaleur de 38 à 42 °C, visites à caler tôt le matin' },
  { levier: 'Choisir janvier ou novembre', gain: 'Fort', contre: 'Nuits fraîches, quelques jours de pluie possibles' },
  { levier: 'Partir en milieu de semaine', gain: 'Moyen', contre: 'Séjour à recaler autour des jours ouvrés' },
  { levier: 'Décaler de un ou deux jours', gain: 'Moyen', contre: 'Nécessite des dates souples' },
  { levier: 'Partir d\'un aéroport secondaire', gain: 'Variable', contre: 'Coût et durée du trajet pour y aller' },
  { levier: 'Voyager avec un bagage cabine seul', gain: 'Moyen', contre: 'Achats au retour limités à ce qui rentre' },
];

const faqs = [
  {
    q: "Quel est le mois le moins cher pour aller à Marrakech ?",
    a: "Juillet et août sont en général les plus abordables, parce que la chaleur — souvent au-delà de 38 °C — réduit la demande, suivis de janvier hors vacances scolaires. À l'inverse, février, Pâques et les fêtes de fin d'année sont les plus chers. Le meilleur compromis entre prix et climat se trouve en novembre et en début de printemps."
  },
  {
    q: "Quel jour de la semaine partir pour payer moins ?",
    a: "Les départs du mardi au jeudi coûtent en moyenne moins cher que ceux du vendredi au dimanche, qui concentrent les week-ends prolongés. L'écart est particulièrement net sur les lignes low cost, dont la grille tarifaire suit la demande par créneau."
  },
  {
    q: "À quelle date faut-il réserver ?",
    a: "Pour les périodes de pointe — février, Pâques, mai, fin d'année — comptez six à dix semaines d'avance. En basse saison, trois à cinq semaines suffisent souvent, et une réservation tardive peut même tomber sur des tarifs de dernière minute avantageux. Il n'existe pas de règle absolue : la concurrence entre compagnies fait bouger les prix sur une même route."
  },
  {
    q: "Une alerte de prix vaut-elle le coup ?",
    a: "Oui, si vos dates sont flexibles. Le comparateur ci-dessus permet de surveiller plusieurs dates à la fois et de repérer les creux. Sur les routes très concurrentielles comme Paris ou Londres, les tarifs remontent aussi vite qu'ils descendent : si le prix vous convient, réservez plutôt que de parier."
  },
  {
    q: "Low cost ou compagnie classique : laquelle est la moins chère ?",
    a: "Le tarif d'appel d'un low cost est plus bas, mais il ne comprend que le bagage sous le siège. Avec une valise de soute et le choix du siège, l'écart avec une compagnie classique bagage inclus fond souvent de moitié, voire disparaît. Comparez le prix final, taxes et bagages compris."
  },
  {
    q: "Vaut-il mieux passer par Casablanca ?",
    a: "Rarement pour un voyageur français. Les vols directs vers Marrakech sont nombreux et concurrentiels : une correspondance par Casablanca ajoute plusieurs heures de trajet pour un gain de prix souvent nul. Elle se justifie surtout depuis des villes sans vol direct ou sur des billets long-courrier."
  },
];
---
<MoneyLayout
  title="Vols pas chers pour Marrakech : quand et comment réserver (2026) | AirportRAK"
  description="Comment payer moins un vol vers Marrakech : les mois les plus abordables, le bon jour pour partir, le vrai prix d'un low cost avec bagage, les pièges des correspondances et une recherche en direct."
  eyebrow="Marrakech · Vols pas chers"
  h1="Vols pas chers pour Marrakech"
  lede="Les meilleurs prix ne sont pas un secret de dates, mais le résultat de trois arbitrages : la saison, le jour de départ, et le prix final une fois le bagage ajouté. Voici comment les combiner."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['travel-guide-marrakech']}
  heroProvider="#recherche"
  heroCtaLabel="Comparer les vols maintenant"
  secondaryHref="/vols-marrakech/"
  secondaryLabel="Guide des vols vers Marrakech"
  faqs={faqs}
  cta={{ heading: 'Lancez la comparaison', text: "Testez plusieurs dates : un décalage de un ou deux jours suffit souvent à économiser plus qu'un changement de compagnie.", provider: '#recherche', label: 'Comparer les vols' }}
>
  <div id="recherche" style="scroll-margin-top: 6rem;">
    <h2 style="margin-top:0">Comparez les vols</h2>
    <FlightSearchWidget />
    <p class="disclosure-inline">
      Prix indicatifs. Nous pouvons percevoir une commission sur les réservations effectuées via ce
      comparateur, sans surcoût pour vous.
    </p>
  </div>

  <p>
    Marrakech est l'une des destinations européennes de courte distance où l'écart de prix entre
    haute et basse saison est le plus marqué : un même aller-retour peut varier du simple au triple
    selon la semaine. Bonne nouvelle : la concurrence entre compagnies est vive, et les leviers sont
    nombreux.
  </p>

  <h2>Les six leviers, classés par effet</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Levier</th><th>Effet sur le prix</th><th>Le revers</th></tr>
      </thead>
      <tbody>
        {leviers.map((l, i) => (
          <tr class:list={[{ 'row-highlight': i < 2 }]}>
            <td><strong>{l.levier}</strong></td>
            <td>{l.gain}</td>
            <td>{l.contre}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Le calendrier des prix</h2>
  <p>
    <strong>Le plus bas :</strong> juillet et août. La chaleur, souvent supérieure à 38 °C, éloigne la
    demande touristique classique, et les compagnies ajustent leurs tarifs en conséquence. C'est une
    saison qui se vit tôt le matin et tard le soir, avec la piscine à l'heure chaude.
  </p>
  <p>
    <strong>Le bon compromis :</strong> novembre, début décembre, janvier hors vacances. Les journées
    sont douces, les nuits fraîches, et la ville est plus calme.
  </p>
  <p>
    <strong>Le plus cher :</strong> février (vacances scolaires et soleil hivernal), Pâques, les ponts de
    mai et les fêtes de fin d'année. Sur ces périodes, réservez six à dix semaines à l'avance.
  </p>
  <p>
    Notre page <a href={L('/quand-partir-marrakech/')}>quand partir à Marrakech</a> détaille le climat
    mois par mois, pour arbitrer entre budget et confort.
  </p>

  <h2>Comparer le prix final, pas le prix d'appel</h2>
  <div class="callout">
    <span class="callout-label">Le calcul que tout le monde fait trop tard</span>
    <p>
      Un aller-retour affiché 60 € ne comprend, en low cost, que le sac sous le siège. Ajoutez une
      valise de 20 kg, le choix du siège et l'embarquement prioritaire, et l'addition dépasse souvent
      150 €. Une compagnie classique à 170 € avec bagage inclus n'est alors plus si chère. Faites
      toujours le total avant de trancher.
    </p>
  </div>

  <h2>Voyager avec un bagage cabine seul</h2>
  <p>
    C'est le levier le plus puissant et le plus sous-estimé : pour un séjour de trois à cinq jours, un
    sac cabine suffit. Vous économisez le bagage, vous gagnez vingt minutes au tapis, et vous évitez le
    risque de valise perdue. Contrepartie : les achats du souk doivent rentrer dans le sac. Prévoyez
    d'ailleurs de mettre les liquides — huile d'argan, eau de fleur d'oranger — dans un petit format,
    car la limite de 100 ml s'applique en cabine.
  </p>

  <h2>Les pièges à éviter</h2>
  <ul>
    <li><strong>L'aéroport secondaire éloigné.</strong> Économiser 25 € pour ajouter deux heures de train ou 40 € de navette n'est pas une économie.</li>
    <li><strong>La correspondance improvisée.</strong> Deux billets séparés ne sont pas protégés en cas de retard du premier vol.</li>
    <li><strong>Le retour tôt le matin.</strong> Un vol à 6 h impose de quitter la médina en pleine nuit : voyez <a href={L('/guide-aeroport-marrakech/departs/')}>départs du RAK</a>.</li>
    <li><strong>Les frais d'enregistrement à l'aéroport.</strong> Enregistrez-vous en ligne, sous peine de supplément chez plusieurs low cost.</li>
  </ul>

  <p class="small text-muted">
    Repères vérifiés en {PRICES_CHECKED}. Pour la préparation du séjour, voyez
    {' '}<a href={L('/vols-marrakech/')}>vols vers Marrakech</a> et
    {' '}<a href={L('/formalites-entree-maroc/')}>formalités d'entrée au Maroc</a>.
  </p>
</MoneyLayout>
