---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Louer une voiture à Marrakech', href: L('/louer-voiture-marrakech-guide/') },
];

const toc = [
  { label: 'Papiers et conditions d\'âge', id: 'papiers' },
  { label: 'La caution', id: 'caution' },
  { label: 'Assurance et franchise', id: 'assurance' },
  { label: 'Carburant', id: 'carburant' },
  { label: 'État des lieux', id: 'etat-des-lieux' },
  { label: 'Aéroport ou centre-ville ?', id: 'ou-louer' },
  { label: 'Stationner à Marrakech', id: 'stationnement' },
];

const faqs = [
  {
    q: "Faut-il un permis international pour louer une voiture au Maroc ?",
    a: "Non pour un permis européen en cours de validité, accepté pour louer et conduire lors d'un séjour touristique. Un permis international ne nuit pas et simplifie un éventuel contrôle, mais il n'est pas exigé. Gardez toujours sur vous permis, contrat de location et carte grise du véhicule."
  },
  {
    q: "Quel âge minimum pour louer à Marrakech ?",
    a: "Généralement 21 ans, parfois 23 ou 25 selon la catégorie du véhicule, avec un permis détenu depuis au moins un an — souvent deux ou trois pour les catégories supérieures. En dessous de 25 ans, un supplément jeune conducteur s'applique presque partout."
  },
  {
    q: "Quelle caution prévoir ?",
    a: "Une empreinte sur carte de crédit au nom du conducteur principal, de l'ordre de 3 000 à 10 000 MAD selon le véhicule. Les cartes de débit sont souvent refusées, les prépayées presque toujours. Vérifiez le montant avant de réserver et gardez du plafond disponible pour le reste du séjour."
  },
  {
    q: "L'assurance de base suffit-elle ?",
    a: "Elle couvre la responsabilité civile mais laisse une franchise élevée à votre charge, avec des exclusions classiques : pneus, vitrage, bas de caisse, toit et conduite hors routes revêtues. Si votre carte bancaire couvre la location, faites-le vérifier ; sinon, une couverture souscrite en ligne coûte nettement moins que le rachat vendu au comptoir."
  },
  {
    q: "Peut-on payer une location en espèces au Maroc ?",
    a: "Le loyer, parfois ; la caution, non. Elle passe par une empreinte de carte de crédit, et une agence qui accepterait des espèces en garantie vous expose davantage qu'elle ne vous arrange. Considérez la carte de crédit comme une condition d'accès à la location."
  },
  {
    q: "Vaut-il mieux louer à l'aéroport ou en ville ?",
    a: "À l'aéroport pour la commodité et pour partir directement en excursion. En ville si vous ne louez que deux ou trois jours au milieu du séjour : les agences de Guéliz affichent parfois des tarifs inférieurs, et vous évitez de payer une voiture immobilisée pendant que vous visitez la médina."
  },
];
---
<GuideLayout
  keywords="louer une voiture Marrakech, conditions location Maroc, caution location voiture Maroc"
  title={"Louer une voiture à Marrakech : conditions et pièges"}
  description={"Louer une voiture à Marrakech : papiers, âge minimum, caution, franchise et exclusions, carburant, état des lieux, aéroport ou centre-ville, parking."}
  eyebrow="Marrakech · Location de voiture"
  h1="Louer une voiture à Marrakech : ce qu'il faut savoir"
  lede="Louer au Maroc n'a rien de compliqué, à condition de connaître les règles du jeu avant d'arriver au comptoir : la carte exigée, la caution, la franchise et ses exclusions, et les cinq minutes d'état des lieux qui évitent 90 % des litiges."
  breadcrumbs={breadcrumbs}
  heroImage={photos['marrakech-car-rental']}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: 'Comparer avant de réserver', text: "Tarif, caution, carburant et franchise des agences du RAK dans une seule vue : c'est là que se joue le coût réel.", provider: 'discovercars', label: 'Comparer les prix de location' }}
>
  <h2 id="papiers">Papiers et conditions d'âge</h2>
  <p>
    Un permis national européen valide suffit pour un séjour touristique : le permis international n'est
    pas exigé, même s'il facilite un contrôle. Prévoyez également votre passeport, la carte de crédit du
    conducteur principal et, si vous voyagez à deux conducteurs, la présence du second au comptoir avec
    son permis — un conducteur non déclaré au contrat n'est pas assuré.
  </p>
  <p>
    L'âge minimum est généralement de 21 ans, parfois 23 ou 25 selon la catégorie, avec un permis détenu
    depuis au moins un an. En dessous de 25 ans, comptez un supplément jeune conducteur quotidien.
  </p>

  <h2 id="caution">La caution : le vrai point bloquant</h2>
  <p>
    C'est la première cause d'échec au comptoir au Maroc. L'agence bloque une empreinte sur une
    <strong>carte de crédit au nom du conducteur principal</strong> : de l'ordre de 3 000 MAD pour une
    citadine, jusqu'à 10 000 MAD pour un SUV ou un 4x4. Les cartes de débit sont fréquemment refusées et
    les prépayées quasi systématiquement.
  </p>
  <p>
    Deux conséquences pratiques : vérifiez le plafond disponible avant de partir, et n'utilisez pas la
    même carte pour régler l'hôtel si la marge est juste. La levée de l'empreinte prend souvent plusieurs
    jours ouvrés après la restitution.
  </p>

  <h2 id="assurance">Assurance et franchise</h2>
  <p>
    Le tarif de base inclut une assurance avec franchise élevée — souvent l'équivalent de la caution.
    Regardez surtout les <strong>exclusions</strong>, car ce sont elles qui posent problème au Maroc :
    pneus, jantes, vitrage, bas de caisse, toit, et conduite hors routes revêtues. Cette dernière clause
    compte si votre itinéraire touche aux pistes de l'Atlas ou aux accès de camps du désert.
  </p>
  <p>
    Pour réduire le risque : vérifiez si votre carte de crédit couvre déjà la location, ou souscrivez
    une couverture de franchise <em>en ligne à la réservation</em>. Le rachat vendu au comptoir reste
    l'option la plus chère, et on l'accepte souvent par fatigue.
  </p>

  <h2 id="carburant">Carburant : une seule formule acceptable</h2>
  <p>
    Exigez le <strong>plein-à-plein</strong>. Vous récupérez le véhicule plein, vous le rendez plein,
    vous ne payez que ce que vous avez brûlé. Le plein-à-vide — acheter un réservoir au tarif du loueur
    et rendre la voiture à sec — vous fait payer du carburant non consommé. Le gasoil est la norme au
    Maroc et les stations sont nombreuses sur les axes ; en montagne, faites le plein avant d'attaquer
    un col, les stations s'espacent nettement au-delà de l'Ourika.
  </p>

  <h2 id="etat-des-lieux">L'état des lieux : cinq minutes décisives</h2>
  <div class="callout">
    <span class="callout-label">Le protocole</span>
    <p>
      Filmez un tour complet du véhicule en vous arrêtant sur chaque rayure, sur les quatre jantes et
      sur le pare-brise. Photographiez le compteur et la jauge. Faites inscrire les dommages existants
      sur le contrat avant de signer. À la restitution, refaites la même vidéo et repartez avec un
      document de retour signé mentionnant l'absence de nouveaux dommages. C'est la seule protection
      réellement efficace, et elle est gratuite.
    </p>
  </div>

  <h2 id="ou-louer">Louer à l'aéroport ou en ville ?</h2>
  <p>
    L'aéroport gagne sur la commodité : vous atterrissez et partez directement vers l'Ourika ou
    Essaouira, sans transfert intermédiaire. Voyez notre
    {' '}<a href={L('/location-voiture-aeroport-marrakech/')}>page location au RAK</a>.
  </p>
  <p>
    La ville gagne quand la voiture ne sert que deux ou trois jours au milieu du séjour. Les agences de
    Guéliz pratiquent parfois des tarifs plus bas, et vous n'immobilisez pas un véhicule pendant vos
    journées de médina — une économie double, sur la location et sur le stationnement.
  </p>

  <h2 id="stationnement">Stationner à Marrakech</h2>
  <p>
    Dans la ville nouvelle, le stationnement de rue est courant et un gardien en gilet vous guidera :
    quelques dirhams suffisent, c'est l'usage. Autour de la médina, visez les parkings gardés proches
    des portes — Bab Doukkala, Bab Laksour, abords de Jemaa el-Fna — qui pratiquent un forfait à la
    journée. Dans la médina elle-même, aucun stationnement n'est possible : les ruelles sont interdites
    aux voitures, comme expliqué sur
    {' '}<a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a>.
  </p>
  <p>
    Pour les règles de circulation, les contrôles et les particularités de la conduite locale, voyez
    {' '}<a href={L('/conduire-au-maroc/')}>conduire au Maroc</a>.
  </p>
</GuideLayout>
