---
import MoneyLayout from '../layouts/MoneyLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
];
const facts = [
  { label: 'Aéroport → ville', value: '22 km' },
  { label: 'Durée', value: '25–40', sub: 'min' },
  { label: 'Train / Uber', value: 'Aucun', sub: 'à AGA' },
  { label: 'Transfert réservé', value: '20 €', sub: 'dès' },
];
const faqs = [
  { q: "Quel est le meilleur moyen d'aller de l'aéroport d'Agadir en ville ?", a: "Pour une course de jour vers un hôtel du centre, le grand taxi de la station convient et reste le moins cher, fixez le prix d'abord (autour de 200–250 MAD). Pour une arrivée du soir, une famille avec sièges-auto, ou un village de surf sur la côte, un transfert privé réservé est plus serein : prix fixe, chauffeur avec votre nom, et quelqu'un capable de trouver une adresse non balisée. À l'AGA il n'y a ni train ni Uber ; ALSA fait bien rouler une navette économique vers le centre d'Agadir (autour de 50 MAD, à peu près toutes les heures en journée), mais elle ne dessert que le centre, et uniquement de jour. Tarifs vérifiés en juin 2026." },
  { q: "Y a-t-il un train ou un bus depuis l'aéroport d'Agadir ?", a: "Pas de train. Agadir n'a aucune ligne ferroviaire. En revanche il y a désormais un bus : ALSA fait rouler une navette d'aéroport vers le centre d'Agadir (à peu près toutes les heures en journée, environ 50 minutes, autour de 50 MAD), et il existe un trajet local moins cher via la ligne 37 jusqu'à Inezgane puis la ligne 98 vers la ville. Les deux ne desservent que le centre, de jour, pas la porte de votre hôtel, pas la côte, pas tard le soir. Avec des bagages, une arrivée tardive ou une destination hors du centre, le grand taxi, un transfert réservé ou une voiture de location reste donc l'option pratique." },
  { q: "Combien coûte un transfert d'aéroport à Agadir ?", a: "Un transfert privé réservé vers le centre d'Agadir démarre autour de 20 € par voiture. Vers Taghazout sur la côte, comptez environ 28 €, Taroudant autour de 55 €, et Marrakech environ 120 €. Un grand taxi vers la ville coûte 200–250 MAD en journée (≈ 19–23 €), 300–350 MAD la nuit." },
  { q: "Peut-on réserver un transfert à l'avance et payer plus tard ?", a: "Oui. La plupart des prestataires permettent de réserver maintenant et payer plus tard, avec annulation gratuite jusqu'à 24 h avant la prise en charge sur la majorité des réservations. Cela bloque le prix et place un chauffeur nommé à l'arrivée, utile pour les vols tardifs ou un premier voyage au Maroc." },
  { q: "Uber ou Careem sont-ils disponibles à l'aéroport d'Agadir ?", a: "Non. Ni Uber ni Careem ne fonctionnent à Agadir : impossible de commander une course à l'arrivée. La station de grands taxis devant les arrivées et un transfert réservé sont les vraies options porte-à-porte." },
];

const routes = [
  { href: '/agadir-airport-to-agadir/', name: "Centre d'Agadir", km: '22 km', min: '25–40 min', eur: '20 €' },
  { href: '/agadir-airport-to-taghazout/', name: 'Taghazout', km: '48 km', min: '50–65 min', eur: '28 €' },
  { href: '/agadir-airport-to-tamraght-aourir/', name: 'Tamraght & Aourir', km: '42 km', min: '40–50 min', eur: '26 €' },
  { href: '/agadir-airport-to-taroudant/', name: 'Taroudant', km: '80 km', min: '70–85 min', eur: '55 €' },
  { href: '/agadir-airport-to-tiznit/', name: 'Tiznit', km: '95 km', min: '80–95 min', eur: '60 €' },
  { href: '/agadir-airport-to-imsouane/', name: 'Imsouane', km: '90 km', min: '90–110 min', eur: '70 €' },
  { href: '/agadir-airport-to-mirleft/', name: 'Mirleft', km: '150 km', min: '130–150 min', eur: '100 €' },
  { href: '/agadir-airport-to-sidi-ifni/', name: 'Sidi Ifni', km: '165 km', min: '145–165 min', eur: '110 €' },
  { href: '/agadir-airport-to-essaouira/', name: 'Essaouira', km: '175 km', min: '150–170 min', eur: '110 €' },
  { href: '/agadir-airport-to-marrakech/', name: 'Marrakech', km: '235 km', min: '165–195 min', eur: '120 €' },
];
---
<MoneyLayout
  lang={lang}
  title="Transfert aéroport Agadir : tous les moyens vers la ville (2026) | AirportAGA"
  description="Le guide complet des transferts depuis l'aéroport Agadir Al Massira en 2026, taxi, transfert privé, navette et chauffeur, prix réels, et chaque trajet de l'AGA vers la ville, Taghazout, Marrakech et la côte."
  eyebrow="Aéroport d'Agadir · Transferts"
  h1="Transfert aéroport Agadir"
  lede="Ni train ni Uber à Al Massira, et la nouvelle navette ALSA ne dessert que le centre d'Agadir en journée, pour la plupart des arrivées, sortir de l'aéroport se résume donc à un taxi, un transfert réservé ou une voiture de location. Voici chaque option présentée clairement, ce que chacune coûte vraiment, et le bon choix selon votre arrivée."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={20}
  heroImage={photos['agadir-bay']}
  heroProvider="transfer"
  heroCtaLabel="Comparer les prix des transferts"
  secondaryHref="/agadir-airport-taxi/prices/"
  secondaryLabel="Voir les prix des taxis"
  faqs={faqs}
  cta={{ heading: 'Bloquez votre course avant de partir', text: 'Prix fixe, un chauffeur qui vous attend avec votre nom, annulation gratuite sur la plupart des réservations, réglez ça maintenant et évitez la négociation à l\'arrivée.', provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    Al Massira se trouve à environ 22 km du centre d'Agadir, du côté de Temsia, un trajet de 25 à
    40 minutes selon votre destination en ville. L'aéroport reçoit surtout des vols charters du soir
    venus d'Europe : arriver tard et fatigué est donc la norme. Ce qui surprend, c'est que la plupart des
    services attendus d'un aéroport européen manquent ici : pas de liaison ferroviaire, et les applis
    comme Uber ou Careem qui ne fonctionnent tout simplement pas dans la ville. Il existe désormais une
    navette ALSA vers le centre d'Agadir (autour de 50 MAD, à peu près toutes les heures en journée),
    mais elle ne dessert que le centre, et seulement de jour, inutile pour un transfert d'hôtel, un
    charter du soir ou la côte. Restent, pour la plupart des arrivées, trois vraies façons de sortir, et
    cette page détaille chacune.
  </p>

  <h2 id="moyens">Les trois façons de quitter l'aéroport d'Agadir</h2>
  <p>
    Chaque décision de transfert à l'AGA se résume à un choix : négocier sur place, fixer le prix à
    l'avance, ou conduire soi-même. Aucune n'est « la meilleure » dans l'absolu, tout dépend de
    l'heure d'arrivée, de qui vous accompagne, et de votre destination.
  </p>
  <ul>
    <li><strong>Grand taxi à la station</strong>, les berlines crème alignées devant les arrivées. Le moins cher pour une course de jour vers le centre, en espèces, prix négocié avant l'ouverture du coffre. Voyez comment ça marche sur la page <a href={L('/agadir-airport-taxi/')}>taxi aéroport</a> et la <a href={L('/agadir-airport-taxi/prices/')}>grille de prix complète</a>.</li>
    <li><strong>Transfert réservé</strong>, réservé en ligne, prix bloqué avant le départ et chauffeur tenant votre nom à l'arrivée. Du simple <a href={L('/agadir-airport-private-transfer/')}>transfert privé</a> à la <a href={L('/agadir-airport-shuttle/')}>navette partagée</a> moins chère ou au <a href={L('/agadir-airport-vip-transfer/')}>transfert VIP</a> haut de gamme.</li>
    <li><strong>Voiture ou chauffeur</strong>, une <a href={L('/agadir-airport-car-rental/')}>voiture de location</a> pour une liberté totale, ou un <a href={L('/agadir-private-driver/')}>chauffeur privé</a> pour une journée d'excursions sans prendre le volant.</li>
  </ul>

  <h2 id="quel">Quelle option pour votre arrivée</h2>
  <p>
    Une arrivée de jour vers un hôtel du centre ou de Founty ? Le grand taxi est rapide, simple et bon
    marché une fois le prix convenu. Un atterrissage à 23 h avec enfants et sièges-auto, ou un camp de
    surf à Taghazout sans numéro de rue ? Réservez un transfert privé, le petit supplément vous offre
    un chauffeur qui suit votre vol et connaît déjà l'adresse. Petit budget, en solo et souple sur les
    horaires ? Une navette partagée divise le coût. Des excursions à Paradise Valley, Taroudant ou la
    côte ? Une location ou un chauffeur a plus de sens que payer chaque trajet. Nous avons détaillé les
    compromis sur le comparatif <a href={L('/best-agadir-airport-transfer/')}>meilleur transfert aéroport
    Agadir</a>.
  </p>

  <h3 id="reserver">Réserver un transfert</h3>
  <p>Deux prestataires couvrent la côte du Souss de façon fiable. Prix et conditions d'annulation s'affichent avant de payer :</p>
  <TransferOptions
    sub="agadir-airport-transfers"
    options={[
      { provider: 'transfer', highlight: true, badge: 'Meilleur rapport qualité-prix', pitch: 'Voitures privées et minivans vers toutes les destinations d\'Agadir à Taghazout et Taroudant. Tarifs fixes, annulation gratuite.', label: 'Voir les prix des transferts' },
      { provider: 'transfer-vip', badge: 'Accueil personnalisé', pitch: 'Chauffeur avec pancarte à votre nom, suivi du vol en direct et arrivée sereine.', label: 'Réserver un transfert VIP' },
    ]}
  />

  <h2 id="trajets">Tous les trajets depuis l'aéroport d'Agadir</h2>
  <p>
    Voici chaque destination que nous couvrons, avec distance, durée et le prix de départ indicatif d'un
    transfert privé réservé (par voiture). Cliquez un trajet pour le détail complet, tarifs taxi,
    moments où la route est la plus lente, et les détails locaux qui comptent. Tarifs vérifiés en
    juin 2026.
  </p>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Vers</th><th>Distance</th><th>Durée</th><th>Transfert dès</th></tr>
      </thead>
      <tbody>
        {routes.map((r) => (
          <tr class:list={[{ 'row-highlight': r.href === '/agadir-airport-to-agadir/' }]}>
            <td><a href={L(r.href)}>{r.name}</a></td>
            <td class="num">{r.km}</td>
            <td class="num">{r.min}</td>
            <td class="num">{r.eur}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Quel que soit votre choix, retirez d'abord des dirhams à un distributeur du hall d'arrivée. Les
    grands taxis se paient en espèces, les machines près de la sortie appliquent le vrai taux bancaire,
    et même un chauffeur réservé vous indiquera volontiers le distributeur avant de monter vers la côte.
  </div>

  <h2 id="moins-cher">Le moins cher contre le plus simple</h2>
  <p>
    Si seul le prix compte, l'ordre est à peu près : navette partagée ou grand taxi négocié tout en bas,
    transfert privé au milieu, VIP ou chauffeur à la journée en haut. Mais « le moins cher » et « le
    moins de tracas » pointent rarement la même option après un charter du soir. Si vous comptez chaque
    dirham, voyez le guide <a href={L('/cheapest-agadir-airport-transfer/')}>transfert aéroport Agadir
    pas cher</a> ; pour un verdict net, la page <a href={L('/best-agadir-airport-transfer/')}>meilleur
    transfert</a> le résume.
  </p>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation : si vous réservez un transfert via ces liens, nous
    pouvons percevoir une petite commission, sans surcoût pour vous. Cela ne change ni les prix affichés
    ni nos recommandations. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>

  <p>
    Prêt à entrer dans le détail ? Commencez par le <a href={L('/agadir-airport-taxi/')}>taxi aéroport</a>
    et sa <a href={L('/agadir-airport-taxi/prices/')}>grille de prix</a>, comparez un
    <a href={L('/agadir-airport-private-transfer/')}>transfert privé</a>, une
    <a href={L('/agadir-airport-shuttle/')}>navette</a> ou un <a href={L('/agadir-airport-vip-transfer/')}>transfert
    VIP</a>, pensez à un <a href={L('/agadir-private-driver/')}>chauffeur privé</a>, ou allez droit à
    votre trajet, <a href={L('/agadir-airport-to-agadir/')}>centre d'Agadir</a>,
    <a href={L('/agadir-airport-to-taghazout/')}>Taghazout</a> ou
    <a href={L('/agadir-airport-to-marrakech/')}>Marrakech</a>.
  </p>
</MoneyLayout>
