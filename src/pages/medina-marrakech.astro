---
import GuideLayout from '../layouts/GuideLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: "La médina", href: L("/medina-marrakech/") },
];

const toc = [
  { label: "Ce qu'est la médina", id: "histoire" },
  { label: "Les quartiers", id: "quartiers" },
  { label: "Les monuments à voir", id: "monuments" },
  { label: "Quand la visiter", id: "quand" },
  { label: "S'orienter sans se faire guider", id: "orientation" },
  { label: "Dormir en médina", id: "dormir" },
  { label: "Bonnes manières", id: "manieres" },
];

const faqs = [
  { q: "Que voir dans la médina de Marrakech en une journée ?", a: "Un parcours cohérent : le matin, la madrasa Ben Youssef et le musée de Marrakech, puis les souks au nord de Jemaa el-Fna ; l'après-midi, le palais de la Bahia et les Tombeaux saadiens au sud, avant de finir sur la place au coucher du soleil. Comptez six à sept heures avec une pause à l'ombre, et n'essayez pas de tout voir." },
  { q: "Quels sont les tarifs d'entrée des monuments de Marrakech ?", a: "À titre indicatif : environ 100 MAD pour le palais de la Bahia et pour les Tombeaux saadiens, 50 MAD pour la madrasa Ben Youssef, 140 MAD pour le musée Yves Saint Laurent et 170 MAD pour le jardin Majorelle, qui reste hors de la médina. Ces montants évoluent : vérifiez-les avant de partir." },
  { q: "La médina est-elle dangereuse ?", a: "Non, elle est même très fréquentée jusqu'à tard le soir. Les désagréments sont ceux d'une grande ville touristique : petits vols à l'arraché, faux guides et insistance des commerçants. Voyez notre page sécurité pour les réflexes qui les évitent." },
  { q: "Peut-on visiter la médina avec un enfant en poussette ?", a: "C'est difficile. Les pavés sont irréguliers, les ruelles étroites, et les deux-roues passent vite. Un porte-bébé est bien plus pratique. Pour les familles avec de jeunes enfants, un hôtel de Guéliz ou de l'Hivernage simplifie tout." },
  { q: "Comment ne pas se perdre dans la médina ?", a: "Repérez la Koutoubia, téléchargez une carte hors ligne, gardez sous la main la porte et l'adresse de votre riad écrites en arabe, et demandez votre chemin à un commerçant plutôt qu'à quelqu'un qui vous accoste dans la rue. Et acceptez qu'une partie du charme tienne à ces détours." },
  { q: "Quelle est la meilleure saison pour visiter la médina ?", a: "Mars à mai et septembre à novembre, quand les journées sont douces. En juillet et août, la chaleur dépasse régulièrement 38 °C : visitez tôt le matin ou en fin de journée, et gardez l'après-midi pour la piscine." },
];
---
<GuideLayout
  keywords="médina Marrakech, visiter la médina, Bahia, Ben Youssef, Tombeaux saadiens, souks"
  title={"Médina de Marrakech : quartiers et monuments à voir"}
  description={"Visiter la médina de Marrakech : remparts, quartiers, madrasa Ben Youssef, Bahia, Tombeaux saadiens, tarifs d'entrée et façon de ne pas s'y perdre."}
  eyebrow={"Marrakech · Médina"}
  h1={"La médina de Marrakech"}
  lede={"Neuf siècles d'histoire derrière des remparts ocre, un labyrinthe de ruelles où l'on se perd volontiers, et une vingtaine de sites à visiter. Voici comment l'aborder sans s'épuiser ni se faire piloter."}
  breadcrumbs={breadcrumbs}
  heroImage={photos["marrakech-medina"]}
  toc={toc}
  faqs={faqs}
  updated={PRICES_CHECKED}
  cta={{ heading: "Trouvez un riad à la bonne porte", text: "Un riad proche d'un grand bab s'atteint en trois minutes de marche, contre dix pour un derb profond. Comparez nos sélections.", provider: "hotel", label: "Voir où dormir" }}
>
<h2 id="histoire">Ce qu'est la médina</h2>
<p>
  Fondée à la fin du XI<sup>e</sup> siècle par les Almoravides, Marrakech doit à ses remparts de terre
  ocre le surnom de « ville rouge ». Ces murailles, longues d'une vingtaine de kilomètres et ponctuées
  de portes monumentales, enferment encore aujourd'hui un tissu urbain médiéval, classé par l'UNESCO
  depuis 1985. On y vit, on y travaille, on y dort : ce n'est pas un musée, mais un quartier habité de
  plusieurs dizaines de milliers de personnes, avec ses écoles, ses fours à pain et ses mosquées.
</p>
<p>
  Le cœur battant s'appelle Jemaa el-Fna, la grande place. Au nord, les souks ; au sud, la Kasbah et les
  palais ; à l'ouest, les quartiers de riads. Le minaret de la Koutoubia, haut de 77 mètres, veille sur
  l'ensemble.
</p>

<h2 id="quartiers">Les quartiers</h2>
<div class="table-wrap">
  <table class="data">
    <thead><tr><th>Quartier</th><th>Caractère</th><th>Porte de référence</th></tr></thead>
    <tbody>
      <tr><td><strong>Autour de Jemaa el-Fna</strong></td><td>Animé, touristique, bruyant</td><td>Bab Laksour</td></tr>
      <tr><td><strong>Mouassine et Dar el Bacha</strong></td><td>Riads, boutiques d'artisans, jardins secrets</td><td>Bab Doukkala</td></tr>
      <tr><td><strong>Souks et Ben Youssef</strong></td><td>Commerce dense, madrasa, tanneries au loin</td><td>Bab Debbagh</td></tr>
      <tr><td><strong>Kasbah</strong></td><td>Palais, tombeaux saadiens, plus calme</td><td>Bab Agnaou</td></tr>
      <tr><td><strong>Mellah</strong></td><td>Ancien quartier juif, marché aux épices, cimetière</td><td>Bab Berrima</td></tr>
      <tr><td><strong>Riad Zitoun</strong></td><td>Résidentiel et animé, proche de la place</td><td>Bab Laksour</td></tr>
    </tbody>
  </table>
</div>

<h2 id="monuments">Les monuments à voir</h2>
<h3>La madrasa Ben Youssef</h3>
<p>
  Ancienne école coranique, l'un des plus beaux exemples de décor saadien : cour à bassin, zellige,
  plâtre sculpté et bois de cèdre. Elle est petite : comptez 45 minutes, et arrivez à l'ouverture pour
  la voir sans foule. Entrée autour de 50 MAD.
</p>
<h3>Le palais de la Bahia</h3>
<p>
  Construit à la fin du XIX<sup>e</sup> siècle pour un grand vizir, avec des cours, des jardins et des
  plafonds peints. Un lieu qu'on parcourt lentement, sans se presser. Entrée d'environ 100 MAD.
</p>
<h3>Les Tombeaux saadiens</h3>
<p>
  Un ensemble funéraire du XVI<sup>e</sup> siècle, muré puis redécouvert au début du XX<sup>e</sup>. La
  salle aux douze colonnes est la pièce maîtresse. La file d'attente peut être longue en pleine saison :
  venez à l'ouverture. Entrée autour de 100 MAD.
</p>
<h3>Le palais El Badi et la Koutoubia</h3>
<p>
  Les ruines du palais El Badi, à ciel ouvert, offrent une vue sur les cigognes qui nichent sur les
  remparts. La Koutoubia, mosquée du XII<sup>e</sup> siècle, ne se visite pas de l'intérieur si vous
  n'êtes pas musulman, mais ses jardins et son minaret se contemplent librement.
</p>
<div class="callout">
  <span class="callout-label">Combiner, ne pas tout faire</span>
  <p>
    Trois monuments par jour, c'est un maximum raisonnable. Associez un site du nord (Ben Youssef,
    souks) et un site du sud (Bahia, Tombeaux saadiens) plutôt que de traverser la ville plusieurs fois.
  </p>
</div>

<h2 id="quand">Quand la visiter</h2>
<p>
  La médina se visite tôt : de 8 h à 11 h, les ruelles sont calmes, la lumière est belle et les sites
  ouvrent. Entre 12 h et 16 h, en été, on s'abrite. Le soir, la ville change de visage : les souks
  ferment progressivement, les lampes s'allument et Jemaa el-Fna prend le relais — voyez notre page sur
  <a href={L('/jemaa-el-fna/')}>la place Jemaa el-Fna</a>. Le vendredi, jour de prière collective, certains
  commerces ouvrent tard.
</p>

<h2 id="orientation">S'orienter sans se faire guider</h2>
<p>
  Trois repères : la Koutoubia au sud-ouest, Jemaa el-Fna au centre, et les portes des remparts.
  Téléchargez une carte hors ligne, car le GPS dérape entre les murs. Et méfiez-vous du « c'est fermé,
  suivez-moi » : une personne qui vous aborde pour vous dire que votre destination est fermée vous
  emmène presque toujours vers une boutique. Un refus poli et un sourire suffisent.
</p>
<p>
  Si vous préférez un guide, choisissez-en un agréé, avec un badge officiel et un tarif convenu à
  l'avance : voyez <a href={L('/guide-touristique/')}>guide et excursions</a>.
</p>

<h2 id="dormir">Dormir en médina</h2>
<p>
  C'est l'expérience du riad : patio, terrasse, calme derrière une porte cloutée. Avec une contrainte
  d'arrivée — dépose à une porte et marche — que nous détaillons dans
  <a href={L('/guide-aeroport-marrakech/aller-a-la-medina/')}>aller à la médina</a> et
  <a href={L('/riads-medina-marrakech/')}>riads dans la médina</a>.
</p>

<h2 id="manieres">Bonnes manières</h2>
<ul>
  <li><strong>Tenue :</strong> épaules et genoux couverts, par respect plus que par obligation, surtout dans les quartiers résidentiels et près des mosquées.</li>
  <li><strong>Photos :</strong> demandez avant de photographier une personne ; beaucoup de commerçants refusent, certains réclament un pourboire.</li>
  <li><strong>Deux-roues :</strong> les scooters passent vite dans les derbs : longez le mur et écoutez le « balak ! » (attention).</li>
  <li><strong>Mosquées :</strong> fermées aux non-musulmans, à l'exception de rares édifices ouverts à la visite.</li>
</ul>
</GuideLayout>
