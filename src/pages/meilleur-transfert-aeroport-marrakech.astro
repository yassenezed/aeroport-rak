---
import TransferLayout from '../layouts/TransferLayout.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { airport, PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts & taxi', href: L('/transfert-aeroport-marrakech/') },
  { name: 'Quel transfert choisir', href: L('/meilleur-transfert-aeroport-marrakech/') },
];

const facts = [
  { label: 'Transfert privé', value: '27 €', sub: 'dès, par véhicule' },
  { label: 'Taxi affiché', value: `${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]}`, sub: 'MAD le jour' },
  { label: `Bus ${airport.bus.line}`, value: `${airport.bus.oneWayMad}`, sub: 'MAD / personne' },
  { label: 'Critère n°1', value: 'Votre heure', sub: "d'atterrissage" },
];

const scenarios = [
  { cas: 'Couple, arrivée en journée, hôtel à Guéliz', reco: 'Taxi au rang', pourquoi: 'Nettement moins cher à deux : 9 à 14 € contre 27 €, dépose à la réception' },
  { cas: 'Couple, arrivée après 22 h, riad en médina', reco: 'Transfert réservé', pourquoi: 'Barème de nuit du taxi, ruelles sombres, porteur à coordonner' },
  { cas: 'Famille de 4 ou 5 avec valises', reco: 'Transfert réservé', pourquoi: 'Un petit taxi ne prend que 3 passagers : deux voitures sinon' },
  { cas: 'Deux voyageurs en bagage cabine, riad près de la place', reco: `Bus ${airport.bus.line}`, pourquoi: `${airport.bus.oneWayMad} MAD, dépose à Jemaa el-Fna, environ ${airport.bus.rideMin} min` },
  { cas: 'Séjour avec Ourika, Essaouira, Atlas', reco: 'Voiture de location', pourquoi: 'Rentable dès deux ou trois excursions, liberté horaire' },
  { cas: 'Groupe de 6 et plus, camp du désert', reco: 'Minibus réservé', pourquoi: 'Disponibilité à sécuriser, pistes en fin de parcours' },
];

const faqs = [
  {
    q: "Quel est le meilleur transfert depuis l'aéroport de Marrakech ?",
    a: `Il n'y en a pas un seul : trois variables décident. Votre heure d'atterrissage — après 21 h, le transfert réservé prend l'avantage sur le taxi passé au barème de nuit. Votre nombre de passagers — à quatre, un petit taxi ne suffit plus. Et votre quartier — un riad en médina demande de connaître la porte, ce qu'un chauffeur réservé sait à l'avance. En journée, à deux, vers Guéliz, le taxi au tarif affiché (${airport.taxiFare.dayMad[0]}–${airport.taxiFare.dayMad[1]} MAD) reste imbattable.`
  },
  {
    q: "Transfert privé ou taxi : lequel est le moins cher ?",
    a: "Cela dépend entièrement du nombre de passagers. À deux en journée, le taxi gagne nettement : 100 à 150 MAD, soit 9 à 14 €, contre 27 € pour un transfert. À quatre, il faut deux petits taxis (200 à 300 MAD, soit 18 à 28 €) et l'écart disparaît. À quatre de nuit, deux taxis coûtent 300 à 480 MAD, soit 28 à 44 €, et le transfert à 27 € devient le moins cher. Au-delà de quatre passagers, le forfait unique jusqu'à sept places rend le transfert imbattable."
  },
  {
    q: "Les transferts partagés valent-ils le coup à Marrakech ?",
    a: "Rarement. Ils supposent d'attendre les autres passagers, puis d'enchaîner plusieurs déposes en médina — là où chaque arrêt implique une porte différente. Vu l'écart de prix modeste avec un transfert privé sur un trajet de six kilomètres, le privé est presque toujours le meilleur arbitrage ici."
  },
  {
    q: "Comment être sûr que le chauffeur attendra en cas de retard ?",
    a: "Donnez votre numéro de vol à la réservation, et non seulement une heure. Les opérateurs sérieux suivent le vol et ajustent la prise en charge automatiquement, retard inclus, sans surcoût. C'est la principale valeur d'un transfert réservé face à un taxi pris sur place."
  },
  {
    q: "Faut-il réserver longtemps à l'avance ?",
    a: `Quelques jours suffisent pour un véhicule standard. Réservez plusieurs semaines avant pour un monospace, un minibus ou une arrivée en période de pointe — février, Pâques, vacances scolaires — car c'est la disponibilité des grands véhicules qui manque en premier. Repères vérifiés en ${PRICES_CHECKED}.`
  },
];
---
<TransferLayout
  title="Quel transfert choisir à l'aéroport de Marrakech ? (2026) | AirportRAK"
  description="Transfert privé, taxi au tarif affiché, bus 19 ou location : le comparatif honnête selon votre heure d'atterrissage, votre nombre de passagers et votre quartier, avec six scénarios concrets."
  eyebrow="Aéroport Marrakech Ménara · Comparatif"
  h1="Quel transfert choisir à l'aéroport de Marrakech"
  lede="La bonne réponse dépend de trois choses seulement : l'heure où vous vous posez, combien vous êtes, et où vous dormez. Voici la grille de décision, et six situations réelles avec notre recommandation."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={27}
  heroImage={photos['marrakech-airport-transfer']}
  heroProvider="transfer"
  heroCtaLabel="Voir les prix des transferts"
  secondaryHref="/taxi-aeroport-marrakech/prix/"
  secondaryLabel="Comparer avec les tarifs taxi"
  faqs={faqs}
  cta={{ heading: 'Le bon choix pour votre vol', text: "Prix fixe par véhicule, suivi du numéro de vol et dépose à la porte la plus proche de votre riad : la formule qui couvre le plus de cas de figure à Marrakech.", provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <p>
    Les comparatifs de transfert se trompent souvent de question. À Marrakech, aucune option n'est
    meilleure dans l'absolu : le taxi est excellent dans un cas précis, le bus imbattable dans un autre,
    et le transfert réservé s'impose dès que deux facteurs se cumulent. Voici comment trancher en une
    minute.
  </p>

  <h2>Les trois variables qui décident</h2>
  <ol>
    <li>
      <strong>L'heure d'atterrissage.</strong> Avant 20 h, toutes les options sont ouvertes et le taxi est le moins cher à deux. Après, le
      bus s'arrête vers {airport.bus.lastDeparture}, le taxi passe au barème de nuit
      ({airport.taxiFare.nightMad[0]}–{airport.taxiFare.nightMad[1]} MAD) et la médina devient
      difficile à parcourir. Le transfert réservé prend alors l'avantage.
    </li>
    <li>
      <strong>Le nombre de passagers.</strong> Un petit taxi accepte <strong>trois personnes</strong>.
      À quatre, il faut un grand taxi ou deux voitures — et l'économie disparaît.
    </li>
    <li>
      <strong>Le quartier.</strong> Guéliz, l'Hivernage et l'Agdal se desservent porte à porte. La
      médina impose une dépose à un bab : savoir lequel est un avantage décisif, et c'est une
      information que seul un transfert réservé intègre à l'avance.
    </li>
  </ol>

  <h2>Six situations, six recommandations</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Votre situation</th><th>Notre choix</th><th>Pourquoi</th></tr>
      </thead>
      <tbody>
        {scenarios.map((s, i) => (
          <tr class:list={[{ 'row-highlight': i === 1 }]}>
            <td>{s.cas}</td>
            <td><strong>{s.reco}</strong></td>
            <td>{s.pourquoi}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Ce qui distingue vraiment les opérateurs</h2>
  <p>
    Entre plateformes de réservation, l'écart de prix sur un trajet de six kilomètres est faible. Trois
    critères comptent davantage : le <strong>suivi du numéro de vol</strong>, qui absorbe un retard sans
    frais ; la <strong>politique d'annulation</strong>, idéalement gratuite jusqu'à 24 h avant ; et la
    <strong>précision de la dépose</strong>, c'est-à-dire la capacité à traiter « riad X, Bab Laksour »
    comme une adresse et non comme une approximation.
  </p>
  <p>
    Ces trois points figurent dans le récapitulatif de chaque réservation : lisez-les avant de valider,
    plutôt que de vous fier au seul prix affiché. La page
    {' '}<a href={L('/reserver-transfert/')}>réserver un transfert</a> les liste dans sa checklist.
  </p>

  <div class="callout">
    <span class="callout-label">Le réflexe à garder</span>
    <p>
      Quelle que soit l'option retenue, demandez à votre hébergement <strong>la porte la plus proche</strong>
      et, s'il s'agit d'un riad, <strong>un porteur avec charrette</strong>. Ces deux informations
      améliorent davantage votre arrivée que le choix du moyen de transport lui-même.
    </p>
  </div>

  <h2>Et si vous voulez simplement le plus simple ?</h2>
  <p>
    Réservez un transfert privé. Ce n'est pas l'option la moins chère en journée, mais c'est celle qui
    couvre le plus grand nombre de cas de figure à Marrakech : prix connu, chauffeur qui attend,
    bonne porte. Les autres options sont détaillées sur
    {' '}<a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport Marrakech</a>.
  </p>
</TransferLayout>
