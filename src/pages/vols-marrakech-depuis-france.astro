---
import MoneyLayout from '../layouts/MoneyLayout.astro';
import FlightSearchWidget from '../components/affiliate/FlightSearchWidget.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';
import { PRICES_CHECKED } from '../data/airport';

const L = (p: string) => getLocalizedPath(p);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Vols', href: L('/vols-marrakech/') },
  { name: 'Depuis la France', href: L('/vols-marrakech-depuis-france/') },
];

const facts = [
  { label: 'Villes en direct', value: 'Une dizaine', sub: 'en France' },
  { label: 'Paris', value: '≈ 3 h 30', sub: 'de vol' },
  { label: 'Passeport', value: 'Obligatoire', sub: 'CNI insuffisante' },
  { label: 'Décalage', value: '0 à −1 h', sub: 'selon la saison' },
];

const villes = [
  { ville: 'Paris (Orly, Roissy, Beauvais)', duree: '≈ 3 h 30', note: 'Le plus large choix : plusieurs compagnies, low cost et classique' },
  { ville: 'Marseille', duree: '≈ 2 h 50', note: 'Ligne bien fournie, forte demande en vacances scolaires' },
  { ville: 'Lyon', duree: '≈ 3 h 15', note: 'Plusieurs compagnies, dont low cost' },
  { ville: 'Toulouse', duree: '≈ 2 h 45', note: 'Vol le plus court du territoire' },
  { ville: 'Bordeaux', duree: '≈ 2 h 45', note: 'Lignes régulières, surtout low cost' },
  { ville: 'Nantes', duree: '≈ 3 h', note: 'Rotations régulières' },
  { ville: 'Nice', duree: '≈ 3 h', note: 'Ligne saisonnière renforcée en haute saison' },
  { ville: 'Montpellier, Lille, Strasbourg', duree: '≈ 3 h – 3 h 30', note: 'Selon les saisons, à vérifier avant de bloquer les dates' },
];

const faqs = [
  {
    q: "Quelles villes françaises ont un vol direct pour Marrakech ?",
    a: "Paris (Orly, Roissy et Beauvais), Marseille, Lyon, Toulouse, Bordeaux et Nantes forment le noyau des lignes régulières, complétées selon les saisons par Nice, Montpellier, Lille et Strasbourg. Les compagnies et les fréquences changent d'une saison à l'autre : vérifiez votre ligne à vos dates précises."
  },
  {
    q: "Combien de temps dure le vol depuis la France ?",
    a: "Entre 2 h 45 depuis Toulouse ou Bordeaux et 3 h 30 depuis Paris, Lille ou Strasbourg. C'est une durée comparable à un vol vers les Canaries, pour une destination très différente."
  },
  {
    q: "Ma carte d'identité suffit-elle pour aller à Marrakech ?",
    a: "Non. Il faut un passeport en cours de validité, valable pendant tout le séjour, et de préférence au moins six mois pour éviter tout refus d'embarquement par la compagnie. Aucun visa n'est requis pour un séjour touristique de moins de 90 jours."
  },
  {
    q: "Y a-t-il un décalage horaire avec la France ?",
    a: "Le Maroc est à UTC+1 toute l'année. Vous avez donc la même heure que la France de fin octobre à fin mars, et une heure de moins le reste de l'année. Pendant le ramadan, le pays passe à UTC+0, ce qui ajoute une heure d'écart."
  },
  {
    q: "Peut-on utiliser son forfait mobile français au Maroc ?",
    a: "Le Maroc n'est pas dans la zone d'itinérance sans surcoût de l'Union européenne : selon votre opérateur, les données peuvent être coûteuses ou désactivées. Une eSIM marocaine achetée avant le départ coûte quelques euros et vous connecte dès l'atterrissage. Voir notre page eSIM Maroc."
  },
  {
    q: "Quelle valise et quels bagages pour un vol low cost ?",
    a: "Le tarif d'appel ne comprend que le sac sous le siège. Pour un séjour court, un bagage cabine suffit et économise l'option soute. Pour un séjour long ou avec des achats, ajoutez le bagage à l'avance : le tarif augmente sensiblement à l'aéroport."
  },
];
---
<MoneyLayout
  title={"Vols France → Marrakech : villes et conseils"}
  description={"Vols directs de France vers Marrakech : villes desservies, durées, passeport obligatoire, décalage horaire, bagages low cost et recherche en direct."}
  eyebrow="Marrakech · Vols depuis la France"
  h1="Vols de France vers Marrakech"
  lede="Moins de quatre heures de vol depuis n'importe quelle grande ville française, des lignes régulières toute l'année et un passeport à vérifier avant de bloquer les dates. Voici ce qu'il faut savoir avant de réserver."
  breadcrumbs={breadcrumbs}
  facts={facts}
  heroImage={photos['rak-terminal']}
  heroProvider="#recherche"
  heroCtaLabel="Rechercher un vol depuis la France"
  secondaryHref="/vols-marrakech/pas-chers/"
  secondaryLabel="Vols pas chers"
  faqs={faqs}
  cta={{ heading: 'Trouvez votre vol', text: "Comparez les compagnies au départ de votre ville : les tarifs varient fortement d'un jour à l'autre.", provider: '#recherche', label: 'Rechercher des vols' }}
>
  <div id="recherche" style="scroll-margin-top: 6rem;">
    <h2 style="margin-top:0">Recherchez depuis votre ville</h2>
    <FlightSearchWidget />
    <p class="disclosure-inline">
      Prix indicatifs. Nous pouvons percevoir une commission sur les réservations effectuées via ce
      comparateur, sans surcoût pour vous.
    </p>
  </div>

  <p>
    La France est le premier marché de Marrakech : la proximité, la langue, l'histoire commune et
    l'absence de décalage horaire pénalisant en font une destination naturelle pour un week-end
    prolongé comme pour deux semaines. C'est aussi une des routes les plus concurrentielles d'Europe,
    ce qui joue en faveur du voyageur.
  </p>

  <h2>Les villes reliées en direct</h2>
  <div class="table-wrap">
    <table class="data">
      <thead>
        <tr><th>Départ</th><th>Durée</th><th>À savoir</th></tr>
      </thead>
      <tbody>
        {villes.map((v, i) => (
          <tr class:list={[{ 'row-highlight': i === 0 }]}>
            <td><strong>{v.ville}</strong></td>
            <td class="num">{v.duree}</td>
            <td>{v.note}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="small text-muted">Durées indicatives. Les lignes régionales varient selon les saisons.</p>

  <h2>Le passeport : le point qui coûte le plus cher quand on l'oublie</h2>
  <p>
    Pour entrer au Maroc, un Français doit présenter un <strong>passeport</strong> en cours de validité :
    la carte nationale d'identité ne suffit pas, même si elle est valide. Le passeport doit couvrir
    toute la durée du séjour, et il est plus prudent de viser six mois de validité restante, ce que
    certaines compagnies exigent à l'embarquement. Aucun visa n'est nécessaire pour un séjour
    touristique de moins de 90 jours.
  </p>
  <div class="callout">
    <span class="callout-label">À vérifier dès la réservation</span>
    <p>
      Un passeport renouvelé prend plusieurs semaines. Avant de bloquer des dates, contrôlez sa date
      d'expiration. Le détail des formalités est sur
      <a href={L('/formalites-entree-maroc/')}>formalités d'entrée au Maroc</a>.
    </p>
  </div>

  <h2>Le décalage horaire : nul ou d'une heure</h2>
  <p>
    Le Maroc est à UTC+1 en permanence. Vous aurez donc la même heure qu'à Paris de fin octobre à fin
    mars, puis une heure de moins de fin mars à fin octobre. Pendant le mois de ramadan, le pays repasse
    temporairement à UTC+0. Retenez simplement que l'heure de votre billet est l'heure locale, et
    donnez toujours votre <em>numéro de vol</em> à votre chauffeur plutôt qu'un horaire.
  </p>

  <h2>Choisir son aéroport de départ</h2>
  <p>
    Si vous habitez à égale distance de deux aéroports, comparez le coût total, pas le tarif du vol : le
    train ou la voiture jusqu'à l'aéroport, le stationnement, et l'heure de départ. Un vol à 6 h 15 au
    départ d'un aéroport à une heure de route peut coûter plus cher, en transport et en sommeil, que le
    même vol à 11 h depuis chez vous. Pensez aussi au retour : un atterrissage après minuit en France
    pèse sur le lendemain.
  </p>

  <h2>À l'arrivée : ce qui vous attend</h2>
  <p>
    À l'atterrissage, comptez 30 à 50 minutes avant de sortir. Une fiche de police vous sera remise à
    bord : remplissez-la avec l'adresse de votre hébergement. Notre guide des
    {' '}<a href={L('/guide-aeroport-marrakech/arrivees/')}>arrivées au RAK</a> déroule le parcours, et
    {' '}<a href={L('/transfert-aeroport-marrakech/')}>transferts aéroport</a> compare les façons de
    rejoindre la médina. Une <a href={L('/esim-maroc/')}>eSIM</a> vous évite les frais d'itinérance.
  </p>
  <p class="small text-muted">Repères vérifiés en {PRICES_CHECKED}.</p>
</MoneyLayout>
