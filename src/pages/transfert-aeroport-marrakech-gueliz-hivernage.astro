---
import RouteLayout from '../layouts/RouteLayout.astro';
import TransferOptions from '../components/affiliate/TransferOptions.astro';
import { getLocalizedPath } from '../i18n';
import { photos } from '../data/images';

const lang = 'fr';
const L = (p: string) => getLocalizedPath(p, lang);

const breadcrumbs = [
  { name: 'Accueil', href: L('/') },
  { name: 'Transferts', href: L('/agadir-airport-transfers/') },
  { name: 'Vers Taghazout', href: L('/agadir-airport-to-taghazout/') },
];
const facts = [
  { label: 'Distance', value: '48 km' },
  { label: 'Durée', value: '50–65', sub: 'min' },
  { label: 'Transfert réservé', value: '28 €', sub: 'dès' },
  { label: 'Grand taxi', value: '300–400', sub: 'MAD' },
];
const faqs = [
  { q: "Comment aller de l'aéroport d'Agadir à Taghazout ?", a: "Par la route uniquement, ni train ni bus direct. La plupart des surfeurs réservent un transfert privé (le chauffeur attend avec votre nom et trouve le camp grâce à un point) ou négocient un grand taxi à la station. Le trajet fait environ 48 km vers le nord, soit 50–65 minutes selon le trafic à Aourir." },
  { q: "Combien coûte un taxi ou un transfert de l'aéroport d'Agadir à Taghazout ?", a: "Un transfert privé réservé vers Taghazout démarre autour de 28 € pour une voiture, prix fixé avant le départ. Un grand taxi depuis la station revient à environ 300–400 MAD en journée et 400–500 MAD la nuit, à convenir avant de charger. Prix vérifiés en juin 2026." },
  { q: "Combien de temps dure le trajet aéroport – Taghazout ?", a: "Comptez 50 à 65 minutes. La route quitte l'aéroport, contourne Agadir et suit la côte vers le nord par Aourir et Tamraght. Un vendredi après-midi en saison de surf, l'unique route côtière se charge : ajoutez 15–20 minutes si vous atterrissez à ce moment-là." },
  { q: "Peut-on emporter des planches de surf dans un transfert ?", a: "Oui, mais signalez-le à la réservation. Une voiture standard prend deux planches en housse ; un groupe avec plusieurs planches doit demander un minivan ou un break. La réservation est l'option sûre, un grand taxi pris au hasard peut manquer de place ou de galerie." },
  { q: "Vaut-il mieux louer une voiture pour un séjour surf à Taghazout ?", a: "Si vous voulez des sessions à l'aube à Anchor Point, des virées vers Imsouane et la liberté de suivre la houle, une location prise à l'aéroport bat souvent le cumul des transferts. Si vous restez dans un seul camp avec cours sur place, un transfert aller-retour est plus simple et moins cher." },
];
---
<RouteLayout
  lang={lang}
  title="Transfert aéroport Agadir – Taghazout : taxi et prix (2026) | AirportAGA"
  description="La vraie façon d'aller de l'aéroport Agadir Al Massira à Taghazout : distance, durée, prix transfert et taxi 2026, le problème des adresses de camps de surf, et comment arriver sans négocier."
  eyebrow="Trajets depuis l'AGA · Côte du surf"
  h1="Transfert aéroport Agadir → Taghazout"
  lede="Taghazout est à environ 48 km au nord, près d'une heure, et votre camp n'a sans doute pas d'adresse. Voici comment y aller proprement, le prix réel, et pourquoi un chauffeur prévenu à l'avance vaut mieux qu'un taxi de station pour les villages de surf."
  breadcrumbs={breadcrumbs}
  facts={facts}
  priceFrom={28}
  heroImage={photos['taghazout']}
  heroProvider="transfer"
  heroCtaLabel="Voir les prix vers Taghazout"
  faqs={faqs}
  cta={{ heading: 'Déposé à la porte, pas dans le village', text: 'Envoyez le point de votre camp ou appartement et un chauffeur vous y conduit directement, prix fixe, place pour les planches sur demande, annulation gratuite sur la plupart des réservations.', provider: 'transfer', label: 'Réserver votre transfert Taghazout' }}
>
  <p>
    Si vous avez atterri à Agadir pour les vagues, votre vraie destination n'est pas Agadir mais
    Taghazout, le village de surf égrené le long de la route côtière au nord. L'aéroport se trouve du
    mauvais côté de la ville pour vous : chaque trajet vers Taghazout signifie une route d'environ
    48 km, sortir d'Agadir, monter parmi les étals de bananes d'Aourir, passer Tamraght, et rejoindre
    les pointes au-delà. Comptez 50 à 65 minutes, davantage si vous atterrissez dans le trafic du
    vendredi après-midi.
  </p>

  <h2 id="options">Vos options depuis l'aéroport</h2>
  <p>
    Pas de train, pas de bus utile : restent trois choix routiers, et pour Taghazout ils ne se valent
    pas :
  </p>
  <ul>
    <li><strong>Transfert privé réservé</strong>, un chauffeur attend avec votre nom, le prix est fixé avant le départ, et surtout il vous conduit au camp exact grâce à un point WhatsApp. Dès 28 €.</li>
    <li><strong>Grand taxi à la station</strong>, possible si vous fixez le prix d'abord (environ 300–400 MAD en journée), mais les chauffeurs rechignent aux adresses non signalées et peuvent vous laisser « à Taghazout » plutôt qu'à votre porte.</li>
    <li><strong>Voiture de location</strong>, le choix des surfeurs pour une semaine entière à enchaîner les spots ; moins utile si vous restez sur place avec cours organisés.</li>
  </ul>


  <div class="widget-wrap">
    <iframe
      class="tpemd-iframe"
      srcdoc='<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><style>body{margin:0;padding:0;font-family:system-ui,sans-serif;overflow:hidden}</style></head><body><script async src="https://tpemd.com/content?currency=EUR&amp;trs=554574&amp;shmarker=697149&amp;locale=fr&amp;from=al%20massira%20airport&amp;to=TAGHAZOUT&amp;country=Morocco&amp;powered_by=true&amp;transfer_options_limit=10&amp;transfer_options=MCR&amp;disable_currency_selector=true&amp;hide_form_extras=true&amp;hide_external_links=true&amp;campaign_id=1&amp;promo_id=3879" charset="utf-8"><\/script><script>new MutationObserver(function(){document.documentElement.style.height="auto";window.parent.postMessage({tpemdHeight:document.body.scrollHeight},"*")}).observe(document.body,{childList:true,subtree:true,attributes:true})<\/script></body></html>'
      style="width:100%;border:none;min-height:200px;overflow:hidden;"
      loading="lazy"
      title="Transfer booking widget"
    ></iframe>
  </div>

  <h2 id="adresse">Le problème des adresses de camps</h2>
  <p>
    C'est le détail qui piège les nouveaux venus. Camps et appartements de Taghazout et Tamraght n'ont
    presque jamais de vrai numéro de rue, juste un nom, un repère et un point de localisation. Un
    chauffeur à qui ce point a été envoyé d'avance vous y conduit directement. Un taxi pris à la station
    peut hausser les épaules, tourner dans le village, puis abandonner ou facturer le tracas en plus.
    Enregistrez le point de votre logement hors ligne avant de partir, et si possible réservez un
    transfert où vous transmettez l'adresse au paiement.
  </p>

  <h3 id="reserver">Réserver un transfert vers Taghazout</h3>
  <TransferOptions
    sub="aeroport-agadir-taghazout"
    options={[
      { provider: 'transfer', highlight: true, badge: 'Meilleur rapport', pitch: 'Voitures et minivans avec place pour les planches, directement à votre camp ou appartement, prix fixe dès 28 €, annulation gratuite jusqu\'à 24 h.', label: 'Voir les prix des transferts' },
      { provider: 'transfer-vip', badge: 'Accueil personnalisé', pitch: 'Un chauffeur nommé, anglophone, et le suivi du vol, l\'arrivée la plus simple pour un premier voyage surf au Maroc.', label: 'Réserver un transfert VIP' },
    ]}
  />

  <h2 id="trafic">Quand le trajet est le plus lent</h2>
  <p>
    La route côtière est à voie unique presque partout, elle se charge donc de façon prévisible :
    vendredi et samedi après-midi, début et fin de semaines en saison de surf, et au coucher du soleil
    quand les excursionnistes rentrent des pointes. Rien de dramatique, prévoyez simplement 15 à
    20 minutes de plus si votre vol atterrit dans l'une de ces fenêtres, et n'enchaînez pas un plan
    serré juste après le transfert.
  </p>

  <div class="callout">
    <span class="callout-label">Conseil local</span>
    Prenez des espèces et une SIM dans le hall d'arrivée avant de partir. Taghazout fonctionne au
    liquide, petits-déjeuners du camp, la boulangerie, le gardien de voiture, et une connexion data
    permet de partager un point au chauffeur et de vérifier le report de surf avant même d'avoir quitté
    l'aéroport.
  </div>

  <p>
    Vous logez plus près ? Comparez le trajet plus court vers
    <a href={L('/agadir-airport-to-tamraght-aourir/')}>Tamraght et Aourir</a>, ou lisez comment
    fonctionne un <a href={L('/agadir-airport-taxi/')}>taxi d'aéroport classique</a>. Pour des vagues
    plus au nord, voyez <a href={L('/agadir-airport-to-imsouane/')}>l'aéroport vers Imsouane</a>.
  </p>

  <div class="disclosure-inline">
    Certains liens ici sont des liens d'affiliation, réservez via ces liens et nous pouvons percevoir
    une petite commission, sans surcoût pour vous. <a href={L('/affiliate-disclosure/')}>Comment ça fonctionne</a>.
  </div>
</RouteLayout>
