---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import SchemaArticle from '../components/seo/SchemaArticle.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface FAQ { q: string; a: string; }
interface Crumb { name: string; href: string; }
interface TocItem { label: string; id: string; }
interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
  heroImage?: ImageMetadata;
  eyebrow: string;
  h1: string;
  lede: string;
  breadcrumbs: Crumb[];
  toc?: TocItem[];
  faqs?: FAQ[];
  faqHeading?: string;
  updated?: string;
  cta?: { heading: string; text?: string; provider: any; label: string };
  keywords?: string;
}
const {
  title, description, lang, ogImage, heroImage,
  eyebrow, h1, lede, breadcrumbs, toc = [], faqs = [], faqHeading, updated, cta, keywords
} = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const sub = pathname.replace(/\//g, '-').replace(/^-|-$/g, '') || 'home';
const absCrumbs = breadcrumbs.map((c) => ({ name: c.name, url: site.url + c.href }));
---
<BaseLayout title={title} description={description} keywords={keywords} lang={lang} ogImage={ogImage} ogType="article" webpageSchema={false}>
  <SchemaBreadcrumb slot="head" items={absCrumbs} />
  <SchemaArticle slot="head" headline={h1} description={description} url={`${site.url}${pathname}`} lang={lang} image={ogImage} />

  <section class:list={['hero', { 'hero--photo': heroImage }]}>
    {heroImage && <div class="hero-bg"><Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" /></div>}
    <div class="container hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      {updated && <p class="small text-muted" style="margin-top:0.75rem">{t('common.updated')}: {updated}</p>}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="guide-grid">
        <article class="prose">
          <slot />
        </article>
        {toc.length > 0 && (
          <aside class="guide-aside">
            <div class="toc">
              <div class="toc-title">{t('common.onThisPage')}</div>
              <ul>{toc.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}</ul>
            </div>
          </aside>
        )}
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-alt">
      <div class="container container-narrow">
        <FaqSection faqs={faqs} heading={faqHeading ?? t('common.faqHeading')} />
      </div>
    </section>
  )}

  {cta && <CtaBand heading={cta.heading} text={cta.text} provider={cta.provider} sub={sub} ctaLabel={cta.label} />}
</BaseLayout>

<style>
  .guide-grid { display: grid; grid-template-columns: minmax(0, 1fr) 260px; gap: 2.5rem; align-items: start; }
  .guide-aside { position: sticky; top: 90px; }
  @media (max-width: 920px) {
    .guide-grid { grid-template-columns: 1fr; }
    .guide-aside { position: static; order: -1; }
  }
</style>
