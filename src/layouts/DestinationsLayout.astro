---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import SchemaArticle from '../components/seo/SchemaArticle.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';
import { destinations } from '../data/destinations';

import { Image } from 'astro:assets';
import heroImg from '../assets/img/placeholder.png';

interface Props {
  title: string;
  description: string;
  lang: Lang;
  h1: string;
  lede: string;
  breadcrumbs: { name: string; href: string }[];
  dict: {
    city: string;
    country: string;
    continent: string;
    airlines: string;
    searchPlaceholder: string;
    noResults: string;
    stats: {
      destinations: string;
      airlines: string;
      continents: string;
    }
  }
}

const { title, description, lang, h1, lede, breadcrumbs, dict } = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const absCrumbs = breadcrumbs.map((c) => ({ name: c.name, url: site.url + c.href }));

// Serialize destinations data to pass to client
const destinationsJson = JSON.stringify(destinations);
---

<BaseLayout title={title} description={description} lang={lang} ogType="article" webpageSchema={false}>
  <SchemaBreadcrumb slot="head" items={absCrumbs} />
  <SchemaArticle slot="head" headline={h1} description={description} url={`${site.url}${pathname}`} lang={lang} />

  <section class="hero hero--photo">
    <div class="hero-bg"><Image src={heroImg} alt="Agadir" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" /></div>
    <div class="container hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{dict.stats.destinations.toUpperCase()}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      
      <!-- Stats Cards -->
      <div class="stats-grid">
        <div class="stat-card">
          <div class="stat-num">70+</div>
          <div class="stat-label">{dict.stats.destinations}</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">~20</div>
          <div class="stat-label">{dict.stats.airlines}</div>
        </div>
        <div class="stat-card">
          <div class="stat-num">2</div>
          <div class="stat-label">{dict.stats.continents}</div>
        </div>
      </div>

      <!-- Search and Table -->
      <div class="table-section">
        <div class="search-box">
          <input type="text" id="destSearch" placeholder={dict.searchPlaceholder} />
        </div>

        <div class="table-wrapper">
          <table class="dest-table">
            <thead>
              <tr>
                <th>{dict.city}</th>
                <th>{dict.country}</th>
                <th>{dict.continent}</th>
                <th>{dict.airlines}</th>
              </tr>
            </thead>
            <tbody id="destBody">
              <!-- Rendered by JS -->
            </tbody>
          </table>
        </div>
        <div id="noResults" class="no-results" style="display:none;">{dict.noResults}</div>
      </div>

    </div>
  </section>
  
  <slot />
</BaseLayout>

<style>
  .hero--small { padding-top: 4rem; padding-bottom: 3rem; background: var(--cream); text-align: center; }
  .hero-inner h1 { margin-top: 1rem; }
  .stats-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1.5rem; margin-bottom: 3rem;
  }
  .stat-card {
    background: var(--cream-2); padding: 1.5rem; border-radius: var(--r-lg); text-align: center;
  }
  .stat-num { font-size: 2.5rem; font-weight: 700; color: var(--orange); font-family: var(--font-display); }
  .stat-label { color: var(--ink-2); font-weight: 500; margin-top: 0.5rem; }
  
  .table-section { margin-top: 2rem; }
  .search-box { margin-bottom: 1.5rem; }
  #destSearch {
    width: 100%; padding: 1rem; border: 1px solid var(--line-2); border-radius: var(--r-md);
    font-size: 1rem; font-family: inherit; transition: border-color var(--transition);
  }
  #destSearch:focus { border-color: var(--green); outline: none; }
  
  .table-wrapper {
    overflow-x: auto; background: #fff; border-radius: var(--r-lg); 
    border: 1px solid var(--line); box-shadow: 0 1px 2px rgba(0,0,0,0.02);
  }
  .dest-table { width: 100%; border-collapse: collapse; text-align: left; min-width: 600px; }
  
  .dest-table th {
    background: var(--green-soft); padding: 1.15rem 1.5rem; font-weight: 600; color: var(--green-dark);
    font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.05em;
    border-bottom: 2px solid rgba(13, 114, 86, 0.15); font-family: var(--font-display);
  }
  .dest-table th:nth-child(1) { width: 28%; padding-left: 32px; }
  .dest-table th:nth-child(2) { width: 20%; }
  .dest-table th:nth-child(3) { width: 20%; }
  .dest-table th:nth-child(4) { width: 32%; padding-right: 32px; }
  
  .dest-table tr {
    transition: background-color var(--transition);
  }
  
  .dest-table tr:hover {
    background-color: var(--cream);
  }
  
  .dest-table :global(td) { 
    padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--line); 
    color: var(--ink-2); font-size: 0.95rem; vertical-align: middle;
  }
  .dest-table :global(td:first-child) { padding-left: 32px; }
  .dest-table :global(td:last-child) { padding-right: 32px; }
  .dest-table :global(td.cell-country), .dest-table :global(td.cell-continent) { color: var(--ink-2); }
  
  .dest-table :global(td strong) { color: var(--ink); font-weight: 600; font-family: var(--font-display); }
  
  .dest-table :global(tr:last-child td) { border-bottom: none; padding-bottom: 1.5rem; }
  
  .no-results { text-align: center; padding: 3rem; color: var(--ink-2); font-style: italic; font-size: 1.1rem; }
  
  /* Fix: Scope dynamic JS elements under .dest-table so Astro applies the styles */
  .dest-table :global(.airline-tag) {
    display: inline-block; background: #fafafa; border: 1px solid var(--line-2);
    color: var(--ink-2); font-weight: 500;
    padding: 0.35rem 0.75rem; border-radius: var(--r-pill); font-size: 0.75rem; 
    margin: 0.2rem 0.2rem 0.2rem 0; box-shadow: 0 1px 2px rgba(0,0,0,0.02);
    transition: all var(--transition);
  }
  .dest-table :global(.airline-tag:hover) {
    border-color: var(--orange); color: var(--orange-dark); background: var(--orange-soft);
    transform: translateY(-1px);
  }

  /* Mobile Responsive Card Layout */
  @media (max-width: 768px) {
    .dest-table { min-width: 100%; display: block; }
    .dest-table thead { display: none; }
    .dest-table tbody, .dest-table tr { display: block; width: 100%; }
    .dest-table :global(tr) { 
      padding: 1.5rem 1.25rem; 
      border-bottom: 1px solid var(--line);
    }
    .dest-table :global(td) { 
      display: block; 
      padding: 0 !important; 
      border: none; 
      width: 100%;
    }
    .dest-table :global(td.cell-city) { 
      font-size: 1.15rem; 
      margin-bottom: 0.35rem;
    }
    .dest-table :global(td.cell-country),
    .dest-table :global(td.cell-continent) {
      display: inline-block;
      font-size: 0.85rem;
      color: #666;
      width: auto;
    }
    .dest-table :global(td.cell-continent::before) {
      content: "·";
      margin: 0 0.4rem;
      font-weight: bold;
      color: #999;
    }
    .dest-table :global(td.cell-airlines) {
      margin-top: 0.85rem;
    }
  }
</style>

<style is:global>
  /* Rich Content Blocks */
  .content-section { padding: 4rem 0; background: var(--cream); }
  .content-prose { max-width: 800px; font-size: 1.05rem; line-height: 1.7; color: var(--ink-2); margin-bottom: 3rem; }
  .content-prose h2 { margin-bottom: 1.5rem; font-family: var(--font-display); color: var(--ink); }
  .content-prose p { margin-bottom: 1rem; }
  
  .links-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1.5rem;
  }
  .link-card {
    background: #fff; padding: 2rem; border-radius: var(--r-lg);
    border: 1px solid var(--line); box-shadow: var(--shadow-sm);
    text-decoration: none; color: var(--ink); display: block;
    transition: transform var(--transition), box-shadow var(--transition);
  }
  .link-card:hover {
    transform: translateY(-3px); box-shadow: var(--shadow-md); border-color: var(--green);
  }
  .link-card h3 { font-size: 1.15rem; font-family: var(--font-display); margin-bottom: 0.5rem; color: var(--green-dark); }
  .link-card p { font-size: 0.95rem; color: var(--ink-2); margin: 0; }
</style>

<script is:inline define:vars={{ destinationsJson }}>
  document.addEventListener('DOMContentLoaded', () => {
    const data = JSON.parse(destinationsJson);
    const tbody = document.getElementById('destBody');
    const searchInput = document.getElementById('destSearch');
    const noResults = document.getElementById('noResults');

    const render = (items) => {
      if (!tbody) return;
      tbody.innerHTML = '';
      if (items.length === 0) {
        if(noResults) noResults.style.display = 'block';
        tbody.parentElement.style.display = 'none';
        return;
      }
      if(noResults) noResults.style.display = 'none';
      tbody.parentElement.style.display = 'table';
      
      items.forEach(item => {
        const tr = document.createElement('tr');
        const airlinesHtml = item.airlines.map(a => `<span class="airline-tag">${a}</span>`).join('');
        tr.innerHTML = `
          <td class="cell-city"><strong>${item.city}</strong></td>
          <td class="cell-country">${item.country}</td>
          <td class="cell-continent">${item.continent}</td>
          <td class="cell-airlines">${airlinesHtml}</td>
        `;
        tbody.appendChild(tr);
      });
    };

    render(data);

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const term = e.target.value.toLowerCase();
        const filtered = data.filter(d => 
          d.city.toLowerCase().includes(term) ||
          d.country.toLowerCase().includes(term) ||
          d.continent.toLowerCase().includes(term) ||
          d.airlines.some(a => a.toLowerCase().includes(term))
        );
        render(filtered);
      });
    }
  });
</script>
