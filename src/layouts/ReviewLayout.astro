---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import FaqSection from '../components/ui/FaqSection.astro';
import CtaBand from '../components/ui/CtaBand.astro';
import AffiliateLink from '../components/affiliate/AffiliateLink.astro';
import Icon from '../components/ui/Icon.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import SchemaReview from '../components/seo/SchemaReview.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface FAQ { q: string; a: string; }
interface Crumb { name: string; href: string; }
interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
  heroImage?: ImageMetadata;
  eyebrow: string;
  h1: string;
  lede: string;
  breadcrumbs: Crumb[];
  brand: string;
  rating: number;
  verdict: string;
  pros: string[];
  cons: string[];
  heroProvider: any;
  heroCtaLabel: string;
  faqs?: FAQ[];
  faqHeading?: string;
  cta: { heading: string; text?: string; provider: any; label: string };
}
const {
  title, description, lang, ogImage, heroImage,
  eyebrow, h1, lede, breadcrumbs, brand, rating, verdict, pros, cons,
  heroProvider, heroCtaLabel, faqs = [], faqHeading, cta,
} = Astro.props;
const t = useTranslations(lang);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const sub = pathname.replace(/\//g, '-').replace(/^-|-$/g, '') || 'home';
const absCrumbs = breadcrumbs.map((c) => ({ name: c.name, url: site.url + c.href }));
const full = Math.floor(rating);
---
<BaseLayout title={title} description={description} lang={lang} ogImage={ogImage} ogType="article" webpageSchema={false}>
  <SchemaBreadcrumb slot="head" items={absCrumbs} />
  <SchemaReview slot="head" itemName={brand} description={verdict} url={`${site.url}${pathname}`} rating={rating} />

  <section class:list={['hero', { 'hero--photo': heroImage }]}>
    {heroImage && <div class="hero-bg"><Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" /></div>}
    <div class="container hero-inner">
      <Breadcrumbs items={breadcrumbs} />
      <span class="eyebrow">{eyebrow}</span>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div class="hero-cta">
        <AffiliateLink provider={heroProvider} sub={sub} class="btn btn-primary btn-lg btn-arrow">{heroCtaLabel}</AffiliateLink>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="content-col">
        <div class="verdict-card">
          <div class="verdict-rating">
            <div class="stars" aria-label={`${rating} out of 5`}>
              {Array.from({ length: 5 }).map((_, i) => <Icon name="star" size={22} class={i < full ? 'star-on' : 'star-off'} />)}
            </div>
            <span class="rating-num">{rating.toFixed(1)}<small>/5</small></span>
          </div>
          <p class="verdict-text">{verdict}</p>
          <div class="proscons">
            <div class="pros">
              <h3>{t('labels.pros')}</h3>
              <ul>{pros.map((p) => <li><Icon name="check" size={16} /> {p}</li>)}</ul>
            </div>
            <div class="cons">
              <h3>{t('labels.cons')}</h3>
              <ul>{cons.map((c) => <li>{c}</li>)}</ul>
            </div>
          </div>
        </div>
        <slot />
      </div>
    </div>
  </section>

  {faqs.length > 0 && (
    <section class="section section-alt">
      <div class="container content-col">
        <FaqSection faqs={faqs} heading={faqHeading ?? t('common.faqHeading')} />
      </div>
    </section>
  )}

  <CtaBand heading={cta.heading} text={cta.text} provider={cta.provider} sub={sub} ctaLabel={cta.label} />
</BaseLayout>

<style>
  .verdict-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); padding: 1.5rem; margin-bottom: 2rem; box-shadow: var(--shadow-sm); }
  .verdict-rating { display: flex; align-items: center; gap: 0.75rem; margin-bottom: 0.75rem; }
  .stars { display: flex; gap: 2px; }
  .star-on { color: var(--yellow); fill: var(--yellow); }
  .star-off { color: var(--line); }
  .rating-num { font-family: var(--font-display); font-weight: 700; font-size: 1.4rem; color: var(--ink); }
  .rating-num small { font-size: 0.85rem; color: var(--ink-3); }
  .verdict-text { font-size: 1.1rem; color: var(--ink); }
  .proscons { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-top: 1rem; }
  .proscons h3 { font-size: 1rem; margin-bottom: 0.5rem; }
  .proscons ul { list-style: none; padding: 0; }
  .proscons li { font-size: 0.95rem; color: var(--ink-2); margin-bottom: 0.4rem; }
  .pros li { display: flex; gap: 0.5rem; align-items: flex-start; }
  .pros svg { color: var(--green); flex: none; margin-top: 3px; }
  .cons li { padding-left: 1.2rem; position: relative; }
  .cons li::before { content: '–'; position: absolute; left: 0.2rem; color: var(--orange); font-weight: 700; }
  @media (max-width: 560px) { .proscons { grid-template-columns: 1fr; } }
</style>
