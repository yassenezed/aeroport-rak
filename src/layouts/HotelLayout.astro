---
// Fiche hôtel : avis éditorial, points forts et réserves, schéma Hotel + Review.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import { useTranslations, pathFor, type Locale } from '../i18n';
import { site } from '../data/site';
import type { LocalizedHotel } from '../copy/types';
import { HOTEL_HERO, HOTEL_ALT_SUFFIX, PRICE_LABEL, hotelPriceLink } from '../data/hotelLinks';
import { existsSync } from 'node:fs';
import { HOTEL_IMAGES } from '../data/hotelLinks';

// Sous-titre du H1 (mot-clé), titre de FAQ et bloc « autres hôtels », par langue.
const H1_SUB: Record<string, string> = {
  fr: "notre avis et l'accès depuis l'aéroport Marrakech-Ménara",
  en: 'our review and access from Marrakech Menara Airport',
  es: 'nuestra reseña y el acceso desde el aeropuerto de Marrakech-Menara',
  de: 'unsere Bewertung und Anfahrt ab Flughafen Marrakesch-Menara',
  nl: 'onze beoordeling en bereikbaarheid vanaf luchthaven Marrakech-Menara',
  ar: 'تقييمنا وطريقة الوصول من مطار مراكش المنارة',
};
const FAQ_H: Record<string, (n: string) => string> = {
  fr: (n) => `${n} et aéroport Marrakech-Ménara : questions fréquentes`,
  en: (n) => `${n} and Marrakech Menara Airport: frequently asked questions`,
  es: (n) => `${n} y aeropuerto de Marrakech-Menara: preguntas frecuentes`,
  de: (n) => `${n} und Flughafen Marrakesch-Menara: häufige Fragen`,
  nl: (n) => `${n} en luchthaven Marrakech-Menara: veelgestelde vragen`,
  ar: (n) => `${n} ومطار مراكش المنارة: أسئلة شائعة`,
};
const MORE: Record<string, { h: string; all: string; read: string; prep: string; links: [string, string][] }> = {
  fr: { h: "Autres hôtels près de l'aéroport Marrakech-Ménara", all: 'Voir les 15 hôtels sélectionnés', read: 'Lire notre avis', prep: 'Préparer votre arrivée :', links: [['bookTransfer', 'réserver un transfert'], ['transfers', 'taxi, bus 19 ou transfert'], ['arrivals', 'arrivées en direct'], ['carRental', 'location de voiture']] },
  en: { h: 'More hotels near Marrakech Menara Airport', all: 'See all 15 selected hotels', read: 'Read our review', prep: 'Plan your arrival:', links: [['bookTransfer', 'book a transfer'], ['transfers', 'taxi, bus 19 or transfer'], ['arrivals', 'live arrivals'], ['carRental', 'car hire']] },
  es: { h: 'Otros hoteles cerca del aeropuerto de Marrakech-Menara', all: 'Ver los 15 hoteles seleccionados', read: 'Leer nuestra reseña', prep: 'Prepare su llegada:', links: [['bookTransfer', 'reservar un traslado'], ['transfers', 'taxi, bus 19 o traslado'], ['arrivals', 'llegadas en directo'], ['carRental', 'alquiler de coches']] },
  de: { h: 'Weitere Hotels nahe Flughafen Marrakesch-Menara', all: 'Alle 15 ausgewählten Hotels', read: 'Zur Bewertung', prep: 'Ankunft planen:', links: [['bookTransfer', 'Transfer buchen'], ['transfers', 'Taxi, Bus 19 oder Transfer'], ['arrivals', 'Ankünfte live'], ['carRental', 'Mietwagen']] },
  nl: { h: 'Meer hotels bij luchthaven Marrakech-Menara', all: 'Bekijk de 15 geselecteerde hotels', read: 'Lees onze beoordeling', prep: 'Uw aankomst plannen:', links: [['bookTransfer', 'transfer boeken'], ['transfers', 'taxi, bus 19 of transfer'], ['arrivals', 'aankomsten live'], ['carRental', 'autohuur']] },
  ar: { h: 'فنادق أخرى قرب مطار مراكش المنارة', all: 'شاهد الفنادق الخمسة عشر المختارة', read: 'اقرأ تقييمنا', prep: 'خطط لوصولك:', links: [['bookTransfer', 'احجز نقلًا'], ['transfers', 'تاكسي أو الحافلة 19 أو نقل'], ['arrivals', 'الرحلات الواصلة مباشرة'], ['carRental', 'كراء السيارات']] },
};
// Autres fiches d'avis : clé de route → identifiant photo.
const REVIEWS: [string, string][] = [['mamounia', 'mamounia'], ['mansour', 'royalMansour'], ['essaadi', 'esSaadi'], ['yasmine', 'riadYasmine'], ['riadbe', 'riadBe']];

interface Props { locale: Locale; routeKey: string; page: LocalizedHotel; noindex?: boolean }
const { locale, routeKey, page, noindex = false } = Astro.props;
const t = useTranslations(locale);
const path = pathFor(routeKey, locale);
const hero = HOTEL_HERO[routeKey];
// Image de partage de l'hôtel si elle existe (photos assez grandes), sinon image de marque de la langue.
const ogCandidate = hero ? hero.src.replace('/images/hotels/', '/og/hotels/').replace('-large.webp', '.jpg') : undefined;
const heroOg = ogCandidate && existsSync(`public${ogCandidate}`) ? ogCandidate : undefined;
// Clé de route de la fiche → identifiant de l'hôtel dans hotelLinks.ts
const HOTEL_ID: Record<string, string> = { mamounia: 'mamounia', mansour: 'royalMansour', essaadi: 'esSaadi', yasmine: 'riadYasmine', riadbe: 'riadBe' };
const more = MORE[locale] ?? MORE.en;
const others = REVIEWS.filter(([k]) => k !== routeKey);
const price = HOTEL_ID[routeKey] ? hotelPriceLink(HOTEL_ID[routeKey], page.h1) : null;

const crumbs = [
  { name: t('nav.home'), href: pathFor('home', locale) },
  { name: t('nav.hotels'), href: pathFor('hotels', locale) },
  { name: page.h1, href: path },
];

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: `${site.url}${c.href}` })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Hotel',
    name: page.h1,
    description: page.description,
    address: { '@type': 'PostalAddress', addressLocality: 'Marrakech', addressCountry: 'MA' },
    ...(hero ? { image: `${site.url}${hero.src}` } : {}),
    ...(page.priceRange ? { priceRange: page.priceRange } : {}),
    ...(page.rating ? {
      review: {
        '@type': 'Review',
        reviewRating: { '@type': 'Rating', ratingValue: page.rating, bestRating: 5 },
        author: { '@type': 'Organization', name: site.name },
        ...(page.verdict ? { reviewBody: page.verdict } : {}),
      },
    } : {}),
  },
];
if (page.faqs?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<BaseLayout locale={locale} routeKey={routeKey} title={page.title} description={page.description} schema={schema} noindex={noindex} ogImage={heroOg}>
  <section class="hero hero--small hero--hotel">
    <div class="container hero__inner">
      <Breadcrumbs items={crumbs} />
      {page.eyebrow && <span class="eyebrow">{page.eyebrow}</span>}
      <h1>{page.h1}<span class="h1-sub">{H1_SUB[locale] ?? H1_SUB.en}</span></h1>
      <p class="lede">{page.lede}</p>
      <div class="hotel-meta">
        {page.stars && <span class="chip">{page.stars}</span>}
        {page.area && <span class="chip">{page.area}</span>}
        {page.priceRange && <span class="chip">{page.priceRange}</span>}
        {page.rating && (
          <span class="chip chip--score">
            <strong>{page.rating.toFixed(1)}</strong>/5 · {page.ratingLabel ?? t('common.editorialScore')}
          </span>
        )}
      </div>
      {price && <p class="hotel-cta"><a class="btn btn--primary" href={price.href} target="_blank" rel={price.rel}>{PRICE_LABEL[locale]}</a></p>}
    </div>
  </section>

  {hero && (
    <section class="section-block section-block--tight hotel-photo-block">
      <div class="container">
        <figure class="hotel-photo">
          <img src={hero.src} alt={`${page.h1} – ${HOTEL_ALT_SUFFIX[locale]}`} width={hero.width} height={hero.height} fetchpriority="high" decoding="async" style={hero.width < 1000 ? `max-width: ${hero.width}px` : undefined} />
        </figure>
      </div>
    </section>
  )}

  {page.verdict && (
    <section class="section-block section-block--tight">
      <div class="container">
        <div class="callout callout--verdict">
          <h2>{t('common.verdict')}</h2>
          <p>{page.verdict}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section-block">
    <div class="container">
      <div class="prose" set:html={page.body} />
    </div>
  </section>

  {(page.pros?.length || page.cons?.length) && (
    <section class="section-block section-block--alt">
      <div class="container">
        <div class="proscons">
          {page.pros?.length && (
            <div class="proscons__col proscons__col--pro">
              <h2>{t('common.pros')}</h2>
              <ul>{page.pros.map((p) => <li>{p}</li>)}</ul>
            </div>
          )}
          {page.cons?.length && (
            <div class="proscons__col proscons__col--con">
              <h2>{t('common.cons')}</h2>
              <ul>{page.cons.map((c) => <li>{c}</li>)}</ul>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {page.faqs && page.faqs.length > 0 && (
    <section class="section-block">
      <div class="container container--narrow">
        <h2 class="section-block__title">{(FAQ_H[locale] ?? FAQ_H.en)(page.h1)}</h2>
        <div class="faq-list">
          {page.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-body"><p set:html={f.a} /></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-block section-block--alt related-hotels">
    <div class="container">
      <h2 class="section-block__title">{more.h}</h2>
      <ul class="card-grid card-grid--feature" style="--cols: 4">
        {others.map(([k, id]) => (
          <li class:list={['feat-card feat-card--feature', { 'feat-card--photo': !!HOTEL_IMAGES[id] }]}>
            {HOTEL_IMAGES[id] && <img class="feat-card__photo" src={HOTEL_IMAGES[id]} alt={`${t(`hotelNames.${k}`)} – ${HOTEL_ALT_SUFFIX[locale]}`} width="640" height="400" loading="lazy" decoding="async" />}
            <div class="feat-card__body">
              <h3>{t(`hotelNames.${k}`)}</h3>
              <a class="feat-card__link" href={pathFor(k, locale)}>{more.read} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>
            </div>
          </li>
        ))}
      </ul>
      <p class="related-hotels__all"><a class="btn btn--secondary" href={pathFor('hotels', locale)}>{more.all}</a></p>
      <p class="related-hotels__prep"><strong>{more.prep}</strong> {more.links.map(([k, label], i) => <>{i > 0 && ' · '}<a href={pathFor(k, locale)}>{label}</a></>)}</p>
    </div>
  </section>

  {page.cta && (
    <section class="section-block section-block--alt">
      <div class="container">
        <div class="cta-dark-bg">
          <h2>{page.cta.heading}</h2>
          {page.cta.text && <p>{page.cta.text}</p>}
          <a class="btn btn--primary btn--lg" href={page.cta.href ?? pathFor('bookTransfer', locale)}>{page.cta.label}</a>
        </div>
      </div>
    </section>
  )}
</BaseLayout>
