---
import MoneyLayout from './MoneyLayout.astro';
const props = Astro.props as any;
---
<MoneyLayout
  {...props}
  heroProvider={props.heroProvider ?? 'booking'}
  cta={props.cta ?? { heading: 'Trouvez où dormir à Marrakech', text: 'Comparez riads de la médina, hôtels de Guéliz et resorts de la Palmeraie, annulation gratuite sur la plupart des chambres.', provider: 'booking', label: 'Voir les hébergements' }}
>
  <slot />
</MoneyLayout>
