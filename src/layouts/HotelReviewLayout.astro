---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import AffiliateLink from '../components/affiliate/AffiliateLink.astro';
import SchemaBreadcrumb from '../components/seo/SchemaBreadcrumb.astro';
import SchemaReview from '../components/seo/SchemaReview.astro';
import { site } from '../data/site';
import { useTranslations, type Lang } from '../i18n';

interface FAQ { q: string; a: string; }
interface Crumb { name: string; href: string; }
interface Props {
  title: string;
  description: string;
  lang: Lang;
  ogImage?: string;
  heroImage: ImageMetadata;
  h1: string;
  subtitle: string;
  breadcrumbs: Crumb[];
  brand: string;
  rating: number;
  verdict: string;
  priceAvg: string;
  address: string;
  stars: string;
  ratingText: string;
  ctaLink: string;
  ctaLabel: string;
  faqs?: FAQ[];
  faqHeading?: string;
}

const {
  title, description, lang, ogImage, heroImage,
  h1, subtitle, breadcrumbs, brand, rating, verdict,
  priceAvg, address, stars, ratingText,
  ctaLink, ctaLabel, faqs = [], faqHeading = 'Questions fréquentes'
} = Astro.props;

const t = useTranslations(lang);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const absCrumbs = breadcrumbs.map((c) => ({ name: c.name, url: site.url + c.href }));
---
<BaseLayout title={title} description={description} lang={lang} ogImage={ogImage} ogType="article" webpageSchema={false}>
  <SchemaBreadcrumb slot="head" items={absCrumbs} />
  <SchemaReview slot="head" itemName={brand} description={verdict} url={`${site.url}${pathname}`} rating={rating} />
  
  {faqs.length > 0 && (
    <script type="application/ld+json" slot="head" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    })} />
  )}

  <section class="page-hero page-hero--sm">
    <div class="page-hero__bg">
      <Image src={heroImage} alt="" widths={[768, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="page-hero__overlay"></div>
    <div class="container page-hero__content">
      <h1 class="page-hero__title">{h1}</h1>
      <p class="page-hero__subtitle">{subtitle}</p>
    </div>
  </section>

  <div class="container layout-sidebar">
    <main class="main-content">
      <slot />

      {faqs.length > 0 && (
        <div class="content-block" style="margin-top: var(--space-lg);">
          <h2>{faqHeading}</h2>
          <div class="faq-accordion">
            {faqs.map(f => (
              <details class="faq-accordion__item">
                <summary class="faq-accordion__question">{f.q}</summary>
                <div class="faq-accordion__answer">
                  <p>{f.a}</p>
                </div>
              </details>
            ))}
          </div>
        </div>
      )}
    </main>

    <aside class="sidebar">
      <div class="widget">
        <h3>Infos pratiques</h3>
        <ul class="info-list">
          <li><strong>Classement :</strong> {stars}</li>
          <li><strong>Notre note éditoriale :</strong> {rating}/5 ({ratingText})</li>
          <li><strong>Ordre de prix :</strong> {priceAvg}</li>
          <li><strong>Wi-Fi :</strong> Gratuit</li>
          <li><strong>Quartier :</strong> {address}</li>
        </ul>
        <a class="btn btn--full btn--green mt-md" href={ctaLink} rel="nofollow sponsored" target="_blank">{ctaLabel}</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .page-hero--sm {
    min-height: 28vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    overflow: hidden;
    padding-top: 80px; /* Fix header overlap */
  }
  .page-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .page-hero__bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .page-hero__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.65); /* Darker overlay for better text readability */
    z-index: 2;
  }
  .page-hero__content {
    position: relative;
    z-index: 3;
    text-align: center;
    padding: var(--space-xl) 0;
    max-width: var(--container-narrow);
  }
  .page-hero__title {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 0 0 1rem;
    font-family: var(--font-display);
    line-height: 1.15;
    color: #fff;
  }
  .page-hero__subtitle {
    font-size: 1.25rem;
    opacity: 0.95;
    margin: 0;
  }

  .layout-sidebar {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 3rem;
    margin-top: 3rem;
    margin-bottom: 3rem;
    align-items: start;
  }

  /* These classes are for the <slot/> content */
  :global(.content-block) {
    background: #fff;
    padding: 2.5rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
  }
  :global(.content-block h2) {
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-size: 1.8rem;
    color: var(--ink);
  }
  :global(.content-block h2:first-child) {
    margin-top: 0;
  }
  :global(.content-block h3) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.4rem;
    color: var(--ink-2);
  }
  :global(.content-block p) {
    font-size: 1.1rem;
    line-height: 1.7;
    margin-bottom: 1.2rem;
  }
  :global(.pros-list) {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
  }
  :global(.pros-list li) {
    margin-bottom: 0.8rem;
    font-size: 1.1rem;
    padding-left: 20px;
    position: relative;
    line-height: 1.6;
  }
  :global(.pros-list li::before) {
    content: "✓";
    color: var(--green);
    position: absolute;
    left: 0;
    font-weight: bold;
  }
  :global(.steps-list) {
    padding-left: 24px;
    margin: 1.5rem 0;
  }
  :global(.steps-list li) {
    margin-bottom: 0.8rem;
    line-height: 1.6;
    font-size: 1.1rem;
  }
  :global(.features-grid) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin: 1.5rem 0;
  }
  :global(.feature-item) {
    background: var(--cream-2);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 1.5rem;
  }
  :global(.feature-item strong) {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--ink);
    font-size: 1.15rem;
  }
  :global(.feature-item p) {
    margin: 0;
    font-size: 1rem;
    color: var(--ink-2);
  }
  :global(.promo-box) {
    background: #f0fdf4;
    border: 1px solid #bbf7d0;
    padding: 2rem;
    border-radius: var(--r-lg);
    margin-top: 3rem;
    text-align: center;
  }
  :global(.promo-box h3) {
    margin-top: 0;
    color: var(--green-dark);
  }

  .sidebar .widget {
    background: #fff;
    padding: 2rem;
    border-radius: var(--r-lg);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-sm);
    position: sticky;
    top: 100px;
  }
  .info-list {
    list-style: none;
    padding: 0;
  }
  .info-list li {
    margin-bottom: 12px;
    border-bottom: 1px solid var(--line);
    padding-bottom: 12px;
    font-size: 1.05rem;
    color: var(--ink-2);
  }
  .info-list li strong {
    color: var(--ink);
  }
  .btn--full {
    display: block;
    width: 100%;
    text-align: center;
  }
  .btn--green {
    display: inline-block;
    background: var(--green);
    color: #fff;
    padding: 14px 24px;
    border-radius: var(--r-pill);
    font-weight: 600;
    text-decoration: none;
    font-size: 1.1rem;
    transition: background var(--transition), transform var(--transition);
  }
  .btn--green:hover {
    background: var(--green-dark);
    transform: translateY(-2px);
  }
  .mt-md {
    margin-top: 1.5rem;
  }

  /* FAQ Styles */
  .faq-accordion__item {
    border-bottom: 1px solid var(--line);
    padding: 1.2rem 0;
  }
  .faq-accordion__question {
    font-weight: 600;
    font-size: 1.15rem;
    cursor: pointer;
    color: var(--ink);
    list-style: none;
    position: relative;
    padding-right: 30px;
  }
  .faq-accordion__question::-webkit-details-marker {
    display: none;
  }
  .faq-accordion__question::after {
    content: '+';
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.5rem;
    line-height: 1;
    font-weight: bold;
    color: var(--green);
  }
  .faq-accordion__item[open] .faq-accordion__question::after {
    content: '−';
  }
  .faq-accordion__answer {
    margin-top: 1rem;
    color: var(--ink-2);
    line-height: 1.7;
    font-size: 1.05rem;
  }

  @media (max-width: 768px) {
    .layout-sidebar {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .sidebar .widget {
      position: static;
    }
    :global(.features-grid) {
      grid-template-columns: 1fr;
    }
    .page-hero__title {
      font-size: 2rem;
    }
  }
</style>
