---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import TrustBand from '../components/layout/TrustBand.astro';
import StickyTransfer from '../components/ui/StickyTransfer.astro';
import ConsentBanner from '../components/layout/ConsentBanner.astro';
import { site } from '../data/site';
import { gaId, travelpayouts } from '../data/affiliate';
import {
  useTranslations, alternatesFor, pathFor, isRtl, OG_LOCALES,
  DEFAULT_LOCALE, type Locale, type RouteKey,
} from '../i18n';

interface Props {
  locale: Locale;
  routeKey: RouteKey | string;
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  schema?: object | object[];
  bodyClass?: string;
}

const {
  locale, routeKey, title, description,
  ogImage, ogType = 'website', noindex = false, schema, bodyClass,
} = Astro.props;

const t = useTranslations(locale);
const path = pathFor(routeKey, locale);
const canonical = `${site.url}${path}`;
const alternates = alternatesFor(routeKey);
const xDefault = alternates.find((a) => a.locale === DEFAULT_LOCALE)!;
// Pas de suffixe de marque : le title reste exactement celui défini pour la page.
const fullTitle = title;
// Image de partage : celle de la page, sinon l'image de marque dans la langue de la page (scripts/og.mjs).
const ogImageUrl = `${site.url}${ogImage ?? `/og/aeroportrak-${locale}.jpg`}`;
const dir = isRtl(locale) ? 'rtl' : 'ltr';
const schemas = schema ? (Array.isArray(schema) ? schema : [schema]) : [];
---
<!DOCTYPE html>
<html lang={locale} dir={dir}>
<head>
  <script is:inline>
    // Consentement (mode consentement Google v2). Les visiteurs dont le fuseau horaire est
    // européen (EEE, Royaume-Uni, Suisse) partent en « refusé » jusqu'à leur choix dans le
    // bandeau ; les autres en « accordé », avec possibilité de refuser via le pied de page.
    (function () {
      var tz = '';
      try { tz = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
      var eu = /^Europe\//.test(tz) || /^(Atlantic\/(Canary|Madeira|Azores|Reykjavik|Faroe)|Asia\/Nicosia|Arctic\/Longyearbyen)$/.test(tz);
      var choice = null;
      try { choice = localStorage.getItem('rak-consent'); } catch (e) {}
      var ok = choice === 'granted' || (!eu && choice !== 'denied');
      window.rakConsent = { eu: eu, choice: choice, ok: ok };
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () { dataLayer.push(arguments); };
      var v = ok ? 'granted' : 'denied';
      gtag('consent', 'default', { analytics_storage: v, ad_storage: v, ad_user_data: v, ad_personalization: v, wait_for_update: 500 });
      gtag('set', 'ads_data_redaction', !ok);
    })();
  </script>
  {gaId && (
    <>
      <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
      <script is:inline define:vars={{ gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', gaId);
      </script>
    </>
  )}

  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#15172b" />
  {noindex
    ? <meta name="robots" content="noindex, nofollow" />
    : <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />}

  <link rel="canonical" href={canonical} />
  {alternates.map((a) => (
    <link rel="alternate" hreflang={a.locale} href={`${site.url}${a.path}`} />
  ))}
  <link rel="alternate" hreflang="x-default" href={`${site.url}${xDefault.path}`} />

  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:locale" content={OG_LOCALES[locale]} />
  {alternates.filter((a) => a.locale !== locale).map((a) => (
    <meta property="og:locale:alternate" content={OG_LOCALES[a.locale]} />
  ))}
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={title} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />

  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,700&family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&display=swap" rel="stylesheet" />

  {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  <slot name="head" />

  {travelpayouts.trackingScript && (
    <script is:inline data-noptimize="1" data-cfasync="false" data-no-defer="1" define:vars={{ src: travelpayouts.trackingScript }}>
      // Travelpayouts Drive : injecté seulement après le chargement complet de la page,
      // pendant un temps mort du navigateur, pour ne pas peser sur l'affichage.
      (function () {
        var inject = function () {
          var s = document.createElement('script');
          s.async = true; s.src = src; s.setAttribute('data-cmp-ab', '2');
          document.head.appendChild(s);
        };
        var done = false;
        var idle = function () {
          if (done) return; done = true;
          if ('requestIdleCallback' in window) requestIdleCallback(inject, { timeout: 3000 });
          else setTimeout(inject, 1500);
        };
        var start = function () {
          if (document.readyState === 'complete') idle();
          else window.addEventListener('load', idle, { once: true });
        };
        // Script d'affiliation : seulement si le consentement est acquis (voir bandeau).
        window.rakLoadDrive = start;
        if (window.rakConsent && window.rakConsent.ok) start();
      })();
    </script>
  )}
</head>
<body class={bodyClass}>
  <Header locale={locale} routeKey={routeKey} />
  <main>
    <slot />
  </main>
  <TrustBand locale={locale} />
  <Footer locale={locale} />
  <StickyTransfer locale={locale} routeKey={routeKey} />
  <ConsentBanner locale={locale} />
  <script is:inline>
    window.addEventListener('message', function (e) {
      if (e.data && e.data.tpemdHeight) {
        var frames = document.querySelectorAll('.tpemd-iframe');
        for (var i = 0; i < frames.length; i++) {
          if (frames[i].contentWindow === e.source) {
            frames[i].style.height = (e.data.tpemdHeight + 20) + 'px';
            break;
          }
        }
      }
    });
  </script>
</body>
</html>
