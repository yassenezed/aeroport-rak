---
import MoneyLayout from './MoneyLayout.astro';
const props = Astro.props as any;
---
<MoneyLayout
  {...props}
  heroProvider={props.heroProvider ?? 'kiwitaxi'}
  cta={props.cta ?? { heading: 'Comparez les transferts et réservez le bon', text: 'Prix en direct chez les opérateurs que nous suivons : bloquez celui qui correspond à votre vol et à votre groupe.', provider: 'transfer', label: 'Voir les prix des transferts' }}
>
  <slot />
</MoneyLayout>
