---
// Gabarit de page courant :
// hero--small, bandeau de chiffres, blocs de contenu, FAQ, CTA sombre.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/layout/Breadcrumbs.astro';
import FlightWidget from '../components/ui/FlightWidget.astro';
import FlightSearchWidget from '../components/affiliate/FlightSearchWidget.astro';
import EsimWidget from '../components/affiliate/EsimWidget.astro';
import CompensationWidget from '../components/affiliate/CompensationWidget.astro';
import TransferWidget from '../components/affiliate/TransferWidget.astro';
import Icon from '../components/ui/Icon.astro';
import DestinationsExplorer from '../components/destinations/DestinationsExplorer.astro';
import { airport } from '../data/airport';
import { useTranslations, pathFor, type Locale, type RouteKey } from '../i18n';
import { site } from '../data/site';
import type { LocalizedPage } from '../copy/types';

interface Props {
  locale: Locale;
  routeKey: RouteKey | string;
  page: LocalizedPage;
  ogType?: 'website' | 'article';
  extraSchema?: object[];
  noindex?: boolean;
  crumbs?: { name: string; key: string }[];
}
const { locale, routeKey, page, ogType = 'website', extraSchema = [], crumbs = [], noindex = false } = Astro.props;
const t = useTranslations(locale);
const path = pathFor(routeKey, locale);
const weatherLabels = Object.fromEntries(
  ['clear', 'clearNight', 'partly', 'cloudy', 'fog', 'rain', 'snow', 'showers', 'storm'].map((k) => [k, t(`weatherCodes.${k}`)]),
);

const breadcrumbItems = [
  { name: t('nav.home'), href: pathFor('home', locale) },
  ...crumbs.map((c) => ({ name: c.name, href: pathFor(c.key, locale) })),
  { name: page.h1, href: path },
];

const schema: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems.map((c, i) => ({
      '@type': 'ListItem', position: i + 1, name: c.name, item: `${site.url}${c.href}`,
    })),
  },
  ...extraSchema,
];
if (page.faqs?.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: page.faqs.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---
<BaseLayout
  locale={locale}
  routeKey={routeKey}
  title={page.title}
  description={page.description}
  ogType={ogType}
  schema={schema}
  noindex={noindex}
>
  <section class="hero hero--small">
    <div class="container hero__inner">
      <Breadcrumbs items={breadcrumbItems} />
      {page.eyebrow && <span class="eyebrow">{page.eyebrow}</span>}
      <h1>{page.h1}</h1>
      <p class="lede">{page.lede}</p>
    </div>
  </section>

  {page.highlights && page.highlights.length > 0 && (
    <section class="info-cards-band">
      <div class="container">
        <ul class="info-cards">
          {page.highlights.map((h) => (
            <li class="info-card">
              <span class="info-card__icon"><Icon name={h.icon} size={24} /></span>
              <div>
                <span class="info-card__label">{h.label}</span>
                {h.live === 'clock' && <strong class="info-card__value" dir="ltr" data-rak-clock data-offset={airport.utcOffsetHours}>{h.value}</strong>}
                {h.live === 'weather' && <strong class="info-card__value" dir="auto" data-rak-weather data-labels={JSON.stringify(weatherLabels)}>{h.value}</strong>}
                {!h.live && <strong class="info-card__value" dir="auto">{h.value}</strong>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {page.facts && page.facts.length > 0 && (
    <section class="facts-band">
      <div class="container">
        <div class="facts">
          {page.facts.map((f) => (
            <div class="fact">
              <span class="fact-label">{f.label}</span>
              <span class="fact-value" dir="auto">{f.value}{f.sub && <small> {f.sub}</small>}</span>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.widget && (
    <section class="section-block section-block--widget">
      <div class="container">
        {page.widget === 'flights-arrivals' && <FlightWidget type="arrivals" lang={locale} />}
        {page.widget === 'flights-departures' && <FlightWidget type="departures" lang={locale} />}
        {page.widget === 'flight-search' && <FlightSearchWidget locale={locale} />}
        {page.widget === 'transfer' && <TransferWidget locale={locale} />}
        {page.widget === 'esim' && <EsimWidget locale={locale} />}
        {page.widget === 'compensation' && <CompensationWidget locale={locale} />}
      </div>
    </section>
  )}

  {page.destinations && <DestinationsExplorer locale={locale} copy={page.destinations} />}

  {page.cardSections?.map((sec, si) => (
    <section class={`section-block card-section card-section--${sec.variant}${si % 2 ? ' section-block--alt' : ''}`}>
      <div class="container">
        <header class="home-services__head">
          {sec.eyebrow && <span class="eyebrow">{sec.eyebrow}</span>}
          <h2>{sec.heading}</h2>
          {sec.intro && <p>{sec.intro}</p>}
        </header>
        <ul class={`card-grid card-grid--${sec.variant}`} style={sec.variant === 'feature' && sec.items.length === 4 ? '--cols: 4' : undefined}>
          {sec.items.map((it) => (
            <li class={`feat-card feat-card--${sec.variant}`}>
              <span class="feat-card__icon"><Icon name={it.icon} size={sec.variant === 'feature' ? 24 : 20} /></span>
              <div class="feat-card__body">
                <h3>{it.title}</h3>
                <p>{it.text}</p>
                {it.tags && it.tags.length > 0 && (
                  <ul class="feat-card__tags">{it.tags.map((tg) => <li>{tg}</li>)}</ul>
                )}
                {it.link && <a class="feat-card__link" href={pathFor(it.link.key, locale)}>{it.link.label} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></a>}
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
  ))}

  {page.steps && (
    <section class="section-block page-steps">
      <div class="container">
        <header class="home-services__head">
          <h2>{page.steps.heading}</h2>
          {page.steps.intro && <p>{page.steps.intro}</p>}
        </header>
        <ol class="steps-grid" style={`--cols: ${page.steps.items.length}`}>
          {page.steps.items.map((st, i) => (
            <li class="step-card">
              <span class="step-card__icon"><Icon name={st.icon} size={24} /><span class="step-card__num" dir="ltr">{i + 1}</span></span>
              <h3>{st.title}</h3>
              <p>{st.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  {page.services && (
    <section class="section-block section-block--alt home-services">
      <div class="container">
        <header class="home-services__head">
          <h2>{page.services.heading}</h2>
          <p>{page.services.intro}</p>
        </header>
        <div class="service-grid">
          {page.services.items.map((sv) => (
            <a class="service-card" href={pathFor(sv.key, locale)}>
              <span class="service-card__icon"><Icon name={sv.icon} size={26} /></span>
              <h3>{sv.title}</h3>
              <p>{sv.text}</p>
              <span class="service-card__cta">{sv.cta} <span aria-hidden="true">{locale === 'ar' ? '←' : '→'}</span></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section-block">
    <div class="container">
      <article class="prose" set:html={page.body} />
    </div>
  </section>

  {page.spotlight && (
    <section class="section-block">
      <div class="container">
        <aside class="spotlight">
          <span class="spotlight__icon"><Icon name={page.spotlight.icon} size={26} /></span>
          <div>
            <h2>{page.spotlight.heading}</h2>
            <p set:html={page.spotlight.text} />
          </div>
        </aside>
      </div>
    </section>
  )}

  {page.faqs && page.faqs.length > 0 && (
    <section class="section-block section-block--alt">
      <div class="container container--narrow">
        <h2 class="section-block__title">{page.faqHeading ?? t('common.faq')}</h2>
        <div class="faq-list">
          {page.faqs.map((f) => (
            <details class="faq-item">
              <summary>{f.q}</summary>
              <div class="faq-body"><p>{f.a}</p></div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {page.cta && (
    <section class="section-block">
      <div class="container">
        <div class="cta-dark-bg">
          <h2>{page.cta.heading}</h2>
          {page.cta.text && <p>{page.cta.text}</p>}
          <a class="btn btn--primary btn--lg" href={page.cta.href ?? pathFor('bookTransfer', locale)}>{page.cta.label}</a>
        </div>
      </div>
    </section>
  )}
  {page.highlights?.some((h) => h.live) && (
    <script is:inline>
      (function () {
        // Heure locale de Marrakech : UTC + décalage fixé dans src/data/airport.ts.
        var el = document.querySelector('[data-rak-clock]');
        if (el) {
          var offset = parseFloat(el.dataset.offset || '0') * 3600000;
          var pad = function (n) { return (n < 10 ? '0' : '') + n; };
          var tick = function () {
            var d = new Date(Date.now() + offset);
            el.textContent = pad(d.getUTCHours()) + ':' + pad(d.getUTCMinutes());
          };
          tick(); setInterval(tick, 15000);
        }
        // Météo actuelle à l'aéroport (Open-Meteo, sans clé ni cookie) : température + ciel (codes WMO).
        var w = document.querySelector('[data-rak-weather]');
        if (w && window.fetch) {
          var L = JSON.parse(w.dataset.labels || '{}');
          var sky = function (c, day) {
            if (c === 0) return day ? L.clear : L.clearNight;
            if (c <= 2) return L.partly;
            if (c === 3) return L.cloudy;
            if (c === 45 || c === 48) return L.fog;
            if (c >= 95) return L.storm;
            if (c >= 80) return L.showers;
            if (c >= 71 && c <= 77) return L.snow;
            if (c >= 51) return L.rain;
            return '';
          };
          fetch('https://api.open-meteo.com/v1/forecast?latitude=31.607&longitude=-8.036&current=temperature_2m,weather_code,is_day&timezone=Africa%2FCasablanca')
            .then(function (r) { return r.ok ? r.json() : null; })
            .then(function (d) {
              var c = d && d.current;
              if (c && typeof c.temperature_2m === 'number') {
                var label = sky(c.weather_code, c.is_day === 1);
                w.textContent = Math.round(c.temperature_2m) + ' °C' + (label ? ' · ' + label : '');
              }
            })
            .catch(function () {});
        }
      })();
    </script>
  )}
</BaseLayout>
