---
import MoneyLayout from './MoneyLayout.astro';
const props = Astro.props as any;
---
<MoneyLayout
  {...props}
  heroProvider={props.heroProvider ?? 'discovercars'}
  cta={props.cta ?? { heading: 'Comparez tous les comptoirs du RAK', text: "Les agences de l'aéroport de Marrakech côte à côte : prix, caution, politique carburant et assurance au même endroit.", provider: 'discovercars', label: 'Comparer les prix de location' }}
>
  <slot />
</MoneyLayout>
