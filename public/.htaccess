# AeroportRAK — hébergement statique Hostinger (Apache / LiteSpeed)
Options -Indexes
DirectorySlash On

# HTTPS + domaine sans www (une seule version canonique)
RewriteEngine On
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://aeroportrak.com%{REQUEST_URI} [L,R=301]

# /index.html et /dossier/index.html → URL propre avec slash (évite les doublons de contenu)
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^ https://aeroportrak.com/%1 [L,R=301]

# Page 404 personnalisée (non indexée)
ErrorDocument 404 /404.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/xml text/xml
</IfModule>

# Cache navigateur : fichiers versionnés d'Astro = 1 an, images = 30 jours, HTML = toujours revalidé
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(png|jpe?g|webp|avif|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # HTTPS obligatoire pour les navigateurs pendant 1 an (le site est 100 % HTTPS)
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
